/-! ## (A) THE BELOW-Λ CENSUS-CONSERVING TAIL — the two derived parts and their positivity. -/

/-- Abstract arithmetic core (opaque `k, C` — NO transcendental terms): if `0 < k`,
    `k ≤ (1/3)·(2500000/7853981)`, and `−5/3 ≤ C`, then `0 < 16/9 + k·C`. This keeps the heavy
    `cutLog`/`cutPi` terms OUT of the arithmetic — the W9 decomposition (a monolithic `nlinarith` on the
    unexpanded transcendentals blows the tableau; the abstract core closes in bounded time). -/
theorem pos_core (k C : Cut) (hk : 0 < k) (hkhi : k ≤ (1 / 3) * (2500000 / 7853981))
    (hC : (-5 / 3 : Cut) ≤ C) : 0 < 16 / 9 + k * C := by
  rcases le_or_gt 0 C with hCpos | hCneg
  · have : 0 ≤ k * C := mul_nonneg (le_of_lt hk) hCpos
    linarith
  · have h1 : k * C ≥ ((1 / 3) * (2500000 / 7853981)) * C :=
      mul_le_mul_of_nonpos_right hkhi (le_of_lt hCneg)
    have h2 : ((1 / 3 : Cut) * (2500000 / 7853981)) * C
        ≥ ((1 / 3) * (2500000 / 7853981)) * (-5 / 3) :=
      mul_le_mul_of_nonneg_left hC (by norm_num)
    have h3 : ((1 / 3 : Cut) * (2500000 / 7853981)) * (-5 / 3) > -16 / 9 := by norm_num
    linarith [h1, h2, h3]

