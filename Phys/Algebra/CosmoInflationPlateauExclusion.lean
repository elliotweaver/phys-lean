noncomputable section

/-! ## (1) THE THREE NAMED CANDIDATE POTENTIALS over the derived ℝ `Cut`. -/

/-- THE PLATEAU / α-attractor potential, built on the fold's OWN Born-positive self-overlap
    exponential `cutExp` (N174): `V(φ) = (1 − cutExp(−cφ))²`. The eternal approach (C6) toward a
    coherence asymptote realized on the derived continuum. -/
def plateauApproachPot (c φ : Cut) : Cut := (1 - cutExp (-(c * φ))) ^ 2

/-- THE MONOMIAL potential `V(φ) = φ^p` — the chaotic-inflation family. -/
def monomialPot (p : ℕ) (φ : Cut) : Cut := φ ^ p

/-- THE HILLTOP potential `V(φ) = 1 − (φ/μ)^p`. -/
def hilltopPot (μ : Cut) (p : ℕ) (φ : Cut) : Cut := 1 - (φ / μ) ^ p

/-! ## (2) THE PLATEAU SURVIVES: bounded, NEVER attained (C6 / self-blindness), the approach. -/

/-- The plateau potential is nonnegative (it is a square of a `Cut`). -/
theorem plateauApproachPot_nonneg (c φ : Cut) : 0 ≤ plateauApproachPot c φ := by
  unfold plateauApproachPot; positivity

/-- ★ BOUNDED (the coherence asymptote): the plateau potential is STRICTLY below `1` for every
    `φ ≥ 0`. The suppression factor `cutExp(−cφ) ∈ (0,1]` (banked `cutExp_pos`,
    `cutExp_le_one_of_nonpos`) forces `(1 − cutExp(−cφ))² < 1`. -/
theorem plateauApproachPot_lt_one (c φ : Cut) (hc : 0 < c) (hφ : 0 ≤ φ) :
    plateauApproachPot c φ < 1 := by
  unfold plateauApproachPot
  set e := cutExp (-(c * φ)) with he
  have hepos : 0 < e := by rw [he]; exact cutExp_pos _
  have hle : e ≤ 1 := by
    rw [he]
    apply cutExp_le_one_of_nonpos
    have hcf : 0 ≤ c * φ := by positivity
    linarith
  nlinarith [hepos, hle]

/-- ★★★ THE CORE (C6 / self-blindness): the plateau potential NEVER attains its bound on `φ ≥ 0`.
    This is the fold's no-fixed-point primitive made concrete — the eternal approach: the field
    rolls toward the coherence value `1` but reaches it for no finite `φ`. -/
theorem plateauApproachPot_never_attains_bound (c φ : Cut) (hc : 0 < c) (hφ : 0 ≤ φ) :
    plateauApproachPot c φ ≠ 1 :=
  ne_of_lt (plateauApproachPot_lt_one c φ hc hφ)

/-- ★ THE APPROACH: the plateau potential is strictly increasing on `φ ≥ 0` — the field rolls
    monotonically toward (but never reaches) the asymptote. Uses banked `cutExp_strictMono`. -/
theorem plateauApproachPot_strictMono (c φ₁ φ₂ : Cut)
    (hc : 0 < c) (h0 : 0 ≤ φ₁) (h12 : φ₁ < φ₂) :
    plateauApproachPot c φ₁ < plateauApproachPot c φ₂ := by
  unfold plateauApproachPot
  have harg : -(c * φ₂) < -(c * φ₁) := by nlinarith
  have hmono : cutExp (-(c * φ₂)) < cutExp (-(c * φ₁)) := cutExp_strictMono harg
  set e1 := cutExp (-(c * φ₁)) with he1
  set e2 := cutExp (-(c * φ₂)) with he2
  have he1le : e1 ≤ 1 := by
    rw [he1]
    apply cutExp_le_one_of_nonpos
    have hcf : 0 ≤ c * φ₁ := by positivity
    linarith
  have he2pos : 0 < e2 := by rw [he2]; exact cutExp_pos _
  nlinarith [hmono, he1le, he2pos]

/-! ## (3) THE MONOMIAL AND HILLTOP ARE EXCLUDED (structurally, by the fold's criteria). -/

/-- ★ MONOMIAL EXCLUDED: `φ^p` (`p ≠ 0`) is UNBOUNDED above — it has NO coherence asymptote to
    approach, so it cannot realize the eternal-approach (C6) structure. For any bound `B` there is
    a `φ ≥ 0` with `φ^p > B`. -/
theorem monomialPot_unbounded (p : ℕ) (hp : p ≠ 0) (B : Cut) :
    ∃ φ : Cut, 0 ≤ φ ∧ B < monomialPot p φ := by
  refine ⟨|B| + 1, by positivity, ?_⟩
  unfold monomialPot
  have h1 : (1 : Cut) ≤ |B| + 1 := by have := abs_nonneg B; linarith
  have hself : |B| + 1 ≤ (|B| + 1) ^ p := le_self_pow₀ h1 hp
  have hBle : B ≤ |B| := le_abs_self B
  linarith

/-- ★ HILLTOP EXCLUDED (attains its bound): `1 − (φ/μ)^p` (`p ≠ 0`) ATTAINS its supremum `1` at
    `φ = 0` — a stationary maximum = a FIXED POINT, which the fold's self-blindness forbids. -/
theorem hilltopPot_attains_bound (μ : Cut) (p : ℕ) (hp : p ≠ 0) :
    hilltopPot μ p 0 = 1 := by
  unfold hilltopPot
  rw [zero_div, zero_pow hp, sub_zero]

/-- The hilltop is bounded above by its attained max `1` on `φ ≥ 0` (contrast with the plateau,
    which is bounded but NEVER attains). -/
theorem hilltopPot_le_one (μ φ : Cut) (p : ℕ) (hμ : 0 < μ) (hφ : 0 ≤ φ) :
    hilltopPot μ p φ ≤ 1 := by
  unfold hilltopPot
  have : 0 ≤ (φ / μ) ^ p := by positivity
  linarith

/-! ## (4) THE CLASS-UNIVERSAL OBSERVABLE RELATIONS (candidate-grade — DEFINED, derivation CHILDED). -/

/-- The plateau spectral relation `n_s = 1 − 2/N` (`N` the e-fold count, SYMBOLIC). Candidate-grade:
    the slow-roll derivation FROM `plateauApproachPot` is childed (needs derived-ℝ calculus). -/
def nsPlateau (N : Cut) : Cut := 1 - 2 / N

/-- The monomial spectral relation `n_s = 1 − (p+2)/(2N)`. -/
def nsMonomial (p N : Cut) : Cut := 1 - (p + 2) / (2 * N)

/-- The plateau tensor-to-scalar ratio `r = 8/(c²N²)` (the `1/N²` suppression). -/
def rPlateau (c N : Cut) : Cut := 8 / (c ^ 2 * N ^ 2)

/-- The monomial tensor-to-scalar ratio `r = 4p/N` (only `1/N` suppression). -/
def rMonomial (p N : Cut) : Cut := 4 * p / N

/-- ★ THE TENSOR CROSS-TIE: the plateau's `r` IS the monomial's `r` scaled by `2/(p·c²·N)` — the
    extra `1/N` (i.e. `1/N²` vs `1/N`) suppression that makes plateau tensors unobservably small. -/
theorem rPlateau_eq_rMonomial_scaled (c N p : Cut)
    (hc : c ≠ 0) (hN : N ≠ 0) (hp : p ≠ 0) :
    rPlateau c N = rMonomial p N * (2 / (p * c ^ 2 * N)) := by
  unfold rPlateau rMonomial
  field_simp
  ring

/-- ★ MONOMIALS DIE ON r: once `p·c²·N > 2` the plateau's tensor ratio is STRICTLY below the
    monomial's. This is "monomials die on `r`" — the falsifiable no-observable-tensor stance. -/
theorem rPlateau_lt_rMonomial (c N p : Cut)
    (hc : 0 < c) (hN : 0 < N) (hp : 0 < p) (hbig : 2 < p * c ^ 2 * N) :
    rPlateau c N < rMonomial p N := by
  have hrm : 0 < rMonomial p N := by unfold rMonomial; positivity
  have hpc : 0 < p * c ^ 2 * N := by positivity
  rw [rPlateau_eq_rMonomial_scaled c N p (ne_of_gt hc) (ne_of_gt hN) (ne_of_gt hp)]
  have hfrac : 2 / (p * c ^ 2 * N) < 1 := by
    rw [div_lt_one hpc]; exact hbig
  nlinarith [hrm, hfrac]

/-- Monomials are never bluer than the plateau in the spectral tilt: for `p ≥ 2`, `N > 0`,
    `n_s(monomial) ≤ n_s(plateau)`. -/
theorem nsMonomial_le_nsPlateau (p N : Cut) (hp : 2 ≤ p) (hN : 0 < N) :
    nsMonomial p N ≤ nsPlateau N := by
  unfold nsMonomial nsPlateau
  have h2N : 0 < 2 * N := by positivity
  have hdiff : (p + 2) / (2 * N) - 2 / N = (p - 2) / (2 * N) := by
    field_simp; ring
  have hnn : 0 ≤ (p - 2) / (2 * N) := by
    apply div_nonneg
    · linarith
    · linarith
  linarith [hdiff, hnn]

/-! ## (5) THE CAPSTONE: the plateau class is SELECTED by the fold's criteria. -/

/-- ★★★ THE HEART: for `c > 0`, `φ ≥ 0`, the plateau potential is nonnegative, is BOUNDED
    (`< 1`), NEVER attains its bound (the C6 / self-blindness no-fixed-point), and (for `φ₂ > φ`)
    strictly increases toward the asymptote; meanwhile the monomial (`p ≠ 0`) is UNBOUNDED above
    (no asymptote → excluded) and the hilltop (`p ≠ 0`) ATTAINS its bound `1` at the origin
    (a fixed-point maximum → excluded). The plateau is the unique named class that is
    bounded-yet-never-attained — SELECTED, not fit. All over the derived `Cut`. -/
theorem inflation_plateau_selected (c φ : Cut) (hc : 0 < c) (hφ : 0 ≤ φ)
    (p : ℕ) (hp : p ≠ 0) (μ : Cut) :
    0 ≤ plateauApproachPot c φ
      ∧ plateauApproachPot c φ < 1
      ∧ plateauApproachPot c φ ≠ 1
      ∧ (∀ B : Cut, ∃ ψ : Cut, 0 ≤ ψ ∧ B < monomialPot p ψ)
      ∧ hilltopPot μ p 0 = 1 :=
  ⟨plateauApproachPot_nonneg c φ,
   plateauApproachPot_lt_one c φ hc hφ,
   plateauApproachPot_never_attains_bound c φ hc hφ,
   fun B => monomialPot_unbounded p hp B,
   hilltopPot_attains_bound μ p hp⟩

end

