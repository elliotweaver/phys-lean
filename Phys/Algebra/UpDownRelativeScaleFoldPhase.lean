/-! ## (A) THE ℂ-FOLD BORN AMPLITUDE `q = cutCos(cutPi/4)` — the banked half-turn root. -/

/-- The ℂ-fold Born amplitude `q := cutCos(cutPi/4)`. Banked: `q² = 1/2`, `0 < q`. This is the
    balance-point amplitude of the amplitude-halving cascade (N416). -/
def q : Cut := cutCos (cutPi / 4)

/-- `q² = 1/2` (banked N416 `cutCos_quarter_sq`). -/
theorem q_sq : q * q = 1 / 2 := cutCos_quarter_sq

/-- `0 < q` (banked N416 `cutCos_quarter_pos`). -/
theorem q_pos : 0 < q := cutCos_quarter_pos

/-- `q < 1` — from `q² = 1/2 < 1` and `0 < q`. Load-bearing for the strict suppression below. -/
theorem q_lt_one : q < 1 := by nlinarith [q_sq, q_pos]

/-! ## (B) THE FOLD-PHASE SQUARE AMPLITUDES at `P = foldPhase = cutPi/8`. -/

/-- ★ THE FOLD-PHASE COSINE SQUARE: `cutCos(foldPhase)² = (1 + q)/2` (banked N416 `cutCos_eighth_sq`,
    the ℍ-level half-angle amplitude root). -/
theorem cosP_sq : cutCos foldPhase * cutCos foldPhase = (1 + q) / 2 := by
  unfold foldPhase q; exact cutCos_eighth_sq

/-- ★ THE FOLD-PHASE SINE SQUARE: `cutSin(foldPhase)² = (1 − q)/2` — from the Born-circle Pythagorean
    identity (N323 `cutSin_sq_add_cutCos_sq`) and `cosP_sq`. -/
theorem sinP_sq : cutSin foldPhase * cutSin foldPhase = (1 - q) / 2 := by
  have hpy := cutSin_sq_add_cutCos_sq foldPhase
  have hc : cutCos foldPhase * cutCos foldPhase = (1 + q) / 2 := cosP_sq
  linarith [hpy, hc]

/-- `0 < cutCos foldPhase` (banked N416 `cutCos_eighth_pos`). -/
theorem cosP_pos : 0 < cutCos foldPhase := cutCos_eighth_pos

/-! ## (C) THE FOLD-PHASE BORN FACTOR `foldPhaseBorn = (tan²P·cosP)² = sin⁴P/cos²P`. -/

/-- ★ THE FOLD-PHASE BORN FACTOR over the derived ℝ: the QT1 phase factor `(tan²P·cosP)²`, which over
    the Born square is `sin⁴P/cos²P`. The `tan` dissolves to `sin`/`cos` — no `cutTan` needed. This is
    the slot the banked M2 gear (N408) DEFERRED as "route-not-yet-found, needs the fold phase P"; P is
    now banked (N416). -/
def foldPhaseBorn : Cut :=
  (cutSin foldPhase * cutSin foldPhase) * (cutSin foldPhase * cutSin foldPhase)
    / (cutCos foldPhase * cutCos foldPhase)

/-- ★★ THE FOLD-PHASE BORN FACTOR CLOSES: `foldPhaseBorn = (1 − q)²/(2·(1 + q))`, a determined derived
    `Cut` value (from `sinP_sq`, `cosP_sq`). -/
theorem foldPhaseBorn_closed : foldPhaseBorn = (1 - q) ^ 2 / (2 * (1 + q)) := by
  unfold foldPhaseBorn
  rw [sinP_sq, cosP_sq]
  have hq1 : 0 < 1 + q := by have := q_pos; linarith
  have hne : (1 + q) / 2 ≠ 0 := by positivity
  field_simp

/-- Born positivity: `0 < foldPhaseBorn` (`1 − q > 0`, `1 + q > 0`). -/
theorem foldPhaseBorn_pos : 0 < foldPhaseBorn := by
  rw [foldPhaseBorn_closed]
  have h1 : 0 < 1 + q := by have := q_pos; linarith
  have h2 : 0 < 1 - q := by have := q_lt_one; linarith
  positivity

/-! ## (D) THE DERIVED UP/DOWN BORN RATIO `mbRatioDerived = foldPhaseBorn · (banked survival 2/3)`. -/

/-- The `Cut`-domain gear: the M2 Born ratio `phaseBorn · (tr Poth/3)`, over the derived ℝ (the banked
    N408 ℚ-gear `mbBornRatio` lifted to `Cut` so it accepts the derived — irrational — fold-phase
