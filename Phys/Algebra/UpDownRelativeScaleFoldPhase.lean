    ∧ mbRatioDerived ≠ 2 / 3
    ∧ sectorMass 2 0 / sectorMass 1 0 = 4 :=
  ⟨foldPhaseBorn_closed,
   mbRatioDerived_closed,
   mbBornRatioCut_restrict,
   crossSector_heaviest_ratio Mu Md hu,
