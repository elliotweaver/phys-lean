def mbBornRatioCut (phaseBorn : Cut) : Cut := phaseBorn * ((s1BornProb : ℚ) : Cut)

/-- ★ THE `Cut`-GEAR RESTRICTS TO THE BANKED ℚ-GEAR: on rational slots (cast ℚ→`Cut`), `mbBornRatioCut`
    equals the banked N408 `mbBornRatio` — the domain extension is faithful, not a substitution. -/
theorem mbBornRatioCut_restrict (p : ℚ) :
    mbBornRatioCut ((p : ℚ) : Cut) = ((mbBornRatio p : ℚ) : Cut) := by
  unfold mbBornRatioCut mbBornRatio
  push_cast
  ring

/-- ★★ THE DERIVED UP/DOWN BORN RATIO: the M2 gear with its `phaseBorn` slot FILLED by the banked
    fold-phase Born factor. A determined derived `Cut` value — NO free parameter. -/
def mbRatioDerived : Cut := mbBornRatioCut foldPhaseBorn

/-- `mbRatioDerived = foldPhaseBorn · (2/3)` (the banked survival `s1BornProb = 2/3`, N308). -/
theorem mbRatioDerived_eq : mbRatioDerived = foldPhaseBorn * (2 / 3) := by
  unfold mbRatioDerived mbBornRatioCut
  rw [s1BornProb_value]
  norm_num

/-- ★★★ THE CLOSED FORM: `mbRatioDerived = (1 − q)²/(3·(1 + q))` — the up/down relative Born ratio as
    an EXACT determined function of the banked ℂ-fold amplitude `q = cutCos(cutPi/4)`, `q² = 1/2`. The
    QT1 law (b) `m_b/m_t = (tan²P·cosP·√(2/3))²` with the fold phase `P = cutPi/8` filled from N416. -/
theorem mbRatioDerived_closed : mbRatioDerived = (1 - q) ^ 2 / (3 * (1 + q)) := by
  rw [mbRatioDerived_eq, foldPhaseBorn_closed]
  have h1 : 0 < 1 + q := by have := q_pos; linarith
  field_simp

/-- Born positivity: `0 < mbRatioDerived`. -/
theorem mbRatioDerived_pos : 0 < mbRatioDerived := by
  rw [mbRatioDerived_eq]; have := foldPhaseBorn_pos; positivity

/-! ## (E) THE RELATIVE-SCALE READING — the parent's residual, read off the fold phase. -/

/-- ★★★ THE CROSS-SECTOR HEAVIEST RATIO IS A PURE RELATIVE SCALE: `sectorMass Md 0 / sectorMass Mu 0 =
    (Md/Mu)²`. In the parent sector tower `sectorMass M k = M²·bMass k`, the heaviest-to-heaviest
    cross-sector ratio has the banked shape `bMass 0` CANCEL entirely — leaving the pure relative
    sector scale `(Md/Mu)²`, no shape content. So `mbRatioDerived` IS the up/down relative scale
    squared: `(Md/Mu)² = mbRatioDerived`. -/
theorem crossSector_heaviest_ratio (Mu Md : Cut) (hu : Mu ≠ 0) :
    sectorMass Md 0 / sectorMass Mu 0 = (Md / Mu) ^ 2 := by
  rw [sectorMass_eq, sectorMass_eq]
  have hb0 : (0 : Cut) < bMass 0 := by
    have : bMass 0 = GenerationMassRatios.mass0 := rfl
    rw [this]; exact GenerationMassRatios.mass0_pos
  have hb0ne : bMass 0 ≠ 0 := ne_of_gt hb0
  have hu2 : (Mu : Cut) ^ 2 ≠ 0 := pow_ne_zero 2 hu
  field_simp

/-! ## (F) W8 NON-VACUITY WITH TEETH. -/

/-- ★★ W8 — THE DOWN LEG IS GENUINELY BELOW THE TOP: `mbRatioDerived < 1`. A WRONG "no up/down
    hierarchy" reading gives `1`; the fold-phase Born weight is a genuine suppression `< 1`. -/
theorem mbRatioDerived_lt_one : mbRatioDerived < 1 := by
  rw [mbRatioDerived_closed]
  have h1 : 0 < 1 + q := by have := q_pos; linarith
  have h3 : 0 < 3 * (1 + q) := by linarith
  rw [div_lt_one h3]
  -- (1 − q)² < 3(1 + q):  expand and use q² = 1/2, q > 0
  nlinarith [q_sq, q_pos, q_lt_one]

/-- ★★ W8 — THE FOLD-PHASE FACTOR GENUINELY BITES: `mbRatioDerived ≠ 2/3` (the bare banked survival).
    A WRONG "the phase factor is trivial (= 1)" reading would give `mbRatioDerived = 2/3`; the derived
    fold-phase Born factor is genuinely `≠ 1`, so the ratio is strictly below the bare survival. -/
theorem mbRatioDerived_ne_survival : mbRatioDerived ≠ 2 / 3 := by
  have hlt : mbRatioDerived < 1 := mbRatioDerived_lt_one
  rw [mbRatioDerived_closed]
  intro hcontra
  -- (1−q)²/(3(1+q)) = 2/3  ⟹  (1−q)² = 2(1+q)  ⟹  contradiction with q²=1/2, q<1
  have h1 : 0 < 1 + q := by have := q_pos; linarith
  have h3 : (3 : Cut) * (1 + q) ≠ 0 := by positivity
  rw [div_eq_iff h3] at hcontra
  nlinarith [q_sq, q_pos, q_lt_one, hcontra]

/-- ★ W8 — THE RELATIVE-SCALE RESIDUAL IS REAL: the heaviest cross-sector ratio genuinely DEPENDS on
    the relative scale — at `Md = 2·Mu` (fixed `Mu = 1`) it is `4 ≠ 1`, so the reduction to the
    relative scale is not a vacuous constant. -/
theorem crossSector_scale_genuine :
    sectorMass 2 0 / sectorMass 1 0 = 4 := by
  rw [crossSector_heaviest_ratio 1 2 one_ne_zero]
  norm_num

/-! ## (G) THE CAPSTONE — welded, non-hollow. -/

/-- ★★★ THE UP/DOWN RELATIVE SECTOR SCALE = THE FOLD PHASE'S BORN WEIGHT (arc-D remainder, welded
    landing). The dominant leg of the parent's reduced residual — the up/down relative sector scale —
    DERIVED from the banked fold phase `P = cutPi/8`:

    (1) THE FOLD-PHASE BORN FACTOR: `foldPhaseBorn = (1 − q)²/(2·(1 + q))` (`foldPhaseBorn_closed`),
        `q = cutCos(cutPi/4)`, `q² = 1/2` — the QT1 phase factor `(tan²P·cosP)²` with P filled from N416
        (the deferred M2-gear slot, now closed);
    (2) THE DERIVED UP/DOWN BORN RATIO: `mbRatioDerived = foldPhaseBorn · (tr Poth/3) =
        (1 − q)²/(3·(1 + q))` (`mbRatioDerived_closed`) — the M2 gear with the banked self-blind
