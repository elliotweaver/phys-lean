/-! ## (1) THE SEESAW RATIO `m₀/M = (v/M)²` as the Born self-overlap square of the EW rung. -/

/-- THE SEESAW-TO-CLOSURE RATIO `m₀/M = (v/M)²`, the BORN SELF-OVERLAP SQUARE of the banked electroweak
    rung `ewClosureRatio = v/M` (N332). The square is the Born self-overlap form (`cutExp_pos`, N174):
    the electroweak rung seen through its own overlap. `ewClosureRatio` is BANKED (N332). -/
def seesawRatio : Cut := ewClosureRatio * ewClosureRatio

/-- `m₀/M` is a genuine square (`ewClosureRatio²`) — the Born self-overlap form, mirroring B3's
    `newtonScaleProduct = planckClosureRatio²` (N330). -/
theorem seesawRatio_born_square : seesawRatio = ewClosureRatio ^ 2 := by
  unfold seesawRatio; ring

/-- ★★ THE SEESAW RATIO VALUE `m₀/M = e^(−56π/3)`. The Born square of the EW rung `e^(−28π/3)`
    collapses by the banked homomorphism `cutExp_add` to `cutExp(−(56·cutPi/3))` (56π/3 = 28π/3 +
    28π/3); the exponent is the n=9 electroweak rung DOUBLED. Never premised as a literal. -/
theorem seesawRatio_eq : seesawRatio = cutExp (-(56 * cutPi / 3)) := by
  unfold seesawRatio
  rw [ewClosureRatio_eq, cutExp_add]
  congr 1; ring

/-- ★ THE BORN-SQUARE DOUBLING: the seesaw exponent `56·cutPi/3` is exactly twice the banked n=9
    electroweak rung `rungExponent(finrank spaceSub) = 28·cutPi/3` — the factor `2` is the Born
    self-overlap square, not a second input (mirrors `gravExponent_eq_two_rung`, N330). -/
theorem seesawExponent_eq_two_rung :
    (56 : Cut) * cutPi / 3 = 2 * rungExponent (Module.finrank ℚ spaceSub) := by
  rw [rungExponent_at_spaceSub]; ring

/-- Born positivity of the seesaw ratio: `0 < m₀/M` (banked `cutExp_pos`). -/
theorem seesawRatio_pos : 0 < seesawRatio := by
  rw [seesawRatio_eq]; exact cutExp_pos _

/-- STRICT SUPPRESSION: `m₀/M < 1`. The argument `−(56·cutPi/3)` is strictly negative (`cutPi_pos`),
    so by banked `cutExp_strictMono` and `cutExp_zero`, `cutExp(−(56·cutPi/3)) < cutExp 0 = 1`. -/
theorem seesawRatio_lt_one : seesawRatio < 1 := by
  rw [seesawRatio_eq]
  have hneg : -(56 * cutPi / 3) < 0 := by have := cutPi_pos; linarith
  have := cutExp_strictMono hneg
  rwa [cutExp_zero] at this

/-- ★ THE SEESAW SCALE IS DEEPER THAN THE EW RUNG: `m₀/M < v/M`. Since `0 < v/M < 1`, squaring the EW
    rung lands strictly below it — the seesaw ratio is more suppressed than its EW rung atom. -/
theorem seesawRatio_lt_ewClosureRatio : seesawRatio < ewClosureRatio := by
  unfold seesawRatio
  have h1 := ewClosureRatio_lt_one
  have h0 := ewClosureRatio_pos
  calc ewClosureRatio * ewClosureRatio < 1 * ewClosureRatio :=
        mul_lt_mul_of_pos_right h1 h0
    _ = ewClosureRatio := one_mul _

/-! ## (2) THE SEESAW SCALE `m₀ = M·(v/M)²` and the LITERAL seesaw formula `m₀ = v²/M`. -/

/-- THE SEESAW SCALE `m₀ = M·(v/M)²`, keeping the closure scale `M` the single dimensionful anchor
    (G3) — no new `Cut` atom. `seesawRatio` is the banked EW rung squared. -/
def seesawScale (M : Cut) : Cut := M * seesawRatio

/-- Positivity of the seesaw scale: `0 < m₀` for `0 < M` (banked positivity of the ratio). -/
theorem seesawScale_pos (M : Cut) (hM : 0 < M) : 0 < seesawScale M := by
  unfold seesawScale; exact mul_pos hM seesawRatio_pos

/-- ★ THE LITERAL SEESAW FORMULA `m₀ = v²/M`. The banked VEV `v = transmutationScale M
    (rungExponent(9)·g²) g²` equals `M·(v/M)` (N332's `ewClosureRatio_eq_transmutation` forces B1's
    coefficient `c = rungExponent(9)·g²`), so `v²/M = (M·(v/M))²/M = M·(v/M)² = m₀`. Pure `field_simp`
    on the banked rung. The seesaw scale is genuinely the Born self-overlap of the VEV over the
    closure anchor. -/
theorem seesawScale_eq_vev_sq_div (M g2 : Cut) (hM : M ≠ 0) (hg : g2 ≠ 0) :
    (transmutationScale M (rungExponent (Module.finrank ℚ spaceSub) * g2) g2) ^ 2 / M
      = seesawScale M := by
  have hv : transmutationScale M (rungExponent (Module.finrank ℚ spaceSub) * g2) g2
          = M * ewClosureRatio := by
    unfold transmutationScale; rw [ewClosureRatio_eq_transmutation g2 hg]
  rw [hv]; unfold seesawScale; rw [seesawRatio_born_square]
  field_simp

/-- ★ THE SEESAW SCALE IS BELOW THE VEV: `m₀ < v`. Since `0 < m₀/M < v/M`, multiplying by the anchor
    `M > 0` keeps the order: the seesaw scale is strictly below the electroweak VEV. -/
theorem seesawScale_lt_vev (M g2 : Cut) (hM : 0 < M) (hg : g2 ≠ 0) :
    seesawScale M < transmutationScale M (rungExponent (Module.finrank ℚ spaceSub) * g2) g2 := by
  have hv : transmutationScale M (rungExponent (Module.finrank ℚ spaceSub) * g2) g2
          = M * ewClosureRatio := by
    unfold transmutationScale; rw [ewClosureRatio_eq_transmutation g2 hg]
  rw [hv]; unfold seesawScale
  exact mul_lt_mul_of_pos_left seesawRatio_lt_ewClosureRatio hM

/-! ## (3) THE CAPSTONE — B6, all consequences at once. -/

/-- ★★★ B6 — THE BORN-SQUARE SEESAW SCALE, all consequences at once, on the banked derived-ℝ
    `cutExp`/`cutPi` and the banked electroweak rung. The seesaw ratio `m₀/M` equals `e^(−56π/3)`, is
    the Born self-overlap square of the EW rung `e^(−28π/3)`, its exponent `56·cutPi/3` is twice the
    banked n=9 rung `28·cutPi/3`, it is positive, strictly below the EW rung `v/M`, and the EW rung is
    strictly below `1` — i.e. the ordered chain `0 < m₀/M < v/M < 1`. -/
theorem seesaw_born_square_scale :
    seesawRatio = cutExp (-(56 * cutPi / 3))
    ∧ seesawRatio = ewClosureRatio ^ 2
    ∧ (56 : Cut) * cutPi / 3 = 2 * rungExponent (Module.finrank ℚ spaceSub)
    ∧ 0 < seesawRatio
    ∧ seesawRatio < ewClosureRatio
    ∧ ewClosureRatio < 1 :=
  ⟨seesawRatio_eq, seesawRatio_born_square, seesawExponent_eq_two_rung,
   seesawRatio_pos, seesawRatio_lt_ewClosureRatio, ewClosureRatio_lt_one⟩

/-! ## NON-VACUITY (W8): the Born-square doubling is load-bearing. -/

/-- NON-VACUITY: `m₀/M ≠ v/M` — the Born self-overlap SQUARE is genuinely below the un-squared EW
    rung. If the square collapsed (no Born self-overlap), the two would coincide. -/
theorem seesawRatio_ne_ewClosureRatio : seesawRatio ≠ ewClosureRatio :=
  ne_of_lt seesawRatio_lt_ewClosureRatio

/-- NON-VACUITY: the seesaw exponent `56·cutPi/3` genuinely differs from the un-squared EW rung
    `28·cutPi/3` — a WRONG single-power reading (`m₀/M = e^(−28π/3)`, no Born square) would collapse
    the doubling. -/
theorem seesawExponent_ne_rung : (56 : Cut) * cutPi / 3 ≠ 28 * cutPi / 3 := by
  intro h
  have := cutPi_pos
  nlinarith [this]

