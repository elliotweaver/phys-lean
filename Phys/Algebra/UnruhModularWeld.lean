theorem unruh_modular_weld {n : ℕ} [NeZero n] (E : Fin n → Cut) (a : Cut) (ha : a ≠ 0) :
    (∀ ρ τ : Cut, rindlerEucPoint ρ a (τ + unruhPeriod a) = rindlerEucPoint ρ a τ)
      ∧ rindlerEucPoint 1 1 cutPi ≠ rindlerEucPoint 1 1 0
      ∧ a * unruhPeriod a = azimuthalTurn
      ∧ unruhTemp a = a / (2 * cutPi)
      ∧ unruhPeriod a = hawkingPeriod a
      ∧ (∃ c, MaxEnt.IsGibbsState (MaxEnt.boltzmann E (unruhPeriod a)) E (unruhPeriod a) c) :=
  ⟨fun ρ τ => rindler_closes ρ a τ ha, rindler_half_period_conical, unruh_closure a ha,
   unruhTemp_eq a, unruhPeriod_eq_hawkingPeriod a, unruh_kms_equilibrium E a⟩

/-! ## (6) W8 NON-VACUITY: the temperature is genuinely acceleration-dependent. -/

/-- ★★ W8 NON-VACUITY (the tie genuinely bites): `T_Unruh(a=2) ≠ T_Unruh(a=1)` — the temperature
    genuinely depends on the acceleration, `2/(2·cutPi) ≠ 1/(2·cutPi)`. This REFUTES the vacuous
    mis-reading "the Unruh temperature is acceleration-independent" (the tie is not empty). -/
theorem unruhTemp_two_ne_one : unruhTemp 2 ≠ unruhTemp 1 := by
  rw [unruhTemp_eq, unruhTemp_eq]
  have hπ := cutPi_pos
  intro h
  have h2 : (2 : Cut) * cutPi ≠ 0 := by positivity
  field_simp at h
  norm_num at h

