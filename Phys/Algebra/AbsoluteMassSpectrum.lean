    breaking element, not a bolted-on spurion. (N275's "no fixed root" left this as a route-finder's
    job; it is the banked N295 spectrum-mover.) -/
theorem breaking_direction_outside_symmetry : Lmul (slotA (1 : O ℚ)) ∉ derH3 := Lmul_notMem_derH3

/-! ## (H) NON-VACUITY (W8, C452). -/

/-- W8 NON-VACUITY: the absolute mass scale is a genuine nonzero determined value (not a collapse to
    `0`, which would make the whole spectrum vacuous). -/
theorem massScale_ne_zero : massScale ≠ 0 := ne_of_gt massScale_pos

/-- W8 NON-VACUITY: the spectrum is genuinely non-degenerate — the lightest is strictly below the
    heaviest (`absMass1 < absMass0`), a real 3-generation spectrum, not a collapsed one. -/
theorem absMass_nondegenerate : absMass1 < absMass0 :=
  lt_trans absMass_order_12 absMass_order_20

/-- W8 NON-VACUITY: the derived breaking direction is genuinely a spectrum-MOVER — it moves the
    identity to a nonzero element, so it is not the trivial zero map (which would move nothing). -/
theorem breaking_direction_nontrivial : Lmul (slotA (1 : O ℚ)) ≠ 0 := by
  intro h
  apply breaking_direction_moves
  rw [h]; rfl

/-! ## (I) THE CAPSTONE. -/

/-- ★★★ N427 — THE ABSOLUTE FERMION MASS SPECTRUM (arc-P P2, theorem-grade). The absolute masses are
    a DETERMINED parameter-free derived-ℝ spectrum, not just ratios:
      (T1) each absolute mass is the Born square of its absolute amplitude
           (`absMass k = (absAmp k)²`, `absMass{0,1,2}_born`) — the derived scale `S` and the derived
           relative eigenvalues `mass_k` combined via `sc·sc = S`;
      (T2) the spectrum is positive and strictly ordered `0 < absMass1 < absMass2 < absMass0`
           (`absMass_order_12/20`);
      (T3) the absolute mass ratios carry the SAME banked N340 brackets (`abs_ratio_12`, `abs_ratio_20`)
           — the scale cancels, so "ratios × the derived scale ARE the absolutes";
      (T4) the Koide self-overlap quotient is scale-invariant `(Σ absMass)/(Σ absAmp)² = 2/3`
           (`koide_abs`) — the absolute masses satisfy the SAME Koide as the relative amplitudes;
      (T5) the derived breaking direction `L₀ = Lmul (slotA 1)` MOVES the identity every symmetry
           derivation of `f₄` KILLS, hence is genuinely OUTSIDE `f₄` (`breaking_direction_outside_
           symmetry`) — the FORCED splitting element, the arena's own multiplication, not a spurion.
    Every input is banked/derived (N417 scale, N340 eigenvalues, N295 direction); nothing posited; no
    free parameter. The GeV value (the empirical `M_oct` unit) and the physical e/μ/τ labelling are
    REMOVABLE PROSE. The "ratios-only" conditional DISSOLVES into a determined absolute spectrum. -/
theorem absolute_mass_spectrum :
    -- T1: absolute mass is the Born square of the absolute amplitude
    (absMass0 = absAmp0 ^ 2 ∧ absMass1 = absAmp1 ^ 2 ∧ absMass2 = absAmp2 ^ 2)
    -- T2: positive, strictly ordered spectrum
    ∧ (0 < absMass1 ∧ absMass1 < absMass2 ∧ absMass2 < absMass0)
    -- T3: absolute ratios inherit the banked N340 brackets
    ∧ ((483 : Cut) / 100000 * absMass2 ≤ absMass1 ∧ absMass1 ≤ (485 : Cut) / 100000 * absMass2)
    ∧ ((594 : Cut) / 10000 * absMass0 ≤ absMass2 ∧ absMass2 ≤ (595 : Cut) / 10000 * absMass0)
    -- T4: scale-invariant Koide
    ∧ ((absMass0 + absMass1 + absMass2) / (absAmp0 + absAmp1 + absAmp2) ^ 2 = 2 / 3)
    -- T5: the derived breaking direction lifts the degeneracy f₄ fixes, from outside f₄
    ∧ ((∀ T : Module.End ℚ (Matrix (Fin 3) (Fin 3) (O ℚ)), T ∈ derH3 → T 1 = 0)
        ∧ Lmul (slotA (1 : O ℚ)) 1 ≠ 0
        ∧ Lmul (slotA (1 : O ℚ)) ∉ derH3) :=
  ⟨⟨absMass0_born, absMass1_born, absMass2_born⟩,
   ⟨absMass1_pos, absMass_order_12, absMass_order_20⟩,
   abs_ratio_12, abs_ratio_20,
   koide_abs,
   ⟨symmetry_fixes_identity, breaking_direction_moves, breaking_direction_outside_symmetry⟩⟩

end

