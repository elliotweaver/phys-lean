/-! ## (A) THE ABSOLUTE SCALE (N417) and ITS BORN-AMPLITUDE ROOT.

  `massScale = S = absScaleChainDerived` is the parameter-free derived scale (arc-O O2, N417). Its
  Born-amplitude root `ampScale = cutSqrt S` satisfies `ampScale·ampScale = S`; `Born = self-overlap`
  ties the mass (Born square) to the amplitude. Both strictly positive derived `Cut`. -/

/-- THE DERIVED ABSOLUTE MASS SCALE `S`: the parameter-free derived `Cut` from N417 (the discharge of
    arc M — the electroweak-anchored chain with the free phase slot closed by the derived fold-phase
    amplitude). This IS the absolute scale in the arena's natural unit `M_oct := 1`. -/
def massScale : Cut := absScaleChainDerived

/-- THE ABSOLUTE BORN-AMPLITUDE SCALE `sc = √S`: the derived-ℝ square root of the mass scale, so that
    `sc·sc = S`. The absolute masses are Born squares of `sc·b_k`. -/
def ampScale : Cut := Phys.Algebra.cutSqrt massScale

/-- The mass scale is a genuine positive derived scale (`0 < S`, N417 `absScaleChainDerived_pos`). -/
theorem massScale_pos : 0 < massScale := absScaleChainDerived_pos

/-- The amplitude scale is strictly positive (`0 < √S`, from `0 < S`). -/
theorem ampScale_pos : 0 < ampScale := Phys.Algebra.cutSqrt_pos massScale_pos

/-- ★ THE BORN ROOT IDENTITY: `ampScale·ampScale = massScale` (`√S·√S = S`, `cutSqrt_sq`). The
    absolute amplitude scale squares to the absolute mass scale — `Born = self-overlap`. -/
theorem ampScale_sq : ampScale * ampScale = massScale :=
  Phys.Algebra.cutSqrt_sq (le_of_lt massScale_pos)

/-! ## (B) THE ABSOLUTE MASSES AND AMPLITUDES — scale × the banked relative eigenvalues (N340). -/

/-- The absolute masses: the derived scale `S` times the banked relative Born-square eigenvalues
    `mass_k` (N340, at the derived phase `δ_B = 2/9`). Determined derived `Cut`, no free parameter. -/
def absMass0 : Cut := massScale * mass0
def absMass1 : Cut := massScale * mass1
def absMass2 : Cut := massScale * mass2

/-- The absolute amplitudes: the amplitude scale `sc = √S` times the banked relative cycle amplitudes
    `b_k` (N340). `absMass k = (absAmp k)²`. -/
def absAmp0 : Cut := ampScale * b0
def absAmp1 : Cut := ampScale * b1
def absAmp2 : Cut := ampScale * b2

/-! ## (C) T1 — THE ABSOLUTE MASS IS THE BORN SQUARE OF THE ABSOLUTE AMPLITUDE. -/

/-- ★★ THE BORN-SQUARE LAW (T1): `absMass k = (absAmp k)²`. Since `absAmp k = sc·b_k`, `mass_k = b_k²`
    (N340), and `sc·sc = S` (`ampScale_sq`): `(sc·b_k)² = (sc·sc)·b_k² = S·mass_k = absMass k`. The
    absolute mass is the Born self-overlap of the absolute amplitude at the derived scale. -/
theorem absMass0_born : absMass0 = absAmp0 ^ 2 := by
  unfold absMass0 absAmp0
  have h : (ampScale * b0) ^ 2 = (ampScale * ampScale) * (b0 ^ 2) := by ring
  rw [h, ampScale_sq]; rfl

theorem absMass1_born : absMass1 = absAmp1 ^ 2 := by
  unfold absMass1 absAmp1
  have h : (ampScale * b1) ^ 2 = (ampScale * ampScale) * (b1 ^ 2) := by ring
  rw [h, ampScale_sq]; rfl

theorem absMass2_born : absMass2 = absAmp2 ^ 2 := by
  unfold absMass2 absAmp2
  have h : (ampScale * b2) ^ 2 = (ampScale * ampScale) * (b2 ^ 2) := by ring
  rw [h, ampScale_sq]; rfl

/-! ## (D) T2 — POSITIVITY AND ORDERING (a determined ordered spectrum). -/

theorem absMass0_pos : 0 < absMass0 := mul_pos massScale_pos mass0_pos
theorem absMass1_pos : 0 < absMass1 := mul_pos massScale_pos mass1_pos
theorem absMass2_pos : 0 < absMass2 := mul_pos massScale_pos mass2_pos

/-- ★ ORDERING (lightest < middle): `absMass1 < absMass2` — the derived scale `S > 0` preserves the
    banked relative order `mass1 < mass2` (N340 `mass_distinct_1_2`). -/
theorem absMass_order_12 : absMass1 < absMass2 :=
  mul_lt_mul_of_pos_left mass_distinct_1_2 massScale_pos

/-- ★ ORDERING (middle < heaviest): `absMass2 < absMass0` — the scale preserves `mass2 < mass0`
    (N340 `mass_distinct_2_0`). -/
theorem absMass_order_20 : absMass2 < absMass0 :=
  mul_lt_mul_of_pos_left mass_distinct_2_0 massScale_pos

/-! ## (E) T3 — RATIO INHERITANCE (the banked N340 brackets carry to the absolute spectrum). -/

/-- ★★ ABSOLUTE RATIO `m₁/m₂` INHERITS THE BANKED BRACKET: `483/1e5·absMass2 ≤ absMass1 ≤
    485/1e5·absMass2`. The derived scale `S > 0` multiplies through the banked N340 relative bracket
    `massRatio_1_2` and cancels in the ratio — the ABSOLUTE masses carry the same forced ratio as the
    relative eigenvalues. -/
theorem abs_ratio_12 :
    (483 : Cut) / 100000 * absMass2 ≤ absMass1 ∧ absMass1 ≤ (485 : Cut) / 100000 * absMass2 := by
  unfold absMass1 absMass2
  obtain ⟨hlo, hhi⟩ := massRatio_1_2
  constructor
  · nlinarith [mul_le_mul_of_nonneg_left hlo (le_of_lt massScale_pos)]
  · nlinarith [mul_le_mul_of_nonneg_left hhi (le_of_lt massScale_pos)]

/-- ★★ ABSOLUTE RATIO `m₂/m₀` INHERITS THE BANKED BRACKET: `594/1e4·absMass0 ≤ absMass2 ≤
    595/1e4·absMass0` (banked N340 `massRatio_2_0`, scale-multiplied). -/
theorem abs_ratio_20 :
    (594 : Cut) / 10000 * absMass0 ≤ absMass2 ∧ absMass2 ≤ (595 : Cut) / 10000 * absMass0 := by
  unfold absMass2 absMass0
  obtain ⟨hlo, hhi⟩ := massRatio_2_0
  constructor
  · nlinarith [mul_le_mul_of_nonneg_left hlo (le_of_lt massScale_pos)]
  · nlinarith [mul_le_mul_of_nonneg_left hhi (le_of_lt massScale_pos)]

/-! ## (F) T4 — THE SCALE-INVARIANT KOIDE (the absolute masses satisfy the SAME Koide). -/

/-- The banked relative amplitude sum `b₀+b₁+b₂ = 3` (the ℤ₃-cycle mode sums to zero; `Σ√m = 3M` at
    `M = 1`). Pure ring identity on the banked `b_k`. -/
theorem sum_b : b0 + b1 + b2 = 3 := by unfold b0 b1 b2; ring

/-- ★★★ THE SCALE-INVARIANT KOIDE (T4): `(Σ absMass)/(Σ absAmp)² = 2/3`. The absolute masses satisfy
    the SAME Koide self-overlap relation as the relative amplitudes — the derived scale `S` CANCELS:
    `(S·Σmass)/(sc·Σb)² = (S·6)/(sc²·9) = (S·6)/(S·9) = 2/3`, using `Σmass = 6` (`koide_total`, N340),
    `Σb = 3` (`sum_b`), and `sc·sc = S` (`ampScale_sq`). Koide is scale-free, so it holds at the
    absolute scale exactly as at the relative one. -/
theorem koide_abs :
    (absMass0 + absMass1 + absMass2) / (absAmp0 + absAmp1 + absAmp2) ^ 2 = 2 / 3 := by
  have hm : absMass0 + absMass1 + absMass2 = massScale * 6 := by
    unfold absMass0 absMass1 absMass2
    have h := koide_total
    linear_combination massScale * h
  have ha : absAmp0 + absAmp1 + absAmp2 = ampScale * 3 := by
    unfold absAmp0 absAmp1 absAmp2
    have h := sum_b
    linear_combination ampScale * h
  rw [hm, ha]
  have hsq : (ampScale * 3) ^ 2 = massScale * 9 := by
    have h : (ampScale * 3) ^ 2 = (ampScale * ampScale) * 9 := by ring
    rw [h, ampScale_sq]
  rw [hsq]
  have hS : massScale ≠ 0 := ne_of_gt massScale_pos
  field_simp
  ring

/-! ## (G) T5 — THE DERIVED BREAKING DIRECTION `L₀` (N295, banked facts).

  The absolute spectrum is non-degenerate (T2). WHAT lifts the degeneracy is not a posited spurion:
