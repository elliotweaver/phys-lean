    (hbR : rb ≤ R) (hcR : rc ≤ R) (hlR : rl ≤ R) :
    reweightedFreezeout wb wc wl rb rc rl ≤ kappaLeading * (wb + wc + wl) * cutLog R :=
  freezeout_reweight_bounded wb wc wl rb rc rl R hwb hwc hwl hb hc hl hbR hcR hlR

