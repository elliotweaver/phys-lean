/-! ## (1) THE DISCHARGE — the light-edge rung with `huc` supplied by the derived `huc_fully_derived`. -/

/-- ★★★ THE DISCHARGE: the light-edge log carries the confinement rung `8*cutPi/3` WITHOUT `huc` as a
    free hypothesis. The rung is supplied by the DERIVED `huc_fully_derived` (fed the top amplitude's
    empty-insertion pinning `Mu^2 = M·insertionChain []` and the definitional confinement-floor half
    `Mlam^2 = M·confinementScaleRatio`), so `cutLog (edgeLight Md (Mlam^2)) = cutLog mbRatioDerived +
    8*cutPi/3 + cutLog (bMass 2)` holds carrying the two Born-square anchor pinnings and the up/down
    leg `hud` — but NOT the candidate `huc`. The rung's provenance is now internal to the derivation. -/
theorem light_log_rung_huc_discharged (M Mu Md Mlam : Cut)
    (hM : M ≠ 0) (hu : Mu ≠ 0) (hl : Mlam ≠ 0)
    (hud : (Md / Mu) ^ 2 = mbRatioDerived)
    (hMu : Mu ^ 2 = M * insertionChain [])
    (hMlam : Mlam ^ 2 = M * confinementScaleRatio) :
    cutLog (edgeLight Md (Mlam ^ 2))
      = cutLog mbRatioDerived + 8 * cutPi / 3 + cutLog (bMass 2) :=
  light_log_carries_rung Mu Md Mlam hu hl hud (huc_fully_derived M Mu Mlam hM hMu hMlam)

/-- THE RUNG IS ISOLATED IN THE LIGHT EDGE, `huc` DISCHARGED: subtracting the pure shape combination
    from the light log leaves EXACTLY `8*cutPi/3`, with the rung supplied by the derived `huc` (no free
    hypothesis). Same isolation as N576 `rung_isolated_in_light`, now with the confinement rung's
    identification internal. -/
theorem rung_isolated_huc_discharged (M Mu Md Mlam : Cut)
    (hM : M ≠ 0) (hu : Mu ≠ 0) (hl : Mlam ≠ 0)
    (hud : (Md / Mu) ^ 2 = mbRatioDerived)
    (hMu : Mu ^ 2 = M * insertionChain [])
    (hMlam : Mlam ^ 2 = M * confinementScaleRatio) :
    cutLog (edgeLight Md (Mlam ^ 2)) - (cutLog mbRatioDerived + cutLog (bMass 2))
      = 8 * cutPi / 3 := by
  rw [light_log_rung_huc_discharged M Mu Md Mlam hM hu hl hud hMu hMlam]; ring

