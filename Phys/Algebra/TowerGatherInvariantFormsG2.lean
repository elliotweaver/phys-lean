import Phys.Algebra.OctonionCoassociative4Form
import Phys.Algebra.OctonionCrossProductDerivation
import Phys.Algebra.DerivationAutCompact
import Phys.Algebra.DerivationCompact

namespace Phys.Algebra

open Phys.Cascade Phys.Cascade.CD

attribute [local instance] CD.narCD CD.srCD dblModuleQ cdModuleQ

noncomputable section

/-! ## δ (the metric = Born self-overlap `gForm`) is g₂-invariant. -/

/-- ★ δ-INVARIANCE: the Born self-overlap form is g₂-invariant — for every derivation
    `D ∈ derivationLieQ` and all `x, y`, `⟨D x, y⟩ + ⟨x, D y⟩ = 0`. This is LITERALLY the banked
    skew-adjointness `gFormQ_skew` (N24): a derivation kills the self-conjugate `x·star y + y·star x`.
    δ is the degree-2 generator of the g₂-invariant algebra of the 7 (= `ImO`). -/
theorem bornForm_g2_invariant (D : derivationLieQ) (x y : O ℚ) :
    gForm ((D : Module.End ℚ (O ℚ)) x) y + gForm x ((D : Module.End ℚ (O ℚ)) y) = 0 :=
  gFormQ_skew (D : Module.End ℚ (O ℚ)) D.2 x y

/-! ## The associator `[x,y,z]` obeys the Leibniz rule under any derivation. -/

/-- ★ ASSOCIATOR LEIBNIZ: for any ℚ-linear derivation `D` (Leibniz law `IsDerivQ`), the associator
    `assoc x y z = (x·y)·z − x·(y·z)` — being built from products only — satisfies the third-order
    Leibniz identity `D [x,y,z] = [D x, y, z] + [x, D y, z] + [x, y, D z]`. Forced by distributing the
    product Leibniz law twice; no associativity, no coordinates. -/
theorem assoc_deriv_leibniz (D : Module.End ℚ (O ℚ)) (hD : IsDerivQ D) (x y z : O ℚ) :
    D (assoc x y z) = assoc (D x) y z + assoc x (D y) z + assoc x y (D z) := by
  unfold assoc
  rw [map_sub, hD (x * y) z, hD x (y * z), hD x y, hD y z]
  simp only [add_mul, mul_add]
  abel

/-- The associator Leibniz identity specialised to a member `D ∈ derivationLieQ = g₂`. -/
theorem assoc_deriv_leibniz_lieQ (D : derivationLieQ) (x y z : O ℚ) :
    (D : Module.End ℚ (O ℚ)) (assoc x y z)
      = assoc ((D : Module.End ℚ (O ℚ)) x) y z + assoc x ((D : Module.End ℚ (O ℚ)) y) z
        + assoc x y ((D : Module.End ℚ (O ℚ)) z) :=
  assoc_deriv_leibniz (D : Module.End ℚ (O ℚ)) D.2 x y z

/-! ## φ (the associative 3-form `assoc3 = ⟨x, y×z⟩`) is g₂-invariant. -/

/-- ★★ φ-INVARIANCE: the associative 3-form is g₂-invariant — for every derivation
    `D ∈ derivationLieQ` and all `x, y, z`,
    `φ(D x, y, z) + φ(x, D y, z) + φ(x, y, D z) = 0`.
    The last two slots combine via the cross-product Leibniz law (N207,
    `D (y×z) = (D y)×z + y×(D z)`) into `⟨x, D(y×z)⟩`; the whole is then
    `⟨D x, y×z⟩ + ⟨x, D(y×z)⟩ = 0` by δ-invariance (`gFormQ_skew`, N24). φ is the degree-3 generator
    of the g₂-invariant algebra of the 7 — the calibration whose stabiliser IS g₂. -/
theorem assoc3_g2_invariant (D : derivationLieQ) (x y z : O ℚ) :
    assoc3 ((D : Module.End ℚ (O ℚ)) x) y z
      + assoc3 x ((D : Module.End ℚ (O ℚ)) y) z
      + assoc3 x y ((D : Module.End ℚ (O ℚ)) z) = 0 := by
  unfold assoc3
  -- Leibniz for the cross product (N207): D(y×z) = (Dy)×z + y×(Dz)
  have hleib : octCross ((D : Module.End ℚ (O ℚ)) y) z + octCross y ((D : Module.End ℚ (O ℚ)) z)
      = (D : Module.End ℚ (O ℚ)) (octCross y z) :=
    (derivationLieQ_octCross_leibniz D y z).symm
  -- combine the last two terms via right-additivity of gForm
  have h2 : gForm x (octCross ((D : Module.End ℚ (O ℚ)) y) z)
              + gForm x (octCross y ((D : Module.End ℚ (O ℚ)) z))
            = gForm x ((D : Module.End ℚ (O ℚ)) (octCross y z)) := by
    rw [← gForm_add_right, hleib]
  rw [add_assoc, h2]
  -- now: ⟨D x, y×z⟩ + ⟨x, D (y×z)⟩ = 0 — skew-adjointness of D for gForm (N24)
  exact gFormQ_skew (D : Module.End ℚ (O ℚ)) D.2 x (octCross y z)

/-! ## ψ (the coassociative 4-form `coassoc4 = ⟨[x,y,z], w⟩`) is g₂-invariant. -/

/-- ★★ ψ-INVARIANCE: the coassociative 4-form ψ = *φ is g₂-invariant — for every derivation
    `D ∈ derivationLieQ` and all `x, y, z, w`,
    `ψ(D x,y,z,w) + ψ(x,D y,z,w) + ψ(x,y,D z,w) + ψ(x,y,z,D w) = 0`.
    The first three slots combine via the associator Leibniz law (`assoc_deriv_leibniz_lieQ`) into
    `⟨D[x,y,z], w⟩`; the whole is then `⟨D[x,y,z], w⟩ + ⟨[x,y,z], D w⟩ = 0` by δ-invariance
    (`gFormQ_skew`, N24). The Hodge dual ψ = *φ inherits its g₂-invariance from φ. -/
theorem coassoc4_g2_invariant (D : derivationLieQ) (x y z w : O ℚ) :
    coassoc4 ((D : Module.End ℚ (O ℚ)) x) y z w
      + coassoc4 x ((D : Module.End ℚ (O ℚ)) y) z w
      + coassoc4 x y ((D : Module.End ℚ (O ℚ)) z) w
      + coassoc4 x y z ((D : Module.End ℚ (O ℚ)) w) = 0 := by
  unfold coassoc4
  have hleib := assoc_deriv_leibniz_lieQ D x y z
  -- combine first three coassoc4 terms into ⟨D[x,y,z], w⟩
  have h3 : gForm (assoc ((D : Module.End ℚ (O ℚ)) x) y z) w
              + gForm (assoc x ((D : Module.End ℚ (O ℚ)) y) z) w
              + gForm (assoc x y ((D : Module.End ℚ (O ℚ)) z)) w
            = gForm ((D : Module.End ℚ (O ℚ)) (assoc x y z)) w := by
    rw [← gForm_add_left, ← gForm_add_left, ← hleib]
  -- δ-invariance (N24): ⟨D[x,y,z], w⟩ + ⟨[x,y,z], D w⟩ = 0
  have hskew := gFormQ_skew (D : Module.End ℚ (O ℚ)) D.2 (assoc x y z) w
  linarith [h3, hskew]

/-! ## Non-vacuity (W8): the invariant forms are GENUINELY nonzero — the invariance is not vacuous. -/

/-- W8 NON-VACUITY ANCHOR: the associative 3-form φ takes the value `1` on the derived orthonormal
    triple `(u1, u2, u1×u2)` (the banked witness `assoc3_witness_swapped`, N209). φ is therefore NOT
    the zero form, so its g₂-invariance (`assoc3_g2_invariant`) is genuine content, not a vacuous
    "invariance of 0." -/
theorem invariantForms_nonvacuity : assoc3 u1 u2 (octCross u1 u2) = 1 :=
  assoc3_witness_swapped

/-- ★★★ THE GENERATOR TOOLKIT, BUNDLED: the three derived invariant forms — the metric δ = `gForm`,
    the associative 3-form φ = `assoc3`, and the coassociative 4-form ψ = `coassoc4` — are ALL
    g₂-invariant (invariant under every derivation `D ∈ derivationLieQ`), and φ is genuinely nonzero.
    These are the generators of the g₂-invariant algebra of the fundamental 7 (= `ImO`) whose degree-4
    contractions the First Fundamental Theorem count contracts to force `dim (ImO^{⊗4})^{g₂} = 4` and
    hence the irreducibility of the 27 (`tracelessSym`) — the dedicated dissolution node this toolkit
    serves. -/
theorem invariant_forms_g2_invariant_toolkit :
    (∀ (D : derivationLieQ) (x y : O ℚ),
        gForm ((D : Module.End ℚ (O ℚ)) x) y + gForm x ((D : Module.End ℚ (O ℚ)) y) = 0)
    ∧ (∀ (D : derivationLieQ) (x y z : O ℚ),
        assoc3 ((D : Module.End ℚ (O ℚ)) x) y z + assoc3 x ((D : Module.End ℚ (O ℚ)) y) z
          + assoc3 x y ((D : Module.End ℚ (O ℚ)) z) = 0)
    ∧ (∀ (D : derivationLieQ) (x y z w : O ℚ),
        coassoc4 ((D : Module.End ℚ (O ℚ)) x) y z w + coassoc4 x ((D : Module.End ℚ (O ℚ)) y) z w
          + coassoc4 x y ((D : Module.End ℚ (O ℚ)) z) w + coassoc4 x y z ((D : Module.End ℚ (O ℚ)) w) = 0)
    ∧ assoc3 u1 u2 (octCross u1 u2) ≠ 0 :=
  ⟨bornForm_g2_invariant, assoc3_g2_invariant, coassoc4_g2_invariant,
    by rw [invariantForms_nonvacuity]; norm_num⟩

end

