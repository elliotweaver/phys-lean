/-! ## (1) THE NEAR-HORIZON EUCLIDEAN 2-PLANE and its RETURN-SURFACE CLOSURE. -/

/-- THE NEAR-HORIZON EUCLIDEAN 2-PLANE POINT `(ρ·cutCos θ, ρ·cutSin θ)` — the Wick-rotated section of
    the black-hole metric near the horizon, in polar form on the DERIVED trig `cutCos`/`cutSin` (N323). -/
def eucPlanePoint (ρ θ : Cut) : Cut × Cut := (ρ * cutCos θ, ρ * cutSin θ)

/-- ★ RETURN-SURFACE CLOSURE: the Euclidean 2-plane point returns to itself under the full derived
    Born turn `θ ↦ θ + azimuthalTurn` (`= θ + (cutPi + cutPi)`), from the DERIVED trig periodicity
    (`cutCos_add_two_cutPi`/`cutSin_add_two_cutPi`, N325). This is the "no conical singularity"
    smoothness — DERIVED as the fold's return on itself, not posited. -/
theorem eucPlane_closes (ρ θ : Cut) :
    eucPlanePoint ρ (θ + azimuthalTurn) = eucPlanePoint ρ θ := by
  unfold eucPlanePoint azimuthalTurn
  have h2 : (2 : Cut) * cutPi = cutPi + cutPi := by ring
  rw [h2, cutCos_add_two_cutPi, cutSin_add_two_cutPi]

/-- ★ W8 NON-VACUITY (the cone is load-bearing): a HALF-turn `θ ↦ θ + cutPi` does NOT close — at
    `ρ=1, θ=0` the shifted point `(cutCos cutPi, cutSin cutPi) = (−1, 0)` differs from `(cutCos 0,
    cutSin 0) = (1, 0)`. The sign flip `cutCos_add_cutPi = −cutCos` IS the conical singularity; ONLY
    the FULL `azimuthalTurn` closes. A wrong (sub-full-turn) period genuinely fails. -/
theorem eucPlane_half_turn_conical :
    eucPlanePoint 1 cutPi ≠ eucPlanePoint 1 0 := by
  unfold eucPlanePoint
  rw [cutCos_cutPi, cutSin_cutPi, cutCos_zero, cutSin_zero]
  intro h
  have h1 : (1 : Cut) * (-1) = 1 * 1 := (Prod.ext_iff.mp h).1
  norm_num at h1

/-! ## (2) THE EUCLIDEAN PERIOD `β = azimuthalTurn / κ_sg` and its SMOOTHNESS. -/

/-- THE EUCLIDEAN-SECTION PERIOD `β = azimuthalTurn / κ_sg` (`= 2π/κ_sg`). Fixed by the closure: the
    angular coordinate `κ_sg·τ` must complete one full DERIVED Born turn `azimuthalTurn = 2·cutPi`
    (N328) for the section to close (no cone), so the imaginary-time period is `azimuthalTurn/κ_sg`. -/
def hawkingPeriod (κsg : Cut) : Cut := azimuthalTurn / κsg

/-- ★ SMOOTHNESS: `κ_sg · β = azimuthalTurn` — the surface gravity times the period is exactly one
    full derived Born turn (no conical deficit). The theory-native heart: the period is FORCED so that
    the return surface closes. -/
theorem hawkingPeriod_smoothness (κsg : Cut) (h : κsg ≠ 0) :
    κsg * hawkingPeriod κsg = azimuthalTurn := by
  unfold hawkingPeriod
  field_simp

/-! ## (3) THE HAWKING TEMPERATURE `T_H = 1/β = κ_sg/2π`. -/

/-- THE HAWKING TEMPERATURE `T_H = 1/β` — the reciprocal of the Euclidean period. -/
def hawkingTemp (κsg : Cut) : Cut := 1 / hawkingPeriod κsg

/-- ★★ `T_H = κ_sg/(2·cutPi)` = `κ_sg/2π`. The temperature is the surface gravity over one full derived
    Born turn `azimuthalTurn = 2·cutPi` (N328). DERIVED from the closure period, never posited. -/
theorem hawkingTemp_eq (κsg : Cut) :
    hawkingTemp κsg = κsg / (2 * cutPi) := by
  unfold hawkingTemp hawkingPeriod azimuthalTurn
  rw [one_div_div]

/-- Born positivity of the temperature: for positive surface gravity, `0 < T_H`. -/
theorem hawkingTemp_pos (κsg : Cut) (h : 0 < κsg) : 0 < hawkingTemp κsg := by
  rw [hawkingTemp_eq]
  have hπ := cutPi_pos
  positivity

/-! ## (4) THE SCHWARZSCHILD HOME (conditional): `β = 8π·M`, `T_H = 1/8πM`, HOMED to `gravCouplingCoeff`. -/

/-- ★★ THE MOAT (arc-A + arc-E cross-tie): GIVEN the Schwarzschild surface gravity `κ_sg = (4M)⁻¹`
    (an EXPLICIT HYPOTHESIS — the metric-specific `f'(r_h)/2` computation, CHILDED, NEVER asserted), the
    Euclidean period `β = gravCouplingCoeff · M` (`= 8·cutPi·M`). The thermal period is the SAME banked
    `8π` gravitational-coupling coefficient (N359) times the mass — `α*`, gravity's coupling, and the
    Hawking period ALL the ONE derived Born turn `azimuthalTurn` scaled by the fold's derived counts. -/
theorem hawkingPeriod_schwarzschild (κsg M : Cut) (hM : M ≠ 0) (h : κsg = (4 * M)⁻¹) :
    hawkingPeriod κsg = gravCouplingCoeff * M := by
  unfold hawkingPeriod azimuthalTurn
  rw [h, gravCouplingCoeff_eq]
  have h4M : (4 : Cut) * M ≠ 0 := by
    intro hc; apply hM; rcases mul_eq_zero.mp hc with h4 | hM0
    · norm_num at h4
    · exact hM0
  field_simp
  ring

/-- ★★ THE DERIVED `T_H = 1/8πM`: GIVEN `κ_sg = (4M)⁻¹` (explicit hypothesis, CHILDED), the temperature
    `T_H = 1/(gravCouplingCoeff · M)` = `1/(8·cutPi·M)`. Homed to the banked coupling coefficient
    (N359); the `8π` is the derived Born turn scaled by `4`, NEVER a literal. -/
theorem hawkingTemp_schwarzschild (κsg M : Cut) (hM : M ≠ 0) (h : κsg = (4 * M)⁻¹) :
    hawkingTemp κsg = 1 / (gravCouplingCoeff * M) := by
  unfold hawkingTemp
  rw [hawkingPeriod_schwarzschild κsg M hM h]

/-! ## (5) THE HEART bundled. -/

/-- ★★★ THE HEART: the Euclidean 2-plane CLOSES under the full derived Born turn `azimuthalTurn`
    (smoothness = the fold's return-surface closure) and NOT under a half-turn (the cone, W8); the
    period `β = azimuthalTurn/κ_sg` satisfies `κ_sg·β = azimuthalTurn`; the temperature `T_H = κ_sg/2π`;
    and GIVEN the Schwarzschild surface gravity `κ_sg = (4M)⁻¹` the period homes to `β = gravCouplingCoeff·M`
    (`= 8π·M`, the banked N359 coupling — the moat). -/
theorem hawking_temperature_structure (κsg M : Cut) (hκ : κsg ≠ 0) (hM : M ≠ 0)
    (h : κsg = (4 * M)⁻¹) :
    (∀ ρ θ : Cut, eucPlanePoint ρ (θ + azimuthalTurn) = eucPlanePoint ρ θ)
      ∧ eucPlanePoint 1 cutPi ≠ eucPlanePoint 1 0
      ∧ κsg * hawkingPeriod κsg = azimuthalTurn
      ∧ hawkingTemp κsg = κsg / (2 * cutPi)
      ∧ hawkingPeriod κsg = gravCouplingCoeff * M
      ∧ hawkingTemp κsg = 1 / (gravCouplingCoeff * M) :=
  ⟨eucPlane_closes, eucPlane_half_turn_conical, hawkingPeriod_smoothness κsg hκ,
   hawkingTemp_eq κsg, hawkingPeriod_schwarzschild κsg M hM h,
   hawkingTemp_schwarzschild κsg M hM h⟩

