    gravCouplingCoeff = 8 * cutPi
      ∧ gravCouplingCoeff = 2 * gaussSphereSolidAngle
      ∧ einsteinTraceReversalCoeff⁻¹
          ≠ (1 - einsteinTraceReversalCoeff * (Module.finrank Cut STVC : Cut))
      ∧ criticalPhaseNumerator * 4 = gravCouplingCoeff * 42
      ∧ 0 < gravCouplingCoeff :=
  ⟨gravCouplingCoeff_eq, gravCouplingCoeff_two_flux, kappa_two_ne_traceValue,
   (gravAndGauge_share_azimuthalTurn).2.2, gravCouplingCoeff_pos⟩

