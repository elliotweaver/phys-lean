  rw [gravCouplingCoeff_eq, gaussSphereSolidAngle_eq]
  have := cutPi_pos; intro h; nlinarith [this]

/-- ★★★ THE HEART bundled: `κ/G = 8·cutPi = 2·(4π flux)`, the `2` HOMED to the banked spin-2
    trace-reversal coefficient reciprocal (distinct from the dimension trace-value `−4`), the `4π`
    HOMED to the banked derived Gauss-sphere flux, and BOTH gravity and the gauge coupling scaled from
    the ONE derived Born turn (`criticalPhaseNumerator·4 = gravCouplingCoeff·42`). -/
