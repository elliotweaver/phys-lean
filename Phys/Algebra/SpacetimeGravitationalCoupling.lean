/-! ## (1) THE SPIN-2 TRACE-REVERSAL COEFFICIENT (the `½`), HOMED to the banked Einstein tensor. -/

/-- THE SPIN-2 TRACE-REVERSAL COEFFICIENT `½` — the `2⁻¹` in the banked N354 `einstein_traceReversal`
    (`einsteinScalar G = R − 2⁻¹·finrank·R`). Conservation-forced (N356), DIMENSION-INDEPENDENT. Its
    reciprocal is the `2` in `κ = 2·4π·G`. -/
def einsteinTraceReversalCoeff : Cut := 2⁻¹

/-- ★ THE `½` IS THE BANKED COEFFICIENT: `einsteinScalar G = R − einsteinTraceReversalCoeff·finrank·R`
    is exactly the banked N354 `einstein_traceReversal`. Homes the trace-reversal coefficient to the
    banked Einstein tensor — the `2` in `κ` descends from the banked spin-2 trace-reversal, not a posit. -/
theorem einsteinTraceReversalCoeff_homed (G : STVC →ₗ[Cut] MetricEnd) :
    einsteinScalar G
      = ricciScalar G
        - einsteinTraceReversalCoeff * (Module.finrank Cut STVC : Cut) * ricciScalar G := by
  unfold einsteinTraceReversalCoeff; exact einstein_traceReversal G

/-! ## (2) THE GRAVITATIONAL COUPLING COEFFICIENT `κ/G = 2·4π = 8·cutPi` (both factors homed). -/

/-- ★★ THE DIMENSIONLESS GRAVITATIONAL COUPLING COEFFICIENT `κ/G = (½)⁻¹ · (4π flux)`. The `(½)⁻¹ = 2`
    is the reciprocal of the banked spin-2 trace-reversal coefficient (N354); the `gaussSphereSolidAngle`
    is the banked derived Gauss-sphere flux `= 4·cutPi` (N328). `G` stays the symbolic dimensionful
    anchor (G3); the Lean content is the dimensionless coefficient. -/
def gravCouplingCoeff : Cut := einsteinTraceReversalCoeff⁻¹ * gaussSphereSolidAngle

/-- ★★ THE DERIVED `8π`: `gravCouplingCoeff = 8·cutPi`. FALLS OUT of `(2⁻¹)⁻¹ = 2` times the banked
    derived flux `gaussSphereSolidAngle = 4·cutPi` (N328); never written as a literal `8π`. -/
theorem gravCouplingCoeff_eq : gravCouplingCoeff = 8 * cutPi := by
  unfold gravCouplingCoeff einsteinTraceReversalCoeff
  rw [gaussSphereSolidAngle_eq, inv_inv]; ring

/-- ★★ THE `2·4π` SPLIT, both factors homed: `gravCouplingCoeff = 2 · gaussSphereSolidAngle`. The `2`
    is the trace-reversal reciprocal, the `gaussSphereSolidAngle` the banked derived Gauss-sphere flux. -/
theorem gravCouplingCoeff_two_flux : gravCouplingCoeff = 2 * gaussSphereSolidAngle := by
  unfold gravCouplingCoeff einsteinTraceReversalCoeff; rw [inv_inv]

/-- The definitional home: `κ/G = (trace-reversal coefficient)⁻¹ · (Gauss-sphere flux)`. -/
theorem gravCouplingCoeff_flux_factor :
    gravCouplingCoeff = einsteinTraceReversalCoeff⁻¹ * gaussSphereSolidAngle := rfl

/-- Born positivity of the coupling coefficient: `0 < κ/G` (`cutPi_pos`). -/
theorem gravCouplingCoeff_pos : 0 < gravCouplingCoeff := by
  rw [gravCouplingCoeff_eq]; have := cutPi_pos; linarith

