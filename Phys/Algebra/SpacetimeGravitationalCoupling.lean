      ∧ criticalPhaseNumerator = azimuthalTurn * 42
      ∧ criticalPhaseNumerator * 4 = gravCouplingCoeff * 42 := by
  refine ⟨gravCouplingCoeff_azimuthal, numerator_azimuthal, ?_⟩
  rw [criticalPhaseNumerator_eq, gravCouplingCoeff_eq]; ring

