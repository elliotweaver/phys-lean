open Matrix

noncomputable section

/-! ## (A) THE CHAIN: the absolute mass scale as a product of banked links.

  `absScaleChain phaseBorn topLink lightLink`
    = (electroweak anchor `v/M = ewClosureRatio`, the banked n=9 tower rung `e^(−28π/3)`)
      · (`m_b` gear link `mbBornRatio phaseBorn`, cast ℚ→`Cut`, the banked M2 factor)
      · (deferred top link `topLink`, cast ℚ→`Cut`)
      · (deferred light/lepton link `lightLink`, cast ℚ→`Cut`).
  The deferred links (`topLink`, `lightLink`, and the phase `phaseBorn` inside the gear factor) are
  the CANDIDATE / inception-flagged part — the chain STRUCTURE is the theorem-grade content. -/

/-- THE BUDGET-ANCHORED ABSOLUTE-SCALE CHAIN: the electroweak anchor `v/M = ewClosureRatio` (the
    banked n=9 tower rung) times the banked `m_b` gear link (N408) times the deferred top and
    light/lepton links. Every factor is a banked or honestly-deferred object; nothing is posited. -/
def absScaleChain (phaseBorn topLink lightLink : ℚ) : Cut :=
  ewClosureRatio * ((mbBornRatio phaseBorn : ℚ) : Cut)
    * ((topLink : ℚ) : Cut) * ((lightLink : ℚ) : Cut)

/-- ★ THE CHAIN FACTORS THROUGH THE BANKED ELECTROWEAK RUNG `e^(−28π/3)`: the whole absolute scale
    is anchored at the banked n=9 tower rung of the `84π` budget (`ewClosureRatio_eq`, N332), NOT a
    free overall scale. -/
theorem absScaleChain_factors (phaseBorn topLink lightLink : ℚ) :
    absScaleChain phaseBorn topLink lightLink
      = cutExp (-(28 * cutPi / 3)) * ((mbBornRatio phaseBorn : ℚ) : Cut)
          * ((topLink : ℚ) : Cut) * ((lightLink : ℚ) : Cut) := by
  unfold absScaleChain; rw [ewClosureRatio_eq]

/-! ## (B) THE WELD: ONE `84π` budget threads BOTH the scale anchor AND the winding grid.

  This is the genuine NEW cross-tie (never banked before, NOT a hollow-AND): the electroweak
  anchor's budget lock (`lock_spaceSub`: `rungExponent 9 · 9 = criticalPhaseNumerator`, arc B)
  EQUALS the winding phase's budget form (`criticalBudget_channelform`:
  `criticalPhaseNumerator = azimuthalTurn · channelCount`, arc M). The v-rung that anchors the
  spectrum and the winding grid that quantizes the lepton scale are readings of the SAME `84π`. -/

/-- ★★ THE CHAIN WELD (arc-M M3 headline, the never-banked cross-tie): the anchor's `84π` budget
    lock EQUALS the winding phase's budget form. The electroweak scale anchor (arc B) and the
    winding ladder that quantizes the lepton rung (arc M) are threaded by the SAME critical-phase
    numerator `84π = 2π·42 = azimuthalTurn · channelCount`. One budget, two readings. -/
theorem chain_budget_weld :
    rungExponent (Module.finrank ℚ spaceSub) * (Module.finrank ℚ spaceSub : Cut)
      = azimuthalTurn * channelCount := by
  rw [lock_spaceSub]; exact criticalBudget_channelform

/-! ## (C) THE LINKS ARE THE BANKED FACTORS (M1, M2 threaded into the chain). -/

/-- ★ THE `m_b` LINK IS THE BANKED SELF-BLIND SURVIVAL (M2, N408): the gear link in the chain equals
    `phaseBorn · (tr Poth / 3)` — the deferred fold-phase factor times the banked N308 self-blind
    Born-survival, cast into `Cut`. Not a free Yukawa; a banked survival gear. -/
theorem mbLink_is_banked_survival (phaseBorn : ℚ) :
    ((mbBornRatio phaseBorn : ℚ) : Cut)
      = ((phaseBorn * (Matrix.trace Poth / 3) : ℚ) : Cut) := by
  rw [mbBornRatio_decomp]

/-- ★ THE `m_b` LINK AT THE BANKED VALUE: `= phaseBorn · (2/3)` cast into `Cut`. -/
theorem mbLink_value (phaseBorn : ℚ) :
    ((mbBornRatio phaseBorn : ℚ) : Cut) = ((phaseBorn * (2 / 3) : ℚ) : Cut) := by
  rw [mbBornRatio_value]

/-- ★ THE `m_e` (LEPTON) LINK SITS AT THE BANKED `w = −1` WINDING BOUNDARY RUNG (M1, N407): the
    lepton scale is quantized at the first descent below the self-blind ground,
    `windingRungIndex boundaryRungIndex = 1 − n_gen`. Not a free scale; a banked winding rung. -/
theorem meLink_at_winding_boundary :
    windingRungIndex boundaryRungIndex = 1 - (Module.finrank ℚ Uhol : ℤ) :=
  windingRung_boundary

/-- ★ THE LEPTON LINK IS THE FIRST DESCENT: the `w = −1` rung lies strictly below the self-blind
    ground rung `k = 0`, and every negative-index rung lies at or below it (M1 `boundary_is_first_
    descent`). The lepton scale sits at the immediate first winding descent, not an arbitrary rung. -/
theorem meLink_first_descent :
    windingRungIndex boundaryRungIndex < windingRungIndex 0
    ∧ ∀ k : ℤ, k < 0 → windingRungIndex k ≤ windingRungIndex boundaryRungIndex :=
  boundary_is_first_descent

/-! ## (D) POSITIVITY (Born-positive chain) and GENUINE SUPPRESSION. -/

/-- ★ BORN-POSITIVITY OF THE CHAIN: for positive links the whole chain is strictly positive — a
    genuine scale, the anchor Born-positive (`ewClosureRatio_pos`) and the links positive rationals. -/
theorem absScaleChain_pos (phaseBorn topLink lightLink : ℚ)
    (hp : 0 < phaseBorn) (ht : 0 < topLink) (hl : 0 < lightLink) :
    0 < absScaleChain phaseBorn topLink lightLink := by
  unfold absScaleChain
  have h1 : 0 < ewClosureRatio := ewClosureRatio_pos
  have h2 : (0 : Cut) < ((mbBornRatio phaseBorn : ℚ) : Cut) := by
    rw [mbBornRatio_value]
    have : (0 : ℚ) < phaseBorn * (2 / 3) := by positivity
    exact_mod_cast this
  have h3 : (0 : Cut) < ((topLink : ℚ) : Cut) := by exact_mod_cast ht
  have h4 : (0 : Cut) < ((lightLink : ℚ) : Cut) := by exact_mod_cast hl
  positivity

/-- ★★ GENUINE SUPPRESSION (the chain is not the trivial `1`): the anchor times the bare banked
    survival `2/3` is strictly below `1` — `ewClosureRatio · (2/3) < 1`. The electroweak anchor
    `< 1` (`ewClosureRatio_lt_one`) times the Born-survival `2/3 < 1` gives a genuine suppression,
    NOT a free `1`. (This is the two-link core of the chain at `phaseBorn = 1`, `topLink = 1`.) -/
theorem anchor_survival_suppressed :
    ewClosureRatio * ((mbBornRatio 1 : ℚ) : Cut) < 1 := by
  have ha : ewClosureRatio < 1 := ewClosureRatio_lt_one
  have hb : ((mbBornRatio 1 : ℚ) : Cut) = ((2 / 3 : ℚ) : Cut) := by
    rw [mbBornRatio_value]; norm_num
  rw [hb]
  have hb0 : (0 : Cut) < ((2 / 3 : ℚ) : Cut) := by
    have : ((0 : ℚ) : Cut) < ((2 / 3 : ℚ) : Cut) :=
      by exact_mod_cast (by norm_num : (0 : ℚ) < 2 / 3)
    simpa using this
  have hb1 : ((2 / 3 : ℚ) : Cut) < 1 := by
    have : ((2 / 3 : ℚ) : Cut) < ((1 : ℚ) : Cut) :=
      by exact_mod_cast (by norm_num : (2 / 3 : ℚ) < 1)
    simpa using this
  calc ewClosureRatio * ((2 / 3 : ℚ) : Cut)
      < 1 * ((2 / 3 : ℚ) : Cut) := mul_lt_mul_of_pos_right ha hb0
    _ = ((2 / 3 : ℚ) : Cut) := one_mul _
    _ < 1 := hb1

/-! ## (E) NON-VACUITY (W8). -/

/-- W8 NON-VACUITY: the electroweak ANCHOR is a genuine nontrivial suppression `≠ 1` (`v/M ≠ 1`,
    banked `ewClosureRatio_ne_one`) — the chain is anchored below the closure scale, not at the
    trivial overall scale `1`. -/
theorem anchor_ne_one : ewClosureRatio ≠ 1 := ewClosureRatio_ne_one

/-- W8 NON-VACUITY: the `m_b` gear link genuinely suppresses — at `phaseBorn = 1` the link is the
    bare banked survival `2/3 ≠ 1` (`s1BornProb_ne_one`, N408), so the link is real content, not a
    vacuous `1`. -/
theorem mbLink_one_ne_one : ((mbBornRatio 1 : ℚ) : Cut) ≠ ((1 : ℚ) : Cut) := by
  rw [mbBornRatio_value]
  intro h
  have : (1 * (2 / 3) : ℚ) = (1 : ℚ) := by exact_mod_cast h
  norm_num at this

/-- W8 NON-VACUITY: the lepton link's `w = −1` boundary rung is genuinely distinct from the
    self-blind ground rung `k = 0` — the winding descent is real, not the trivial ground. -/
theorem meLink_ne_ground : windingRungIndex boundaryRungIndex ≠ windingRungIndex 0 := by
  have := boundary_is_first_descent.1
  intro h; rw [h] at this; exact lt_irrefl _ this

/-! ## (F) THE CAPSTONE (structural + the WELD only — NOT the candidate absolute value). -/

/-- ★★★ THE ABSOLUTE-SCALE CHAIN CLOSURE (arc-M M3, theorem-grade STRUCTURE): the absolute mass
    scale is ONE budget-anchored CHAIN — it factors through the banked electroweak rung
    `e^(−28π/3)`; its `84π` budget lock EQUALS the winding phase's budget form (the WELD, one budget
    threading anchor + winding grid); its `m_b` link IS the banked self-blind survival `tr Poth/3`;
    its lepton link sits at the banked `w = −1` winding boundary rung `1 − n_gen`; and (for positive
    links) it is Born-positive with the anchor·survival core strictly suppressed below `1`. The
    absolute VALUE and the deferred links (the fold phase `P`, the top mechanism, the `m_s/m_d` laws,
    the winding rung↔scale assignment) are CANDIDATE / inception-flagged and deliberately EXCLUDED
    from this structural capstone (the phantom cap). -/
theorem absolute_scale_chain_closure :
    (∀ phaseBorn topLink lightLink : ℚ,
        absScaleChain phaseBorn topLink lightLink
          = cutExp (-(28 * cutPi / 3)) * ((mbBornRatio phaseBorn : ℚ) : Cut)
              * ((topLink : ℚ) : Cut) * ((lightLink : ℚ) : Cut))
    ∧ (rungExponent (Module.finrank ℚ spaceSub) * (Module.finrank ℚ spaceSub : Cut)
        = azimuthalTurn * channelCount)
    ∧ (∀ phaseBorn : ℚ,
        ((mbBornRatio phaseBorn : ℚ) : Cut) = ((phaseBorn * (Matrix.trace Poth / 3) : ℚ) : Cut))
    ∧ windingRungIndex boundaryRungIndex = 1 - (Module.finrank ℚ Uhol : ℤ)
    ∧ ewClosureRatio * ((mbBornRatio 1 : ℚ) : Cut) < 1 :=
  ⟨absScaleChain_factors, chain_budget_weld, mbLink_is_banked_survival,
   meLink_at_winding_boundary, anchor_survival_suppressed⟩

