def completeBandList (d : Cut) : List (Cut × Cut) := derivedBandList ++ leptonTail d

/-- ★★★ THE ENDPOINT AS A DERIVED CLOSED REAL OF Cut: `invAlphaZero (completeBandList d) = 190/3 +
