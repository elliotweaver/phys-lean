    fit. No empirical number in any proof. -/
theorem endpointAssembly_landing (w d : Cut) (hw0 : 0 ≤ w) (hw1 : w < 1) :
    -- (1) the scale bundle cancels — every lepton edge ratio is a forced flavor ratio
    absMass0 / absMass2 = mass0 / mass2
    ∧ absMass2 / absMass1 = mass2 / mass1
    -- (2) the intermediate edge telescopes
    ∧ totalScreening (leptonTail d) = bandScreen d (mass0 / mass1)
    -- (3) the endpoint as a closed real of Cut
    ∧ invAlphaZero (completeBandList d) = 190 / 3 + kappaLeading * d * cutLog (mass0 / mass1)
    -- (4) both banked way-points land free
    ∧ invAlphaZero (completeBandList d) = 190 / 3 + totalScreening (leptonTail d)
    ∧ invAlphaZero (completeBandList d)
        = 1582 / 27 + totalScreening ((chargeTraceDepth, confBandRatio) :: leptonTail d)
    -- (5) the forced flavor ratio as a derived rational bracket
    ∧ ((1000000000 : Cut) / 288575 ≤ mass0 / mass1 ∧ mass0 / mass1 ≤ (1000000000 : Cut) / 286902)
    -- (6) the dressed (depth-tower) endpoint
    ∧ dressedInvAlphaZero w (completeBandList d) = 42 + totalScreening (completeBandList d) / (1 - w)
    -- (7) the endpoint genuinely screens; the sense is forced
    ∧ (190 : Cut) / 3 < invAlphaZero (completeBandList chargeTraceDepth)
    ∧ bandScreen (-chargeTraceDepth) (mass0 / mass1) < 0 :=
  ⟨absRatio_02,
   absRatio_21,
   leptonTail_screen_telescope d,
   endpoint_expanded d,
   confWaypoint_in_complete d,
   ewWaypoint_in_complete d,
   ⟨m01_bracket_lo, m01_bracket_hi⟩,
   dressed_endpoint_closed w d hw0 hw1,
   endpoint_gt_conf,
   leptonBand_sense_negative⟩

end

end Phys.Algebra.EndpointAssembly
