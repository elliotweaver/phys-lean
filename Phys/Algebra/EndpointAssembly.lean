theorem endpoint_closed (d : Cut) :
    invAlphaZero (completeBandList d) = 190 / 3 + bandScreen d (mass0 / mass1) := by
  unfold completeBandList
  rw [confWaypoint_free (leptonTail d), leptonTail_screen_telescope]

/-- THE ENDPOINT FULLY EXPANDED: `invAlphaZero (completeBandList d) = 190/3 + κ·d·cutLog(mass0/mass1)`
