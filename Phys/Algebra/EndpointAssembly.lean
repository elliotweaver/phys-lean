/-! ## (A) THE SCALE-BUNDLE CANCELLATION — every lepton edge ratio is a FORCED FLAVOR ratio. -/

/-- ★★ THE SCALE BUNDLE CANCELS (heaviest/middle): `absMass0 / absMass2 = mass0 / mass2`. The
    absolute scale `massScale` (arc-O/P) is common to every lepton edge (`absMass k = massScale·mass_k`,
    N427) and nonzero, so it cancels — the edge ratio is the FORCED flavor eigenvalue ratio (δ_B = 2/9,
    N340). The endpoint's tail sees only the forced generation ratios. -/
theorem absRatio_02 : absMass0 / absMass2 = mass0 / mass2 := by
  unfold absMass0 absMass2
  exact mul_div_mul_left mass0 mass2 massScale_ne_zero

/-- ★★ THE SCALE BUNDLE CANCELS (middle/lightest): `absMass2 / absMass1 = mass2 / mass1`. -/
theorem absRatio_21 : absMass2 / absMass1 = mass2 / mass1 := by
  unfold absMass2 absMass1
  exact mul_div_mul_left mass2 mass1 massScale_ne_zero

/-- The heaviest/middle forced flavor ratio is a genuine positive derived real. -/
theorem mr02_pos : (0 : Cut) < mass0 / mass2 := div_pos mass0_pos mass2_pos

/-- The middle/lightest forced flavor ratio is a genuine positive derived real. -/
theorem mr21_pos : (0 : Cut) < mass2 / mass1 := div_pos mass2_pos mass1_pos

/-! ## (B) THE LEPTON TAIL AND ITS TELESCOPING (the intermediate edge drops out). -/

/-- THE DERIVED LEPTON TAIL over the derived ℝ: the two consecutive charged-lepton resolution bands
    below the confinement edge, each carrying the SAME per-generation census `d` (the three charged
    leptons carry identical charge; only the mass edge differs) over a derived edge ratio. Heaviest→
    middle `absMass0/absMass2` then middle→lightest `absMass2/absMass1`. Every entry a derived `Cut`. -/
def leptonTail (d : Cut) : List (Cut × Cut) :=
  [(d, absMass0 / absMass2), (d, absMass2 / absMass1)]

/-- ★★★ THE LEPTON TAIL TELESCOPES: `totalScreening (leptonTail d) = bandScreen d (mass0/mass1)`. The
    two consecutive edge-ratio screenings sum, via the banked `cutLog` homomorphism `cutLog_mul`, to a
    SINGLE band screening of the product ratio — which the scale cancellation makes the FORCED flavor
    ratio `mass0/mass1` (heaviest/lightest). The INTERMEDIATE edge `absMass2` drops out: it is a
    genuine way-point, not an anchor. `κ·d·cutLog(m0/m2) + κ·d·cutLog(m2/m1) = κ·d·cutLog(m0/m1)`. -/
theorem leptonTail_screen_telescope (d : Cut) :
    totalScreening (leptonTail d) = bandScreen d (mass0 / mass1) := by
  unfold leptonTail totalScreening
  simp only [List.map_cons, List.map_nil, List.sum_cons, List.sum_nil, add_zero]
  rw [absRatio_02, absRatio_21]
  unfold bandScreen
  have hlog : cutLog (mass0 / mass2) + cutLog (mass2 / mass1) = cutLog (mass0 / mass1) := by
    rw [← cutLog_mul mr02_pos mr21_pos]
    congr 1
    have h1 : mass1 ≠ 0 := ne_of_gt mass1_pos
    have h2 : mass2 ≠ 0 := ne_of_gt mass2_pos
    field_simp
  have hr : kappaLeading * d * cutLog (mass0/mass2) + kappaLeading * d * cutLog (mass2/mass1)
          = kappaLeading * d * (cutLog (mass0/mass2) + cutLog (mass2/mass1)) := by ring
  rw [hr, hlog]

/-! ## (C) THE COMPLETE BAND LIST AND THE ENDPOINT AS A CLOSED REAL OF Cut. -/

/-- THE COMPLETE DERIVED BAND LIST: the two banked exact high bands (Z4 `derivedBandList`) followed by
