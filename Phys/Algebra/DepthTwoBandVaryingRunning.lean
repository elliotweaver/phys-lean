/-! ## (A) THE BAND-VARYING SECOND-DEPTH SCREEN — the census-in-census with a PER-BAND weight. -/

/-- THE BAND-VARYING DEPTH-2 SCREEN over the derived ℝ: the finite sum, over labelled bands
    `(w_b, (depth_b, ratio_b))`, of the Z5 depth-tower band step `bandScreen depth_b ratio_b/(1−w_b)`
    with a PER-BAND second-depth weight `w_b`. This is the honest generalization of Z5's uniform
    `dressedTotalScreening`: the second application of the fold's self-look-back weights each band by
    ITS OWN self-overlap census, and the census differs per band, so the weight is band-varying. -/
def bandVaryingScreen (wbands : List (Cut × (Cut × Cut))) : Cut :=
  (wbands.map (fun q => bandScreen q.2.1 q.2.2 / (1 - q.1))).sum

/-- THE UNIFORM LABELLING: assign the SAME second-depth weight `w` to every band. The uniform case is
    ONE point of the band-varying framework (`bandVaryingScreen_uniform` recovers Z5). -/
def withWeight (w : Cut) (bands : List (Cut × Cut)) : List (Cut × (Cut × Cut)) :=
  bands.map (fun b => (w, b))

/-- THE ZERO-MOMENTUM COUPLING RUN THROUGH THE BAND-VARYING DEPTH-2 TOWER: the banked octonion ceiling
    `invAlphaHigh` (the bare channel COUNT `42`, NOT dressed) plus the band-varying depth-2 screen. -/
def bandVaryingInvAlphaZero (wbands : List (Cut × (Cut × Cut))) : Cut :=
  invAlphaHigh + bandVaryingScreen wbands

/-! ## (B) ADDITIVITY AND THE UNIFORM / LEADING RECOVERIES (the framework contains Z5 and Z4). -/

/-- ★★ THE BAND-VARYING SCREEN IS ADDITIVE over concatenation: `bandVaryingScreen (xs ++ ys) =
    bandVaryingScreen xs + bandVaryingScreen ys`. The high bands and the low tail compose linearly —
    the ground for way-point preservation. -/
theorem bandVaryingScreen_append (xs ys : List (Cut × (Cut × Cut))) :
    bandVaryingScreen (xs ++ ys) = bandVaryingScreen xs + bandVaryingScreen ys := by
  unfold bandVaryingScreen
  rw [List.map_append, List.sum_append]

/-- ★★★ THE UNIFORM RECOVERY (Z5 tie-in): with the SAME second-depth weight `w` on every band, the
    band-varying screen equals Z5's banked uniform depth tower `dressedTotalScreening w`. The
    band-varying framework CONTAINS the banked uniform depth tower as its constant-weight point. -/
theorem bandVaryingScreen_uniform (w : Cut) (hw0 : 0 ≤ w) (hw1 : w < 1)
    (bands : List (Cut × Cut)) :
    bandVaryingScreen (withWeight w bands) = dressedTotalScreening w bands := by
  unfold bandVaryingScreen withWeight dressedTotalScreening
  induction bands with
  | nil => simp
  | cons b bs ih =>
    simp only [List.map_cons, List.sum_cons]
    rw [dressedBandScreen_factor w hw0 hw1 b.1 b.2, ih]

/-- ★★ THE LEADING RECOVERY: with second-depth weight `0` on every band (no inner self-resolution) the
    band-varying screen collapses to the banked leading Z4/X6 tower `totalScreening bands`. -/
theorem bandVaryingScreen_zeroWeights (bands : List (Cut × Cut)) :
    bandVaryingScreen (withWeight 0 bands) = totalScreening bands := by
  rw [bandVaryingScreen_uniform 0 (le_refl 0) (by norm_num) bands,
      dressedTotalScreening_factor 0 (le_refl 0) (by norm_num)]
  simp

/-- ★★ THE LEADING TOWER RECOVERY: `bandVaryingInvAlphaZero (withWeight 0 bands) = invAlphaZero bands`
    — the band-varying depth-2 tower at zero weights is exactly the banked leading assembly. -/
theorem bandVaryingInvAlphaZero_zeroWeights (bands : List (Cut × Cut)) :
    bandVaryingInvAlphaZero (withWeight 0 bands) = invAlphaZero bands := by
  unfold bandVaryingInvAlphaZero
  rw [bandVaryingScreen_zeroWeights, invAlphaZero_closed, invAlphaHigh_eq]

/-- ★★ THE UNIFORM TOWER RECOVERY (Z5 tie-in): `bandVaryingInvAlphaZero (withWeight w bands) =
    dressedInvAlphaZero w bands` — the constant-weight point of the band-varying tower is Z5's banked
    depth tower. -/
theorem bandVaryingInvAlphaZero_uniform (w : Cut) (hw0 : 0 ≤ w) (hw1 : w < 1)
    (bands : List (Cut × Cut)) :
    bandVaryingInvAlphaZero (withWeight w bands) = dressedInvAlphaZero w bands := by
  unfold bandVaryingInvAlphaZero dressedInvAlphaZero
  rw [bandVaryingScreen_uniform w hw0 hw1]

/-! ## (C) WAY-POINT PRESERVATION — the KEY (resolving the uniform-only exclusion). -/

/-- ★★★ THE HIGH WAY-POINT BANDS ARE PRESERVED when their second-depth weight is `0`: for any low tail
    `lowTail`, `bandVaryingInvAlphaZero (withWeight 0 derivedBandList ++ lowTail) = 190/3 +
    bandVaryingScreen lowTail`. The banked exact confinement way-point `190/3` is a partial sum on the
    band-varying tower whenever the high bands carry no second-depth weight — the census-in-census
    content of the HIGH bands is already inside the banked all-orders band edges, so setting `w = 0`
    there avoids the double-count `DressingSeamResolved` excluded, while the low tail runs freely. -/
theorem highBands_preserved (lowTail : List (Cut × (Cut × Cut))) :
    bandVaryingInvAlphaZero (withWeight 0 derivedBandList ++ lowTail)
      = 190 / 3 + bandVaryingScreen lowTail := by
  unfold bandVaryingInvAlphaZero
  rw [bandVaryingScreen_append, bandVaryingScreen_zeroWeights,
      totalScreening_derivedBandList, invAlphaHigh_eq]
  ring

/-- ★★★ ZERO ON THE HIGH BANDS PRESERVES THE WAY-POINT EXACTLY: `bandVaryingInvAlphaZero (withWeight 0
    derivedBandList) = 190/3` — the banked Z4 confinement way-point (`derivedBandList_assembly`)
    reproduced by the band-varying tower when the high bands carry no second-depth weight. -/
theorem zeroOnHigh_preserves_waypoint :
    bandVaryingInvAlphaZero (withWeight 0 derivedBandList) = 190 / 3 := by
  rw [bandVaryingInvAlphaZero_zeroWeights, derivedBandList_assembly]

/-- ★★★ THE UNIFORM SECOND-DEPTH DRESSING MOVES THE WAY-POINT (the banked exclusion, re-read on the
    band-varying tower): `bandVaryingInvAlphaZero (withWeight depthWeight derivedBandList) = 74 ≠ 190/3`.
    Applying the UNIFORM derived weight `depthWeight = 1/3` to the HIGH way-point bands moves the banked
    `190/3` to `74` (re-export of the banked `dressed_at_depthWeight`) — precisely the double-count
    `DressingSeamResolved` excluded. The band-varying-zero-on-high frame (above) is the way-point-
    consistent alternative. -/
theorem uniform_derived_moves_waypoint :
    bandVaryingInvAlphaZero (withWeight depthWeight derivedBandList) = 74
    ∧ (74 : Cut) ≠ 190 / 3 := by
  refine ⟨?_, by norm_num⟩
  rw [bandVaryingInvAlphaZero_uniform depthWeight (le_of_lt depthWeight_pos) depthWeight_lt_one,
      dressed_at_depthWeight]

/-! ## (D) THE UPWARD DIRECTION AND THE PER-BAND CENSUS-IN-CENSUS SELF-REFERENCE. -/

/-- ★★★ THE DEPTH-2 RUNNING STRICTLY RAISES A SCREENED BAND (the ONE-LAW-correct direction): for a
    positive per-loop weight `0 < w < 1`, a positive census `0 < depth`, and a genuine scale ratio
    `1 < ratio`, the depth-2 band step `bandScreen depth ratio/(1−w)` STRICTLY EXCEEDS the leading
    `bandScreen depth ratio`. The census-in-census adds — from the census-conserving UNDERSHOOT the
    depth-2 running corrects UPWARD toward the region, never downward onto an overshoot. -/
theorem bandVaryingBandScreen_gt_leading (w depth ratio : Cut)
    (hw0 : 0 < w) (hw1 : w < 1) (hd : 0 < depth) (hr : 1 < ratio) :
    bandScreen depth ratio < bandScreen depth ratio / (1 - w) := by
  have hpos : 0 < bandScreen depth ratio := bandScreen_pos hd hr
  have hw : (0 : Cut) < 1 - w := by linarith
  rw [lt_div_iff₀ hw]
  nlinarith [hpos, hw0]

/-- ★★ THE PER-BAND CENSUS-IN-CENSUS SELF-REFERENCE: the depth-2 band step obeys the fixed-point
    identity `bandScreen d r/(1−w) = bandScreen d r + w·(bandScreen d r/(1−w))` — the whole band step
    reappears inside itself weighted by `w`, exactly X5's `κ(w) = κ₀ + w·κ(w)` carried to the band, now
    with a PER-BAND weight. The running OF the running is the self-referential loop depth AT each band. -/
theorem bandVaryingBandScreen_selfref (w depth ratio : Cut) (hw1 : w < 1) :
    bandScreen depth ratio / (1 - w)
      = bandScreen depth ratio + w * (bandScreen depth ratio / (1 - w)) := by
  have h1w : (1 : Cut) - w ≠ 0 := sub_ne_zero.mpr (fun h => (ne_of_lt hw1) h.symm)
  field_simp
  ring

/-! ## (E) W8 NON-VACUITY WITH TEETH. -/

/-- ★★ W8 — THE DEPTH-2 RUNNING GENUINELY RAISES THE CONFINEMENT BAND (not vacuous): at a witness
    nontrivial weight `w = 1/3` the depth-2 confinement band `bandScreen chargeTraceDepth
    confBandRatio/(1−1/3)` strictly exceeds the leading `bandScreen chargeTraceDepth confBandRatio =
    128/27`. The correction is real. -/
theorem depth2_conf_gt_leading :
    bandScreen chargeTraceDepth confBandRatio
      < bandScreen chargeTraceDepth confBandRatio / (1 - (1 / 3 : Cut)) := by
  apply bandVaryingBandScreen_gt_leading (1 / 3) chargeTraceDepth confBandRatio (by norm_num)
    (by norm_num) chargeTraceDepth_pos confBandRatio_gt_one

/-- ★★★ W8 — THE BAND-VARYING-ZERO-ON-HIGH VALUE GENUINELY DIFFERS FROM THE UNIFORM-DERIVED VALUE:
    `bandVaryingInvAlphaZero (withWeight 0 derivedBandList) = 190/3` while `bandVaryingInvAlphaZero
    (withWeight depthWeight derivedBandList) = 74`, and `190/3 ≠ 74`. Preserving the way-point via the
    band-varying-zero-on-high frame is a genuine, content-bearing choice — the uniform second-depth
    dressing MOVES it, the band-varying one does not. -/
theorem varying_vs_uniform_waypoint :
    bandVaryingInvAlphaZero (withWeight 0 derivedBandList)
      ≠ bandVaryingInvAlphaZero (withWeight depthWeight derivedBandList) := by
  rw [zeroOnHigh_preserves_waypoint, uniform_derived_moves_waypoint.1]; norm_num

/-- ★ W8 — THE DERIVED SECOND-DEPTH WEIGHT IS GENUINELY NONTRIVIAL (`0 < depthWeight < 1`, D3): the
    upward correction and the uniform way-point move are at a genuine `w > 0`. Were `w = 0` there would
    be no second-depth running and no seam; the nontrivial derived weight is the source of the content. -/
theorem derived_weight_nontrivial : 0 < depthWeight ∧ depthWeight < 1 :=
  ⟨depthWeight_pos, depthWeight_lt_one⟩

