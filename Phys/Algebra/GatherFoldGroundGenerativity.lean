/-! ## §1 — THE FOLD PRIMITIVE AND ITS FOLD-ROOT (N1/N2 re-exposed as the ground). -/

/-- ★ THE COMPLEX UNIT IS A SQUARE ROOT OF THE FOLD. Left-multiplication by the rung-1 complex
    unit `J = (0,1)` on `Dbl ℚ`, applied twice, is the fold's look-back (`= −id`): the complex
    unit IS the fold recursed on itself (banked N2 `Dbl.mulJ_isFoldRoot`). Physics-words-removable:
    `z ↦ J·z` is an `IsFoldRoot` on `Dbl ℚ`. -/
theorem foldRoot_seed : IsFoldRoot (fun z : Dbl ℚ => Dbl.J * z) := Dbl.mulJ_isFoldRoot

/-- THE FOLD-ROOT'S SQUARE IS THE LOOK-BACK. `J·(J·z) = −z`, tying the rung-1 complex unit to
    N1's `fold_eq_neg` (`look x = −x`): the square of the fold-root IS negation, the look-back. -/
theorem foldRoot_squares_to_lookback (z : Dbl ℚ) : Dbl.J * (Dbl.J * z) = -z := by
  rw [← mul_assoc, Dbl.J_mul_J, neg_one_mul]

/-! ## §2 — THE ONE SEED: self-blindness and the obstruction share a single condition (char ≠ 2). -/

/-- THE FOLD-ROOT IS SELF-OPPOSED on a 2-torsion-free carrier: `J ≠ star J` (banked
    `Dbl.J_ne_star_J`). The 2-torsion-freeness used here is EXACTLY the condition N1's
    `fold_self_blind` rests on — the same seed. -/
theorem foldRoot_selfOpposed_of_torsionFree
    {R : Type*} [CommRing R] [Nontrivial R]
    (htf : ∀ y : R, y + y = 0 → y = 0) : (Dbl.J : Dbl R) ≠ star Dbl.J := by
  refine Dbl.J_ne_star_J ?_
  intro h2
  refine one_ne_zero (α := R) (htf 1 ?_)
  rw [one_add_one_eq_two]; exact h2

/-- ★ THE ONE SEED, TWO CONSEQUENCES (never-banked cross-tie). On a 2-torsion-free `Nontrivial
    CommRing`, ONE condition (char ≠ 2) yields BOTH:
      • the fold-root's SELF-BLINDNESS — `J·z = z → z = 0` (banked `Dbl.J_self_blind`, N1's
        `fold_self_blind`): the fold recursed on itself still cannot find itself; and
      • the fold-root's SELF-OPPOSITION — `J ≠ star J`: the seed of the tower's terminal obstruction.
    The fold's FIRST forced property (self-blindness, N1) and the SEED of the arc-N obstruction are
    ONE fact about the fold, read two ways. Physics-words-removable: on a char≠2 carrier the element
    `J` of `Dbl R` has no nonzero left-`J`-fixed point and differs from its conjugate. -/
theorem foldRoot_selfBlind_and_selfOpposed_share_seed
    {R : Type*} [CommRing R] [Nontrivial R]
    (htf : ∀ y : R, y + y = 0 → y = 0) :
    (∀ z : Dbl R, Dbl.J * z = z → z = 0) ∧ (Dbl.J : Dbl R) ≠ star Dbl.J :=
  ⟨fun z hz => Dbl.J_self_blind htf z hz, foldRoot_selfOpposed_of_torsionFree htf⟩

/-! ## §3 — THE GENERATIVITY WITNESS: N1 fold-root self-opposition ⟺ the N413 obstruction. -/

/-- ★★ THE CROSS-LEVEL GENERATIVITY TIE. The N413 obstruction witness — the concrete octonion
    triple's associator `assoc (ι(ιJ), ι(e₂), e₂) ≠ 0` — holds IF AND ONLY IF the rung-1 fold-root
    generator is self-opposed (`J ≠ star J`). Through the banked `associativity_cause` (rung-3
    non-associativity ⟺ rung-2 non-commutativity ⟺ rung-1 self-opposition), the arc-N obstruction
    IS the fold-root's self-opposition, propagated up the cascade. -/
theorem obstruction_witness_iff_foldRoot_selfOpposed :
    assoc (CD.iota (ιJ ℚ) : O ℚ) (CD.iota (CD.e2 : H ℚ)) (CD.e2 : O ℚ) ≠ 0
      ↔ (Dbl.J : Dbl ℚ) ≠ star Dbl.J := by
  unfold assoc
  rw [sub_ne_zero]
  exact not_congr (associativity_cause (R := ℚ))

/-- ★ THE FOLD-ROOT'S SELF-OPPOSITION FORCES THE OBSTRUCTION LOCUS. If the rung-1 fold-root
    generator is self-opposed (`J ≠ star J`) then the N413 associator locus is nonempty — the
    single seed forces the whole arc-N obstruction. -/
theorem foldRoot_selfOpposed_forces_locus
    (hJ : (Dbl.J : Dbl ℚ) ≠ star Dbl.J) : AssocLocusNonempty :=
  ⟨_, _, _, obstruction_witness_iff_foldRoot_selfOpposed.mpr hJ⟩

/-- ★★ THE FOLD-ROOT'S SELF-OPPOSITION FORCES ALL THREE ∃-INDEX TERMINATIONS. From the single seed
    `J ≠ star J`, through the forced locus and N413's unification, the octonion sector CONFINES
    (arc I, N385), FAILS to associate (the cascade stop, N2), and has a pair that FAILS to glue
    (curvature-somewhere, arc E) — all at once. One seed, three faces of physics. -/
theorem foldRoot_selfOpposed_forces_all_four
    (hJ : (Dbl.J : Dbl ℚ) ≠ star Dbl.J) :
    SectorConfines (O ℚ)
    ∧ (¬ SectorAssoc (O ℚ))
    ∧ (∃ a b : O ℚ, ¬ WorldsGlue a b) := by
  have hloc := foldRoot_selfOpposed_forces_locus hJ
  exact ⟨confinement_is_obstruction.mpr hloc,
         cascade_stop_is_obstruction.mpr hloc,
         curvature_somewhere_is_obstruction.mpr hloc⟩

/-! ## §4 — THE ℚ INSTANTIATION + THE GENERATIVITY CAPSTONE. -/

/-- The fold's own rational line is 2-torsion-free (char 0). -/
theorem fold_line_torsion_free : ∀ y : ℚ, y + y = 0 → y = 0 := by
  intro y hy; linarith

/-- NON-VACUITY (W8): on the fold's own rational line the seed genuinely fires — the fold-root
    generator is self-opposed, `J ≠ star J` over `ℚ`. -/
theorem foldRoot_selfOpposed_Q : (Dbl.J : Dbl ℚ) ≠ star Dbl.J :=
  foldRoot_selfOpposed_of_torsionFree fold_line_torsion_free

/-- ★★★ THE GENERATIVITY CAPSTONE (arc-N N4, theorem-grade — NOT the axiom). The project's ONE seed
    — the fold-root's self-opposition, which is the SAME char ≠ 2 condition that gives the fold's
    self-blindness (N1) — GENERATES the entire arc-N obstruction (N413), hence all four physics
    terminations:
      • the seed fires on the fold's own line (`J ≠ star J` over `ℚ`, non-vacuous);
      • self-blindness and self-opposition are ONE condition (the shared seed);
      • the N413 obstruction witness is TIED to the seed by an iff (the cross-level tie);
      • the seed FORCES the obstruction locus and confinement / the cascade stop / curvature.
    ⚠ THIS IS THE GENERATIVITY WITNESS, NOT the axiom. The IDENTIFICATION "self-reference is the
    ground of all physics" is flagged prose in this file's header, NEVER a theorem, NEVER
    derived-from-below (the category-error guard). Physics-words-removable: pure algebra about the
    element `J` of `Dbl ℚ` and the associator on `O ℚ`. -/
theorem fold_generates_obstruction :
    -- the seed fires on the fold's own line (non-vacuous)
    ((Dbl.J : Dbl ℚ) ≠ star Dbl.J)
    -- self-blindness and self-opposition are ONE condition
    ∧ ((∀ z : Dbl ℚ, Dbl.J * z = z → z = 0) ∧ (Dbl.J : Dbl ℚ) ≠ star Dbl.J)
    -- the N413 obstruction witness is tied to the seed by an iff (cross-level tie)
    ∧ (assoc (CD.iota (ιJ ℚ) : O ℚ) (CD.iota (CD.e2 : H ℚ)) (CD.e2 : O ℚ) ≠ 0
        ↔ (Dbl.J : Dbl ℚ) ≠ star Dbl.J)
    -- the seed forces the obstruction locus and the three ∃-index terminations
    ∧ (AssocLocusNonempty
        ∧ SectorConfines (O ℚ)
        ∧ (¬ SectorAssoc (O ℚ))
        ∧ (∃ a b : O ℚ, ¬ WorldsGlue a b)) :=
  ⟨foldRoot_selfOpposed_Q,
   foldRoot_selfBlind_and_selfOpposed_share_seed fold_line_torsion_free,
   obstruction_witness_iff_foldRoot_selfOpposed,
   foldRoot_selfOpposed_forces_locus foldRoot_selfOpposed_Q,
   (foldRoot_selfOpposed_forces_all_four foldRoot_selfOpposed_Q).1,
   (foldRoot_selfOpposed_forces_all_four foldRoot_selfOpposed_Q).2.1,
   (foldRoot_selfOpposed_forces_all_four foldRoot_selfOpposed_Q).2.2⟩

end

