/-! ## Entrywise scalar–matrix multiplication over the non-associative `O ℚ`.

    `Matrix.smul_mul`/`Matrix.mul_smul` require an `IsScalarTower ℚ (O ℚ) (O ℚ)` on matrices that is
    not synthesized here; we prove the two needed facts entrywise from the banked scalar identities
    `qsmul_mul_left`/`qsmul_mul_right` (the ℚ-scalar is central through the octonion product). -/

/-- `(r • A) * B = r • (A * B)` entrywise, over the non-associative octonion entries. -/
theorem mat_smul_mul (r : ℚ) (A B : Matrix (Fin 3) (Fin 3) (O ℚ)) :
    (r • A) * B = r • (A * B) := by
  apply Matrix.ext; intro i j
  simp only [Matrix.smul_apply, Matrix.mul_apply, Finset.smul_sum]
  apply Finset.sum_congr rfl; intro k _
  exact qsmul_mul_left r (A i k) (B k j)

/-- `A * (r • B) = r • (A * B)` entrywise. -/
theorem mat_mul_smul (r : ℚ) (A B : Matrix (Fin 3) (Fin 3) (O ℚ)) :
    A * (r • B) = r • (A * B) := by
  apply Matrix.ext; intro i j
  simp only [Matrix.smul_apply, Matrix.mul_apply, Finset.smul_sum]
  apply Finset.sum_congr rfl; intro k _
  exact qsmul_mul_right r (A i k) (B k j)

/-! ## The Jordan-multiplication operator `Lmul` (SUPPORTING — generic). -/

/-- THE JORDAN-MULTIPLICATION OPERATOR. `Lmul A` is left-multiplication by `A` in the symmetric
    (Jordan) bracket `jb A X = A*X + X*A`, packaged as a ℚ-linear endomorphism of the arena. The
    span of `[Lmul A, Lmul B]` over all `A, B` is the arena's inner-derivation algebra (`f₄`); this
    node mines its first non-trivial action. Generic to any matrix ring → supporting. -/
noncomputable def Lmul (A : Matrix (Fin 3) (Fin 3) (O ℚ)) :
    Matrix (Fin 3) (Fin 3) (O ℚ) →ₗ[ℚ] Matrix (Fin 3) (Fin 3) (O ℚ) where
  toFun X := jb A X
  map_add' X Y := by unfold jb; rw [mul_add, add_mul]; abel
  map_smul' r X := by
    unfold jb
    simp only [RingHom.id_apply, smul_add]
    rw [mat_mul_smul, mat_smul_mul]

@[simp] theorem Lmul_apply (A X : Matrix (Fin 3) (Fin 3) (O ℚ)) : Lmul A X = jb A X := rfl

/-! ## The inner-multiplication commutator `innerMul` (SUPPORTING structure — headline is its action). -/

/-- THE INNER-MULTIPLICATION COMMUTATOR. `innerMul A B := Lmul A ∘ Lmul B − Lmul B ∘ Lmul A`, the
    canonical inner-derivation generator of the Jordan arena (a ℚ-linear endomorphism). Its span over
    all `A, B` is `f₄ = Der(J₃(O)) ⊋` the entrywise `g₂` (N269). -/
noncomputable def innerMul (A B : Matrix (Fin 3) (Fin 3) (O ℚ)) :
    Matrix (Fin 3) (Fin 3) (O ℚ) →ₗ[ℚ] Matrix (Fin 3) (Fin 3) (O ℚ) :=
  Lmul A ∘ₗ Lmul B - Lmul B ∘ₗ Lmul A

theorem innerMul_apply (A B X : Matrix (Fin 3) (Fin 3) (O ℚ)) :
    innerMul A B X = jb A (jb B X) - jb B (jb A X) := rfl

/-- `innerMul` is ANTISYMMETRIC in its two multiplier arguments: `innerMul A B = − innerMul B A`. -/
theorem innerMul_antisymm (A B : Matrix (Fin 3) (Fin 3) (O ℚ)) :
    innerMul A B = - innerMul B A := by
  unfold innerMul; abel

/-! ## Scalar helpers — the embedded ground scalar `ocR d` is central. -/

/-- The embedded scalar `ocR d` acts on the left as the ℚ-smul: `ocR d * x = d • x`. -/
theorem ocRmulL (d : ℚ) (x : O ℚ) : ocR d * x = d • x := by
  rw [show ocR d = d • (1 : O ℚ) from by ext <;> simp [ocR], qsmul_mul_left, one_mul]

/-! ## Structural helpers — the diagonal Cartan action and slot linearity (from banked N213/N272). -/

section QModLocal
-- The N213 weight action `jb_Dg_Xzabc` is stated under the `qMod` scalar instance (`r • x = ocR r
-- * x`); we localise it to these two helpers, whose CONCLUSIONS are in instance-agnostic `ocR`
-- form, so they transport out to the default `cdSmulQ` scalar used everywhere else in this file.
attribute [local instance] qMod

/-- The diagonal Cartan `Dg` acts on the second matter slot by the derived weight (`t0 + t2`), in
    explicit central-scalar (`ocR`) form: `jb (Dg d0 d1 d2) (slotB b) = slotB (ocR (d0+d2) * b)`.
    This is the N213 weight-diagram `jb_Dg_Xzabc` specialised to `slotB` (the `(0,2)`-slot carries
    weight `t0 + t2`), the two zero slots collapsing. -/
theorem jb_Dg_slotB (d0 d1 d2 : ℚ) (b : O ℚ) :
    jb (Dg d0 d1 d2) (slotB b) = slotB (ocR (d0 + d2) * b) := by
  unfold slotB; rw [jb_Dg_Xzabc]; simp only [qsmul_def, mul_zero]

/-- The diagonal Cartan `Dg` acts on the first matter slot by the derived weight (`t0 + t1`):
    `jb (Dg d0 d1 d2) (slotA a) = slotA (ocR (d0+d1) * a)` (N213 `jb_Dg_Xzabc` at `slotA`). -/
theorem jb_Dg_slotA (d0 d1 d2 : ℚ) (a : O ℚ) :
    jb (Dg d0 d1 d2) (slotA a) = slotA (ocR (d0 + d1) * a) := by
  unfold slotA; rw [jb_Dg_Xzabc]; simp only [qsmul_def, mul_zero]

end QModLocal

/-- The Jordan bracket is symmetric (commutative): `jb A B = jb B A`. -/
theorem jb_comm (A B : Matrix (Fin 3) (Fin 3) (O ℚ)) : jb A B = jb B A := by
  unfold jb; rw [add_comm]

/-- The third slot is subtraction-additive: `slotC (x - y) = slotC x - slotC y`. -/
theorem slotC_sub (x y : O ℚ) : slotC (x - y) = slotC x - slotC y := by
  apply Matrix.ext; intro i j
  fin_cases i <;> fin_cases j <;>
    simp [slotC, Xz, Matrix.sub_apply, star_sub]

/-- `star` commutes with the ℚ-scalar action on `O ℚ`: `star (r • a) = r • star a` (componentwise;
    the ℚ-scalar is real, hence self-conjugate). -/
theorem star_qsmul (r : ℚ) (a : O ℚ) : star (r • a) = r • star a := by
  ext <;> simp [cd_qsmul_re, cd_qsmul_im]

/-- The ℚ-scalar identity closing the coupling coefficient: `(d0+d2)•v - (d0+d1)•v = (d2-d1)•v`
    (componentwise over the derived module `O ℚ`). -/
theorem weight_diff_smul (v : O ℚ) (d0 d1 d2 : ℚ) :
    (d0 + d2) • v - (d0 + d1) • v = (d2 - d1) • v := by
  have h : ∀ (z w : O ℚ), z - w = z + (-1 : ℚ) • w := by
    intro z w
    rw [sub_eq_add_neg]; congr 1; ext <;> simp
  rw [h]; ext <;> simp [cd_qsmul_re, cd_qsmul_im, add_re, add_im] <;> ring

/-! ## ★★★ THE HEADLINE — the charge-weight ↔ octonion-coupling identity. -/

set_option maxHeartbeats 800000 in
/-- ★★★ THE CHARGE-WEIGHT ↔ COUPLING IDENTITY. The inner-multiplication commutator of two distinct
    matter-slot multiplications, applied to the diagonal, reads the diagonal position-weight
    DIFFERENCE into the octonion entry-gauge coupling:

        `innerMul (slotA a) (slotB b) (Dg d0 d1 d2) = slotC ((d2 - d1) • (star a * b))`.

    The coefficient `d2 - d1` is a DIFFERENCE of diagonal Cartan coordinates — the N213 trace-zero
    charge-space coordinate (`jb_Dg_Xzabc` grades the slots by `t0+t1 / t0+t2 / t1+t2`). The value
    `star a * b` is the N272 inter-generation octonion coupling (`jb_slotA_slotB`). The inner
    multiplication commutator COUPLES the derived charge-weight axis (N213) to the derived
    non-commutative family-coupling axis (N272) — the axes `framePerm` (position) and `jAct` (entry)
    leave separate (N273).

    THE ONE LAW REFRAME (no octonion coordinate bash): the whole identity dissolves through the
    banked structural lemmas. Flip each inner bracket to `Dg`-first (`jb_comm`), apply the N213
    weight action (`jb_Dg_slotA`/`jb_Dg_slotB`), apply the N272 coupling (`jb_slotA_slotB`) to land
    both terms in `slotC`, factor `slotC` out (`slotC_sub`), and close the octonion coefficient with
    the central-scalar helpers (`ocRmulL`, `qsmul_mul_left/right`, `star_qsmul`) and the ℚ-scalar
    identity (`weight_diff_smul`). -/
theorem innerMul_slot_diag (a b : O ℚ) (d0 d1 d2 : ℚ) :
    innerMul (slotA a) (slotB b) (Dg d0 d1 d2) = slotC ((d2 - d1) • (star a * b)) := by
  rw [innerMul_apply,
      jb_comm (slotB b) (Dg d0 d1 d2), jb_Dg_slotB,
      jb_comm (slotA a) (Dg d0 d1 d2), jb_Dg_slotA,
      jb_slotA_slotB, jb_comm (slotB b) (slotA (ocR (d0 + d1) * a)), jb_slotA_slotB,
      ← slotC_sub]
  congr 1
  rw [ocRmulL, ocRmulL, qsmul_mul_right, star_qsmul, qsmul_mul_left, weight_diff_smul]

/-! ## W8 anti-vacuity — the commutator moves matter that `jAct` and `framePerm` cannot. -/

/-- ★★ W8 NON-VACUITY / THE DIRECTION-MIXING. The inner-multiplication commutator MOVES matter that
    NEITHER the derived gauge `jAct` (diagonal-FIXING, `jAct_Dg = 0`, N268) NOR the family symmetry
    `framePerm` (position-PERMUTING, N273) can produce: at `d1 = 0, d2 = 1, a = b = 1` it yields
    `slotC 1 ≠ 0` — an off-diagonal matter entry SOURCED from a diagonal position-weight split. This
    is the derived direction-mixing operator N273 flagged as the missing S₃-breaking structure. -/
theorem innerMul_moves_diagonal :
    innerMul (slotA 1) (slotB 1) (Dg 0 0 1) ≠ 0 := by
  intro h
  have hentry : (innerMul (slotA 1) (slotB 1) (Dg 0 0 1)) 1 2
      = (0 : Matrix (Fin 3) (Fin 3) (O ℚ)) 1 2 := by rw [h]
  rw [innerMul_slot_diag] at hentry
  simp only [star_one, mul_one, sub_zero, one_smul, slotC_entry, Matrix.zero_apply] at hentry
  have : reQ (1 : O ℚ) = reQ (0 : O ℚ) := by rw [hentry]
  simp only [reQ] at this; norm_num at this

/-! ## The capstone — the derived inner-multiplication structure, cap-bounded at order 3. -/

/-- ★★★ THE CAPSTONE — THE ARENA'S INNER-MULTIPLICATION COMMUTATOR. The Jordan-multiplication
    operator `Lmul A := jb A ·` and its inner commutator `innerMul A B` (a ℚ-linear, antisymmetric
    endomorphism of the arena) satisfy:
      · `innerMul` is antisymmetric (`innerMul_antisymm`);
      · ★ THE CHARGE-WEIGHT ↔ COUPLING IDENTITY
        `innerMul (slotA a)(slotB b)(Dg d0 d1 d2) = slotC ((d2 - d1) • (star a * b))` — the derived
        operator COUPLING the N213 charge-weight difference to the N272 octonion coupling
        (`innerMul_slot_diag`), the octonion-specific headline;
      · the direction-mixing non-vacuity (`innerMul_moves_diagonal` — moves what `jAct`/`framePerm`
        cannot);
      · MAXIMAL at order 3 because the Hermitian octonionic Jordan order is cap-forced at 3
        (`jordan_cap_pinned_at_three` — the order-3 identity holds while order 4 fails,
        `jdef Xwit Ywit ≠ 0`, the octonion-SPECIFIC anchor making this NOT carrier-agnostic).
    The derived operator that mixes the two orthogonal symmetry axes N273 built — DERIVED from the
    banked Jordan product, dissolving the RUNBOOK S₃-breaking blocker without a posit. -/
theorem inner_multiplication_structure :
    (∀ (A B : Matrix (Fin 3) (Fin 3) (O ℚ)), innerMul A B = - innerMul B A)
    ∧ (∀ (a b : O ℚ) (d0 d1 d2 : ℚ),
        innerMul (slotA a) (slotB b) (Dg d0 d1 d2) = slotC ((d2 - d1) • (star a * b)))
    ∧ (innerMul (slotA 1) (slotB 1) (Dg 0 0 1) ≠ 0)
    ∧ ((∀ (d0 d1 d2 : ℚ) (a b c : O ℚ) (e0 e1 e2 : ℚ) (p q r : O ℚ),
          jdef (Hm d0 d1 d2 a b c) (Hm e0 e1 e2 p q r) = 0) ∧ jdef Xwit Ywit ≠ 0) :=
  ⟨innerMul_antisymm, innerMul_slot_diag, innerMul_moves_diagonal, jordan_cap_pinned_at_three⟩

