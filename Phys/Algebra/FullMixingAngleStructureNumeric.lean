/-! ## §1 — the general per-edge survival-dressed overlap machinery over `Cut`.

For an ordered amplitude pair `(A, B)` the C1 survival-dressed frames are `u = (A, B)`,
`d = (A, survivalCut·B)`; the mixing cross-term, aligned inner product, and frame norms are the banked
`mixV` data (N312), and the mixing fraction is the arctan-free Brahmagupta–Fibonacci-normalized `sin²`
of the edge angle. This is exactly the C2 machinery, now abstracted over the pair so it reads across the
three edges. -/

/-- The per-edge mixing cross-term `u∧d = A·B·(1 − survivalCut)` (the C1 keystone shape). -/
def eCross (A B : Cut) : Cut := A * B * (1 - survivalCut)

/-- The up-frame norm `u₀²+u₁² = A²+B²`. -/
def eNu (A B : Cut) : Cut := A ^ 2 + B ^ 2

/-- The survival-dressed down-frame norm `d₀²+d₁² = A²+(survivalCut·B)²`. -/
def eNd (A B : Cut) : Cut := A ^ 2 + (survivalCut * B) ^ 2

/-- The per-edge aligned inner product `u·d = A·A + B·(survivalCut·B)` (the Brahmagupta complement). -/
def eAligned (A B : Cut) : Cut := A * A + B * (survivalCut * B)

/-- ★ The per-edge mixing FRACTION `|V_mix|² = eCross²/(eNu·eNd)` over the derived ℝ (arctan-free). -/
def eMix2 (A B : Cut) : Cut := (eCross A B) ^ 2 / (eNu A B * eNd A B)

/-- The per-edge aligned complement fraction (the `cos²` of the edge angle). -/
def eAln2 (A B : Cut) : Cut := (eAligned A B) ^ 2 / (eNu A B * eNd A B)

theorem eNu_pos (A B : Cut) (hA : 0 < A) : 0 < eNu A B := by
  unfold eNu; nlinarith [pow_pos hA 2, sq_nonneg B]
theorem eNd_pos (A B : Cut) (hA : 0 < A) : 0 < eNd A B := by
  unfold eNd; nlinarith [pow_pos hA 2, sq_nonneg (survivalCut * B)]
theorem eDen_pos (A B : Cut) (hA : 0 < A) : 0 < eNu A B * eNd A B :=
  mul_pos (eNu_pos A B hA) (eNd_pos A B hA)
theorem eCross_pos (A B : Cut) (hA : 0 < A) (hB : 0 < B) : 0 < eCross A B := by
  unfold eCross; rw [survivalCut_val]; nlinarith [mul_pos hA hB]

/-! ## §2 — the free unitarity tooth (arctan-free, Brahmagupta–Fibonacci) for every edge. -/

/-- ★ THE BRAHMAGUPTA–FIBONACCI IDENTITY of the survival-dressed frames (a ring identity over `Cut`),
    for EVERY edge: `eCross² + eAligned² = eNu·eNd`. The algebraic core of each edge's `sin²+cos² = 1`. -/
theorem e_brahmagupta (A B : Cut) :
    (eCross A B) ^ 2 + (eAligned A B) ^ 2 = eNu A B * eNd A B := by
  unfold eCross eAligned eNu eNd; rw [survivalCut_val]; ring

/-- ★★ THE ARCTAN-FREE UNITARITY TOOTH for every edge: `eMix2 A B + eAln2 A B = 1` EXACTLY over the
    derived ℝ — the `sin²+cos² = 1` of each edge angle reproduced from the evaluated fractions. -/
theorem e_unitarity (A B : Cut) (hA : 0 < A) : eMix2 A B + eAln2 A B = 1 := by
  unfold eMix2 eAln2
  rw [← add_div, e_brahmagupta, div_self (ne_of_gt (eDen_pos A B hA))]

/-! ## §3 — ★★★ THE MONOTONE COMPARISON (the C3 heart): the mixing fraction is strictly increasing in
    the sub/leading amplitude ratio. The strict-ordering crux, from which the whole hierarchy follows. -/

/-- ★★★ THE FORCED-ORDERING CRUX. The per-edge mixing fraction is STRICTLY INCREASING in the sub/leading
    amplitude ratio: `eMix2 A₁ B₁ < eMix2 A₂ B₂` whenever the ratio order holds (`A₂²B₁² < A₁²B₂²`, i.e.
    `B₁/A₁ < B₂/A₂`) and the second factor is positive (`survivalCut²B₁²B₂² < A₁²A₂²`, automatic when
    both ratios are `< 1`). The cross-multiplied difference factors EXACTLY as
    `(1 − survivalCut)²·(A₁²B₂² − A₂²B₁²)·(A₁²A₂² − survivalCut²B₁²B₂²)` — a product of the two positive
    factors. This is the theorem that makes the mixing ORDER forced (by the amplitude order) rather than
    an observation of three brackets. -/
theorem eMix2_lt (A1 B1 A2 B2 : Cut) (hA1 : 0 < A1) (hA2 : 0 < A2)
    (hfac1 : A2 ^ 2 * B1 ^ 2 < A1 ^ 2 * B2 ^ 2)
    (hfac2 : (4 / 9) * (B1 ^ 2 * B2 ^ 2) < A1 ^ 2 * A2 ^ 2) :
    eMix2 A1 B1 < eMix2 A2 B2 := by
  unfold eMix2
  rw [div_lt_div_iff₀ (eDen_pos A1 B1 hA1) (eDen_pos A2 B2 hA2)]
  unfold eCross eNu eNd
  rw [survivalCut_val]
  nlinarith [mul_pos (sub_pos.mpr hfac1) (sub_pos.mpr hfac2)]

