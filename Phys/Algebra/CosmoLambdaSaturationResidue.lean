    vacuumResidueDensity M
      = Phys.Algebra.NoDial.selfOverlap (Phys.Algebra.NoDial.selfOverlap (residualScale M)) := by
  rw [vacuumResidueDensity_eq_fourth_power]
  unfold Phys.Algebra.NoDial.selfOverlap; ring

