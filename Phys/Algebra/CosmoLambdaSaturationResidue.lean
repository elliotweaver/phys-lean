    octonion Born-channel count `channelCount = 42 = 1/α*`. The residual coherence is spread over the
    Born channels of the terminal division algebra. -/
def residualScale (M : Cut) : Cut := seesawScale M / channelCount

/-- THE VACUUM RESIDUE DENSITY. The per-channel deepest scale raised to the DERIVED spacetime
    dimension `finrank STV4` (the (1,3) reduction, N-SpacetimeReduction). This is the residue of the
    saturated Born budget — the energy density the C6 eternal approach leaves behind. -/
def vacuumResidueDensity (M : Cut) : Cut := residualScale M ^ (Module.finrank ℚ STV4)

/-- The exponent of the residue density IS the DERIVED spacetime dimension `finrank STV4` (= 4) —
    NOT a posited `4`. The fourth power is the derived carrier dimension of the physical arena. -/
theorem vacuumResidueExponent_eq_spacetimeDim :
    Module.finrank ℚ STV4 = 4 := finrank_STV4

/-- The residue density is the FOURTH POWER of the per-channel scale (unfolding the derived
    dimension `finrank STV4 = 4`). -/
theorem vacuumResidueDensity_eq_fourth_power (M : Cut) :
    vacuumResidueDensity M = residualScale M ^ 4 := by
  unfold vacuumResidueDensity; rw [finrank_STV4]

/-- ★ THE FOURTH POWER IS THE ITERATED BORN SELF-OVERLAP. `ρ_Λ = selfOverlap (selfOverlap m)`: the
