theorem vacuumResidueDensity_pos (M : Cut) (hM : 0 < M) : 0 < vacuumResidueDensity M := by
  unfold vacuumResidueDensity residualScale
  have hs : 0 < seesawScale M := seesawScale_pos M hM
  have hc : (0 : Cut) < channelCount := by rw [channelCount_eq]; norm_num
  rw [finrank_STV4]; positivity

/-- ★ THE RESIDUE IS NOT THE BARE TERM. The observed vacuum energy density `ρ_Λ = vacuumResidueDensity M`
