    ∧ (((Nat.card ↥(levelOccupancy 1) : ℕ) : Cut)
        ≠ censusBottomBand + censusCharmBand + censusLightBand)
    -- (4) the D7 restatement AS 1/α(0)
    ∧ ((1363071880 : Cut) / 10000000 ≤ recomposedEndpoint
        ∧ recomposedEndpoint ≤ 1363071883 / 10000000)
    -- (5) the fold's prediction (kernel-forced landing)
    ∧ recomposedEndpoint < 137
    -- (6) teeth
    ∧ ((1363071880 : Cut) / 10000000 < 1363071883 / 10000000)
    ∧ Nat.card ↥(levelOccupancy 1) ≠ 0 :=
  ⟨mirror_census_composed_zero w,
   mirror_census_count,
   abovefloor_count_distinct,
   augmented_endpoint_restated,
   augmented_endpoint_predicts_below_137,
   augmented_bracket_strict,
   floor_occupancy_ne_zero⟩

end

