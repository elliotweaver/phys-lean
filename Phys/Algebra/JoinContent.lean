    ∧ (0 : Cut) < joinContent w j
    -- (6) the composition lifts the endpoint
    ∧ dressedInvAlphaEM w s bands < dressedInvAlphaEMJoin w s j bands
    -- (7) teeth
    ∧ mirrorMultCensus ≠ 0
    ∧ ((-8 : ℚ) ≠ 0) :=
  ⟨matter_doubling_tear,
   mirror_quasi_degenerate,
   mirrorMultCensus_eq,
   fun j' => joinContent_factor w hw0 hw1 j',
   joinContent_bounded w j R hw0 hw1 hj hR hjR,
   joinContent_pos w j hw0 hw1 hj,
   dressedInvAlphaEMJoin_gt w s j hw0 hw1 hj bands,
   mirrorMultCensus_ne_zero,
   by norm_num⟩

end

end Phys.Algebra.JoinContent
