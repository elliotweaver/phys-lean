/-- ★ THE MIRROR CENSUS IS `3` (from the banked `finrank_TR`): the doubled mirror triplet is a
    genuine 3-dimensional multiplet, so its census is `3`. -/
theorem mirrorMultCensus_eq : mirrorMultCensus = 3 := by
  unfold mirrorMultCensus; rw [finrank_TR]; norm_num

/-- THE MIRROR CENSUS IS POSITIVE (`= 3 > 0`): the join content acts on a genuinely nonzero
    multiplet. -/
theorem mirrorMultCensus_pos : (0 : Cut) < mirrorMultCensus := by
  rw [mirrorMultCensus_eq]; norm_num

/-! ## (B) THE JOIN CONTENT — the mirror census run through the banked D3/Z5 depth dressing. -/

/-- THE JOIN CONTENT at the transmutation join over the derived ℝ: the banked mirror-multiplet census
    (`mirrorMultCensus`) run through the banked Z5 depth dressing (`dressedBandScreen`) at the join
    splitting ratio `j`, at the shared return-surface weight `w` (D3, channel-independent). This is
    the derived census-shift of the join content at the join — a threshold term of the chain's OWN
    content, the census-in-census resummation of the mirror multiplet's contribution. -/
def joinContent (w j : Cut) : Cut := dressedBandScreen w mirrorMultCensus j

/-- ★★ THE JOIN CONTENT FACTORS (Z5 `dressedBandScreen_factor`): the census-in-census dressing factors
    by `/(1 − w)` — the SAME uniform Z5 factoring, now for the join threshold.
    `joinContent w j = bandScreen mirrorMultCensus j / (1 − w)` for `0 ≤ w < 1`. -/
theorem joinContent_factor (w : Cut) (hw0 : 0 ≤ w) (hw1 : w < 1) (j : Cut) :
    joinContent w j = bandScreen mirrorMultCensus j / (1 - w) := by
  unfold joinContent
  exact dressedBandScreen_factor w hw0 hw1 mirrorMultCensus j

/-- ★★★ THE JOIN-CONTENT BOUND (the marquee — quasi-degeneracy IS the ceiling): for a join splitting
    ratio `j` bounded above by any `R` (`1 < j ≤ R`), the join content is bounded by
    `κ(w)·mirrorMultCensus·cutLog R` — a BOUNDED, logarithmically-small threshold refinement. Because
    the doubled mirror triplet `TR` is QUASI-DEGENERATE with `TL` (equal Casimir, `mirror_quasi_degenerate`),
    the join splitting ratio sits near `1`, so this threshold term grows only logarithmically in the
    join span. The twin of D8's census-conservation ceiling: a finite mirror census (`= 3`) caps the
    join content's screening. -/
theorem joinContent_bounded (w j R : Cut) (hw0 : 0 ≤ w) (hw1 : w < 1)
    (hj : 1 < j) (hR : 1 < R) (hjR : j ≤ R) :
    joinContent w j ≤ kappaLeadingDressed w * mirrorMultCensus * cutLog R := by
  unfold joinContent dressedBandScreen
  have hkw : 0 ≤ kappaLeadingDressed w * mirrorMultCensus := by
    apply mul_nonneg
    · rw [kappaLeadingDressed_eq_div w hw0 hw1]
      have h1w : (0 : Cut) < 1 - w := by linarith
      exact le_of_lt (div_pos kappaLeading_pos h1w)
    · rw [mirrorMultCensus_eq]; norm_num
  have hlog : cutLog j ≤ cutLog R := cutLog_mono (by linarith) hjR
  exact mul_le_mul_of_nonneg_left hlog hkw

/-- ★★ THE JOIN CONTENT IS POSITIVE (the matter sense): for a genuine join splitting `1 < j` and a
    dressing weight `0 ≤ w < 1`, `0 < joinContent w j`. The doubled mirror triplet `TR ⊂ ImO` is a
    submodule of the MATTER carrier, so its census sense is POSITIVE (matter screens up — the banked
    matter/gather dichotomy, Z1). The join content genuinely screens, not a null step. -/
theorem joinContent_pos (w j : Cut) (hw0 : 0 ≤ w) (hw1 : w < 1) (hj : 1 < j) :
    (0 : Cut) < joinContent w j := by
  rw [joinContent_factor w hw0 hw1]
  unfold bandScreen
  have h1w : (0 : Cut) < 1 - w := by linarith
  have hnum : (0 : Cut) < kappaLeading * mirrorMultCensus * cutLog j := by
    have hc : (0 : Cut) < mirrorMultCensus := mirrorMultCensus_pos
    have hlog : (0 : Cut) < cutLog j := cutLog_pos hj
    exact mul_pos (mul_pos kappaLeading_pos hc) hlog
  exact div_pos hnum h1w

/-! ## (C) THE COMPOSITION — the join threshold composed onto the D2c dressed recombined endpoint. -/

/-- ★ THE RECOMBINED DRESSED ENDPOINT WITH THE JOIN CONTENT COMPOSED over the derived ℝ: the D2c
    per-channel dressed recombined coupling PLUS the derived join-content threshold at the
    transmutation join. `dressedInvAlphaEMJoin w s j bands := dressedInvAlphaEM w s bands +
    joinContent w j`. -/
def dressedInvAlphaEMJoin (w s j : Cut) (bands : List (Cut × Cut)) : Cut :=
  dressedInvAlphaEM w s bands + joinContent w j

/-- ★★ THE COMPOSED SPLIT: the join-composed endpoint reads EXACTLY the D2c dressed recombined
    endpoint PLUS the join-content summand — a genuine partial sum plus an additive threshold term. -/
theorem dressedInvAlphaEMJoin_split (w s j : Cut) (bands : List (Cut × Cut)) :
    dressedInvAlphaEMJoin w s j bands = dressedInvAlphaEM w s bands + joinContent w j := rfl

/-- ★★★ THE JOIN CONTENT GENUINELY LIFTS THE ENDPOINT: for a genuine join splitting `1 < j`, the
    join-composed endpoint STRICTLY EXCEEDS the join-free D2c dressed recombined endpoint. The join
    content is a real (positive, matter-sense) refinement — the composition is not a null step. -/
theorem dressedInvAlphaEMJoin_gt (w s j : Cut) (hw0 : 0 ≤ w) (hw1 : w < 1) (hj : 1 < j)
    (bands : List (Cut × Cut)) :
    dressedInvAlphaEM w s bands < dressedInvAlphaEMJoin w s j bands := by
  rw [dressedInvAlphaEMJoin_split]
  have hpos := joinContent_pos w j hw0 hw1 hj
  linarith

/-- ★★ THE COMPOSED BOUNDED INCREMENT: for a join splitting bounded by `R` (`1 < j ≤ R`), the
    join-composed endpoint exceeds the D2c dressed recombined endpoint by AT MOST the bounded
    increment `κ(w)·mirrorMultCensus·cutLog R` — the join content lifts the endpoint by only a
    bounded logarithmic threshold term (quasi-degeneracy), never a large gap. -/
theorem dressedInvAlphaEMJoin_bounded (w s j R : Cut) (hw0 : 0 ≤ w) (hw1 : w < 1)
    (hj : 1 < j) (hR : 1 < R) (hjR : j ≤ R) (bands : List (Cut × Cut)) :
    dressedInvAlphaEMJoin w s j bands
      ≤ dressedInvAlphaEM w s bands + kappaLeadingDressed w * mirrorMultCensus * cutLog R := by
  rw [dressedInvAlphaEMJoin_split]
  have hb := joinContent_bounded w j R hw0 hw1 hj hR hjR
  linarith

/-- ★★ THE JOIN COMPOSED AT THE DERIVED WEIGHT: the shared dressing weight is D3's derived
    return-surface geometry `depthWeight = 1/3` (channel-independent, the SAME weight that dresses the
