      have : (0 : Cut) < 5969 / 100 := by norm_num
      linarith
    apply cutLog_le_certified (1 / mbRatioDerived) (41 / 10) 10 (by norm_num) hc
    calc (1 : Cut) / mbRatioDerived ≤ 5971 / 100 := hhi
      _ ≤ partialExp (41 / 10 : Cut) 10 := upper_certifies

