  unfold partialExp expRemBound expTermC
  simp only [Finset.sum_range_succ, Finset.sum_range_zero]
  norm_num [Nat.factorial]

/-- THE LOWER CERTIFICATION INEQUALITY: `7579/135 ≤ 5969/100` — the exp upper bracket at `4` lands
