    calc partialExp (4 : Cut) 6 + expRemBound (4 : Cut) 6 = 7579 / 135 := lower_waypoint
      _ ≤ 5969 / 100 := lower_certifies
      _ ≤ 1 / mbRatioDerived := hlo
  · -- cutLog (1/mbRatioDerived) ≤ 41/10: 1/mbRatioDerived ≤ exp lower bracket at 41/10
