    (4 : Cut) ≤ cutLog (1 / mbRatioDerived) ∧ cutLog (1 / mbRatioDerived) ≤ 41 / 10 := by
  obtain ⟨hlo, hhi⟩ := invMbRatio_bracket
  refine ⟨?_, ?_⟩
  · -- 4 ≤ cutLog (1/mbRatioDerived): exp upper bracket at 4 lands ≤ 1/mbRatioDerived
