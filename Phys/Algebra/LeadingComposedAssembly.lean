            (freezeoutTail (edgeBottom Mu Md) (edgeCharm Mu Md) (edgeLight Md (Mlam ^ 2)))
      = 112
        + (chargeTraceDepth - projectedS) * totalScreeningWith 1 (completeBandList chargeTraceDepth)
        + (16 / 9
          + kappaLeading * ((7 / 3) * cutLog mbRatioDerived + (11 / 3) * cutLog (bMass 0)
            - (5 / 3) * cutLog (bMass 2))))
    -- (2) the leading-κ = dressed-at-w=0 identity
    ∧ (invAlphaEM (completeBandList chargeTraceDepth)
          - projectedS * totalScreeningWith 1 (completeBandList chargeTraceDepth)
        = dressedInvAlphaEM 0 projectedS (completeBandList chargeTraceDepth))
    -- (3) the composition inventory
    ∧ invAlphaEM (completeBandList chargeTraceDepth)
        = invAlphaZero (completeBandList chargeTraceDepth) + 70
    ∧ projectedS = 1 / 8
    ∧ joinContent depthWeight joinSplitRatio = 0
    -- (4) the completeness attestation: the ONE uncomposed summand's floor rung derived exactly
    ∧ Nat.card ↥(levelOccupancy 1) = 16
    -- (5) teeth
    ∧ (0 : Cut) < projectedS * totalScreeningWith 1 (completeBandList chargeTraceDepth)
    ∧ Nat.card ↥(levelOccupancy 1) ≠ 0 :=
  ⟨composed_leading_closed Mu Md Mlam hu hd hl hud huc,
   leading_is_dressed_at_w0 projectedS,
   recombination_composed,
   antiscreen_composed,
   join_contributes_zero depthWeight,
   floorOccupancy_eq_sixteen,
   antiscreen_positive,
   bornweight_floor_nonzero⟩

end

end Phys.Algebra.LeadingComposedAssembly
