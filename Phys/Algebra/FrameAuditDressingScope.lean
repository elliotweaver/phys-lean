    sits; the fit `s ≈ 1.9` / the band-varying window `(13/9, 40/27)` named ONLY to be EXCLUDED. -/
theorem frameAuditDressingScope_landing (lowTail : List (Cut × Cut)) (b : Cut × Cut)
    (hb : bandScreen b.1 b.2 ≠ 0) :
    -- (1) SCOPE-(a) is way-point-forbidden (moves both), leading reproduces both
    ((42 : Cut) + totalScreening [(chargeTraceDepth, topBandRatio)] / (1 - depthWeight) = 602 / 9
        ∧ (602 / 9 : Cut) ≠ 1582 / 27)
    ∧ (dressedInvAlphaZero depthWeight derivedBandList = 74 ∧ (74 : Cut) ≠ 190 / 3)
    ∧ (invAlphaZero [(chargeTraceDepth, topBandRatio)] = 1582 / 27
        ∧ invAlphaZero derivedBandList = 190 / 3)
    -- (2) SCOPE-(b) collapses to the single fold constant; the per-band slot is a fold-fixed knob
    ∧ (bandVaryingScreen (withWeight depthWeight lowTail) = 3 / 2 * totalScreening lowTail)
    ∧ (bandVaryingScreen [(0, b)] ≠ bandVaryingScreen [(depthWeight, b)])
    -- (3) SCOPE-(c) forced closed form + base exemption + base is resummed content
    ∧ (recomposedEndpointDressed = 2425 / 18 + (3 / 2) * kappaLeading * cInner)
    ∧ (recomposedEndpointDressed - (3 / 2) * kappaLeading * cInner = 2425 / 18)
    ∧ ((2425 : Cut) / 18 = 7179 / 54 + 16 / 9)
    -- (4) the F1↔F2 tie: the weight is channel-independent
    ∧ (depthWeight = 1 / 3 ∧ depthWeight ≠ 0 ∧ depthWeight ≠ 1)
    -- (5) teeth
    ∧ ((602 / 9 : Cut) ≠ 1582 / 27 ∧ (602 / 9 : Cut) ≠ 2425 / 18 ∧ (1582 / 27 : Cut) ≠ 2425 / 18)
    ∧ (PerChannelRecomb.recomposedEndpoint < recomposedEndpointDressed) :=
  ⟨scopeA_moves_topBand,
   scopeA_moves_conf,
   shared_waypoints,
   scopeB_collapses lowTail,
   scopeB_knob_real b hb,
   scopeC_closed,
   scopeC_exempts_base,
   exempt_base_is_resummed,
   weight_channel_independent,
   scopes_distinct_topBand,
   scopeC_dresses⟩

end

