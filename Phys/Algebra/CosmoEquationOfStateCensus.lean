/-! ## The perfect-fluid mixed (1,1) stress on the derived (1,3) arena. -/

/-- THE PERFECT-FLUID STRESS in MIXED (1,1) form `T^μ_ν = diag(ρ, −P, −P, −P)` on the banked
    physical `(1,3)` arena `STV4 = ℚ × ℚ × Dbl ℚ` (N419): the density `ρ` on the ONE timelike
    coordinate, the pressure `−P` on the THREE spacelike coordinates (`x` plus the two ℂ-rung
    coordinates). The `−P` sign IS the fold's indefinite signature — the same signature that gave
    the banked H4 its `w = −1`. Written as a `prodMap` of scalar multiples of the identity, so both
    the diagonal readings and the endomorphism trace fall out cleanly. -/
def pfStress (rho P : ℚ) : STV4 →ₗ[ℚ] STV4 :=
  LinearMap.prodMap (rho • LinearMap.id) ((-P) • LinearMap.id)

/-- THE TIMELIKE DIAGONAL READING (the "density"): the timelike component of the stress applied to
    the pure-time direction. -/
def eosDensity (S : STV4 →ₗ[ℚ] STV4) : ℚ := (S (1, 0, 0)).1

/-- THE SPACELIKE DIAGONAL READING (the "pressure"): minus the spacelike component of the stress
    applied to a pure-space direction — the sign undoing the signature's `−P`. -/
def eosPressure (S : STV4 →ₗ[ℚ] STV4) : ℚ := -(S (0, 1, 0)).2.1

/-- THE EQUATION OF STATE `w = P/ρ`. -/
def eosState (S : STV4 →ₗ[ℚ] STV4) : ℚ := eosPressure S / eosDensity S

/-! ## The readings on the perfect-fluid stress. -/

/-- The density reading of `pfStress ρ P` is `ρ`. -/
theorem eosDensity_pf (rho P : ℚ) : eosDensity (pfStress rho P) = rho := by
  simp [eosDensity, pfStress, LinearMap.prodMap_apply]

/-- The pressure reading of `pfStress ρ P` is `P` (the `−` in the reading undoes the signature `−P`). -/
theorem eosPressure_pf (rho P : ℚ) : eosPressure (pfStress rho P) = P := by
  simp [eosPressure, pfStress, LinearMap.prodMap_apply]

/-- ★ THE EQUATION OF STATE of `pfStress ρ P` is `P/ρ` — one division, valid for every component. -/
theorem eosState_pf (rho P : ℚ) : eosState (pfStress rho P) = P / rho := by
  rw [eosState, eosDensity_pf, eosPressure_pf]

/-! ## The census values — the three canonical cosmic components. -/

/-- ★ DUST (pressureless matter): `w = 0`. The pressure reading is `0`, so the quotient is `0`. -/
theorem eos_dust (rho : ℚ) : eosState (pfStress rho 0) = 0 := by
  rw [eosState_pf]; simp

/-- ★ RADIATION: at `P = ρ/3` the equation of state is `w = 1/3` (for `ρ ≠ 0`). The `1/3` is the
    dimension-locked value — see `eos_radiation_from_traceless` for its forced-by-tracelessness form. -/
theorem eos_radiation (rho : ℚ) (h : rho ≠ 0) : eosState (pfStress rho (rho / 3)) = 1 / 3 := by
  rw [eosState_pf]; field_simp

/-- ★ VACUUM (dark energy): at `P = −ρ` the equation of state is `w = −1` (for `ρ ≠ 0`) — the same
    value the banked H4 derived from the fold signature, here on the reduced `(1,3)` arena. -/
theorem eos_vacuum (rho : ℚ) (h : rho ≠ 0) : eosState (pfStress rho (-rho)) = -1 := by
  rw [eosState_pf]; field_simp

/-! ## The trace — the dimension-lock (the moat). -/

/-- ★★★ THE TRACE WITH THE DERIVED DIMENSION. The ordinary endomorphism trace of the mixed (1,1)
    stress (the physical `T^μ_μ`) is `ρ − (dim of the spacelike block)·P`, where the spacelike block
    is the DERIVED `ℚ × Dbl ℚ`. The dimension is not put in by hand — it is `finrank` of the derived
    space. -/
theorem eos_trace_dim (rho P : ℚ) :
    LinearMap.trace ℚ STV4 (pfStress rho P)
      = rho - (Module.finrank ℚ (ℚ × Dbl ℚ) : ℚ) * P := by
  unfold pfStress
  rw [LinearMap.trace_prodMap', map_smul, map_smul, LinearMap.trace_id, LinearMap.trace_id,
      Module.finrank_self]
  simp only [smul_eq_mul]; push_cast; ring

/-- `finrank ℚ (ℚ × Dbl ℚ) = 3` — the spacelike block's dimension. -/
theorem spacelike_block_finrank : Module.finrank ℚ (ℚ × Dbl ℚ) = 3 := by
  rw [Module.finrank_prod, finrank_dbl_eq_two, Module.finrank_self]

/-- ★★★ THE DIMENSION-LOCK ANCHOR. The spacelike block `ℚ × Dbl ℚ` (whose dimension is the trace's
    `P`-coefficient) has the SAME dimension as the banked negative-definite spatial subspace
    `spaceSub4` of the derived `(1,3)` reduction (N419, `finrank_spaceSub4 = 3`). So the `3` in the
    trace is the DERIVED physical spacelike dimension, not a chosen input. -/
theorem spacelike_block_eq_spaceSub4_dim :
    Module.finrank ℚ (ℚ × Dbl ℚ) = Module.finrank ℚ spaceSub4 := by
  rw [spacelike_block_finrank, finrank_spaceSub4]

/-- THE TRACE at the banked dimension: `trace (pfStress ρ P) = ρ − 3·P`. -/
theorem eos_trace (rho P : ℚ) : LinearMap.trace ℚ STV4 (pfStress rho P) = rho - 3 * P := by
  rw [eos_trace_dim, spacelike_block_finrank]; push_cast; ring

/-- TRACELESSNESS FORCES `ρ = 3·P` (`= n·P` with `n` the derived spacelike dimension). This is the
    fold's replacement for the textbook "traceless in 3+1 ⟹ ρ = 3P": the `3` is `finrank spaceSub4`. -/
theorem traceless_forces (rho P : ℚ) (h : LinearMap.trace ℚ STV4 (pfStress rho P) = 0) :
    rho = 3 * P := by
  rw [eos_trace] at h; linarith

/-- ★★★ THE DIMENSION-LOCKED RADIATION EQUATION OF STATE. A TRACELESS stress (physical `T^μ_μ = 0`)
    on the derived `(1,3)` arena has `w = 1/3 = 1/n`, where `n = 3` is the DERIVED spacelike
    dimension (`= finrank spaceSub4`, N419). On the ambient octonionic `(1,9)` this would be `1/9`;
    the physical `1/3` is FORCED by the fold's `(1,3)` reduction, never inserted. -/
theorem eos_radiation_from_traceless (rho P : ℚ) (hr : rho ≠ 0)
    (h : LinearMap.trace ℚ STV4 (pfStress rho P) = 0) : eosState (pfStress rho P) = 1 / 3 := by
  rw [eosState_pf]
  have := traceless_forces rho P h
  field_simp
  linarith

/-! ## The trace-signatures of the three components (the census weld). -/

/-- The DUST trace-signature: `trace (pfStress ρ 0) = ρ` — no cancellation (`P = 0`). -/
theorem trace_dust (rho : ℚ) : LinearMap.trace ℚ STV4 (pfStress rho 0) = rho := by
  rw [eos_trace]; ring

/-- The VACUUM trace-signature: `trace (pfStress ρ (−ρ)) = 4·ρ = ρ·(dim of spacetime)` — the full
    spacetime dimension `4` (`finrank_STV4`), because the vacuum stress is `ρ•id`. -/
theorem trace_vac (rho : ℚ) : LinearMap.trace ℚ STV4 (pfStress rho (-rho)) = 4 * rho := by
  rw [eos_trace]; ring

/-- ★ THE VACUUM STRESS IS PROPORTIONAL TO THE IDENTITY: `pfStress ρ (−ρ) = ρ•id`. The `P = −ρ`
    case makes the spacelike block `−(−ρ)•id = ρ•id`, matching the timelike `ρ•id` — the stress is
    Lorentz-invariant (`∝ id`), the hallmark of the vacuum. Its trace is therefore `ρ · dim`. -/
theorem vacuum_eq_smul_id (rho : ℚ) : pfStress rho (-rho) = rho • LinearMap.id := by
  unfold pfStress; ext p <;> simp

/-- `finrank ℚ STV4 = 4` — the derived spacetime dimension (the vacuum trace count `4ρ = ρ·4`). -/
theorem finrank_STV4 : Module.finrank ℚ STV4 = 4 := by
  simp [STV4, Module.finrank_prod, finrank_dbl_eq_two]

/-! ## W8 anti-vacuity. -/

/-- ★ W8: the three census values are GENUINELY DISTINCT — `1/3 ≠ 0` (radiation ≠ dust),
    `1/3 ≠ −1` (radiation ≠ vacuum), `0 ≠ −1` (dust ≠ vacuum). The census is not a hollow
    conjunction of equal values. -/
theorem eos_census_values_distinct :
    (1 / 3 : ℚ) ≠ 0 ∧ (1 / 3 : ℚ) ≠ -1 ∧ (0 : ℚ) ≠ -1 := by
  refine ⟨?_, ?_, ?_⟩ <;> norm_num

/-- ★★ W8: THE PRESSURE SIGN IS LOAD-BEARING. Dropping the signature `−` (using the naive `P•id`
    spatial block, `pfStress ρ (−P)`) would make the pressure reading `−P` instead of `P`, sending
    the vacuum `P = −ρ` to a WRONG `w = +1` (a stiff fluid) rather than `w = −1`. Concretely the
    density and pressure readings of the sign-flipped map differ from the census: the reading
    `eosPressure (pfStress ρ (−P)) = −P ≠ P` whenever `P ≠ 0`. The signature `−` is genuinely at
    work — the census is not sign-agnostic. -/
theorem pressure_sign_load_bearing (rho P : ℚ) (hP : P ≠ 0) :
    eosPressure (pfStress rho (-P)) ≠ eosPressure (pfStress rho P) := by
  rw [eosPressure_pf, eosPressure_pf]
  intro h
  apply hP
  linarith

/-! ## The capstone — the equation-of-state census. -/

/-- ★★★ THE EQUATION-OF-STATE CENSUS (bundled). The three canonical cosmic components are the three
    values the ONE signature-diagonal reading takes on the derived `(1,3)` arena, welded by their
    endomorphism trace-signatures (NOT a bare ∧ — each conjunct is a distinct trace-signature of the
    ONE `pfStress`, and the radiation value is the dimension-locked `1/n`):
      • DUST (`P = 0`): `w = 0`, trace `= ρ` (no cancellation);
      • RADIATION (traceless, `ρ = 3P`): `w = 1/3 = 1/n` with `n = finrank spaceSub4` DERIVED,
        trace `= 0`;
      • VACUUM (`P = −ρ`, `T = ρ•id`): `w = −1`, trace `= 4ρ = ρ·finrank STV4`.
    The dimension-lock `finrank (ℚ×Dbl ℚ) = finrank spaceSub4` ties the radiation `1/3` to the
    DERIVED physical spacelike dimension. NON-HOLLOW: the three w-values are distinct
    (`eos_census_values_distinct`) and the pressure sign is load-bearing
    (`pressure_sign_load_bearing`). THEOREM-route; the physical component names carry ZERO logical
    weight (words-removable). -/
theorem equation_of_state_census (rho : ℚ) (h : rho ≠ 0) :
    -- DUST: w = 0, trace ρ
    (eosState (pfStress rho 0) = 0 ∧ LinearMap.trace ℚ STV4 (pfStress rho 0) = rho)
    -- RADIATION: traceless ⟹ w = 1/n, n the DERIVED spacelike dim
    ∧ (∀ P, LinearMap.trace ℚ STV4 (pfStress rho P) = 0 → eosState (pfStress rho P) = 1 / 3)
    ∧ Module.finrank ℚ (ℚ × Dbl ℚ) = Module.finrank ℚ spaceSub4
    -- VACUUM: w = −1, T ∝ id, trace ρ·dim
    ∧ (eosState (pfStress rho (-rho)) = -1 ∧ pfStress rho (-rho) = rho • LinearMap.id
        ∧ LinearMap.trace ℚ STV4 (pfStress rho (-rho)) = 4 * rho)
    -- NON-HOLLOW: distinct values, load-bearing sign
    ∧ ((1 / 3 : ℚ) ≠ 0 ∧ (1 / 3 : ℚ) ≠ -1 ∧ (0 : ℚ) ≠ -1) := by
  refine ⟨⟨eos_dust rho, trace_dust rho⟩, ?_, spacelike_block_eq_spaceSub4_dim,
    ⟨eos_vacuum rho h, vacuum_eq_smul_id rho, trace_vac rho⟩, eos_census_values_distinct⟩
  intro P hP
  exact eos_radiation_from_traceless rho P h hP

end

