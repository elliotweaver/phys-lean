/-! ## (B) THE `cutLog` DISSOLUTION HELPERS (derived from the banked homomorphism laws). -/

/-- THE INVERSE LOG LAW: `cutLog (1/a) = − cutLog a` for `0 < a` (from `cutLog_mul` + `cutLog_one`). -/
theorem cutLog_inv_pos {a : Cut} (ha : 0 < a) : cutLog (1 / a) = - cutLog a := by
  have hinv : 0 < 1 / a := by positivity
  have h : cutLog (1 / a) + cutLog a = 0 := by
    rw [← cutLog_mul hinv ha, one_div, inv_mul_cancel₀ (ne_of_gt ha), cutLog_one]
  linarith

/-- THE QUOTIENT LOG LAW: `cutLog (a/b) = cutLog a − cutLog b` for `0 < a`, `0 < b`. -/
theorem cutLog_div_pos {a b : Cut} (ha : 0 < a) (hb : 0 < b) :
    cutLog (a / b) = cutLog a - cutLog b := by
  rw [div_eq_mul_inv, cutLog_mul ha (by positivity), ← one_div, cutLog_inv_pos hb]
  ring

