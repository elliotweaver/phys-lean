    -- (1) the gem: the confinement rung's π cancels
    kappaLeading * 2 * (8 * cutPi / 3) = 16 / 9
    -- (2) the dissolution at the pinned edges
    ∧ totalScreening (freezeoutTail (edgeBottom Mu Md) (edgeCharm Mu Md) (edgeLight Md (Mlam ^ 2)))
        = 16 / 9
          + kappaLeading * ((7 / 3) * cutLog mbRatioDerived + (11 / 3) * cutLog (bMass 0)
            - (5 / 3) * cutLog (bMass 2))
    -- (3) the determined composed endpoint (no free parameter remains)
    ∧ dressedInvAlphaEMJoin depthWeight projectedS joinSplitRatio (completeBandList chargeTraceDepth)
          + totalScreening
              (freezeoutTail (edgeBottom Mu Md) (edgeCharm Mu Md) (edgeLight Md (Mlam ^ 2)))
        = 112
          + ((chargeTraceDepth - projectedS)
              * totalScreeningWith 1 (completeBandList chargeTraceDepth)) / (1 - depthWeight)
          + (16 / 9
            + kappaLeading * ((7 / 3) * cutLog mbRatioDerived + (11 / 3) * cutLog (bMass 0)
              - (5 / 3) * cutLog (bMass 2)))
    -- (4) teeth
    ∧ (16 / 9 : Cut) ≠ 0
    ∧ ((16 / 9
        + kappaLeading * ((7 / 3) * cutLog mbRatioDerived + (11 / 3) * cutLog (bMass 0)
          - (5 / 3) * cutLog (bMass 2)))
      - kappaLeading * ((7 / 3) * cutLog mbRatioDerived + (11 / 3) * cutLog (bMass 0)
          - (5 / 3) * cutLog (bMass 2))
      = 16 / 9) :=
  ⟨confinement_rung_rational,
   freezeout_at_pinned_dissolved Mu Md Mlam hu hd hl hud huc,
   composed_endpoint_determined Mu Md Mlam hu hd hl hud huc,
   gem_nonzero,
   dissolved_uses_confinement⟩

end

end Phys.Algebra.ComposedFreezeoutDissolved
