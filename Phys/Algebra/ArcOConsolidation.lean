theorem arcO_consolidation (a : Cut) (t x : ℚ) :
    (foldPhase = azimuthalTurn / 16
      ∧ (2 : Cut) * foldPhase = azimuthalTurn / 8
      ∧ criticalPhaseNumerator = azimuthalTurn * 42
      ∧ gravCouplingCoeff = azimuthalTurn * 4
      ∧ unruhPeriod a = azimuthalTurn / a)
