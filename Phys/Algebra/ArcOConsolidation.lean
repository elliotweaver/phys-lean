theorem emc2_diag (t x : ℚ) : massSq (t, x, (0 : Dbl ℚ)) = Q4 t x 0 := by
  rw [massSq_eq_Q4v]; rfl

/-- ★ NEW TIE. The O7 equivalence-principle mass channel IS the O5 E=mc² invariant on the plane:
