theorem ep_is_emc2 (t x : ℚ) : massForm2 t x = massSq (t, x, (0 : Dbl ℚ)) := by
  rw [massForm2_eq_Q4, emc2_diag]

/-- ★ NEW TIE. The O4 octonionic (1,9) form on the embedded plane IS the O5 E=mc² invariant:
