    massSq (t, x, (0 : Dbl ℚ)) = Q4 t x 0
    ∧ massForm2 t x = massSq (t, x, (0 : Dbl ℚ))
    ∧ Qv (emb4 (t, x, (0 : Dbl ℚ))) = massSq (t, x, (0 : Dbl ℚ)) :=
  ⟨emc2_diag t x, ep_is_emc2 t x, oct19_restricts_to_emc2 t x⟩

