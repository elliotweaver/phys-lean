    ∧ (((49 / 2 : Cut) ≤ lightBandStrange ∧ lightBandStrange ≤ 1227 / 50)
        ∧ ((118 / 1000 : Cut) ≤ lightBandDown ∧ lightBandDown ≤ 119 / 1000))
    -- (M7) the web closes non-hollow
    ∧ ((((237943 : Cut) / 100000 * (237943 / 100000)
          + (4034 : Cut) / 100000 * (4034 / 100000)
          + (5802 : Cut) / 10000 * (5802 / 10000) < 6)
        ∧ ((6 : Cut)
          < (237944 : Cut) / 100000 * (237944 / 100000)
            + (40365 : Cut) / 1000000 * (40365 / 1000000)
            + (58022 : Cut) / 100000 * (58022 / 100000)))
      ∧ ((448 / 27 : Cut) ≠ 128 / 27)) :=
  ⟨peg_unique_up_to_units,
   ⟨absMass0_bracket, absMass_ratios_reproduce_N340⟩,
   ⟨confBandRatio_bracket, confBand_128_27_free⟩,
   ⟨topBandRatio_bracket, tower_ratio_composition⟩,
