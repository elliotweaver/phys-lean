        ∧ (167505 / (10 : Cut) ^ 7 : Cut) < 167522 / (10 : Cut) ^ 7)
    -- M6 light (two brackets + two widths)
    ∧ ((((49 / 2 : Cut) ≤ lightBandStrange ∧ lightBandStrange ≤ 1227 / 50)
        ∧ ((118 / 1000 : Cut) ≤ lightBandDown ∧ lightBandDown ≤ 119 / 1000))
      ∧ ((49 / 2 : Cut) < 1227 / 50 ∧ (118 / 1000 : Cut) < 119 / 1000)) := by
  refine ⟨⟨absMass0_bracket, absMass1_bracket, absMass2_bracket, ?_⟩,
          ⟨confBandRatio_bracket, by norm_num⟩,
          ⟨topBandRatio_bracket, by norm_num⟩,
