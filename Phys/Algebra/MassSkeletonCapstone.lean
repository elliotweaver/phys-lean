    ∧ (((167505 / (10 : Cut) ^ 7 ≤ mbRatioDerived ∧ mbRatioDerived ≤ 167522 / (10 : Cut) ^ 7))
        ∧ downConfBundle = mbRatioDerived * confBandRatio)
