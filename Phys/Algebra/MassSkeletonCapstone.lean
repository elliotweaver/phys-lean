    light strange placement all inherit their certified brackets scaled by the ONE positive `p.val`.
    NO second dimensionful input appears anywhere in the skeleton. -/
theorem onePeg_law :
    (∀ p q : UnitPeg, ∃ c : Cut, 0 < c ∧ ∀ x, q.human x = c * p.human x)
    ∧ (∀ p : UnitPeg, p.val * (50535 / (10 : Cut) ^ 17) ≤ p.human absMass0
        ∧ p.human absMass0 ≤ p.val * (50565 / (10 : Cut) ^ 17))
    ∧ (∀ p : UnitPeg, p.val * (42408 / (10 : Cut) ^ 21) ≤ p.human confinementScaleRatio
        ∧ p.human confinementScaleRatio ≤ p.val * (42414 / (10 : Cut) ^ 21))
    ∧ (∀ p : UnitPeg, p.val * (167505 / (10 : Cut) ^ 7) ≤ p.human mbRatioDerived
        ∧ p.human mbRatioDerived ≤ p.val * (167522 / (10 : Cut) ^ 7))
    ∧ (∀ p : UnitPeg, p.val * (49 / 2 : Cut) ≤ p.human lightBandStrange
        ∧ p.human lightBandStrange ≤ p.val * (1227 / 50 : Cut)) :=
  ⟨peg_unique_up_to_units, pegged_absMass0_bracket, pegged_confinementScale_bracket,
   pegged_mbRatio_bracket, pegged_lightBandStrange_bracket⟩

