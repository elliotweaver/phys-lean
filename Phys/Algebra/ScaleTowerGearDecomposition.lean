  rw [mbBornRatio, s1BornProb_value]

/-! ## (C) THE GEAR SELECTION: S1 admissible (rational self-overlap), S2 EMPTY (irrational). -/

/- The level-2 (S2) gear amplitude `3^{−1/4}` has Born probability `(3^{−1/4})² = 3^{−1/2} = 1/√3`.
   Its rationality is equivalent to `∃ x : ℚ, x² = 1/3` (`1/√3 = x ⟺ x² = 1/3`). -/

/-- `3` is not a rational square (√3 irrational, via `Nat.prime_three.not_isSquare`) — the
    ℚ-only kernel of the S2 exclusion. -/
theorem three_not_isSquare_rat : ¬ IsSquare (3 : ℚ) := by
  rw [show (3 : ℚ) = ((3 : ℕ) : ℚ) by norm_num, Rat.isSquare_natCast_iff]
  exact (Nat.prime_three).not_isSquare

/-- ★ NO RATIONAL SQUARES TO `3`: there is no `q : ℚ` with `q² = 3`. -/
theorem no_rat_sqrt_three : ¬ ∃ q : ℚ, q ^ 2 = 3 := by
  rintro ⟨q, hq⟩
  exact three_not_isSquare_rat ⟨q, by rw [← hq]; ring⟩

/-- ★★ THE S2 GEAR-SEARCH IS EMPTY: the S2 gear's Born probability `1/√3` is IRRATIONAL — there is
    NO `x : ℚ` with `x² = 1/3`, so no rational self-overlap of the banked cycle realizes the S2 gear.
    (Selection: S1's Born probability is rational and banked; S2's is not even rational.) -/
theorem s2_gear_search_empty : ¬ ∃ x : ℚ, x ^ 2 = 1 / 3 := by
  rintro ⟨x, hx⟩
  have hx0 : x ≠ 0 := by rintro rfl; norm_num at hx
  refine no_rat_sqrt_three ⟨1 / x, ?_⟩
  field_simp
  rw [hx]; ring

/-- ★★★ THE GEAR SELECTION (arc-M M2 selection theorem): S1 is SELECTED — its Born probability is
    RATIONAL and EQUALS the banked self-blind survival `tr Poth / 3 = 2/3`; while the S2 gear-search
