/-! ## (A) ENUMERATION — the census BUDGET is cap-forced and exhausted by the finite band list. -/

/-- ★★★ THE CENSUS BUDGET IS THE CAP-FORCED COUNT APPLIED TO THE LADDER TRACE: `chargeTraceDepth =
    ((ladderChargeTrace (finrank ℚ Uhol) : ℚ) : Cut)` with `finrank ℚ Uhol = 3`. The screening tower's
    total charge-census budget is literally the cap-forced generation count (N42c) fed to the banked
    ladder second moment (N317). The count is FORCED (not chosen) — the finite band list is THE
    threshold set the fold's finite matter content admits, ENUMERATED not posited. -/
theorem census_budget_cap_forced :
    chargeTraceDepth = ((ladderChargeTrace (Module.finrank ℚ Uhol) : ℚ) : Cut)
    ∧ Module.finrank ℚ Uhol = 3 :=
  ⟨rfl, finrank_Uhol⟩

/-- ★★ THE ENUMERATED BANDS EXHAUST THE BUDGET: `chargeTraceDepth = ((freezeoutStaircaseCensus : ℚ) :
    Cut) + leptonCensus` (the banked parent `census_completeness_closure`, `16/3 = 10/3 + 2`). The
    ENUMERATED low-energy parts distribute EXACTLY the cap-forced budget — nothing omitted, nothing left
    over. Combined with (`census_budget_cap_forced`) this closes ENUMERATION: the finite band list is
    the complete threshold set carrying the whole cap-forced census. -/
theorem census_budget_exhausted :
    chargeTraceDepth = ((freezeoutStaircaseCensus : ℚ) : Cut) + leptonCensus :=
  census_completeness_closure

/-- ★★★ ⭐ ONE CAUSE MANY TERMINATIONS: the SAME octonion non-associativity that STOPS the Cayley–
    Dickson cascade at `O ℚ` (`not_associative`, N2c) is the cause that CAPS the generation count at
    `finrank ℚ Uhol = 3` (N42c) — so the charged-species count is FINITE, the band list is finite, and
    its census budget is count-forced. `not_associative ∧ finrank ℚ Uhol = 3`. Load-bearing, not prose:
    the finiteness of the enumeration is the same fact as the cascade stop. -/
theorem one_cause_tie :
    (¬ ∀ (x y z : O ℚ), x * y * z = x * (y * z))
    ∧ Module.finrank ℚ Uhol = 3 :=
  ⟨not_associative, finrank_Uhol⟩

/-! ## (B) TERMINATION — below the lightest charged edge the census is 0, so 1/α FREEZES. -/

/-- THE FROZEN (BELOW-LIGHTEST-EDGE) CENSUS as a derived real of `Cut`: the cast of the banked
    `bandCensus []` — the census of the EMPTY active flavour set (below the lightest charged edge no
    flavour is resolved). -/
def frozenCensus : Cut := ((bandCensus [] : ℚ) : Cut)

/-- THE FROZEN CENSUS IS `0`: below the lightest charged edge the active set is empty, so `bandCensus []
    = 0` and its cast is `0`. The active census has genuinely run out. -/
theorem frozenCensus_zero : frozenCensus = 0 := by
  unfold frozenCensus
  have h : bandCensus [] = 0 := by unfold bandCensus; simp
  rw [h]; push_cast; rfl

/-- A FROZEN BAND SCREENS NOTHING: `bandScreen frozenCensus r = 0` for any edge ratio `r`. A band with
    zero active census contributes zero to the running self-overlap — no matter its edge ratio. -/
theorem frozenBand_screens_zero (r : Cut) : bandScreen frozenCensus r = 0 := by
  rw [frozenCensus_zero]; unfold bandScreen; ring

/-- ★★ A LIST ALL OF WHOSE BANDS HAVE ZERO CENSUS SCREENS NOTHING: `totalScreening bands = 0` whenever
    every band's census (first component) is `0`. The general form of the freeze — a tail of frozen
    (below-edge) bands contributes exactly `0` to the assembly. -/
theorem totalScreening_frozen (bands : List (Cut × Cut))
    (hz : ∀ p ∈ bands, p.1 = 0) : totalScreening bands = 0 := by
  unfold totalScreening
  apply List.sum_eq_zero
  intro x hx
  rw [List.mem_map] at hx
  obtain ⟨p, hp, rfl⟩ := hx
  rw [hz p hp]; unfold bandScreen; ring

/-- A MAPPED FROZEN TAIL has all-zero census: every band `(frozenCensus, r)` built from the empty active
    set has first component `frozenCensus = 0`. -/
theorem frozen_tail_all_zero (rs : List Cut) :
    ∀ p ∈ rs.map (fun r => (frozenCensus, r)), p.1 = 0 := by
  intro p hp
  rw [List.mem_map] at hp
  obtain ⟨r, _, rfl⟩ := hp
  exact frozenCensus_zero

/-- ★★★ THE FREEZE: `invAlphaZero (completeFreezeoutList rb rc rl d ++ (frozen tail)) = invAlphaZero
    (completeFreezeoutList rb rc rl d)`. Appending ANY tail of frozen (below-lightest-edge, zero-census)
    bands leaves the zero-momentum assembly UNCHANGED: the descent has genuinely ENDED, and `1/α` freezes
    at its zero-momentum value. The finite banked band list is NOT truncated — everything below it
    contributes exactly zero. FALLS OUT of `invAlphaZero_append` + `totalScreening_frozen`. -/
theorem endpoint_is_frozen (rb rc rl d : Cut) (rs : List Cut) :
    invAlphaZero (completeFreezeoutList rb rc rl d ++ rs.map (fun r => (frozenCensus, r)))
      = invAlphaZero (completeFreezeoutList rb rc rl d) := by
  rw [invAlphaZero_append, totalScreening_frozen _ (frozen_tail_all_zero rs), add_zero]

/-- ★★ THE FREEZE AT THE OCTONION CEILING: a completely unresolved tower (empty active list) followed by
    any frozen tail sits at the octonion-scale ceiling `42` (`invAlphaZero_nil`, X3/N316). With NO active
    census resolved the assembly is the un-screened ceiling — and frozen bands keep it there. -/
theorem freeze_at_ceiling (rs : List Cut) :
    invAlphaZero (([] : List (Cut × Cut)) ++ rs.map (fun r => (frozenCensus, r))) = 42 := by
  rw [invAlphaZero_append, totalScreening_frozen _ (frozen_tail_all_zero rs), add_zero,
    invAlphaZero_nil]

/-! ## (C) W8 NON-VACUITY WITH TEETH — the freeze is genuine content. -/

/-- ★★ W8 — AN ACTIVE BAND STRICTLY MOVES THE ASSEMBLY: an active band (census `leptonCensus = 2 > 0`
    over an edge ratio `1 < r`) STRICTLY increases `invAlphaZero`: `invAlphaZero list < invAlphaZero
    (list ++ [(leptonCensus, r)])`. So a frozen (zero-census) band is genuinely DISTINGUISHED from an
    active one — the freeze is real content, not a vacuous equality; an active flavour genuinely screens. -/
theorem active_band_moves (list : List (Cut × Cut)) (r : Cut) (hr : 1 < r) :
    invAlphaZero list < invAlphaZero (list ++ [(leptonCensus, r)]) := by
  rw [invAlphaZero_append]
  have hpos : 0 < totalScreening [(leptonCensus, r)] := by
    unfold totalScreening
    simp only [List.map_cons, List.map_nil, List.sum_cons, List.sum_nil, add_zero]
    apply bandScreen_pos _ hr
    rw [leptonCensus_val]; norm_num
  linarith

/-- ★ W8 — THE FROZEN CENSUS IS STRICTLY BELOW THE ACTIVE ONE: `frozenCensus < leptonCensus` (`0 < 2`).
    The below-edge census has genuinely dropped to zero, strictly below the census of an active
    (charged) band — the termination is a real descent to the census floor, not a plateau. -/
theorem frozen_below_active : frozenCensus < leptonCensus := by
  rw [frozenCensus_zero, leptonCensus_val]; norm_num

/-- ★ W8 — A MIS-CAPPED COUNT GIVES A WRONG BUDGET: `chargeTraceDepth ≠ ((ladderChargeTrace 2 : ℚ) :
    Cut)` (banked `chargeTraceDepth_ne_wrong_colour`). The census budget is specifically the cap-forced
