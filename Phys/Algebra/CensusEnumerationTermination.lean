theorem censusEnumerationTermination_landing (rb rc rl d : Cut) (r : Cut) (hr : 1 < r)
    (list : List (Cut × Cut)) (rs : List Cut) :
    -- (A) enumeration
    (chargeTraceDepth = ((ladderChargeTrace (Module.finrank ℚ Uhol) : ℚ) : Cut)
      ∧ Module.finrank ℚ Uhol = 3)
    ∧ chargeTraceDepth = ((freezeoutStaircaseCensus : ℚ) : Cut) + leptonCensus
    ∧ ((¬ ∀ (x y z : O ℚ), x * y * z = x * (y * z)) ∧ Module.finrank ℚ Uhol = 3)
    -- (B) termination
    ∧ frozenCensus = 0
    ∧ bandScreen frozenCensus r = 0
    ∧ (invAlphaZero (completeFreezeoutList rb rc rl d ++ rs.map (fun r => (frozenCensus, r)))
        = invAlphaZero (completeFreezeoutList rb rc rl d))
    ∧ (invAlphaZero (([] : List (Cut × Cut)) ++ rs.map (fun r => (frozenCensus, r))) = 42)
    -- (C) teeth
    ∧ (invAlphaZero list < invAlphaZero (list ++ [(leptonCensus, r)]))
    ∧ frozenCensus < leptonCensus
    ∧ chargeTraceDepth ≠ ((ladderChargeTrace 2 : ℚ) : Cut) :=
  ⟨census_budget_cap_forced,
   census_budget_exhausted,
   one_cause_tie,
   frozenCensus_zero,
   frozenBand_screens_zero r,
   endpoint_is_frozen rb rc rl d rs,
   freeze_at_ceiling rs,
   active_band_moves list r hr,
   frozen_below_active,
   census_budget_ne_uncapped⟩

