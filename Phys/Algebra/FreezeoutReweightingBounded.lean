theorem freezeoutReweightingBounded_landing (wb wc wl rb rc rl R : Cut)
    (hwb : 0 ≤ wb) (hwc : 0 ≤ wc) (hwl : 0 ≤ wl) (hR : 1 < R)
    (hb : 1 < rb) (hc : 1 < rc) (hl : 1 < rl)
    (hbR : rb ≤ R) (hcR : rc ≤ R) (hlR : rl ≤ R) :
