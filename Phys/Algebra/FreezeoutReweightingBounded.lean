/-! ## (A) THE GENERAL PER-BAND REWEIGHTING OF THE FREEZE-OUT. -/

/-- THE FREEZE-OUT UNDER A GENERAL PER-BAND REWEIGHTING `(wb, wc, wl)`: the three census-weighted
    log-screenings with the census weights `11/3, 10/3, 2` replaced by arbitrary weights. The D2e
    "Born-weight modulation" (were it a derived map) would be one such reweighting; so would any
    other. Physics-words-removable: `κ·wb·cutLog rb + κ·wc·cutLog rc + κ·wl·cutLog rl`. -/
def reweightedFreezeout (wb wc wl rb rc rl : Cut) : Cut :=
  kappaLeading * wb * cutLog rb + kappaLeading * wc * cutLog rc + kappaLeading * wl * cutLog rl

/-- ★★ THE CENSUS INSTANCE IS EXACTLY THE BANKED FREEZE-OUT: at the R-ratio census weights
    `(11/3, 10/3, 2)` the general reweighting IS the banked `totalScreening (freezeoutTail rb rc rl)`
    (`freezeout_closed`). This welds the general reweighting frame to the banked object — the bound
    below is a bound on the GENUINE banked freeze-out, not a fresh unrelated quantity. -/
theorem census_reweight_is_banked (rb rc rl : Cut) :
    reweightedFreezeout (11 / 3) (10 / 3) 2 rb rc rl
      = totalScreening (freezeoutTail rb rc rl) := by
  unfold reweightedFreezeout
  rw [freezeout_closed]

/-! ## (B) ★ THE MARQUEE CORRECTION — ANY REWEIGHTING IS BOUNDED (the parent's target cannot close). -/

/-- ★★★ THE GENERAL REWEIGHTING BOUND: for ANY nonneg per-band weights `(wb, wc, wl)` and screening
    edge ratios all bounded by a rational `R` (`1 < R`), the reweighted freeze-out is bounded by
    `κ·(wb+wc+wl)·cutLog R`. This GENERALIZES the banked `freezeout_bounded` (which caps the SPECIFIC
    census freeze-out) to ARBITRARY reweightings — a strictly stronger structural fact. It is the
    theory-native CORRECTION of the parent's mis-selection: modulating the freeze-out band weights
    (by the D2e Born occupancy or anything else) lifts the value by at most a bounded log term, so
    composing it CANNOT be the dominant missing summand of `1/α(0)`. THE ONE CAUSE: `cutLog`'s
    monotonicity (banked `cutLog_mono`) caps each band by the largest edge, and `κ > 0` scales; the
    total is capped by the total weight — the SAME census-conservation ceiling structure the banked
    node found, now for any weighting. -/
theorem freezeout_reweight_bounded (wb wc wl rb rc rl R : Cut)
    (hwb : 0 ≤ wb) (hwc : 0 ≤ wc) (hwl : 0 ≤ wl)
    (hb : 1 < rb) (hc : 1 < rc) (hl : 1 < rl)
    (hbR : rb ≤ R) (hcR : rc ≤ R) (hlR : rl ≤ R) :
    reweightedFreezeout wb wc wl rb rc rl ≤ kappaLeading * (wb + wc + wl) * cutLog R := by
  unfold reweightedFreezeout
  have hk := kappaLeading_pos
  have hlogb : cutLog rb ≤ cutLog R := cutLog_mono (by linarith) hbR
  have hlogc : cutLog rc ≤ cutLog R := cutLog_mono (by linarith) hcR
  have hlogl : cutLog rl ≤ cutLog R := cutLog_mono (by linarith) hlR
  have h1 : (0 : Cut) ≤ kappaLeading * wb := mul_nonneg (le_of_lt hk) hwb
  have h2 : (0 : Cut) ≤ kappaLeading * wc := mul_nonneg (le_of_lt hk) hwc
  have h3 : (0 : Cut) ≤ kappaLeading * wl := mul_nonneg (le_of_lt hk) hwl
  have t1 : kappaLeading * wb * cutLog rb ≤ kappaLeading * wb * cutLog R :=
    mul_le_mul_of_nonneg_left hlogb h1
  have t2 : kappaLeading * wc * cutLog rc ≤ kappaLeading * wc * cutLog R :=
    mul_le_mul_of_nonneg_left hlogc h2
  have t3 : kappaLeading * wl * cutLog rl ≤ kappaLeading * wl * cutLog R :=
    mul_le_mul_of_nonneg_left hlogl h3
  have hsum : kappaLeading * wb * cutLog R + kappaLeading * wc * cutLog R
        + kappaLeading * wl * cutLog R = kappaLeading * (wb + wc + wl) * cutLog R := by ring
  linarith [t1, t2, t3, hsum]

/-- ★★ THE CENSUS-CONSERVING REWEIGHTING STAYS UNDER THE SAME CEILING: any reweighting whose total
    weight is conserved (`wb + wc + wl = 9`, the banked freeze-out total census
    `freezeout_total_census`) is bounded by the SAME `κ·9·cutLog R` as the banked freeze-out. A
    "Born-weight modulation" that conserves the total census (as a re-partition of the same resolved
    content must) is provably no larger than the census freeze-out — it CANNOT supply new bulk. -/
theorem census_conserving_reweight_bounded (wb wc wl rb rc rl R : Cut)
    (hwb : 0 ≤ wb) (hwc : 0 ≤ wc) (hwl : 0 ≤ wl)
    (hconserve : wb + wc + wl = 9)
    (hb : 1 < rb) (hc : 1 < rc) (hl : 1 < rl)
    (hbR : rb ≤ R) (hcR : rc ≤ R) (hlR : rl ≤ R) :
    reweightedFreezeout wb wc wl rb rc rl ≤ kappaLeading * 9 * cutLog R := by
  have h := freezeout_reweight_bounded wb wc wl rb rc rl R hwb hwc hwl hb hc hl hbR hcR hlR
  rw [hconserve] at h
  exact h

/-! ## (C) THE REWEIGHTING PERTURBATION IS A FIXED LINEAR FORM (no new bulk, any edge sign). -/

/-- ★★ THE REWEIGHTING PERTURBATION IS A FIXED LINEAR FORM IN THE EDGE LOGS (edge-SIGN-agnostic): any
    reweighting differs from the census freeze-out by `κ·((wb−11/3)·cutLog rb + (wc−10/3)·cutLog rc +
    (wl−2)·cutLog rl)`. Whatever the signs of the edges (the bottom edge `rb < 1` SUBTRACTS), the
    difference is a bounded linear form — the Born-weight modulation, were it real, would be an O(1)
    perturbation, NEVER the dominant missing bulk. -/
theorem reweight_is_linear_perturbation (wb wc wl rb rc rl : Cut) :
    reweightedFreezeout wb wc wl rb rc rl
      - reweightedFreezeout (11 / 3) (10 / 3) 2 rb rc rl
      = kappaLeading * ((wb - 11 / 3) * cutLog rb + (wc - 10 / 3) * cutLog rc
          + (wl - 2) * cutLog rl) := by
  unfold reweightedFreezeout; ring

/-- ★ THE PERTURBATION WELDED TO THE BANKED `totalScreening`: any reweighting differs from the banked
    freeze-out `totalScreening (freezeoutTail rb rc rl)` by the SAME fixed linear form. Re-expresses
    `reweight_is_linear_perturbation` against the banked object via `census_reweight_is_banked`. -/
theorem reweight_delta_from_totalScreening (wb wc wl rb rc rl : Cut) :
    reweightedFreezeout wb wc wl rb rc rl
      - totalScreening (freezeoutTail rb rc rl)
      = kappaLeading * ((wb - 11 / 3) * cutLog rb + (wc - 10 / 3) * cutLog rc
          + (wl - 2) * cutLog rl) := by
  rw [← census_reweight_is_banked]
  exact reweight_is_linear_perturbation wb wc wl rb rc rl

/-! ## (D) THE TWO COUNTS ARE DISTINCT — the D2e occupancy is NOT the freeze-out census. -/

/-- ★★ THE OCCUPANCY FLOOR WEIGHT IS DISTINCT FROM THE FREEZE-OUT CENSUS TOTAL: the D2e per-level
    Born occupancy of the floor is `Nat.card ↥(levelOccupancy 1) = 16` (`floorOccupancy_eq_sixteen`),
    while the freeze-out total census is `9` (`freezeout_total_census`). `16 ≠ 9` — the integer-
    lattice degeneracy count and the R-ratio flavour census are GENUINELY DISTINCT objects. The
    parent's conflation ("the freeze-out band weights ARE the Born occupancies") is refuted: there is
    no identity, only a level-1 coincidence (`r₈(1) = 16` = floor weight). -/
theorem occupancy_ne_census_total :
    ((Nat.card ↥(levelOccupancy 1) : ℕ) : Cut)
      ≠ censusBottomBand + censusCharmBand + censusLightBand := by
  rw [floorOccupancy_eq_sixteen, freezeout_total_census]; norm_num

/-- ★ THE OCCUPANCY FLOOR WEIGHT IS DISTINCT FROM EACH FREEZE-OUT BAND CENSUS: `16 ≠ 11/3, 10/3, 2`
    (`floorOccupancy_eq_sixteen`, `censusBottomBand_val`/`censusCharmBand_val`/`censusLightBand_val`).
    No band census equals the floor occupancy — the two counts do not coincide band by band. -/
theorem occupancy_ne_band_censuses :
    ((Nat.card ↥(levelOccupancy 1) : ℕ) : Cut) ≠ censusBottomBand
    ∧ ((Nat.card ↥(levelOccupancy 1) : ℕ) : Cut) ≠ censusCharmBand
    ∧ ((Nat.card ↥(levelOccupancy 1) : ℕ) : Cut) ≠ censusLightBand := by
  rw [floorOccupancy_eq_sixteen, censusBottomBand_val, censusCharmBand_val, censusLightBand_val]
  refine ⟨?_, ?_, ?_⟩ <;> norm_num

/-! ## (E) THE FREEZE-OUT IS NOT THE DOMINANT SUMMAND (re-export of the banked composed bound). -/

