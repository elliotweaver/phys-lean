/-! ## (A) THE split@6 COS PARTIAL SUM AND THE FURTHER-SQUEEZED `1/cutPi` BRACKET. -/

/-- `partialCos x 6 = 1 − x²/2 + x⁴/24 − x⁶/720 + x⁸/40320 − x¹⁰/3628800` (the sixth partial cosine
    sum). -/
theorem partialCos_six (x : Cut) :
    partialCos x 6 = 1 - x ^ 2 / 2 + x ^ 4 / 24 - x ^ 6 / 720 + x ^ 8 / 40320
      - x ^ 10 / 3628800 := by
  unfold partialCos cosTermC
  simp only [Finset.sum_range_succ, Finset.sum_range_zero]
  norm_num; ring

/-- ★ THE SHARPER UPPER SIGN FACT: `cutCos (15707970/1e7) < 0`, split at index 6
    (`partialCos (15707970/1e7) 6 ≈ −1.14×10⁻⁶`, remainder `cosRemBound (15707970/1e7) 6 ≤ 478/1e9`,
    so `partialCos + rem < 0`). A sharper sign endpoint than D5-next-3's `cutCos (15709/10000) < 0`
    (split@4). -/
theorem cutCos_15707970_neg : cutCos (15707970 / 10000000 : Cut) < 0 := by
  have hb := (cutCos_bracket (15707970 / 10000000) (by norm_num) 6 (by norm_num)).2
  rw [partialCos_six] at hb
  have hpart : (1 : Cut) - (15707970 / 10000000) ^ 2 / 2 + (15707970 / 10000000) ^ 4 / 24
      - (15707970 / 10000000) ^ 6 / 720 + (15707970 / 10000000) ^ 8 / 40320
      - (15707970 / 10000000) ^ 10 / 3628800 ≤ -1137 / 1000000000 := by norm_num
  have hrem : cosRemBound (15707970 / 10000000 : Cut) 6 ≤ 478 / 1000000000 := by
    unfold cosRemBound; norm_num [Nat.factorial]
  linarith

/-- Helper: the tightened-factor degree-10 lower-positivity polynomial is strictly positive for
    `0 ≤ x` with `x² < 246732/100000`. Extracted as its own lemma so its `nlinarith` heartbeat cost is
    paid once (W9 decomposition). -/
theorem split5_tightfactor_poly_pos (x : Cut) (hx0 : 0 ≤ x) (hx2 : x ^ 2 < 246732 / 100000) :
    0 < 1 - x ^ 2 / 2 + x ^ 4 / 24 - x ^ 6 / 720 + x ^ 8 / 40320
      - 103 / 100 * (x ^ 10 / 3628800) := by
  nlinarith [hx2, hx0, sq_nonneg x, sq_nonneg (x ^ 2), sq_nonneg (x ^ 3), sq_nonneg (x ^ 4),
    sq_nonneg (x ^ 5), pow_nonneg hx0 4, pow_nonneg hx0 6, pow_nonneg hx0 8, pow_nonneg hx0 10,
    mul_nonneg hx0 (pow_nonneg hx0 3)]

/-- Helper: the tightened remainder-factor bound `cosRemBound x 5 ≤ (103/100)·x¹⁰/3628800` for
    `0 ≤ x` with `x² < 246732/100000`. Extracted so its calc/`norm_num` cost is paid once. -/
theorem split5_tightfactor_rem_bound (x : Cut) (hx0 : 0 ≤ x) (hx2 : x ^ 2 < 246732 / 100000) :
    cosRemBound x 5 ≤ 103 / 100 * (x ^ 10 / 3628800) := by
  have hden : (0 : Cut) < 1 - x ^ 2 / (((2 * 5 + 1) * (2 * 5 + 2) : ℕ) : Cut) := by
    push_cast; nlinarith [hx2]
  have hinv : (1 - x ^ 2 / (((2 * 5 + 1) * (2 * 5 + 2) : ℕ) : Cut))⁻¹ ≤ 103 / 100 := by
    rw [inv_le_comm₀ hden (by norm_num)]
    push_cast; nlinarith [hx2]
  unfold cosRemBound
  have hcoef : (0 : Cut) ≤ x ^ (2 * 5) / ((2 * 5).factorial : Cut) := by positivity
  have hstep : x ^ (2 * 5) / ((2 * 5).factorial : Cut)
      * (1 - x ^ 2 / (((2 * 5 + 1) * (2 * 5 + 2) : ℕ) : Cut))⁻¹
      ≤ x ^ (2 * 5) / ((2 * 5).factorial : Cut) * (103 / 100) :=
    mul_le_mul_of_nonneg_left hinv hcoef
  calc x ^ (2 * 5) / ((2 * 5).factorial : Cut)
          * (1 - x ^ 2 / (((2 * 5 + 1) * (2 * 5 + 2) : ℕ) : Cut))⁻¹
        ≤ x ^ (2 * 5) / ((2 * 5).factorial : Cut) * (103 / 100) := hstep
    _ = 103 / 100 * (x ^ 10 / 3628800) := by norm_num [Nat.factorial]; ring

/-- ★ THE SHARPER LOWER POSITIVITY FACT: `0 < cutCos x` for `0 ≤ x < 15707705/1e7`, split at index 5
    with the remainder factor tightened from `≤ 2` to `≤ 103/100` (valid since `x²/132 ≤ 3/103`), i.e.
    the degree-10 positivity `1 − x²/2 + x⁴/24 − x⁶/720 + x⁸/40320 − (103/100)·x¹⁰/3628800 > 0` for
    `x² < 246732/100000`. Sharpens D5-next-3's `< 15707/10000` positivity out to `< 15707705/1e7` (the
    tightened factor extends the split@5 reach toward `π/2`). Assembled from the two helper lemmas
    (`split5_tightfactor_poly_pos`, `split5_tightfactor_rem_bound`) so no single obligation is heavy. -/
theorem cutCos_pos_of_lt_15707705 (x : Cut) (hx0 : 0 ≤ x) (hx : x < 15707705 / 10000000) :
    0 < cutCos x := by
  have hx2 : x ^ 2 < 246732 / 100000 := by
    have h1 : x * x < (15707705 / 10000000) * (15707705 / 10000000) :=
      mul_lt_mul' (le_of_lt hx) hx hx0 (by norm_num)
    have h2 : (15707705 / 10000000 : Cut) * (15707705 / 10000000) ≤ 246732 / 100000 := by norm_num
    nlinarith [h1, h2]
  have hxN : x ^ 2 < (((2 * 5 + 1) * (2 * 5 + 2) : ℕ) : Cut) := by push_cast; nlinarith [hx2]
  have hb := (cutCos_bracket x hx0 5 hxN).1
  rw [partialCos_five] at hb
  have hrembd := split5_tightfactor_rem_bound x hx0 hx2
  have hpos := split5_tightfactor_poly_pos x hx0 hx2
  linarith [hb, hrembd, hpos]

/-- ★ `leastCosZero ≤ 15707970/1e7` (sharper UPPER bound): the IVT on `[0,15707970/1e7]` supplies a
    cosine zero `≤ 15707970/1e7` (since `cutCos (15707970/1e7) < 0 ≤ cutCos 0`), and `csInf_le`. -/
theorem leastCosZero_le_15707970 : leastCosZero ≤ 15707970 / 10000000 := by
  have h02 : (0 : Cut) ≤ 15707970 / 10000000 := by norm_num
  have hcont : ContinuousOn cutCos (Icc (0 : Cut) (15707970 / 10000000)) :=
    cutCos_continuous.continuousOn
  have hmem : (0 : Cut) ∈ Icc (cutCos (15707970 / 10000000)) (cutCos 0) := by
    rw [cutCos_zero]; exact ⟨le_of_lt cutCos_15707970_neg, by norm_num⟩
  obtain ⟨c, hc, hcval⟩ := (intermediate_value_Icc' h02 hcont) hmem
  have hc2 : c ≤ 2 := le_trans hc.2 (by norm_num)
  have hcmem : c ∈ cosZeroSet := ⟨⟨hc.1, hc2⟩, hcval⟩
  exact le_trans (csInf_le cosZeroSet_bddBelow hcmem) hc.2

/-- ★ `15707705/1e7 ≤ leastCosZero` (sharper LOWER bound): the cosine is strictly positive on
    `[0,15707705/1e7)`, so no zero lives below `15707705/1e7`, hence `15707705/1e7 ≤` the infimum
    (`le_csInf`). -/
theorem le_leastCosZero_15707705 : (15707705 / 10000000 : Cut) ≤ leastCosZero := by
  apply le_csInf cosZeroSet_nonempty
  intro b hb
  by_contra hlt
  rw [not_le] at hlt
  have hb0 : 0 ≤ b := hb.1.1
  have hpos := cutCos_pos_of_lt_15707705 b hb0 hlt
  rw [hb.2] at hpos
  exact lt_irrefl _ hpos

/-- ★★ THE FURTHER-TIGHTER `cutPi` BRACKET: `cutPi ∈ [3141541/1000000, 1570797/500000]`, from
    `cutPi = 2·leastCosZero` and `leastCosZero ∈ [15707705/1e7, 15707970/1e7]`. Nested strictly inside
    D5-next-3's `[15707/5000, 15709/5000]`. (`3141541/1000000 = 2·15707705/1e7`,
    `1570797/500000 = 2·15707970/1e7`.) -/
theorem cutPi_bracket_split6 : (3141541 / 1000000 : Cut) ≤ cutPi ∧ cutPi ≤ 1570797 / 500000 := by
  unfold cutPi
  refine ⟨?_, ?_⟩
  · have := le_leastCosZero_15707705; linarith
  · have := leastCosZero_le_15707970; linarith

/-- ★★★ THE FURTHER-SQUEEZED RESIDUAL BRACKET: `1/cutPi ∈ [500000/1570797, 1000000/3141541]` — a
    certified two-sided rational bracket of `Cut` for the derived `1/cutPi`, width `≈ 5.4×10⁻⁶`, nested
    strictly inside D5-next-3's `[5000/15709, 5000/15707]`. -/
theorem inv_cutPi_bracket_split6 :
    (500000 / 1570797 : Cut) ≤ 1 / cutPi ∧ 1 / cutPi ≤ 1000000 / 3141541 := by
  obtain ⟨hlo, hhi⟩ := cutPi_bracket_split6
  have hpos : 0 < cutPi := cutPi_pos
  refine ⟨?_, ?_⟩
  · rw [le_div_iff₀ hpos]; nlinarith [hhi, hpos]
  · rw [div_le_iff₀ hpos]; nlinarith [hlo, hpos]

/-- ★ W8 — THE FURTHER-SQUEEZED RESIDUAL BRACKET IS STRICTLY TWO-SIDED: `500000/1570797 <
    1000000/3141541`. -/
theorem inv_cutPi_split6_strict : (500000 / 1570797 : Cut) < 1000000 / 3141541 := by norm_num

/-- ★ W8 — THE split@6 `1/cutPi` BRACKET IS NESTED INSIDE D5-next-3's `[5000/15709, 5000/15707]`:
    `5000/15709 ≤ 500000/1570797` and `1000000/3141541 ≤ 5000/15707` — the narrowing genuinely shrinks
    the bracket from both ends. -/
theorem inv_cutPi_split6_nested :
    (5000 / 15709 : Cut) ≤ 500000 / 1570797 ∧ (1000000 / 3141541 : Cut) ≤ 5000 / 15707 := by
  refine ⟨by norm_num, by norm_num⟩

