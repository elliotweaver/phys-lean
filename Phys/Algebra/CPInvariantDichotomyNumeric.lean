/-- `mixProd ∈ [1026/1e13, 1032/1e13]` (≈ 1.03e-10) — the product of the three banked CP-weight
    brackets. -/
theorem mixProd_lo : (1026 : Cut) / 10000000000000 ≤ mixProd := by
  unfold mixProd
  have p12 : (6037 : Cut) / 1000000 * ((5329 : Cut) / 10000000) ≤ cpG12 * cpG23 :=
    mul_le_mul cpG12_lo cpG23_lo (by norm_num) (le_of_lt cpG12_pos)
  have p12p : (0 : Cut) ≤ cpG12 * cpG23 := le_of_lt (mul_pos cpG12_pos cpG23_pos)
  have p3 : ((6037 : Cut) / 1000000 * ((5329 : Cut) / 10000000)) * ((3190 : Cut) / 100000000)
      ≤ (cpG12 * cpG23) * cpH13 := mul_le_mul p12 cpH13_lo (by norm_num) p12p
  calc (1026 : Cut) / 10000000000000
      ≤ ((6037 : Cut) / 1000000 * ((5329 : Cut) / 10000000)) * ((3190 : Cut) / 100000000) := by norm_num
    _ ≤ cpG12 * cpG23 * cpH13 := by rw [mul_assoc]; linarith [p3]
theorem mixProd_hi : mixProd ≤ (1032 : Cut) / 10000000000000 := by
  unfold mixProd
  have p12 : cpG12 * cpG23 ≤ (6041 : Cut) / 1000000 * ((5340 : Cut) / 10000000) :=
    mul_le_mul cpG12_hi cpG23_hi (le_of_lt cpG23_pos) (by norm_num)
  have p12p : (0 : Cut) ≤ (6041 : Cut) / 1000000 * ((5340 : Cut) / 10000000) := by norm_num
  have p3 : (cpG12 * cpG23) * cpH13
      ≤ ((6041 : Cut) / 1000000 * ((5340 : Cut) / 10000000)) * ((3197 : Cut) / 100000000) :=
    mul_le_mul p12 cpH13_hi (le_of_lt cpH13_pos) p12p
  calc cpG12 * cpG23 * cpH13
      ≤ ((6041 : Cut) / 1000000 * ((5340 : Cut) / 10000000)) * ((3197 : Cut) / 100000000) := p3
    _ ≤ (1032 : Cut) / 10000000000000 := by norm_num
theorem mixProd_pos : (0 : Cut) < mixProd := by have := mixProd_lo; linarith
theorem mixProd_nonneg : (0 : Cut) ≤ mixProd := le_of_lt mixProd_pos

