  refine ⟨cpInvSqQuark_pos, ?_⟩; have := cpInvSqQuark_hi; linarith

/-! ## §8 — the capstone. -/

/-- ★★★ THE CAPSTONE — the CP invariant evaluated, the dichotomy tooth at numeral grade (seed C4).

    Over the derived ℝ `Cut`, the chain's convention-free CP invariant squared is the forced product
    `cpInvSq a = mixProd·a²·cpFactorDerived`, where `mixProd = G₁₂·G₂₃·H₁₃` is the arc-C-native
    CP-weight product read off C3's survival-dressed mixing fractions (`Gᵢⱼ = mixij·(1 − mixij)`,
    `H₁₃ = mix13·(1 − mix13)²`), `cpFactorDerived = 1/2` is the banked N418 derived fold-phase Born
    magnitude, and `a` is the banked octonion associator `assoc3` at the texture. The associator is the
    CP SWITCH: on the octonionic Fano triple `a = −1` (`a² = 1`, ON), on the associative ℂ-line `a = 0`
    (`a² = 0`, OFF).

    The SAME formula gives, at the two textures:
    * QUARK (Fano): `cpInvSqQuark = mixProd/2 ∈ [513/1e13, 516/1e13]` (`cpInvSqQuark_lo/hi`), a genuine
      POSITIVE number, and `cpInvQuark = cutSqrt(cpInvSqQuark) ∈ [71/1e7, 72/1e7]` (`cpInvQuark_lo/hi`,
      `cpInvQuark_pos`).
    * LEPTON (ℂ-line): `cpInvSqLepton x b d = 0` EXACTLY for every `x,b,d` (`cpInvSqLepton_zero`), and
      the invariant itself `cutSqrt 0 = 0` (`cpInvLepton_zero`) — a THEOREM, not a small bracket.

    ★★★ THE DICHOTOMY (`cp_dichotomy`, `cp_dichotomy_strict`): quark CP present (positive), lepton CP
    absent (exactly 0), the associator the ONLY difference — one cause, two outcomes, at numeral grade.
    The `mixProd` product falls out of the banked C3 mixing brackets (`mixProd_lo/hi`); ZERO free CP
    parameters (the switch is the associator, the magnitude is the derived phase).

    ⚠ HONEST GRADE (seed §C4): the DICHOTOMY (positive quark bracket vs exact lepton zero, same formula)
    is FORCED and theorem-exact. The quark bracket is LEADING ORDER (inherits the leading-order C3 mixing
    weights and the derived phase magnitude); the measured Jarlskog `J` is the arc-C LIVE-fight residual —
    REMOVABLE PROSE, in NO proof, NEVER fitted. The CP invariant is dimensionless (ONE-PEG LAW: no new
    peg). -/
theorem cp_invariant_dichotomy_numeric :
    -- the invariant carries the derived phase magnitude cpFactorDerived = 1/2 (banked N418)
    cpFactorDerived = 1 / 2
    -- the CP switch: the two banked associator values (Fano unit → a²=1, ℂ-line → 0)
    ∧ cpAssocQuark ^ 2 = 1
    ∧ (∀ (x : O ℚ) (b d : ℚ), cpAssocLepton x b d = 0)
    -- the arc-C-native CP-weight product bracket
    ∧ ((1026 : Cut) / 10000000000000 ≤ mixProd ∧ mixProd ≤ (1032 : Cut) / 10000000000000)
    -- ★★ the quark CP invariant squared = mixProd/2, with bracket
    ∧ cpInvSqQuark = (1 / 2) * mixProd
    ∧ ((513 : Cut) / 10000000000000 ≤ cpInvSqQuark ∧ cpInvSqQuark ≤ (516 : Cut) / 10000000000000)
    -- ★★ the quark CP invariant itself over the derived ℝ, genuinely positive
    ∧ ((71 : Cut) / 10000000 ≤ cpInvQuark ∧ cpInvQuark ≤ (72 : Cut) / 10000000)
    ∧ (0 : Cut) < cpInvQuark
    -- ★★★ THE DICHOTOMY TOOTH: the lepton CP invariant is EXACTLY zero (theorem), same formula
    ∧ (∀ (x : O ℚ) (b d : ℚ), cpInvSqLepton x b d = 0)
    ∧ (∀ (x : O ℚ) (b d : ℚ), cutSqrt (cpInvSqLepton x b d) = 0)
    -- ★★★ the dichotomy: quark present (positive), lepton absent (exactly 0), same formula
    ∧ ((0 : Cut) < cpInvSqQuark ∧ (∀ (x : O ℚ) (b d : ℚ), cpInvSqLepton x b d = 0))
    ∧ (∀ (x : O ℚ) (b d : ℚ), cpInvSqLepton x b d < cpInvSqQuark) :=
  ⟨cpFactorDerived_eq_half, cpAssocQuark_sq, cpAssocLepton_zero,
   ⟨mixProd_lo, mixProd_hi⟩, cpInvSqQuark_eq, ⟨cpInvSqQuark_lo, cpInvSqQuark_hi⟩,
   ⟨cpInvQuark_lo, cpInvQuark_hi⟩, cpInvQuark_pos,
   cpInvSqLepton_zero, cpInvLepton_zero, cp_dichotomy, cp_dichotomy_strict⟩

end

