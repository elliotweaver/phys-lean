/-! ## §1 — the three arc-C-native CP weights `Gᵢⱼ = mixij·(1 − mixij)` (the `s²c²` Jarlskog
    packaging read off C3's mixing fractions and their arctan-free complements). -/

/-- The leading (1-2) CP weight `G₁₂ = mix12·(1 − mix12) = s²θ₁₂·c²θ₁₂`. -/
def cpG12 : Cut := mix12 * (1 - mix12)
/-- The (2-3) CP weight `G₂₃ = mix23·(1 − mix23)`. -/
def cpG23 : Cut := mix23 * (1 - mix23)
/-- The far-corner (1-3) CP weight `H₁₃ = mix13·(1 − mix13)² = s²θ₁₃·c⁴θ₁₃` (the double cosine of the
    Jarlskog corner). -/
def cpH13 : Cut := mix13 * (1 - mix13) ^ 2

/-- The leading edge fraction bracket, via the C2 tie `mix12 = cabMix2`. -/
theorem mix12_lo : (60740 : Cut) / 10000000 ≤ mix12 := by rw [mix12_eq_cabMix2]; exact cabMix2_lo
theorem mix12_hi : mix12 ≤ (60770 : Cut) / 10000000 := by rw [mix12_eq_cabMix2]; exact cabMix2_hi
theorem mix12_pos : (0 : Cut) < mix12 := by rw [mix12_eq_cabMix2]; exact cabMix2_pos

/-- `G₁₂ ∈ [6037/1e6, 6041/1e6]` (≈ 0.006039) — from the banked `mix12` bracket. -/
theorem cpG12_lo : (6037 : Cut) / 1000000 ≤ cpG12 := by
  unfold cpG12
  have key : (60740 : Cut) / 10000000 * (1 - (60770 : Cut) / 10000000) ≤ mix12 * (1 - mix12) :=
    mul_le_mul mix12_lo (by linarith [mix12_hi]) (by norm_num) (le_of_lt mix12_pos)
  have hnum : (6037 : Cut) / 1000000 ≤ (60740 : Cut) / 10000000 * (1 - (60770 : Cut) / 10000000) := by
    norm_num
  exact le_trans hnum key
theorem cpG12_hi : cpG12 ≤ (6041 : Cut) / 1000000 := by
  unfold cpG12
  have key : mix12 * (1 - mix12) ≤ (60770 : Cut) / 10000000 * (1 - (60740 : Cut) / 10000000) :=
    mul_le_mul mix12_hi (by linarith [mix12_lo]) (by linarith [mix12_hi]) (by norm_num)
  have hnum : (60770 : Cut) / 10000000 * (1 - (60740 : Cut) / 10000000) ≤ (6041 : Cut) / 1000000 := by
    norm_num
  exact le_trans key hnum
theorem cpG12_pos : (0 : Cut) < cpG12 := by have := cpG12_lo; linarith

/-- `G₂₃ ∈ [5329/1e7, 5340/1e7]` (≈ 0.0005335) — from the banked `mix23` bracket. -/
theorem cpG23_lo : (5329 : Cut) / 10000000 ≤ cpG23 := by
  unfold cpG23
  have key : (5332 : Cut) / 10000000 * (1 - (5342 : Cut) / 10000000) ≤ mix23 * (1 - mix23) :=
    mul_le_mul mix23_lo (by linarith [mix23_hi]) (by norm_num) (le_of_lt mix23_pos)
  have hnum : (5329 : Cut) / 10000000 ≤ (5332 : Cut) / 10000000 * (1 - (5342 : Cut) / 10000000) := by
    norm_num
  exact le_trans hnum key
theorem cpG23_hi : cpG23 ≤ (5340 : Cut) / 10000000 := by
  unfold cpG23
  have key : mix23 * (1 - mix23) ≤ (5342 : Cut) / 10000000 * (1 - (5332 : Cut) / 10000000) :=
    mul_le_mul mix23_hi (by linarith [mix23_lo]) (by linarith [mix23_hi]) (by norm_num)
  have hnum : (5342 : Cut) / 10000000 * (1 - (5332 : Cut) / 10000000) ≤ (5340 : Cut) / 10000000 := by
    norm_num
  exact le_trans key hnum
theorem cpG23_pos : (0 : Cut) < cpG23 := by have := cpG23_lo; linarith

/-- `H₁₃ ∈ [3190/1e8, 3197/1e8]` (≈ 0.0000319) — from the banked `mix13` bracket (double cosine). -/
theorem cpH13_lo : (3190 : Cut) / 100000000 ≤ cpH13 := by
  unfold cpH13
  have hc : (1 - (3197 : Cut) / 100000000) ^ 2 ≤ (1 - mix13) ^ 2 := by
    have h1 : (0 : Cut) ≤ 1 - (3197 : Cut) / 100000000 := by norm_num
    have h2 : 1 - mix13 ≤ 1 := by linarith [mix13_pos]
    nlinarith [mix13_hi, mix13_pos, h1]
  have key : (3191 : Cut) / 100000000 * ((1 - (3197 : Cut) / 100000000) ^ 2) ≤ mix13 * (1 - mix13) ^ 2 :=
    mul_le_mul mix13_lo hc (by positivity) (le_of_lt mix13_pos)
  have hnum : (3190 : Cut) / 100000000 ≤ (3191 : Cut) / 100000000 * ((1 - (3197 : Cut) / 100000000) ^ 2) := by
    norm_num
  exact le_trans hnum key
theorem cpH13_hi : cpH13 ≤ (3197 : Cut) / 100000000 := by
  unfold cpH13
  have hc : (1 - mix13) ^ 2 ≤ 1 := by
    have h1 : (0 : Cut) ≤ 1 - mix13 := by linarith [mix13_hi]
    nlinarith [mix13_pos, h1]
  have key : mix13 * (1 - mix13) ^ 2 ≤ (3197 : Cut) / 100000000 * 1 :=
    mul_le_mul mix13_hi hc (by positivity) (by norm_num)
  linarith [key]
