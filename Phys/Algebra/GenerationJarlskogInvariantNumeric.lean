/-! ## §0 — two `cutSqrt` monotonicity helpers over the derived ℝ (from the banked N57 `cutSqrt`).

The Jarlskog invariant `J = √(J²)` needs the nonnegative square root of the derived ℝ. The banked
`cutSqrt` (N57) supplies the root and its defining property `cutSqrt a · cutSqrt a = a` (a ≥ 0); we
add the two order-comparisons that convert a two-sided bracket on `J²` into a two-sided bracket on
`J`. Pure order/field facts on `Cut`; no new posit. -/

/-- If `0 ≤ b` and `a ≤ b·b` then `cutSqrt a ≤ b` — upper monotonicity of the derived square root. -/
theorem cutSqrt_le_of_sq_le {a b : Cut} (hb : 0 ≤ b) (h : a ≤ b * b) : cutSqrt a ≤ b := by
  rcases le_total 0 a with ha | ha
  · nlinarith [cutSqrt_sq ha, cutSqrt_nonneg a, hb, h]
  · rcases eq_or_lt_of_le ha with ha0 | ha0
    · nlinarith [cutSqrt_sq (le_of_eq ha0.symm), cutSqrt_nonneg a, hb, h]
    · rw [show cutSqrt a = 0 from by unfold cutSqrt; rw [dif_neg (not_le.mpr ha0)]]; exact hb

/-- If `0 ≤ a`, `0 ≤ c` and `c·c ≤ a` then `c ≤ cutSqrt a` — lower monotonicity of the derived root. -/
theorem le_cutSqrt_of_sq_le {a c : Cut} (ha : 0 ≤ a) (_hc : 0 ≤ c) (h : c * c ≤ a) : c ≤ cutSqrt a := by
  nlinarith [cutSqrt_sq ha, cutSqrt_nonneg a, _hc, h]

/-! ## §1 — THE CP PHASE SOURCE IS THE OCTONION ASSOCIATOR (the switch, re-exported from N310/N312).

The CP invariant is carried by the banked calibration cross-term `assoc3` (N209/N310): it VANISHES on
the associative ℂ-line (CP conserved) and is the UNIT `−1` on the octonionic Fano line (CP present,
maximal). This is the theory-native heart — the CP phase is not a free number but the banked
associator. -/

/-- ★ THE CP SWITCH (re-export of the banked `cp_invariant_tie`, N310/N312): the CP-invariant 3-form
    `assoc3` is `0` on the associative ℂ-line (`assoc3 x (b•u1) (d•u1) = 0`, CP conserved) and NONZERO
    on the octonionic Fano line (`assoc3 u2 u1 (u1×u2) ≠ 0`, CP present). The CP phase source is the
    octonion associator — zero free CP parameters. -/
theorem cp_switch :
    (∀ (x : O ℚ) (b d : ℚ), assoc3 x (b • u1) (d • u1) = 0)
    ∧ assoc3 u2 u1 (octCross u1 u2) ≠ 0 :=
  Phys.Algebra.HJ.cp_invariant_tie

/-- The CP phase magnitude as an element of the derived ℝ: the banked Fano associator `assoc3 u2 u1
    (u1×u2) = −1` (N209) cast to `Cut`. -/
def cpPhase : Cut := ((assoc3 u2 u1 (octCross u1 u2) : ℚ) : Cut)

/-- ★ THE CP PHASE IS THE ASSOCIATOR UNIT `−1` over the derived ℝ (banked `assoc3_witness`). -/
theorem cpPhase_eq : cpPhase = -1 := by unfold cpPhase; rw [assoc3_witness]; push_cast; ring

/-- ★★ THE CP PHASE SQUARED IS THE UNIT `1` — `sinδ` DISSOLVES: `(assoc3)² = 1`, the MAXIMAL CP the
    octonion associator permits. No free continuous CP phase, no `cutSin` transcendental — the CP
    factor is the banked associator unit squared. -/
theorem cpPhaseSq_eq : cpPhase ^ 2 = 1 := by rw [cpPhase_eq]; ring

/-! ## §2 — the three Born amplitude factors as brackets (from the banked N343 sin² weights). -/

/-- `cos²θᵢⱼ = 1 − sin²θᵢⱼ` (the banked Born-closure `sinSq_add_cosSq`, N343). -/
theorem cos12 : cosSqMix mass1 mass2 = 1 - sinSqMix mass1 mass2 := by
  have h := sinSq_add_cosSq mass1 mass2 (ne_of_gt sum12_pos); linarith
theorem cos23 : cosSqMix mass2 mass0 = 1 - sinSqMix mass2 mass0 := by
  have h := sinSq_add_cosSq mass2 mass0 (ne_of_gt sum23_pos); linarith
theorem cos13 : cosSqMix mass1 mass0 = 1 - sinSqMix mass1 mass0 := by
  have h := sinSq_add_cosSq mass1 mass0 (ne_of_gt sum13_pos); linarith

/-- The lightest↔middle Born factor `g₁₂ = sin²θ₁₂·cos²θ₁₂`. -/
def g12 : Cut := sinSqMix mass1 mass2 * cosSqMix mass1 mass2
/-- The middle↔heaviest Born factor `g₂₃ = sin²θ₂₃·cos²θ₂₃`. -/
def g23 : Cut := sinSqMix mass2 mass0 * cosSqMix mass2 mass0
/-- The lightest↔heaviest (far-corner) Born factor `h₁₃ = sin²θ₁₃·cos⁴θ₁₃` (cubic — the corner
    carries a double cosine in the Jarlskog product). -/
def h13 : Cut := sinSqMix mass1 mass0 * cosSqMix mass1 mass0 ^ 2

theorem g12_lo : (4786 : Cut) / 1000000 ≤ g12 := by
  unfold g12; rw [cos12]; nlinarith [sinSq12_lo, sinSq12_hi]
theorem g12_hi : g12 ≤ (4797 : Cut) / 1000000 := by
  unfold g12; rw [cos12]; nlinarith [sinSq12_lo, sinSq12_hi]
theorem g12_pos : (0 : Cut) < g12 := by have := g12_lo; linarith

theorem g23_lo : (5295 : Cut) / 100000 ≤ g23 := by
  unfold g23; rw [cos23]; nlinarith [sinSq23_lo, sinSq23_hi]
theorem g23_hi : g23 ≤ (5305 : Cut) / 100000 := by
