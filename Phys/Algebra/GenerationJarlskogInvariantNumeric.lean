theorem g23_pos : (0 : Cut) < g23 := by have := g23_lo; linarith

theorem h13_lo : (2868 : Cut) / 10000000 ≤ h13 := by
  unfold h13; rw [cos13]; nlinarith [sinSq13_lo, sinSq13_hi]
theorem h13_hi : h13 ≤ (2879 : Cut) / 10000000 := by
  unfold h13; rw [cos13]; nlinarith [sinSq13_lo, sinSq13_hi]
theorem h13_pos : (0 : Cut) < h13 := by have := h13_lo; linarith

/-! ## §3 — ★★ THE JARLSKOG INVARIANT SQUARED as an explicit two-sided rational bracket over ℝ. -/

/-- ★★ THE JARLSKOG CP INVARIANT SQUARED: `J² = g₁₂·g₂₃·h₁₃·(assoc3)²` — the forced rational
    combination of the banked N343 Born mixing weights and the banked N310 associator unit. Because
    `(assoc3)² = 1` (`cpPhaseSq_eq`, the octonion CP phase at maximal magnitude), `J²` is the pure
    product of the three Born amplitude factors. -/
def jarlskogSq : Cut := g12 * g23 * h13 * cpPhase ^ 2

/-- ★★ `J² = g₁₂·g₂₃·h₁₃` (the CP phase unit factors out): the associator squared is `1`. -/
theorem jarlskogSq_eq : jarlskogSq = g12 * g23 * h13 := by
  unfold jarlskogSq; rw [cpPhaseSq_eq]; ring

/-- ★★ THE JARLSKOG SQUARED BRACKET over the derived ℝ: `J² ∈ [72/1e9, 74/1e9]` (≈ 7.3e-8). FALLS OUT
    of the banked N343 Born-weight factor brackets; no decimal posited. -/
theorem jarlskogSq_lo : (72 : Cut) / 1000000000 ≤ jarlskogSq := by
  rw [jarlskogSq_eq]
  have p1 : (4786 : Cut) / 1000000 * ((5295 : Cut) / 100000) ≤ g12 * g23 :=
    mul_le_mul g12_lo g23_lo (by norm_num) (le_of_lt (by linarith [g12_lo]))
  have p1p : (0 : Cut) ≤ g12 * g23 := by positivity
  have p2 : ((4786 : Cut) / 1000000 * ((5295 : Cut) / 100000)) * ((2868 : Cut) / 10000000)
      ≤ (g12 * g23) * h13 := mul_le_mul p1 h13_lo (by norm_num) p1p
  calc (72 : Cut) / 1000000000
      ≤ ((4786 : Cut) / 1000000 * ((5295 : Cut) / 100000)) * ((2868 : Cut) / 10000000) := by norm_num
    _ ≤ g12 * g23 * h13 := by rw [mul_assoc]; linarith [p2]

theorem jarlskogSq_hi : jarlskogSq ≤ (74 : Cut) / 1000000000 := by
  rw [jarlskogSq_eq]
  have p1 : g12 * g23 ≤ (4797 : Cut) / 1000000 * ((5305 : Cut) / 100000) :=
    mul_le_mul g12_hi g23_hi (le_of_lt g23_pos) (by norm_num)
  have p1p : (0 : Cut) ≤ (4797 : Cut) / 1000000 * ((5305 : Cut) / 100000) := by norm_num
  have p2 : (g12 * g23) * h13
      ≤ ((4797 : Cut) / 1000000 * ((5305 : Cut) / 100000)) * ((2879 : Cut) / 10000000) :=
    mul_le_mul p1 h13_hi (le_of_lt h13_pos) p1p
  calc g12 * g23 * h13 = (g12 * g23) * h13 := by rw [mul_assoc]
    _ ≤ ((4797 : Cut) / 1000000 * ((5305 : Cut) / 100000)) * ((2879 : Cut) / 10000000) := p2
    _ ≤ (74 : Cut) / 1000000000 := by norm_num

theorem jarlskogSq_pos : (0 : Cut) < jarlskogSq := by have := jarlskogSq_lo; linarith
theorem jarlskogSq_nonneg : (0 : Cut) ≤ jarlskogSq := le_of_lt jarlskogSq_pos

/-! ## §4 — ★★ THE JARLSKOG INVARIANT `J = cutSqrt(J²)` as an explicit bracket over ℝ. -/

/-- ★★ THE JARLSKOG CP INVARIANT `J = √(J²)` over the derived ℝ (the single √, banked `cutSqrt`). -/
def jarlskog : Cut := cutSqrt jarlskogSq

/-- ★★ THE JARLSKOG INVARIANT BRACKET over the derived ℝ: `J ∈ [268/1e6, 273/1e6]` (≈ 2.70e-4). The
    CP invariant at MAXIMAL phase, EXTRACTED from the `J²` bracket by the derived square root. -/
theorem jarlskog_lo : (268 : Cut) / 1000000 ≤ jarlskog := by
  unfold jarlskog
