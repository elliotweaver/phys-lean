  have := jarlskogSq_lo; nlinarith [this]
theorem jarlskog_hi : jarlskog ≤ (273 : Cut) / 1000000 := by
  unfold jarlskog
  apply cutSqrt_le_of_sq_le (by norm_num)
  have := jarlskogSq_hi; nlinarith [this]

