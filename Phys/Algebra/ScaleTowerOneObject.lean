    ewClosureRatio = scaleTowerRung 9 (-1)
    ∧ seesawRatio = scaleTowerRung 9 (-2)
    ∧ planckClosureRatio = scaleTowerRung 28 (-1)
    ∧ planckMassRatio = scaleTowerRung 28 1
