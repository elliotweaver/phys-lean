theorem qcd_rung_ne_gravity_rung : (12 : Cut) * cutPi ≠ 3 * cutPi := by
  intro h; have := cutPi_pos; nlinarith [this]

/-- NON-VACUITY: the `n=7` eigenvalue `λ₇ = −1/(12·cutPi)` is genuinely nonzero — the eigenvalue lock
    `λ·rung = −1` forces `λ ≠ 0`, so `{7,9,28}` are genuine (nonzero) relevant directions. -/
theorem criticalEigenvalue_7_ne_zero : criticalEigenvalue 7 ≠ 0 := by
  intro h
  have hlock := criticalEigenvalue_mul_rungExponent 7 (by norm_num)
  rw [h, zero_mul] at hlock
  exact absurd hlock (by norm_num)

