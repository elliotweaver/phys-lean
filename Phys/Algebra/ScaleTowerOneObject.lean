/-! ## (1) THE TOWER AS ONE OBJECT: `scaleTowerRung n m = cutExp(m·rungExponent n)`. -/

/-- ★ THE SCALE TOWER AS ONE OBJECT. Every dimensionless rung of the tower is `cutExp` of an INTEGER
    multiple `m` of the banked rung exponent `rungExponent n = criticalPhaseNumerator / n` at a
    structural count `n`. Only two freedoms: the count `n ∈ {7,9,28}` (= `finrank {ImO, spaceSub,
    selfAdj}`) and the integer multiplicity `m` (its sign = the ± e-fold direction, its magnitude =
    the Born self-overlap power). `rungExponent` and `cutExp` are BANKED (N329/N174). -/
def scaleTowerRung (n : ℕ) (m : ℤ) : Cut := cutExp ((m : Cut) * rungExponent n)

/-- ★★ THE EXPONENT-LOCK: every rung's log times its structural count `n` returns `m` times the ONE
    shared 84π critical-phase budget. This is the seed's `bare_exponent × divisor = 84π` (the N329
    `numerator_lock`) lifted to the whole tower: every rung's log is `m/n` of one budget. -/
theorem scaleTowerRung_exponent_lock (n : ℕ) (m : ℤ) (hn : (n : Cut) ≠ 0) :
    ((m : Cut) * rungExponent n) * (n : Cut) = (m : Cut) * criticalPhaseNumerator := by
  rw [mul_assoc, numerator_lock n hn]

/-- ★★ THE TOWER-CLOSURE HOMOMORPHISM: rungs at the SAME count `n` stack additively in the multiplicity
    (banked `cutExp_add`). The tower is closed under products at each count — one homomorphic `cutExp`. -/
theorem scaleTowerRung_mul_same (n : ℕ) (m₁ m₂ : ℤ) :
    scaleTowerRung n m₁ * scaleTowerRung n m₂ = scaleTowerRung n (m₁ + m₂) := by
  unfold scaleTowerRung
  rw [cutExp_add]; congr 1; push_cast; ring

/-- ★★ THE BORN SELF-OVERLAP SQUARE = MULTIPLICITY-DOUBLING. Squaring a rung (the Born self-overlap,
    N174) is exactly doubling its integer multiplicity. This is the STRUCTURAL form of the Born square
    that made gravity's coupling `G·M²` (B3) and the ν seesaw `m₀/M` (B6) squares — one mechanism. -/
theorem scaleTowerRung_sq (n : ℕ) (m : ℤ) :
    (scaleTowerRung n m) ^ 2 = scaleTowerRung n (2 * m) := by
  rw [pow_two, scaleTowerRung_mul_same]; congr 1; ring

/-! ## (2) EVERY BANKED RATIO IS AN INSTANCE of the one object at a specific `(n, m)`. -/

/-- ★ `v/M = scaleTowerRung 9 (−1)` — the electroweak rung is the `n=9`, `m=−1` instance. -/
theorem ewClosureRatio_as_rung : ewClosureRatio = scaleTowerRung 9 (-1) := by
  unfold ewClosureRatio scaleTowerRung
  rw [finrank_spaceSub]; congr 1; push_cast; ring

/-- ★ `M/M_Pl = scaleTowerRung 28 (−1)` — the gravity half-rung is the `n=28`, `m=−1` instance. -/
theorem planckClosureRatio_as_rung : planckClosureRatio = scaleTowerRung 28 (-1) := by
  unfold planckClosureRatio scaleTowerRung
  rw [finrank_selfAdj_eq_28]; congr 1; push_cast; ring

/-- ★ `M_Pl/M = scaleTowerRung 28 (+1)` — the RECIPROCAL of the gravity half-rung is the SAME object
    with the multiplicity sign flipped (`m: −1 → +1`). -/
theorem planckMassRatio_as_rung : planckMassRatio = scaleTowerRung 28 1 := by
  unfold planckMassRatio scaleTowerRung
  rw [finrank_selfAdj_eq_28]; congr 1; push_cast; ring

/-- ★ `m₀/M = scaleTowerRung 9 (−2)` — the ν seesaw ratio is the Born SQUARE of the EW rung, i.e. the
    `n=9`, `m=−2` instance (multiplicity-doubling via `scaleTowerRung_sq`). -/
theorem seesawRatio_as_rung : seesawRatio = scaleTowerRung 9 (-2) := by
  rw [seesawRatio_born_square, ewClosureRatio_as_rung, scaleTowerRung_sq]; congr 1

/-- ★ `G·M² = scaleTowerRung 28 (−2)` — Newton's coupling is the Born SQUARE of the gravity half-rung,
    i.e. the `n=28`, `m=−2` instance (multiplicity-doubling via `scaleTowerRung_sq`). -/
theorem newtonScaleProduct_as_rung : newtonScaleProduct = scaleTowerRung 28 (-2) := by
  rw [newtonScaleProduct_born_square, planckClosureRatio_as_rung, scaleTowerRung_sq]; congr 1

/-! ## (3) THE QCD RUNG completes the structural triple `{7,9,28}`. -/

/-- ★ THE `n = 7` RUNG EXPONENT `rungExponent 7 = 12·cutPi`, the third quotient `84·cutPi / 7` of the
    shared numerator. FALLS OUT of `criticalPhaseNumerator_eq`; matches the banked `rungExponent_at_imO`
    at the banked `finrank_ImO = 7`. -/
theorem rungExponent_at_7 : rungExponent 7 = 12 * cutPi := by
  rw [rungExponent, criticalPhaseNumerator_eq]; push_cast; ring

/-- THE `n = 7` CLOSURE RATIO `cutExp(−12·cutPi)` — the `n=7`, `m=−1` instance completing the triple.
    Physics prose: the QCD running-depth rung. NO new dimensionful `Cut` atom — a dimensionless ratio
    (G3). -/
def qcdClosureRatio : Cut := scaleTowerRung 7 (-1)

/-- ★ THE QCD RUNG VALUE `cutExp(−12·cutPi)`. FALLS OUT of `rungExponent_at_7 = 12·cutPi` (the n=7
    quotient of the shared 84π numerator); never premised as a literal. -/
theorem qcdClosureRatio_eq : qcdClosureRatio = cutExp (-(12 * cutPi)) := by
  unfold qcdClosureRatio scaleTowerRung
  rw [rungExponent_at_7]; congr 1; push_cast; ring

/-- Born positivity of the QCD rung ratio (banked `cutExp_pos`). -/
theorem qcdClosureRatio_pos : 0 < qcdClosureRatio := by
  rw [qcdClosureRatio_eq]; exact cutExp_pos _

/-- STRICT SUPPRESSION: the QCD rung `< 1`. The argument `−(12·cutPi)` is strictly negative
    (`cutPi_pos`), so by banked `cutExp_strictMono` and `cutExp_zero`, `cutExp(−(12·cutPi)) < 1`. -/
theorem qcdClosureRatio_lt_one : qcdClosureRatio < 1 := by
  rw [qcdClosureRatio_eq]
  have hneg : -(12 * cutPi) < 0 := by have := cutPi_pos; linarith
  have := cutExp_strictMono hneg
  rwa [cutExp_zero] at this

/-! ## (4) THE EIGENVALUE READING — `{7,9,28}` as the negative-reciprocal eigenvalues of the ONE budget. -/

/-- ★ THE CRITICAL EIGENVALUE `λ_n = −n / criticalPhaseNumerator`. Built on the BANKED shared numerator
    (NOT the literal `84π`). Physics prose: the relevant-direction eigenvalue of the framework's one
    critical fixed point at the structural count `n`. -/
def criticalEigenvalue (n : ℕ) : Cut := -(n : Cut) / criticalPhaseNumerator

/-- `λ_n = −n / (84·cutPi)` — the eigenvalue in terms of the derived `84·cutPi` (via
    `criticalPhaseNumerator_eq`); never premised as a literal. -/
theorem criticalEigenvalue_eq (n : ℕ) :
    criticalEigenvalue n = -(n : Cut) / (84 * cutPi) := by
  unfold criticalEigenvalue; rw [criticalPhaseNumerator_eq]

/-- ★★ THE EIGENVALUE LOCK: `λ_n · rungExponent n = −1` for any nonzero count. The eigenvalue is the
    NEGATIVE RECIPROCAL of the rung exponent — the deepest structural identity of the tower. -/
theorem criticalEigenvalue_mul_rungExponent (n : ℕ) (hn : (n : Cut) ≠ 0) :
    criticalEigenvalue n * rungExponent n = -1 := by
  unfold criticalEigenvalue rungExponent
  have hK : criticalPhaseNumerator ≠ 0 := ne_of_gt criticalPhaseNumerator_pos
  field_simp

/-- ★★ THE SEED'S `K · λ_n = −n` FORM: the shared numerator times the eigenvalue returns `−n` — the
    three counts `{7,9,28}` are read directly off the eigenvalues scaled by the ONE budget. -/
theorem criticalPhaseNumerator_mul_eigenvalue (n : ℕ) :
    criticalPhaseNumerator * criticalEigenvalue n = -(n : Cut) := by
  unfold criticalEigenvalue
  have hK : criticalPhaseNumerator ≠ 0 := ne_of_gt criticalPhaseNumerator_pos
  field_simp

/-- `λ_n = −(rungExponent n)⁻¹` — the eigenvalue is exactly the negative multiplicative inverse of the
    rung exponent (`n ≠ 0`). -/
theorem criticalEigenvalue_eq_neg_inv_rung (n : ℕ) (hn : (n : Cut) ≠ 0) :
    criticalEigenvalue n = -(rungExponent n)⁻¹ := by
  unfold criticalEigenvalue rungExponent
  have hK : criticalPhaseNumerator ≠ 0 := ne_of_gt criticalPhaseNumerator_pos
  rw [inv_div]
  field_simp

/-- The `n = 7` eigenvalue `λ₇ = −1/(12·cutPi)`. FALLS OUT of `criticalEigenvalue_eq` (`−7/(84π) =
    −1/(12π)`). -/
theorem criticalEigenvalue_at_7 : criticalEigenvalue 7 = -1 / (12 * cutPi) := by
  rw [criticalEigenvalue_eq]; have hp := cutPi_pos; field_simp; ring

/-- The `n = 9` eigenvalue `λ₉ = −3/(28·cutPi)`. FALLS OUT of `criticalEigenvalue_eq` (`−9/(84π) =
    −3/(28π)`). -/
theorem criticalEigenvalue_at_9 : criticalEigenvalue 9 = -3 / (28 * cutPi) := by
  rw [criticalEigenvalue_eq]; have hp := cutPi_pos; field_simp; ring

/-- The `n = 28` eigenvalue `λ₂₈ = −1/(3·cutPi)`. FALLS OUT of `criticalEigenvalue_eq` (`−28/(84π) =
    −1/(3π)`). -/
theorem criticalEigenvalue_at_28 : criticalEigenvalue 28 = -1 / (3 * cutPi) := by
  rw [criticalEigenvalue_eq]; have hp := cutPi_pos; field_simp; ring

/-! ## (5) THE CAPSTONE — B7, the tower as ONE object with `{7,9,28}` the only structural freedom. -/

/-- ★★★ B7 — THE SCALE TOWER AS ONE OBJECT, all consequences at once, over the banked derived-ℝ
    `cutExp`/`cutPi` and the banked 84π critical-phase budget. Every banked scale ratio is the ONE
