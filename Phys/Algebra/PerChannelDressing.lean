/-! ## (A) THE PER-CHANNEL DRESSED SCREENING — the D3/Z5 dressing carried to a fixed channel census. -/

/-- THE PER-CHANNEL DRESSED SCREENING over a band tower at a FIXED channel census `c`: the sum of the
    depth-tower band steps (Z5 `dressedBandScreen`) evaluated at census `c` over each band's ratio.
    The census-in-census resummation of ONE channel's screening. -/
def dressedTotalScreeningWith (w c : Cut) (bands : List (Cut × Cut)) : Cut :=
  (bands.map (fun p => dressedBandScreen w c p.2)).sum

/-- ★★ THE PER-CHANNEL DRESSED FACTORING: the census-in-census dressing FACTORS by `/(1 − w)` — the
    SAME uniform Z5 factoring (`dressedTotalScreening_factor`), per channel. `dressedTotalScreeningWith
    w c bands = totalScreeningWith c bands / (1 − w)` for `0 ≤ w < 1`. Induction over the finite band
    list on Z5's per-band `dressedBandScreen_factor`. -/
theorem dressedTotalScreeningWith_factor (w : Cut) (hw0 : 0 ≤ w) (hw1 : w < 1) (c : Cut)
    (bands : List (Cut × Cut)) :
    dressedTotalScreeningWith w c bands = totalScreeningWith c bands / (1 - w) := by
  unfold dressedTotalScreeningWith totalScreeningWith
  induction bands with
  | nil => simp
  | cons p ps ih =>
    simp only [List.map_cons, List.sum_cons, add_div]
    rw [dressedBandScreen_factor w hw0 hw1 c p.2, ih]

/-- ★★ THE CENSUS HOMOGENEITY: `totalScreeningWith c bands = c · totalScreeningWith 1 bands`. Because
    `bandScreen` is LINEAR in the census (`bandScreen d r = κ·d·cutLog r`), the per-channel screening
    scales linearly in the channel census. The load-bearing simplifier: it isolates the DERIVED
    channel census `c` as a scalar factor of the ratio-only screening unit `T = totalScreeningWith 1`. -/
theorem totalScreeningWith_homog (c : Cut) (bands : List (Cut × Cut)) :
    totalScreeningWith c bands = c * totalScreeningWith 1 bands := by
  unfold totalScreeningWith
  induction bands with
  | nil => simp
  | cons p ps ih =>
    simp only [List.map_cons, List.sum_cons, mul_add]
    rw [ih]
    have : bandScreen c p.2 = c * bandScreen 1 p.2 := by unfold bandScreen; ring
    rw [this]

/-! ## (B) THE PER-CHANNEL DRESSED TOWERS AND THE RECOMBINED DRESSED EM COUPLING. -/

/-- THE DRESSED ISOSPIN TOWER over the derived ℝ: the isospin ceiling `invAlpha2High = 42` plus the
    per-channel dressed screening at the REDUCED isospin census `netIsoDepth s = isoDepth − s` (Z2,
    the Z1 negative gather self-census). -/
def dressedIsoTower (w s : Cut) (bands : List (Cut × Cut)) : Cut :=
  invAlpha2High + dressedTotalScreeningWith w (netIsoDepth s) bands

/-- THE DRESSED HYPERCHARGE TOWER over the derived ℝ: the hypercharge ceiling `invAlphaYHigh = 70`
    plus the per-channel dressed screening at the UNREDUCED hypercharge census `hyperDepth = 10/3`
    (Z2, the abelian channel carries zero gather self-census). -/
def dressedHyperTower (w : Cut) (bands : List (Cut × Cut)) : Cut :=
  invAlphaYHigh + dressedTotalScreeningWith w hyperDepth bands

/-- ★ THE RECOMBINED DRESSED ZERO-MOMENTUM ELECTROMAGNETIC COUPLING over the derived ℝ: the photon is
    the recombination of the two electroweak channels (Z2), each carrying its OWN derived ceiling, its
    OWN derived census, and the SAME per-channel depth dressing (D3/Z5) at the shared return-surface
    weight `w`. `dressedInvAlphaEM w s bands := dressedIsoTower w s bands + dressedHyperTower w bands`. -/
def dressedInvAlphaEM (w s : Cut) (bands : List (Cut × Cut)) : Cut :=
  dressedIsoTower w s bands + dressedHyperTower w bands

/-- ★★★ THE RECOMBINED DRESSED CLOSED FORM: `dressedInvAlphaEM w s bands = 112 + ((chargeTraceDepth −
    s) · totalScreeningWith 1 bands) / (1 − w)`. The two ceilings sum to `42 + 70 = 112`; the census
    SPLITS additively (`chargeTraceDepth = isoDepth + hyperDepth`, D2b `census_additive`), so under the
    per-channel dressing only the isospin reduction `−s` survives the weld, factored by `/(1 − w)` over
    the ratio-only screening unit `totalScreeningWith 1 bands`. EXACT closed function of `Cut`. -/
theorem dressedInvAlphaEM_closed (w s : Cut) (hw0 : 0 ≤ w) (hw1 : w < 1)
    (bands : List (Cut × Cut)) :
    dressedInvAlphaEM w s bands
      = 112 + ((chargeTraceDepth - s) * totalScreeningWith 1 bands) / (1 - w) := by
  unfold dressedInvAlphaEM dressedIsoTower dressedHyperTower
  rw [dressedTotalScreeningWith_factor w hw0 hw1, dressedTotalScreeningWith_factor w hw0 hw1,
      totalScreeningWith_homog (netIsoDepth s), totalScreeningWith_homog hyperDepth,
      invAlpha2High_eq, invAlphaYHigh_eq]
  unfold netIsoDepth
  rw [census_additive]
  have h1w : (1 : Cut) - w ≠ 0 := sub_ne_zero.mpr (fun h => (ne_of_lt hw1) h.symm)
  field_simp
  ring

/-- ★★ THE ANTI-SCREENING REDUCTION (EXACT closed form): the recombined dressed endpoint at reduction
    `s` is the `s = 0` endpoint MINUS the isospin anti-screening term `(s · totalScreeningWith 1
    bands)/(1 − w)`. The Z1 negative gather self-census, composed through the depth dressing, ENTERS
    as a strictly-subtractive term. -/
theorem dressedInvAlphaEM_antiscreen (w s : Cut) (hw0 : 0 ≤ w) (hw1 : w < 1)
    (bands : List (Cut × Cut)) :
    dressedInvAlphaEM w s bands
      = dressedInvAlphaEM w 0 bands - (s * totalScreeningWith 1 bands) / (1 - w) := by
  rw [dressedInvAlphaEM_closed w s hw0 hw1, dressedInvAlphaEM_closed w 0 hw0 hw1]
  have h1w : (1 : Cut) - w ≠ 0 := sub_ne_zero.mpr (fun h => (ne_of_lt hw1) h.symm)
  field_simp
  ring

/-! ## (C) THE SCREENING UNIT IS POSITIVE (from the banked numeral) — the dressing acts on a real base. -/

/-- On the complete charge band list, `chargeTraceDepth · (totalScreeningWith 1 (charge list))` equals
    the banked X6 `totalScreening (charge list)` (D2b `totalScreeningWith_eq_totalScreening` +
    census homogeneity). -/
theorem chargeDepth_screeningUnit_eq :
    chargeTraceDepth * totalScreeningWith 1 (completeBandList chargeTraceDepth)
      = totalScreening (completeBandList chargeTraceDepth) := by
  rw [← totalScreeningWith_homog,
      totalScreeningWith_eq_totalScreening _ completeBandList_all_charge]

/-- THE BANKED NUMERAL GIVES POSITIVE TOTAL SCREENING: `totalScreening (completeBandList
    chargeTraceDepth) > 0`, because the banked D7 numeral bracket lower bound `12007329939722/
    176714586765 ≈ 67.95` exceeds the ceiling `42` (`invAlphaZero = 42 + totalScreening`). -/
theorem numeral_screening_pos :
    (0 : Cut) < totalScreening (completeBandList chargeTraceDepth) := by
  have hlo := theNumeral_bracket.1
  have hclosed : invAlphaZero (completeBandList chargeTraceDepth)
      = invAlphaHigh + totalScreening (completeBandList chargeTraceDepth) := rfl
  rw [invAlphaHigh_eq] at hclosed
  have hval : (12007329939722 / 176714586765 : Cut) > 42 := by norm_num
  linarith [hlo, hclosed, hval]

/-- ★★ THE SCREENING UNIT IS POSITIVE: `0 < totalScreeningWith 1 (completeBandList chargeTraceDepth)`
    (from `numeral_screening_pos` and `chargeTraceDepth = 16/3 > 0`). The depth dressing acts on a
    genuinely nonzero screening base — the running is real. -/
theorem screeningUnit_pos :
    (0 : Cut) < totalScreeningWith 1 (completeBandList chargeTraceDepth) := by
  have hprod := chargeDepth_screeningUnit_eq
  have hpos := numeral_screening_pos
  have hcpos : (0 : Cut) < chargeTraceDepth := chargeTraceDepth_pos
  nlinarith [hpos, hprod, hcpos]

/-! ## (D) THE s = 0 RECOVERY AND THE DOWNWARD DIRECTION — the dressed weld composed. -/

/-- ★★★ THE s = 0 COMPOSED DRESSED ENDPOINT = `dressedInvAlphaZero + 70`: with the isospin
    anti-screening switched off, the recombined dressed endpoint on the complete charge list is EXACTLY
    the dressed single-fold-coupling endpoint (Z5 `dressedInvAlphaZero`) LIFTED by the second
    (hypercharge) ceiling `70`. The DRESSED analog of D2b's `composed_endpoint` — the depth dressing
    composed through the recombination weld. -/
theorem dressedInvAlphaEM_s0_composed (w : Cut) (hw0 : 0 ≤ w) (hw1 : w < 1) :
    dressedInvAlphaEM w 0 (completeBandList chargeTraceDepth)
      = dressedInvAlphaZero w (completeBandList chargeTraceDepth) + 70 := by
  rw [dressedInvAlphaEM_closed w 0 hw0 hw1, dressedInvAlphaZero_closed w hw0 hw1]
  rw [← chargeDepth_screeningUnit_eq]
  have h1w : (1 : Cut) - w ≠ 0 := sub_ne_zero.mpr (fun h => (ne_of_lt hw1) h.symm)
  field_simp
  ring

/-- ★★ THE ISOSPIN ANTI-SCREENING RUNS THE RECOMBINED DRESSED ENDPOINT DOWN: for `0 < s`, `0 ≤ w < 1`
    on the complete charge list, `dressedInvAlphaEM w s (charge list) < dressedInvAlphaEM w 0 (charge
    list)`. The Z1 negative gather self-census (isospin channel) pulls the recombined dressed endpoint
    strictly below its un-anti-screened value — the reduction term `(s · T)/(1 − w) > 0` because the
    screening unit `T = totalScreeningWith 1 (charge list)` is POSITIVE (`screeningUnit_pos`, from the
    banked numeral). This is the precise sense of "without the per-channel dressing the composed sum
    overshoots": the `s = 0` value is `dressedInvAlphaZero + 70`; the gather self-census pulls it
    down. DIRECTION forced (Z1 sign); magnitude `s` bounded, never fitted. -/
theorem dressedInvAlphaEM_runs_down (w s : Cut) (hw0 : 0 ≤ w) (hw1 : w < 1) (hs : 0 < s) :
    dressedInvAlphaEM w s (completeBandList chargeTraceDepth)
      < dressedInvAlphaEM w 0 (completeBandList chargeTraceDepth) := by
  rw [dressedInvAlphaEM_closed w s hw0 hw1, dressedInvAlphaEM_closed w 0 hw0 hw1]
  have hT := screeningUnit_pos
  have h1w : (0 : Cut) < 1 - w := by linarith
  have hred : (0 : Cut) <
      (s * totalScreeningWith 1 (completeBandList chargeTraceDepth)) / (1 - w) :=
    div_pos (mul_pos hs hT) h1w
  have hsub0 : chargeTraceDepth - (0 : Cut) = chargeTraceDepth := by ring
  rw [hsub0]
  have hsplit : (chargeTraceDepth - s) * totalScreeningWith 1 (completeBandList chargeTraceDepth)
      = chargeTraceDepth * totalScreeningWith 1 (completeBandList chargeTraceDepth)
        - s * totalScreeningWith 1 (completeBandList chargeTraceDepth) := by ring
  rw [hsplit, sub_div]
  linarith [hred]

/-! ## (E) THE SHARED DERIVED WEIGHT — the two channels dress at the SAME return-surface geometry. -/

/-- ★★ THE SHARED WEIGHT IS D3's DERIVED RETURN-SURFACE GEOMETRY: the per-channel dressing weight is
    `depthWeight = 1/3` (D3 `depthWeight_eq`), CHANNEL-INDEPENDENT — one return surface, one
    self-reference, one weight. The recombined dressed endpoint at the derived weight reads the
    closed form at `w = 1/3`. -/
theorem dressedInvAlphaEM_at_depthWeight (s : Cut) :
    dressedInvAlphaEM depthWeight s (completeBandList chargeTraceDepth)
      = 112 + ((chargeTraceDepth - s)
          * totalScreeningWith 1 (completeBandList chargeTraceDepth)) / (1 - depthWeight) :=
  dressedInvAlphaEM_closed depthWeight s (le_of_lt depthWeight_pos) depthWeight_lt_one _

/-! ## (F) W8 NON-VACUITY WITH TEETH. -/

/-- ★★ W8 — THE DEPTH DRESSING GENUINELY DRESSES: for a nontrivial weight `0 < w < 1` the recombined
    dressed endpoint at `s = 0` strictly EXCEEDS the bare (`w = 0`) recombined endpoint. The
    census-in-census resummation adds — the dressing is not a null step. -/
theorem dressed_gt_bare (w : Cut) (hw0 : 0 < w) (hw1 : w < 1) :
    dressedInvAlphaEM 0 0 (completeBandList chargeTraceDepth)
      < dressedInvAlphaEM w 0 (completeBandList chargeTraceDepth) := by
  rw [dressedInvAlphaEM_closed 0 0 (le_refl 0) (by norm_num),
      dressedInvAlphaEM_closed w 0 (le_of_lt hw0) hw1]
  have hT := screeningUnit_pos
  have hcpos : (0 : Cut) < chargeTraceDepth := chargeTraceDepth_pos
  set T := totalScreeningWith 1 (completeBandList chargeTraceDepth) with hTdef
  have hnum : (0 : Cut) < (chargeTraceDepth - 0) * T := by
    have h0 : chargeTraceDepth - (0 : Cut) = chargeTraceDepth := by ring
    rw [h0]; exact mul_pos hcpos hT
  have h1w : (0 : Cut) < 1 - w := by linarith
  have hbase : ((chargeTraceDepth - 0) * T) / (1 - 0) = (chargeTraceDepth - 0) * T := by norm_num
  rw [hbase]
  set X := (chargeTraceDepth - 0) * T with hXdef
  have hkey : X < X / (1 - w) := by
    rw [lt_div_iff₀ h1w]
    nlinarith [hnum, hw0]
  linarith [hkey]

