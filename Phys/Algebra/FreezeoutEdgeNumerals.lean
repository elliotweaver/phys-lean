  have h := mass0_lo
  have hk : (56 : Cut) / 10 ≤ (237943 : Cut) / 100000 * (237943 / 100000) := by norm_num
  linarith

/-- `mass0 ≤ 57/10`: the banked N340 upper numeral `mass0 ≤ (237944/1e5)²` cleared to a clean rational
