    (4 : Cut) ≤ cutLog downConfBundle ∧ cutLog downConfBundle ≤ 45 / 10 := by
  obtain ⟨hlo, hhi⟩ := downConfBundle_bracket
  have hpos : (0 : Cut) < downConfBundle := downConfBundle_pos
  refine ⟨?_, ?_⟩
  · apply cutLog_ge_certified downConfBundle 4 6 (by norm_num) (by norm_num)
