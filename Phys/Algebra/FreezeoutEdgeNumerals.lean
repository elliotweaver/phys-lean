/-! ## (D) ★ THE `L_b0 = cutLog (bMass 0)` CERTIFIED BRACKET — `[17/10, 18/10]`. -/

/-- ★★ THE HEAVY SHAPE LOG BRACKET: `17/10 ≤ cutLog (bMass 0) ≤ 18/10`. `bMass 0 = mass0 ∈ [56/10,
    57/10]`, and the banked exp instrument certifies the log via `cutLog_mono`:
      LOWER: `partialExp (17/10) 12 + expRemBound (17/10) 12 ≤ 56/10 ≤ mass0`, so `17/10 ≤ cutLog mass0`;
      UPPER: `mass0 ≤ 57/10 ≤ partialExp (18/10) 14`, so `cutLog mass0 ≤ 18/10`. -/
theorem Lb0_bracket :
    (17 : Cut) / 10 ≤ cutLog (bMass 0) ∧ cutLog (bMass 0) ≤ 18 / 10 := by
  rw [bMass0_eq]
  have hpos : (0 : Cut) < mass0 := mass0_pos
  refine ⟨?_, ?_⟩
  · -- 17/10 ≤ cutLog mass0 : certified at 56/10, monotone up to mass0
    have hcert : (17 : Cut) / 10 ≤ cutLog (56 / 10) := by
      apply cutLog_ge_certified (56 / 10) (17 / 10) 12 (by norm_num) (by norm_num)
      show partialExp (17 / 10 : Cut) 12 + expRemBound (17 / 10 : Cut) 12 ≤ (56 : Cut) / 10
      unfold partialExp expTermC expRemBound
      simp only [Finset.sum_range_succ, Finset.sum_range_zero]
      norm_num [Nat.factorial]
    have hmono : cutLog ((56 : Cut) / 10) ≤ cutLog mass0 := cutLog_mono (by norm_num) mass0_ge_clean
    linarith
  · -- cutLog mass0 ≤ 18/10 : monotone from mass0 to 57/10, certified at 57/10
    have hmono : cutLog mass0 ≤ cutLog ((57 : Cut) / 10) := cutLog_mono hpos mass0_le_clean
    have hcert : cutLog ((57 : Cut) / 10) ≤ (18 : Cut) / 10 := by
      apply cutLog_le_certified (57 / 10) (18 / 10) 14 (by norm_num) (by norm_num)
      show (57 : Cut) / 10 ≤ partialExp (18 / 10 : Cut) 14
      unfold partialExp expTermC
      simp only [Finset.sum_range_succ, Finset.sum_range_zero]
      norm_num [Nat.factorial]
    linarith

/-! ## (E) ★ THE `L_b2 = cutLog (bMass 2)` CERTIFIED BRACKET — `[−12/10, −1]` (via `cutLog (1/mass2)`). -/

/-- The reciprocal-log identity `cutLog (1/mass2) = − cutLog mass2` (banked `cutLog_inv_pos`). -/
theorem cutLog_inv_mass2 : cutLog (1 / mass2) = - cutLog mass2 :=
  Phys.Algebra.ComposedFreezeoutDissolved.cutLog_inv_pos mass2_pos

/-- The `1/mass2` clean bracket: from `33/100 ≤ mass2 ≤ 34/100`, reciprocal-monotone gives
    `100/34 ≤ 1/mass2 ≤ 100/33`. -/
theorem invMass2_bracket : (100 : Cut) / 34 ≤ 1 / mass2 ∧ 1 / mass2 ≤ 100 / 33 := by
  have hpos : (0 : Cut) < mass2 := mass2_pos
  refine ⟨?_, ?_⟩
  · -- 100/34 ≤ 1/mass2 : from mass2 ≤ 34/100
    rw [le_div_iff₀ hpos]
    have := mass2_le_clean
    nlinarith [this]
  · -- 1/mass2 ≤ 100/33 : from 33/100 ≤ mass2
    rw [div_le_iff₀ hpos]
    have := mass2_ge_clean
    nlinarith [this]

/-- ★★ THE LIGHT SHAPE LOG BRACKET: `−12/10 ≤ cutLog (bMass 2) ≤ −1`. Read from the reciprocal
    `cutLog (1/mass2) ∈ [1, 12/10]` (certified via the banked exp instrument at `1/mass2 ∈ [100/34,
    100/33]`) through the identity `cutLog mass2 = − cutLog (1/mass2)`. The light shape log is a
    genuine NEGATIVE certified number. -/
theorem Lb2_bracket :
    (-(12 / 10) : Cut) ≤ cutLog (bMass 2) ∧ cutLog (bMass 2) ≤ - 1 := by
  rw [bMass2_eq]
  obtain ⟨hlo, hhi⟩ := invMass2_bracket
  have hinvpos : (0 : Cut) < 1 / mass2 := by positivity
  -- 1 ≤ cutLog (1/mass2) ≤ 12/10
  have hlog_lo : (1 : Cut) ≤ cutLog (1 / mass2) := by
    have hcert : (1 : Cut) ≤ cutLog (100 / 34) := by
      apply cutLog_ge_certified (100 / 34) 1 8 (by norm_num) (by norm_num)
      show partialExp (1 : Cut) 8 + expRemBound (1 : Cut) 8 ≤ (100 : Cut) / 34
      unfold partialExp expTermC expRemBound
      simp only [Finset.sum_range_succ, Finset.sum_range_zero]
      norm_num [Nat.factorial]
    have hmono : cutLog ((100 : Cut) / 34) ≤ cutLog (1 / mass2) := cutLog_mono (by norm_num) hlo
    linarith
  have hlog_hi : cutLog (1 / mass2) ≤ (12 : Cut) / 10 := by
    have hmono : cutLog (1 / mass2) ≤ cutLog ((100 : Cut) / 33) := cutLog_mono hinvpos hhi
    have hcert : cutLog ((100 : Cut) / 33) ≤ (12 : Cut) / 10 := by
      apply cutLog_le_certified (100 / 33) (12 / 10) 10 (by norm_num) (by norm_num)
      show (100 : Cut) / 33 ≤ partialExp (12 / 10 : Cut) 10
      unfold partialExp expTermC
      simp only [Finset.sum_range_succ, Finset.sum_range_zero]
      norm_num [Nat.factorial]
    linarith
  -- transfer to cutLog mass2 = − cutLog (1/mass2)
  have hid : cutLog (1 / mass2) = - cutLog mass2 := cutLog_inv_mass2
  rw [hid] at hlog_lo hlog_hi
  constructor <;> linarith

/-! ## (F) ★ THE `L_dcb = cutLog downConfBundle` CERTIFIED BRACKET — `[4, 45/10]`. -/

/-- ★★ THE DOWN/CONFINEMENT BUNDLE LOG BRACKET: `4 ≤ cutLog downConfBundle ≤ 45/10`. From the banked M5
    numeral `downConfBundle ∈ [7280/100, 7288/100]` and the banked exp instrument:
