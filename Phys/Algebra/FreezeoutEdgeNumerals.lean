        ≤ 7280 / 100 := by
          unfold partialExp expTermC expRemBound
          simp only [Finset.sum_range_succ, Finset.sum_range_zero]
          norm_num [Nat.factorial]
      _ ≤ downConfBundle := hlo
  · apply cutLog_le_certified downConfBundle (45 / 10) 12 (by norm_num) hpos
    calc downConfBundle ≤ 7288 / 100 := hhi
      _ ≤ partialExp (45 / 10 : Cut) 12 := by
          unfold partialExp expTermC
          simp only [Finset.sum_range_succ, Finset.sum_range_zero]
          norm_num [Nat.factorial]

