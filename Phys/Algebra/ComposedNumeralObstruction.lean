theorem admissible_points :
    (0 : Cut) < 1 / 2 ∧ (1 / 2 : Cut) < isoDepth ∧ (0 : Cut) < 3 / 2 ∧ (3 / 2 : Cut) < isoDepth := by
  rw [isoDepth_eq]
  refine ⟨by norm_num, by norm_num, by norm_num, by norm_num⟩

/-- ★ W8 — THE TWO ADMISSIBLE POINTS ARE GENUINELY DISTINCT: `1/2 ≠ 3/2`. The spread is between two
