/-! ## (A) THE COMPLETE COMPOSED ENDPOINT — the full D2b+D2c+D2d stack (re-export, non-hollow). -/

/-- ★ THE COMPOSED OBJECT IS THE FULL STACK: the D2d fully-composed endpoint reads EXACTLY the D2c
    per-channel dressed recombined coupling PLUS the D2d join-content threshold — the complete
    D2b (weld) + D2c (per-channel dressing) + D2d (join) composition. This node's obstruction is a
    fact about THIS object, not a generic carrier. -/
theorem composition_is_complete_stack (w s j : Cut) (bands : List (Cut × Cut)) :
    dressedInvAlphaEMJoin w s j bands = dressedInvAlphaEM w s bands + joinContent w j :=
  dressedInvAlphaEMJoin_split w s j bands

/-! ## (B) THE EXACT s-DIFFERENCE — joinContent cancels, so the spread is j-independent. -/

/-- ★★★ THE EXACT s-DIFFERENCE (`j`-independent — the join-content threshold CANCELS): for the
    derived weight and any two isospin anti-screening magnitudes `s₁, s₂`,

        dressedInvAlphaEMJoin w s₁ j bands − dressedInvAlphaEMJoin w s₂ j bands
          = ((s₂ − s₁)·totalScreeningWith 1 bands)/(1 − w).

    Because `joinContent w j` does NOT depend on `s`, it drops out of the difference — the composed
    numeral's dependence on the free parameter `s` is exactly the D2c dressed screening term. This is
    the exact structural handle on the obstruction. -/
theorem composed_s_difference (w s₁ s₂ j : Cut) (hw0 : 0 ≤ w) (hw1 : w < 1)
    (bands : List (Cut × Cut)) :
    dressedInvAlphaEMJoin w s₁ j bands - dressedInvAlphaEMJoin w s₂ j bands
      = ((s₂ - s₁) * totalScreeningWith 1 bands) / (1 - w) := by
  rw [dressedInvAlphaEMJoin_split, dressedInvAlphaEMJoin_split,
      dressedInvAlphaEM_closed w s₁ hw0 hw1,
      dressedInvAlphaEM_closed w s₂ hw0 hw1]
  have h1w : (1 : Cut) - w ≠ 0 := sub_ne_zero.mpr (fun h => (ne_of_lt hw1) h.symm)
  field_simp
  ring

/-! ## (C) THE SCREENING UNIT LOWER BOUND — from the banked D7 numeral. -/

/-- ★★ THE SCREENING UNIT EXCEEDS `2/3`: `totalScreeningWith 1 (completeBandList chargeTraceDepth) >
    2/3`. The banked identity `chargeTraceDepth · totalScreeningWith 1 = totalScreening` (D2c
    `chargeDepth_screeningUnit_eq`) with `chargeTraceDepth = 16/3` (X6) and the banked D7 numeral
    lower bound (`invAlphaZero = 42 + totalScreening ≥ 12007329939722/176714586765`, so
    `totalScreening ≥ 4585317295592/176714586765 ≈ 25.95`) force the screening unit above `2/3`. The
    dominant free parameter `s` therefore acts on a genuinely large screening base. -/
theorem screeningUnit_gt_twothirds :
    (2 / 3 : Cut) < totalScreeningWith 1 (completeBandList chargeTraceDepth) := by
  have hprod := chargeDepth_screeningUnit_eq
  have hcd := chargeTraceDepth_eq
  have hlo := theNumeral_bracket.1
  have hclosed : invAlphaZero (completeBandList chargeTraceDepth)
      = 42 + totalScreening (completeBandList chargeTraceDepth) := by
    have h0 : invAlphaZero (completeBandList chargeTraceDepth)
        = invAlphaHigh + totalScreening (completeBandList chargeTraceDepth) := rfl
    rw [invAlphaHigh_eq] at h0; exact h0
  have hSbound : (4585317295592 / 176714586765 : Cut)
      ≤ totalScreening (completeBandList chargeTraceDepth) := by
    rw [hclosed] at hlo; linarith
  rw [hcd] at hprod hSbound ⊢
  -- hprod : 16/3 * T = S,  hSbound : c ≤ S,  goal : 2/3 < T   (linear in the atoms T, S)
  linarith [hprod, hSbound]

/-! ## (D) THE OBSTRUCTION — the composed numeral cannot be pinned to width < 1 while s is free. -/

/-- ★★★ THE COMPOSED NUMERAL IS UNPINNABLE (the exact obstruction): at the derived weight
    `w = depthWeight`, the fully-composed endpoint at the admissible point `s = 1/2` minus its value
    at the admissible point `s = 3/2` STRICTLY EXCEEDS `1`:

        dressedInvAlphaEMJoin depthWeight (1/2) j (completeBandList chargeTraceDepth)
          − dressedInvAlphaEMJoin depthWeight (3/2) j (completeBandList chargeTraceDepth) > 1,

    independent of `j`. Because both `s`-points lie in the banked open range `(0, isoDepth = 2)`, the
    composed numeral floats by more than `1` across admissible parameters — it is NOT determined to
    width `< 1`, let alone the width `< 10⁻¹¹` a ≥15-significant-digit bracket demands. The numeral
    cannot be restated until `s` is DERIVED. -/
theorem composed_numeral_unpinnable (j : Cut) :
    (1 : Cut)
      < dressedInvAlphaEMJoin depthWeight (1 / 2) j (completeBandList chargeTraceDepth)
        - dressedInvAlphaEMJoin depthWeight (3 / 2) j (completeBandList chargeTraceDepth) := by
  rw [composed_s_difference depthWeight (1 / 2) (3 / 2) j (le_of_lt depthWeight_pos)
        depthWeight_lt_one]
  have hT := screeningUnit_gt_twothirds
  rw [depthWeight_eq]
  have h : ((3 / 2 - 1 / 2 : Cut) * totalScreeningWith 1 (completeBandList chargeTraceDepth))
        / (1 - 1 / 3)
      = (3 / 2) * totalScreeningWith 1 (completeBandList chargeTraceDepth) := by ring
  rw [h]
  linarith [hT]

/-- ★★★ NO NARROW BRACKET (the obstruction in bracket form): ANY rational bracket `[lo, hi]` that
    contains the fully-composed endpoint at BOTH admissible points `s = 1/2` and `s = 3/2` has width
    `hi − lo > 1`. A ≥15-significant-digit two-sided bracket (width `< 10⁻¹¹`) is therefore
