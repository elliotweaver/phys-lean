    ∧ (dressedInvAlphaEMJoin w s₁ j bands - dressedInvAlphaEMJoin w s₂ j bands
        = ((s₂ - s₁) * totalScreeningWith 1 bands) / (1 - w))
    -- (3) the screening-unit lower bound
    ∧ (2 / 3 : Cut) < totalScreeningWith 1 (completeBandList chargeTraceDepth)
    -- (4) the obstruction: the two-point spread exceeds 1
    ∧ (1 : Cut) < dressedInvAlphaEMJoin depthWeight (1 / 2) j (completeBandList chargeTraceDepth)
        - dressedInvAlphaEMJoin depthWeight (3 / 2) j (completeBandList chargeTraceDepth)
    -- (5) teeth
    ∧ ((0 : Cut) < 1 / 2 ∧ (1 / 2 : Cut) < isoDepth ∧ (0 : Cut) < 3 / 2 ∧ (3 / 2 : Cut) < isoDepth)
    ∧ (1 / 2 : Cut) ≠ 3 / 2
    ∧ (0 : Cut) < totalScreeningWith 1 (completeBandList chargeTraceDepth) :=
  ⟨composition_is_complete_stack w s₁ j bands,
   composed_s_difference w s₁ s₂ j hw0 hw1 bands,
   screeningUnit_gt_twothirds,
   composed_numeral_unpinnable j,
