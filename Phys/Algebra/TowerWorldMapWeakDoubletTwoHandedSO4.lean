-- Instance-search budget bump (instance search only, NOT the proof kernel) — the banked
-- N255/N257/…/N261/N264/N279 precedent for the End-of-O / octonion-tower instance diamonds.
set_option synthInstance.maxHeartbeats 400000

noncomputable section

/-! ## (A) The RIGHT-regular operators of the three last-doubled H-imaginary units. -/

/-- The right-regular operator of the first H-imaginary unit, `R_hI = rightReg u1M`. -/
noncomputable def rregI : Module.End ℚ (O ℚ) := rightReg u1M
/-- The right-regular operator of the second H-imaginary unit, `R_hJ = rightReg e2I`. -/
noncomputable def rregJ : Module.End ℚ (O ℚ) := rightReg e2I
/-- The right-regular operator of the third H-imaginary unit, `R_hK = rightReg e3I`. -/
noncomputable def rregK : Module.End ℚ (O ℚ) := rightReg e3I

@[simp] theorem rregI_apply (y : O ℚ) : rregI y = y * u1 := rfl
@[simp] theorem rregJ_apply (y : O ℚ) : rregJ y = y * e2O := rfl
@[simp] theorem rregK_apply (y : O ℚ) : rregK y = y * e3O := rfl

/-! ## (B) The generic RIGHT-regular commutator obstruction = the associator (mirror of N279). -/

/-- ★★★ THE GENERIC RIGHT OBSTRUCTION IDENTITY (coordinate-free, from `assoc_swap23`): for ALL
    `a b y : O ℚ`, the failure of the right-regular commutator `R_a R_b - R_b R_a` (acting as
    `y ↦ (y*b)*a - (y*a)*b`) to equal the right-regular of the algebra commutator `R_{b*a - a*b}`
    is EXACTLY (twice) the associator:
      `(y*b)*a - (y*a)*b - y*(b*a - a*b) = -2 • assoc y a b`.
    The MIRROR of N279's `leftmul_comm_obstruction` (which used `assoc_swap12`); here the antisymmetry
    is in the LAST two slots (`assoc_swap23`). The right-regular action fails to be a Lie
    anti-homomorphism precisely by the banked associator (the gather gluing obstruction, N219). -/
theorem rightmul_comm_obstruction (a b y : O ℚ) :
    (y * b) * a - (y * a) * b - y * (b * a - a * b) = (-2 : ℚ) • assoc y a b := by
  have h : assoc y b a = - assoc y a b := eq_neg_of_add_eq_zero_right (assoc_swap23 y a b)
  have key : (y * b) * a - (y * a) * b - y * (b * a - a * b)
      = assoc y b a - assoc y a b := by
    simp only [assoc, mul_sub]; abel
  rw [key, h]; module

/-! ## (C) The RIGHT su(2) closure on the associative rung H (opposite orientation `-2`). -/

/-- ★★ THE su(2)_R CLOSURE ON THE ASSOCIATIVE RUNG H (leg I,J → K). For every `y` in the H-image
    (`y = iotaO w`), the right-regular commutator closes: `⁅R_hI, R_hJ⁆ y = -2 • (R_hK y)`. The
    structure constant is `-2` — the OPPOSITE orientation to su(2)_L's `+2` (N279): the two hands are
    the two SO(4) chiral factors. As with the left, the closure uses `hI*hJ = hK`, `hJ*hI = -hK` AND
    the associator vanishing on H (`assoc_iotaO`). -/
theorem rightReg_closure_on_H_IJ (w : H ℚ) :
    rregI (rregJ (iotaO w)) - rregJ (rregI (iotaO w)) = (-2 : ℚ) • rregK (iotaO w) := by
  simp only [rregI_apply, rregJ_apply, rregK_apply]
  rw [u1_iotaO, e2O_iotaO, e3O_iotaO]
  have hob := rightmul_comm_obstruction (iotaO hI) (iotaO hJ) (iotaO w)
  have hz : assoc (iotaO w) (iotaO hI) (iotaO hJ) = 0 := assoc_iotaO w hI hJ
  rw [hz, smul_zero] at hob
  -- hJ*hI - hI*hJ = -2 hK
  have hcomm : iotaO hJ * iotaO hI - iotaO hI * iotaO hJ = iotaO ((-2 : ℚ) • hK) := by
    rw [show (iotaO hJ * iotaO hI) = iotaO (hJ * hI) from (CD.iota_mul hJ hI).symm,
        show (iotaO hI * iotaO hJ) = iotaO (hI * hJ) from (CD.iota_mul hI hJ).symm,
        ← map_sub]
    congr 1
    rw [hJ_hI, hI_hJ]; module
  have := sub_eq_zero.mp hob
  rw [this, hcomm]
  rw [show iotaO ((-2:ℚ) • hK) = (-2:ℚ) • iotaO hK from map_smul iotaO (-2) hK]
  rw [← e3O_iotaO]
  exact qsmul_mul_right (-2) (iotaO w) e3O

/-! ## (D) The LEFT and RIGHT su(2)'s COMMUTE on H — the `so(4) = su(2)_L ⊕ su(2)_R`. -/

/-- ★★★ THE so(4) STRUCTURE: the LEFT and RIGHT su(2)'s COMMUTE on the associative rung H. For every
    `y` in the H-image, `⁅L_hI, R_hJ⁆ y = 0` — the left- and right-regular actions of the H-units
    mutually commute there, because the associator `(hI, y, hJ)` vanishes on H (`assoc_iotaO`). So on
    the last associative rung the two fundamental su(2) doublets assemble the `so(4) = su(2)_L ⊕
    su(2)_R` (the rotation algebra of `H`, SO(4) ≅ SU(2)×SU(2), realized as left/right multiplication).
    This commuting is EXACTLY what the octonionic non-associativity destroys off H (`so4_breaks_on_O`). -/
theorem leftRight_commute_on_H (w : H ℚ) :
    lregI (rregJ (iotaO w)) - rregJ (lregI (iotaO w)) = 0 := by
  simp only [lregI_apply, rregJ_apply]
  rw [u1_iotaO, e2O_iotaO]
  have hz : assoc (iotaO hI) (iotaO w) (iotaO hJ) = 0 := assoc_iotaO hI w hJ
  have hthis : (iotaO hI * iotaO w) * iotaO hJ - iotaO hI * (iotaO w * iotaO hJ) = 0 := hz
  rw [sub_eq_zero] at hthis ⊢
  exact hthis.symm

/-! ## (E) The RIGHT doublet Casimir = -3•id (the spin-½ / fundamental certificate). -/

/-- ★★ THE RIGHT FUNDAMENTAL DOUBLET CASIMIR: `(R_hI)² + (R_hJ)² + (R_hK)² = -3 • id` on ALL of
    `O ℚ`. Each square is `-(gForm ·)•id = -1•id` (via the banked `rightReg_sq`, N264 + the units
    being Born-normalized), so the sum is `-3•id` — the spin-½ / FUNDAMENTAL DOUBLET certificate,
    EQUAL to the left doublet's (N279 `leftReg_casimir_eq_neg_three`). Both hands are spin-½. -/
theorem rightReg_casimir_eq_neg_three :
    rregI.comp rregI + rregJ.comp rregJ + rregK.comp rregK = (-3 : ℚ) • LinearMap.id := by
  show (rightReg u1M).comp (rightReg u1M) + (rightReg e2I).comp (rightReg e2I)
      + (rightReg e3I).comp (rightReg e3I) = (-3 : ℚ) • LinearMap.id
  rw [rightReg_sq u1M, rightReg_sq e2I, rightReg_sq e3I, gForm_u1M, gForm_e2I, gForm_e3I]
  module

/-! ## (F) The RIGHT su(2) is obstructed on the full spinor by the SAME associator (confinement). -/

/-- ★★★ THE RIGHT OBSTRUCTION IS THE ASSOCIATOR (one-cause, coordinate-free). The right-regular
    commutator defect equals `-2 •` the banked associator on the H-imaginary units — the SAME
    associator (up to slot order) as the left (N279 `leftReg_defect_eq_associator`) and the SAME one
    that stops the cascade (N2c), caps generations (N5), and blocks the chirality fusion (N264). So
    BOTH hands' su(2) are confined to H by ONE cause. -/
theorem rightReg_defect_eq_associator (y : O ℚ) :
    rregI (rregJ y) - rregJ (rregI y) - (-2 : ℚ) • rregK y = (-2 : ℚ) • assoc y u1 e2O := by
  simp only [rregI_apply, rregJ_apply, rregK_apply]
  have hcomm : e2O * u1 - u1 * e2O = (-2 : ℚ) • e3O := by
    have h1 : u1 * e2O = e3O := by rw [← JO_apply]; exact JO_e2
    have h2 : e2O * u1 = -e3O := by
      rw [u1_iotaO, e2O_iotaO,
          show (iotaO hJ * iotaO hI) = iotaO (hJ * hI) from (CD.iota_mul hJ hI).symm, hJ_hI,
          map_neg, ← e3O_iotaO]
    rw [h1, h2]; module
  have hob := rightmul_comm_obstruction u1 e2O y
  rw [hcomm, qsmul_mul_right] at hob
  exact hob

/-- The concrete RIGHT obstruction octonion at the doubling unit `e4O ∈ Hℓ`: the right-regular
    commutator defect `(e4O*e2O)*u1 - (e4O*u1)*e2O - (-2)•(e4O*e3O)` is `-4 • e7O`, a nonzero element
    of the doubled half — the right fundamental su(2) FAILS to close there (mirror of N279's
    `leftReg_obstruction_at_e4O`). Concrete bounded 8-coordinate computation over ℚ. -/
theorem rightReg_obstruction_at_e4O :
    (e4O * e2O) * u1 - (e4O * u1) * e2O - (-2 : ℚ) • (e4O * e3O) = (-4 : ℚ) • e7O := by
  apply CD.ext <;> apply CD.ext <;> apply Dbl.ext <;>
    simp only [u1, e2O, e3O, e4O, e7O, sub_eq_add_neg,
      CD.mul_re, CD.mul_im, CD.star_re, CD.star_im, CD.add_re, CD.add_im,
      CD.neg_re, CD.neg_im,
      cd_qsmul_re, cd_qsmul_im,
      Dbl.mul_re, Dbl.mul_im, Dbl.star_re', Dbl.star_im', Dbl.add_re, Dbl.add_im,
      Dbl.neg_re, Dbl.neg_im,
      Dbl.smul_re, Dbl.smul_im] <;> ring

/-- ★★ W8 — THE su(2)_R DOES NOT CLOSE ON THE FULL SPINOR (CONFINEMENT, right hand). There EXISTS
    `y : O ℚ` with `⁅R_hI, R_hJ⁆ y ≠ -2 • (R_hK y)` — the right-regular fundamental su(2)_R fails to
    close on the non-associative `O ℚ`. Witnessed at the doubling unit `y = e4O ∈ Hℓ`, where the
    defect is `4 • e7O ≠ 0`. So the RIGHT fundamental doublet is ALSO confined to H, obstructed on
    `O ℚ` by exactly the associator that STOPS THE CASCADE — as the left (N279). -/
theorem rightReg_comm_obstructed :
    ∃ y : O ℚ, rregI (rregJ y) - rregJ (rregI y) - (-2 : ℚ) • rregK y ≠ 0 := by
  refine ⟨e4O, ?_⟩
  simp only [rregI_apply, rregJ_apply, rregK_apply]
  rw [rightReg_obstruction_at_e4O]
  intro h
  have hc : ((-4 : ℚ) • e7O).im.im.im = 0 := by rw [h]; rfl
  simp only [e7O, cd_qsmul_im, Dbl.smul_im] at hc
  norm_num at hc

/-! ## (G) The two hands do NOT commute on the full non-associative O (the so(4) breaks). -/

/-- ★★★ THE so(4) BREAKS ON `O ℚ`: the LEFT and RIGHT su(2)'s do NOT all commute on the full
    non-associative spinor. This is exactly the banked N264 chirality block (`chir_spinor_block`):
    the mixed commutator of the two worldMap faces is the associator (`chir_mixed_apply`), and `O ℚ`
    is non-associative — so the `so(4) = su(2)_L ⊕ su(2)_R` that assembled on H (`leftRight_commute_on_H`)
    is TORN APART off H. The two-handed structure lives ONLY on the last associative rung. -/
theorem so4_breaks_on_O :
    ¬ ∀ a b : ImO, (leftReg a).comp (rightReg b) = (rightReg b).comp (leftReg a) :=
  chir_spinor_block

/-! ## (H) The two hands are genuinely distinct operators (non-vacuity). -/

/-- The LEFT and RIGHT su(2)'s are genuinely DIFFERENT: `L_hI ≠ R_hI`, discriminated at `e2O`
    (`u1*e2O = e3O` but `e2O*u1 = -e3O`). The so(4) is a genuine 6-dim two-factor object, not a
    diagonal collapse. -/
theorem lregI_ne_rregI : leftReg u1M ≠ rightReg u1M := by
  intro h
  have hval := congrArg (fun f => f e2O) h
  simp only [leftReg_apply, rightReg_apply] at hval
  have h1 : (u1M : O ℚ) * e2O = e3O := by
    show u1 * e2O = e3O; rw [← JO_apply]; exact JO_e2
  have h2 : e2O * (u1M : O ℚ) = -e3O := by
    show e2O * u1 = -e3O
    rw [u1_iotaO, e2O_iotaO,
        show (iotaO hJ * iotaO hI) = iotaO (hJ * hI) from (CD.iota_mul hJ hI).symm, hJ_hI,
        map_neg, ← e3O_iotaO]
  rw [h1, h2] at hval
  -- hval : e3O = -e3O ⟹ 2•e3O = 0 ⟹ e3O = 0, contradiction
  have h2e : (2 : ℚ) • e3O = 0 := by rw [two_smul]; nth_rewrite 1 [hval]; abel
  have hz : e3O = (0 : O ℚ) := by
    rwa [smul_eq_zero, or_iff_right (by norm_num : (2:ℚ) ≠ 0)] at h2e
  have hne : e3O ≠ (0 : O ℚ) := by
    intro hzz
    have : (e3O : O ℚ).re.im.im = 0 := by rw [hzz]; rfl
    simp only [e3O] at this; norm_num at this
  exact hne hz

/-! ## (I) THE CAPSTONE — the two-handed so(4), confined to H, broken on O by the cascade stop. -/

/-- ★★★ THE TWO-HANDED so(4) STRUCTURE (capstone). Over the derived octonion rung `O ℚ = CD (H ℚ)`
    and its matter spinor (`leftReg`/`rightReg`, N261/N264), the left- and right-regular actions of
    the last-doubled H-imaginary units `u1, e2O, e3O`:
    (i)   the LEFT su(2)_L CLOSES on H with structure constant `+2` (N279 `leftReg_closure_on_H_IJ`);
    (ii)  the RIGHT su(2)_R CLOSES on H with structure constant `-2` (opposite orientation);
    (iii) the two hands COMMUTE on H (`leftRight_commute_on_H`) — the `so(4) = su(2)_L ⊕ su(2)_R`;
    (iv)  BOTH doublet Casimirs are `-3•id` (spin-½, `leftReg_casimir_eq_neg_three` /
          `rightReg_casimir_eq_neg_three`);
    (v)   BOTH hands FAIL to close on the full `O ℚ`, each defect `= -2•` the banked associator
          (`leftReg_defect_eq_associator` / `rightReg_defect_eq_associator`), and the two hands do
          NOT commute there (`so4_breaks_on_O`) — the whole `so(4)` is CONFINED to H and BROKEN on
          `O ℚ` by the SAME non-associativity that stops the cascade (`cap_forces_nonassoc`).
    ONE CAUSE: the cascade-stopping associator confines matter's two-handed `so(4)` to the last
    associative rung. (SCOPE: the SYMMETRIC two-handed germ — parity VIOLATION, the asymmetry of
    which hand couples, is NOT derived here; a symmetric `so(4)` is parity-conserving.) -/
theorem two_handed_so4_structure :
    -- (i) su(2)_L closes on H, +2 (N279)
    (∀ w : H ℚ, lregI (lregJ (iotaO w)) - lregJ (lregI (iotaO w)) = (2 : ℚ) • lregK (iotaO w)) ∧
    -- (ii) su(2)_R closes on H, -2 (opposite orientation)
    (∀ w : H ℚ, rregI (rregJ (iotaO w)) - rregJ (rregI (iotaO w)) = (-2 : ℚ) • rregK (iotaO w)) ∧
    -- (iii) the two hands commute on H — the so(4)
    (∀ w : H ℚ, lregI (rregJ (iotaO w)) - rregJ (lregI (iotaO w)) = 0) ∧
    -- (iv) both doublet Casimirs -3•id (spin-½)
    (lregI.comp lregI + lregJ.comp lregJ + lregK.comp lregK = (-3 : ℚ) • LinearMap.id) ∧
    (rregI.comp rregI + rregJ.comp rregJ + rregK.comp rregK = (-3 : ℚ) • LinearMap.id) ∧
    -- (v) both hands obstructed on O by the SAME associator (confinement), non-vacuously
    (∀ y : O ℚ, lregI (lregJ y) - lregJ (lregI y) - (2 : ℚ) • lregK y = (-2 : ℚ) • assoc u1 e2O y) ∧
    (∀ y : O ℚ, rregI (rregJ y) - rregJ (rregI y) - (-2 : ℚ) • rregK y = (-2 : ℚ) • assoc y u1 e2O) ∧
    (∃ y : O ℚ, rregI (rregJ y) - rregJ (rregI y) - (-2 : ℚ) • rregK y ≠ 0) ∧
    -- the two hands do NOT commute on O — the so(4) is broken off H
    (¬ ∀ a b : ImO, (leftReg a).comp (rightReg b) = (rightReg b).comp (leftReg a)) ∧
    -- and the breaking is the cascade-stopping non-associativity
    ¬ (∀ x y z : O ℚ, x * y * z = x * (y * z)) :=
  ⟨leftReg_closure_on_H_IJ, rightReg_closure_on_H_IJ, leftRight_commute_on_H,
   leftReg_casimir_eq_neg_three, rightReg_casimir_eq_neg_three,
   leftReg_defect_eq_associator, rightReg_defect_eq_associator, rightReg_comm_obstructed,
   so4_breaks_on_O, cap_forces_nonassoc⟩

end

