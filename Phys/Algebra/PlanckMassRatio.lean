import Phys.Algebra.NewtonScaleProduct
import Mathlib.Tactic

namespace Phys.Algebra

open Phys.Foundation Phys.Foundation.ContinuumQ

noncomputable section

/-! ## (1) THE RECIPROCAL HALF-RUNG ATOM `M_Pl/M = e^(3π)` (the banked n=28 rung, exponentiated). -/

/-- THE PLANCK-TO-CLOSURE RECIPROCAL HALF-RUNG RATIO `M_Pl/M = cutExp(rungExponent(finrank selfAdj))`,
    the Born-positive exponential ENHANCEMENT at the banked n=28 gravitational (saturation) rung — the
    multiplicative inverse of the banked half-rung suppression `planckClosureRatio`. `rungExponent` and
    `finrank selfAdj` are BANKED (N329); `cutExp` is the banked derived-ℝ exponential (N174). -/
def planckMassRatio : Cut :=
  cutExp (rungExponent (Module.finrank ℚ (bornBil).selfAdjointSubmodule))

/-- ★ THE RECIPROCAL HALF-RUNG VALUE `M_Pl/M = e^(3π)`. FALLS OUT of the banked `rungExponent_at_selfAdj
    = 3·cutPi`; never premised as a literal `3π`. -/
theorem planckMassRatio_eq : planckMassRatio = cutExp (3 * cutPi) := by
  unfold planckMassRatio; rw [rungExponent_at_selfAdj]

/-- Born positivity of the reciprocal half-rung ratio: `0 < M_Pl/M` (banked `cutExp_pos`). -/
theorem planckMassRatio_pos : 0 < planckMassRatio := by
  unfold planckMassRatio; exact cutExp_pos _

/-! ## (2) THE RECIPROCAL IDENTITY `(M_Pl/M)·(M/M_Pl) = 1` (banked invertibility). -/

/-- ★ THE RECIPROCAL IDENTITY: `(M_Pl/M)·(M/M_Pl) = 1`. FORCED by the banked invertibility law
    `cutExp_mul_neg` (`cutExp x · cutExp(−x) = 1`) — `planckMassRatio` is the exact multiplicative
    inverse of the banked half-rung `planckClosureRatio`. -/
theorem planckMassRatio_mul_planckClosureRatio :
    planckMassRatio * planckClosureRatio = 1 := by
  unfold planckMassRatio planckClosureRatio
  exact cutExp_mul_neg _

/-- `M_Pl/M = (M/M_Pl)⁻¹` — the reciprocal, read as a multiplicative inverse (from the product = 1). -/
theorem planckMassRatio_eq_inv : planckMassRatio = (planckClosureRatio)⁻¹ :=
  eq_inv_of_mul_eq_one_left
    (mul_comm planckMassRatio planckClosureRatio ▸ planckMassRatio_mul_planckClosureRatio)

/-- STRICT ENHANCEMENT: `1 < M_Pl/M`. The argument `3·cutPi` is strictly positive (`cutPi_pos`), so by
    banked `cutExp_strictMono` and `cutExp_zero`, `cutExp 0 = 1 < cutExp(3·cutPi)`. -/
theorem planckMassRatio_gt_one : 1 < planckMassRatio := by
  rw [planckMassRatio_eq]
  have hpos : (0 : Cut) < 3 * cutPi := by have := cutPi_pos; linarith
  have := cutExp_strictMono hpos
  rwa [cutExp_zero] at this

/-! ## (3) THE NATURAL-UNITS NORMALIZATION `G·M_Pl² = 1` (⟺ `M_Pl = G^(−1/2)`). -/

/-- ★★ B4 — THE NATURAL-UNITS NORMALIZATION `(M_Pl/M)² · (G·M²) = G·M_Pl² = 1`. Reading `G·M² = (M/M_Pl)²`
    (banked N330), the reciprocal squared gives `(M_Pl/M)²·(M/M_Pl)² = 1`; concretely `e^(6π)·e^(−6π) =
    1` by the banked homomorphism `cutExp_add`. This IS the natural-units identity `G·M_Pl² = 1` ⟺
    `M_Pl = G^(−1/2)` (bare-G convention — see honest-grade flag (ii) in the header). -/
theorem planckMassRatio_sq_mul_newtonScaleProduct :
    planckMassRatio ^ 2 * newtonScaleProduct = 1 := by
  rw [planckMassRatio_eq, newtonScaleProduct_eq, pow_two, cutExp_add, cutExp_add]
  have h0 : (3 * cutPi + 3 * cutPi) + (-(6 * cutPi)) = 0 := by ring
  rw [h0, cutExp_zero]

/-- ★★★ THE CAPSTONE — B4, all consequences at once, on the banked derived-ℝ `cutExp`/`cutPi`, the
    banked n=28 rung, and the banked N330 `planckClosureRatio`/`newtonScaleProduct`. The reciprocal
    half-rung `M_Pl/M` equals `e^(3π)`, is the multiplicative inverse of the half-rung `M/M_Pl` (their
    product is `1`), is strictly above `1`, and its square times the gravitational product `G·M²` is
    `1` (the natural-units normalization `G·M_Pl² = 1`). -/
theorem planck_mass_ratio_relation :
    planckMassRatio = cutExp (3 * cutPi)
    ∧ planckMassRatio * planckClosureRatio = 1
    ∧ 1 < planckMassRatio
    ∧ planckMassRatio ^ 2 * newtonScaleProduct = 1 :=
  ⟨planckMassRatio_eq, planckMassRatio_mul_planckClosureRatio, planckMassRatio_gt_one,
   planckMassRatio_sq_mul_newtonScaleProduct⟩

/-! ## NON-VACUITY (W8): the reciprocal is a genuine enhancement, not the identity. -/

/-- NON-VACUITY: `M_Pl/M ≠ M/M_Pl` — the reciprocal half-rung (`> 1`) is genuinely distinct from the
    suppression half-rung (`< 1`). If the rung collapsed to `3π = 0`, the two would coincide at `1`. -/
theorem planckMassRatio_ne_planckClosureRatio :
    planckMassRatio ≠ planckClosureRatio := by
  have h1 := planckMassRatio_gt_one
  have h2 := planckClosureRatio_lt_one
  intro h; rw [h] at h1; linarith

/-- NON-VACUITY: `M_Pl/M ≠ 1` — the n=28 rung is nontrivial (`3·cutPi > 0`), so the Planck scale is
    genuinely above the closure scale; a WRONG reading with a vanishing rung would give `1`. -/
theorem planckMassRatio_ne_one : planckMassRatio ≠ 1 := by
  have := planckMassRatio_gt_one; intro h; rw [h] at this; linarith

end

