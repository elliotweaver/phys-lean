/-! ## (1) THE AFFINE F₄ CARTAN MATRIX (finite exact root-system datum over ℤ). -/

/-- THE AFFINE F₄ (`F₄⁽¹⁾`) CARTAN MATRIX over `ℤ`. Node order `[0(affine), 1, 2, 3, 4]`; the finite
    F₄ Dynkin diagram `1 — 2 ⇒ 3 — 4` has its double bond between the long node `2` and the short
    node `3` (`A[2,3] = −2`, `A[3,2] = −1`), and the affine node `0` attaches to the long end (node
    `1`). This is finite root-system combinatorics — a fixed integer array in the metalanguage, NOT a
    content number system (§G5). -/
def f4AffineCartan : Matrix (Fin 5) (Fin 5) ℤ :=
  !![ 2, -1,  0,  0,  0;
     -1,  2, -1,  0,  0;
      0, -1,  2, -2,  0;
      0,  0, -1,  2, -1;
      0,  0,  0, -1,  2]

/-- THE COMARK (dual Kac label) VECTOR of affine F₄: `(1, 2, 3, 2, 1)`. -/
def comarkVec : Fin 5 → ℤ := ![1, 2, 3, 2, 1]

/-! ## (2) THE COMARK NULL-VECTOR THEOREM — the defining property of the dual Kac labels. -/

/-- ★★★ THE COMARK NULL-VECTOR THEOREM. The comark vector `(1,2,3,2,1)` is the NULL vector of the
    affine F₄ Cartan matrix: `f4AffineCartan · comarkVec = 0`. This IS the defining property of the
    dual Kac labels (comarks) — so the comark count `9` (their sum) is DERIVED from the affine Cartan
    matrix, not read off a table. Pure `ℤ` arithmetic per coordinate. -/
theorem f4_comark_null : f4AffineCartan.mulVec comarkVec = 0 := by
  funext i
  fin_cases i <;>
    simp [f4AffineCartan, comarkVec, Matrix.mulVec, dotProduct, Fin.sum_univ_five]

/-! ## (3) THE WRAP COUNT `9` — DERIVED as the comark sum. -/

/-- THE MINIMAL-WRAP CONSTITUENT COUNT: the sum of the comark (dual Kac label) entries — the dual
    Coxeter number of F₄. NOT premised as `9`; it is `(∑ comarkVec).toNat`. -/
