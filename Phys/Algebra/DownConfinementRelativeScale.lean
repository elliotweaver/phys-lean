attribute [local instance] Phys.Cascade.CD.narCD Phys.Cascade.CD.srCD

noncomputable section

/-! ## (A) READING (A): THE TWO-RUNG RATIO `Md/Λ = absScaleChainDerived / confinementScaleRatio`. -/

/-- THE DOWN/CONFINEMENT LEG as the ratio of two banked derived rungs of the ONE closure anchor `M`:
    the arc-O O2 down-sector cascade scale `Md/M = absScaleChainDerived` (N417, parameter-free) over the
    arc-I/X9 confinement floor `Λ/M = confinementScaleRatio = cutExp(−12·cutPi)`. A DETERMINED derived
    `Cut` — the shared electroweak edge cancels below. -/
def downConfLeg : Cut := absScaleChainDerived / confinementScaleRatio

/-- Born positivity: `0 < Md/Λ` (both banked rungs positive). -/
theorem downConfLeg_pos : 0 < downConfLeg :=
  div_pos absScaleChainDerived_pos confinementScaleRatio_pos

/-- ★★ THE SHARED-EDGE CANCELLATION: `Md/Λ = (cutCos foldPhase · s1BornProb · 1 · cutCos(2/3)) /
    confBundle`. Both banked rungs factor through the SAME electroweak edge `v/M = ewClosureRatio`
    (`absScaleChainDerived_eq_anchor_mul` gives `Md/M = ewClosureRatio · factorBundle`;
    `confinement_eq_edge_bundle` gives `Λ/M = ewClosureRatio · confBundle`), so the edge CANCELS in the
    ratio, leaving the derived factor bundle over the confinement bundle `Λ/v`. -/
theorem downConfLeg_edge_cancel :
    downConfLeg
      = ((cutCos foldPhase * ((s1BornProb : ℚ) : Cut)) * 1 * cutCos (2 / 3)) / confBundle := by
  unfold downConfLeg
  rw [absScaleChainDerived_eq_anchor_mul, confinement_eq_edge_bundle]
  have hew : ewClosureRatio ≠ 0 := ne_of_gt ewClosureRatio_pos
  rw [mul_div_mul_left _ _ hew]

/-! ## (B) READING (B): THE RELATIVE-SCALE-SQUARED `downConfBundle = mbRatioDerived / confBundle`. -/

/-- ★★ THE DERIVED DOWN/CONFINEMENT RELATIVE-SCALE-SQUARED: `downConfBundle = mbRatioDerived /
    confBundle` — the parent's up/down fold-phase Born weight `(Md/Mu)² = mbRatioDerived` DIVIDED by the
    banked confinement bundle `Λ/v = confBundle = cutExp(−8·cutPi/3)`. Under the top-at-anchor
    identification `(Mu/Mλ)² = 1/confBundle`, this IS `(Md/Mλ)²`: the down/confinement offset squared, a
    DETERMINED derived `Cut`. -/
def downConfBundle : Cut := mbRatioDerived / confBundle

/-- The relative-scale-squared as its closed quotient of the two banked derived weights. -/
theorem downConfBundle_closed : downConfBundle = mbRatioDerived / confBundle := rfl

/-- Born positivity: `0 < (Md/Mλ)²`. -/
theorem downConfBundle_pos : 0 < downConfBundle :=
  div_pos mbRatioDerived_pos confBundle_pos

/-! ## (C) THE WELD TO THE GRANDPARENT'S `edgeLight` — the light-band edge pins. -/

/-- ★ THE `edgeLight` WELD: with the confinement floor entering as a Born-square scale `lam = Mλ²`, the
    grandparent's light-band edge `edgeLight Md (Mλ²) = sectorMass Md 2 / Mλ² = (Md/Mλ)²·bMass 2`. Pure
    `sectorMass_eq` arithmetic on the banked N340 shape. -/
theorem edgeLight_weld (Md Mlam : Cut) (hl : Mlam ≠ 0) :
    edgeLight Md (Mlam ^ 2) = (Md / Mlam) ^ 2 * bMass 2 := by
  unfold edgeLight
  rw [sectorMass_eq]
  have hl2 : (Mlam : Cut) ^ 2 ≠ 0 := pow_ne_zero 2 hl
  field_simp

/-- ★★★ THE LIGHT-BAND EDGE PINS TO A DETERMINED VALUE: `edgeLight Md (Mλ²) = downConfBundle · bMass 2`.
    Given the parent's up/down leg (`(Md/Mu)² = mbRatioDerived`, banked) and the confinement-sector
    top-at-anchor identification (`(Mu/Mλ)² = 1/confBundle`, candidate), the light-band edge is the
    DETERMINED derived value `downConfBundle · bMass 2`. The grandparent's `rl` residual pins from
    route-not-yet-found to a value. Both premises are banked/derived objects entering as HYPOTHESES —
    NOT a bridge. -/
theorem edgeLight_pinned (Mu Md Mlam : Cut) (hu : Mu ≠ 0) (hl : Mlam ≠ 0)
    (hud : (Md / Mu) ^ 2 = mbRatioDerived)
    (huc : (Mu / Mlam) ^ 2 = 1 / confBundle) :
    edgeLight Md (Mlam ^ 2) = downConfBundle * bMass 2 := by
  rw [edgeLight_weld Md Mlam hl]
  have hsplit : (Md / Mlam) ^ 2 = (Md / Mu) ^ 2 * (Mu / Mlam) ^ 2 := by
    field_simp
  rw [hsplit, hud, huc]
  unfold downConfBundle
  ring

/-! ## (D) THE UP/DOWN EDGES `rb, rc` PIN FROM THE PARENT LEG (the full assignment). -/

/-- The bottom-band edge `rb` pins from the parent's up/down leg: `edgeBottom = mbRatioDerived ·
    (bMass 0 / bMass 2)` — a determined derived value. -/
theorem edgeBottom_pinned (Mu Md : Cut) (hu : Mu ≠ 0) (hd : Md ≠ 0)
    (hud : (Md / Mu) ^ 2 = mbRatioDerived) :
    edgeBottom Mu Md = mbRatioDerived * (bMass 0 / bMass 2) := by
  unfold edgeBottom
  rw [sectorMass_eq, sectorMass_eq]
  have hb2 : bMass 2 = mass2 := rfl
  have hm2 : (mass2 : Cut) ≠ 0 := ne_of_gt mass2_pos
  have hu2 : (Mu : Cut) ^ 2 ≠ 0 := pow_ne_zero 2 hu
  rw [← hud, hb2]
  field_simp

/-- The charm-band edge `rc` pins from the parent's up/down leg: `edgeCharm = 1/mbRatioDerived` — a
    determined derived value. -/
theorem edgeCharm_pinned (Mu Md : Cut) (hu : Mu ≠ 0) (hd : Md ≠ 0)
    (hud : (Md / Mu) ^ 2 = mbRatioDerived) :
    edgeCharm Mu Md = 1 / mbRatioDerived := by
  unfold edgeCharm
  rw [sectorMass_eq, sectorMass_eq]
  have hb2 : bMass 2 = mass2 := rfl
  have hm2 : (mass2 : Cut) ≠ 0 := ne_of_gt mass2_pos
  have hd2 : (Md : Cut) ^ 2 ≠ 0 := pow_ne_zero 2 hd
  have hmb : mbRatioDerived ≠ 0 := ne_of_gt mbRatioDerived_pos
  rw [← hud, hb2]
  field_simp

/-! ## (E) THE FREEZE-OUT SUMMAND PINS (banked closed form at the pinned edges). -/

/-- ★★ THE FREEZE-OUT SUMMAND AT THE PINNED EDGES: the banked `freezeout_at_derived_edges` (D2/D8
    `freezeout_closed`) evaluated at the grandparent tower edges is the census-weighted sum of their
    logs. With `rb, rc` pinned from the up/down leg and `rl` pinned from the down/confinement leg, every
    edge is a determined derived value — the freeze-out summand pins from a bound to a value. -/
theorem freezeout_summand_pins (Mu Md Mlam : Cut) :
    totalScreening (freezeoutTail (edgeBottom Mu Md) (edgeCharm Mu Md) (edgeLight Md (Mlam ^ 2)))
      = kappaLeading * (11 / 3) * cutLog (edgeBottom Mu Md)
        + kappaLeading * (10 / 3) * cutLog (edgeCharm Mu Md)
        + kappaLeading * 2 * cutLog (edgeLight Md (Mlam ^ 2)) :=
  freezeout_at_derived_edges Mu Md (Mlam ^ 2)

/-! ## (F) W8 NON-VACUITY WITH TEETH. -/

/-- ★★ W8 — THE CONFINEMENT BUNDLE GENUINELY BITES: `mbRatioDerived < downConfBundle`. Dividing by the
    banked `confBundle < 1` lifts the leg strictly above the bare up/down weight, so the down/confinement
    leg is genuinely DISTINCT from the up/down leg — a WRONG "the confinement offset is trivial" reading
    would collapse them. -/
theorem downConfBundle_gt_mbRatio : mbRatioDerived < downConfBundle := by
  unfold downConfBundle
  rw [lt_div_iff₀ confBundle_pos]
  have h1 : 0 < mbRatioDerived := mbRatioDerived_pos
  have h2 : confBundle < 1 := confBundle_lt_one
  nlinarith [h1, h2]

/-- ★★ W8 — THE UP/DOWN LEG GENUINELY ENTERS: `downConfBundle ≠ 1/confBundle`. The leg is NOT just the
    inverse confinement bundle — the fold-phase up/down weight `mbRatioDerived` genuinely multiplies in,
    and since `mbRatioDerived < 1` it is strictly below `1/confBundle`. A WRONG "the down/confinement leg
    is pure confinement, no up/down content" reading is refuted. -/
theorem downConfBundle_ne_confBundleInv : downConfBundle ≠ 1 / confBundle := by
  unfold downConfBundle
  intro h
  have hc : confBundle ≠ 0 := confBundle_ne_zero
  have h2 : mbRatioDerived = 1 := by
    field_simp at h
    exact h
  have := mbRatioDerived_lt_one
  linarith

/-- ★ W8 — THE LIGHT-BAND EDGE GENUINELY DEPENDS ON THE CONFINEMENT FLOOR: at two different floors
    `lam = 1` and `lam = 4` (fixed `Md = 1`) the light edge differs — so the reduction to the
    down/confinement leg is not a vacuous constant. `edgeLight Md lam = sectorMass Md 2 / lam` genuinely
    scales with the floor. -/
theorem edgeLight_scale_genuine (Md : Cut) (hd : Md ≠ 0) :
    edgeLight Md 1 ≠ edgeLight Md 4 := by
  unfold edgeLight
  have hpos : 0 < sectorMass Md 2 := sectorMass_pos Md hd 2
  have hne : sectorMass Md 2 ≠ 0 := ne_of_gt hpos
  intro h
  rw [div_eq_div_iff (by norm_num) (by norm_num)] at h
  nlinarith [h, hpos]

/-! ## (G) THE CAPSTONE — welded, non-hollow. -/

/-- ★★★ THE DOWN/CONFINEMENT RELATIVE-SCALE LEG = THE CONFINEMENT BUNDLE (arc-D remainder, welded
    landing). The REMAINING leg of the grandparent's reduced residual — the down/confinement offset
    `Md/Mλ` — DERIVED from TWO banked tower rungs of the ONE closure anchor `M`:

    (1) READING (A) — THE TWO-RUNG RATIO: `downConfLeg = absScaleChainDerived / confinementScaleRatio`,
        with the shared electroweak edge canceling: `= (cutCos foldPhase · s1BornProb · 1 · cutCos(2/3))
        / confBundle` (`downConfLeg_edge_cancel`) — a DETERMINED derived `Cut`, no free parameter;
    (2) READING (B) — THE RELATIVE-SCALE-SQUARED: `downConfBundle = mbRatioDerived / confBundle`
        (`downConfBundle_closed`), the parent's up/down fold-phase weight over the banked confinement
        bundle `Λ/v`, Born-positive (`downConfBundle_pos`);
    (3) THE WELD: `edgeLight Md (Mλ²) = (Md/Mλ)²·bMass 2` (`edgeLight_weld`), so under the two
        relative-scale identifications the light-band edge PINS to `downConfBundle·bMass 2`
        (`edgeLight_pinned`) — the grandparent's `rl` from route-not-yet-found to a value;
    (4) THE FULL ASSIGNMENT: the up/down edges `rb, rc` pin from the parent leg (`edgeBottom_pinned =
        mbRatioDerived·bMass0/bMass2`, `edgeCharm_pinned = 1/mbRatioDerived`), so the freeze-out summand
        pins (`freezeout_summand_pins`, the banked `freezeout_at_derived_edges`);
    (5) TEETH: the confinement bundle genuinely bites (`downConfBundle_gt_mbRatio`); the up/down leg
        genuinely enters (`downConfBundle_ne_confBundleInv`); the light edge genuinely depends on the
        floor (`edgeLight_scale_genuine`).

    Statable from no single conjunct alone (non-hollow). ⚠ HONEST GRADE: (1)–(5) THEOREM-EXACT now
    (exact facts/(in)equalities of `Cut`, no error bar, foundations-only; the two relative-scale
    identifications enter as HYPOTHESES, not asserted equalities). CANDIDATE / MECHANISM (owner QT1 /
    confinement route genre, NEVER fit): the IDENTIFICATION that `confinementScaleRatio`/`confBundle` IS
    the physical confinement floor `Λ`, `absScaleChainDerived` IS the physical down-sector scale `Md`,
    and `(Mu/Mλ)² = 1/confBundle` holds physically. The `Md/Mλ ≈ 8.53`, `downConfBundle ≈ 72.84`, `Md/v
    ≈ 0.484` numerics, and the measured `1/α(0) ≈ 137.036`, `Λ_QCD`, PDG quark masses are REMOVABLE PROSE
    ONLY; no empirical number in any proof; truncating at measured precision FORBIDDEN. -/
theorem downConf_relativeScale_confinementBundle (Mu Md Mlam : Cut)
    (hu : Mu ≠ 0) (hd : Md ≠ 0) (hl : Mlam ≠ 0)
    (hud : (Md / Mu) ^ 2 = mbRatioDerived)
    (huc : (Mu / Mlam) ^ 2 = 1 / confBundle) :
    -- (1) reading (A): the two-rung ratio with the electroweak edge canceling
    downConfLeg = ((cutCos foldPhase * ((s1BornProb : ℚ) : Cut)) * 1 * cutCos (2 / 3)) / confBundle
    -- (2) reading (B): the relative-scale-squared, positive
    ∧ downConfBundle = mbRatioDerived / confBundle
    ∧ 0 < downConfBundle
    -- (3) the weld: the light-band edge pins to a determined value
    ∧ edgeLight Md (Mlam ^ 2) = downConfBundle * bMass 2
    -- (4) the full assignment: the up/down edges pin from the parent leg
    ∧ edgeBottom Mu Md = mbRatioDerived * (bMass 0 / bMass 2)
    ∧ edgeCharm Mu Md = 1 / mbRatioDerived
    ∧ (totalScreening (freezeoutTail (edgeBottom Mu Md) (edgeCharm Mu Md) (edgeLight Md (Mlam ^ 2)))
        = kappaLeading * (11 / 3) * cutLog (edgeBottom Mu Md)
          + kappaLeading * (10 / 3) * cutLog (edgeCharm Mu Md)
          + kappaLeading * 2 * cutLog (edgeLight Md (Mlam ^ 2)))
    -- (5) teeth
    ∧ mbRatioDerived < downConfBundle
    ∧ downConfBundle ≠ 1 / confBundle
    ∧ edgeLight Md 1 ≠ edgeLight Md 4 :=
  ⟨downConfLeg_edge_cancel,
   downConfBundle_closed,
   downConfBundle_pos,
   edgeLight_pinned Mu Md Mlam hu hl hud huc,
   edgeBottom_pinned Mu Md hu hd hud,
   edgeCharm_pinned Mu Md hu hd hud,
   freezeout_summand_pins Mu Md Mlam,
   downConfBundle_gt_mbRatio,
   downConfBundle_ne_confBundleInv,
   edgeLight_scale_genuine Md hd⟩

end

