    ∧ (bandVaryingScreen (withWeight 0 (leptonTail leptonCensus))
        < bandVaryingScreen (withWeight depthWeight (leptonTail leptonCensus)))
    -- (5) the census-conserving endpoint with the fold-forced low-tail weight (closed real)
    ∧ (bandVaryingInvAlphaZero
          (withWeight 0 derivedBandList ++ withWeight depthWeight (leptonTail leptonCensus))
        = 190 / 3 + 3 / 2 * totalScreening (leptonTail leptonCensus))
    ∧ (bandVaryingInvAlphaZero
          (withWeight 0 derivedBandList ++ withWeight depthWeight (leptonTail leptonCensus))
        = 190 / 3 + 3 / 2 * bandScreen leptonCensus (mass0 / mass1))
    -- (6) the endpoint genuinely screens above the way-point
    ∧ ((190 / 3 : Cut)
        < bandVaryingInvAlphaZero
            (withWeight 0 derivedBandList ++ withWeight depthWeight (leptonTail leptonCensus))) :=
  ⟨foldForcedLowTailScreen lowTail,
   foldForcedWeight_value,
   perBand_knob_real b hb,
   foldForced_dresses_lowTail,
   conservingEndpoint_foldForced,
   conservingEndpoint_closed,
   conservingEndpoint_gt_waypoint⟩

end

end Phys.Algebra.LowTailFoldForcedWeight
