open Phys.Algebra.BandEdgeList
open Phys.Foundation Phys.Foundation.ContinuumQ

noncomputable section

/-! ## (a) `1/confBundle` UNCONDITIONALLY — the reciprocal confinement bundle `v/Λ`. -/

/-- ★ `1/confBundle = ewClosureRatio / confinementScaleRatio = v/Λ`. Unconditional, from the banked
    `confBundle = confinementScaleRatio / ewClosureRatio` (X9 `confBundle_eq_confToEw`) and
    `one_div_div`. The reciprocal confinement bundle is the ratio of the electroweak edge to the
    confinement edge — both banked tower rungs of the ONE anchor `M`. -/
theorem oneOverConfBundle_eq_ratio :
    (1 : Cut) / confBundle = ewClosureRatio / confinementScaleRatio := by
  rw [confBundle_eq_confToEw, one_div_div]

/-- `1/confBundle = cutExp(8*cutPi/3)`. From the banked `confBundle = cutExp(−8π/3)` (X9
    `confBundle_eq`); the reciprocal flips the sign of the exponent (`cutExp_add`, `cutExp_zero`). -/
theorem oneOverConfBundle_eq_exp : (1 : Cut) / confBundle = cutExp (8 * cutPi / 3) := by
  rw [confBundle_eq, one_div]
  exact inv_eq_of_mul_eq_one_left (by rw [cutExp_add, add_neg_cancel]; exact cutExp_zero)

/-! ## (b) THE BORN-SQUARE ANCHOR REDUCTION — `huc` FORCED, the anchor `M` cancelling. -/

/-- ★★★ THE BORN-SQUARE ANCHOR REDUCTION OF `huc`. Given the two sector-anchor Born-square pinnings
    — the up-sector top anchor at the electroweak rung `Mu^2 = M · ewClosureRatio` (= `v`) and the
    confinement-floor anchor at the colour rung `Mlam^2 = M · confinementScaleRatio` (= `Λ`) — the
    candidate top-anchor identification `(Mu/Mlam)^2 = 1/confBundle` is FORCED, with the shared
    closure anchor `M` CANCELLING. The mass is the Born-SQUARE of its amplitude applied ONCE (trunk),
    so the rung enters LINEARLY; the ratio is the ratio of the two banked tower rungs, which the
    banked `confBundle_eq_confToEw` identifies with `1/confBundle`. This DERIVES the candidate `huc`
    as a theorem of `Cut` (modulo the two anchor pinnings, one of which is definitional below and one
    handed to the directed successor). -/
theorem huc_from_born_anchors (M Mu Mlam : Cut) (hM : M ≠ 0)
    (hu : Mu ^ 2 = M * ewClosureRatio)
    (hl : Mlam ^ 2 = M * confinementScaleRatio) :
    (Mu / Mlam) ^ 2 = 1 / confBundle := by
  rw [div_pow, hu, hl, mul_div_mul_left _ _ hM, confBundle_eq_confToEw, one_div_div]

/-- THE CONFINEMENT-FLOOR ANCHOR HALF IS DEFINITIONAL: `M · confinementScaleRatio = confinementScale
    M` — the confinement-floor anchor's Born-square scale IS the banked confinement scale `Λ = M·Λ/M`
    (arc-I `confinementScale`), not a free real. This half of the reduction needs no new derivation. -/
theorem confAnchor_is_confScale (M : Cut) :
    M * confinementScaleRatio = confinementScale M := by
  unfold confinementScale; ring

/-! ## (c) READING (iii) MIS-POWER EXCLUDED — the Born-square is LINEAR, not squared. -/

/-- ★★ MIS-POWER READING EXCLUDED: `1/confBundle ≠ 1/confBundle^2`. A mis-power reading would put the
    rung in TWICE (`(Mu/Mlam)^2 = 1/confBundle^2 = cutExp(16*cutPi/3)`), which requires the anchors'
    Born-square to be `(rung)^2` — the rung applied twice. The single self-overlap applies the rung
    ONCE, so the derivation lands at `1/confBundle` (the linear reading), and since `confBundle ≠ 1`
    (banked `confBundle_ne_one`), the linear and mis-power readings are genuinely DIFFERENT values.
    The Born-square structure discriminates. -/
theorem huc_not_mispower : (1 : Cut) / confBundle ≠ 1 / confBundle ^ 2 := by
  have hne : confBundle ≠ 1 := confBundle_ne_one
  have hpos : 0 < confBundle := confBundle_pos
  have hnz : confBundle ≠ 0 := ne_of_gt hpos
  intro h
  rw [div_eq_div_iff hnz (by positivity)] at h
  apply hne
  have h2 : confBundle ^ 2 = confBundle := by nlinarith [h]
  have hmc : confBundle * confBundle = confBundle * 1 := by rw [mul_one]; nlinarith [h2]
  exact mul_left_cancel₀ hnz hmc

/-! ## (d) READING (ii) DOUBLE-COUNT REFUTED — ONE derived object, two censuses (ONE CAUSE). -/

/-- THE RUNG IS THE COLOUR/SPACE QUOTIENT-GAP OF THE ONE 84π BUDGET: `8*cutPi/3 = 12*cutPi −
    28*cutPi/3` (the confinement n=7 rung minus the electroweak n=9 rung, banked X9 `rung_gap_eq`).
    The light-edge rung is not an independent scale; it is a forced DIFFERENCE of two rungs of the
    single critical-phase budget. -/
theorem rung_is_gap : (8 * cutPi / 3 : Cut) = 12 * cutPi - 28 * cutPi / 3 := by ring

/-- ★★ DOUBLE-COUNT REFUTED — the light-edge rung and the band rung are the SAME single derived
    object (ONE CAUSE, not two independent rungs): `cutLog (1/confBundle) = 8*cutPi/3 = cutLog
    confBandRatio`. The value the light edge carries is EXACTLY the value the band screens — read
    once in the light census and once in the band census. Two DIFFERENT census weights of ONE
    derived value is the ONE-CAUSE signature, not a double-count (which would require two independent
    rungs). -/
theorem rung_is_one_object :
    cutLog ((1 : Cut) / confBundle) = 8 * cutPi / 3
    ∧ cutLog ((1 : Cut) / confBundle) = cutLog confBandRatio := by
  have hval : cutLog ((1 : Cut) / confBundle) = 8 * cutPi / 3 := by
    rw [oneOverConfBundle_eq_exp, cutLog_cutExp]
  refine ⟨hval, ?_⟩
  rw [hval, confBandRatio_eq, cutLog_cutExp]

/-! ## (W8) NON-VACUITY WITH TEETH. -/

/-- W8 — THE REDUCTION IS SATISFIABLE (not vacuous): with `M = 1`, `Mu = cutExp(−14*cutPi/3)`
    (= `√(v/M)`) and `Mlam = cutExp(−6*cutPi)` (= `√(Λ/M)`), BOTH anchor pinnings hold, so
    `huc_from_born_anchors` fires on genuine derived tower half-rungs. The hypotheses are not
    contradictory — the derived `huc` has real content. -/
theorem born_anchors_satisfiable :
    (cutExp (-(14 * cutPi / 3))) ^ 2 = (1 : Cut) * ewClosureRatio
    ∧ (cutExp (-(6 * cutPi))) ^ 2 = (1 : Cut) * confinementScaleRatio := by
  refine ⟨?_, ?_⟩
  · rw [ewClosureRatio_eq, one_mul, sq, cutExp_add]; congr 1; ring
  · rw [confinementScaleRatio_eq, one_mul, sq, cutExp_add]; congr 1; ring

/-- W8 — THE ANCHOR `M` GENUINELY CANCELS (not vacuously): the same `huc` value `1/confBundle`
    results from TWO different anchors `M = 1` and `M = 4`, confirming the reduction is
    anchor-independent — the self-consistency point does not depend on the closure scale. -/
theorem huc_anchor_independent :
    ((cutExp (-(14 * cutPi / 3))) / (cutExp (-(6 * cutPi)))) ^ 2 = 1 / confBundle
    ∧ ((2 * cutExp (-(14 * cutPi / 3))) / (2 * cutExp (-(6 * cutPi)))) ^ 2 = 1 / confBundle := by
  have h1 : (cutExp (-(14 * cutPi / 3))) ^ 2 = (1 : Cut) * ewClosureRatio :=
    born_anchors_satisfiable.1
  have h2 : (cutExp (-(6 * cutPi))) ^ 2 = (1 : Cut) * confinementScaleRatio :=
    born_anchors_satisfiable.2
  refine ⟨huc_from_born_anchors 1 _ _ one_ne_zero h1 h2, ?_⟩
  have h1' : (2 * cutExp (-(14 * cutPi / 3))) ^ 2 = (4 : Cut) * ewClosureRatio := by
    rw [mul_pow, h1]; ring
  have h2' : (2 * cutExp (-(6 * cutPi))) ^ 2 = (4 : Cut) * confinementScaleRatio := by
    rw [mul_pow, h2]; ring
  exact huc_from_born_anchors 4 _ _ (by norm_num) h1' h2'

/-- W8 — THE LINEAR AND MIS-POWER VALUES ARE GENUINELY ORDERED: `1/confBundle < 1/confBundle^2`
    (since `0 < confBundle < 1`, `confBundle^2 < confBundle`), so the two readings are not just
    unequal but strictly separated — the mis-power would over-count the rung. -/
theorem mispower_strictly_above : (1 : Cut) / confBundle < 1 / confBundle ^ 2 := by
  have hpos : 0 < confBundle := confBundle_pos
  have hlt : confBundle < 1 := confBundle_lt_one
  have hsq : 0 < confBundle ^ 2 := by positivity
  have hlt2 : confBundle ^ 2 < confBundle := by nlinarith [hpos, hlt]
  exact one_div_lt_one_div_of_lt hsq hlt2

/-! ## THE LANDING — the verdict, packaged. -/

/-- ★★★ N577 — THE BORN-SQUARE ANCHOR DERIVATION OF `huc` (arc-M/O2 keystone, campaign node 1).
