/-! ## (A) THE TWO CASIMIR MAGNITUDES — extracted from the banked eigenvalues WITH TEETH (uniqueness).
    These are the load-bearing tie to N277/N279: the magnitudes `8` and `3` are the UNIQUE scalars for
    which the banked Casimir eigenvalue equations hold, not asserted literals. -/

/-- ★★ THE ADJOINT CASIMIR MAGNITUDE IS UNIQUELY `8` (tied to N277 `casimirOp_u1I`). Any scalar `c`
    with `casimirOp u1M = c • u1M` must be `−8` — because `u1M ≠ 0` and `casimirOp u1M = (−8)•u1M`
    (N277). The magnitude `adjCas = 8` is thus forced by the banked adjoint eigenvalue, not posited. -/
theorem adjCasMag_forced (c : ℚ) (hc : casimirOp u1M = c • u1M) : c = -8 := by
  have hu : (u1M : ImO) ≠ 0 := fun h => Phys.Algebra.u1_ne_zero (congrArg Subtype.val h)
  have h : c • u1M = (-8 : ℚ) • u1M := by rw [← hc, casimirOp_u1I]
  have h2 : (c - (-8)) • u1M = 0 := by rw [sub_smul, h, sub_self]
  rcases smul_eq_zero.mp h2 with h3 | h4
  · linarith [sub_eq_zero.mp h3]
  · exact absurd h4 hu

/-- ★★ THE FUNDAMENTAL CASIMIR MAGNITUDE IS UNIQUELY `3` (tied to N279
    `leftReg_casimir_eq_neg_three`). Any scalar `c` with `Σ (leftReg)² = c • id` must be `−3` —
    because `(1 : O ℚ) ≠ 0` and `Σ (leftReg)² = (−3)•id` (N279). The magnitude `funCas = 3` is thus
    forced by the banked fundamental eigenvalue, not posited. -/
theorem funCasMag_forced (c : ℚ)
    (hc : lregI.comp lregI + lregJ.comp lregJ + lregK.comp lregK = c • LinearMap.id) :
    c = -3 := by
  have hone : (1 : O ℚ) ≠ 0 := by
    intro h
    have hh : reQ (1 : O ℚ) = reQ (0 : O ℚ) := by rw [h]
    simp only [reQ] at hh
    norm_num at hh
  have heq : c • LinearMap.id = (-3 : ℚ) • (LinearMap.id : Module.End ℚ (O ℚ)) := by
    rw [← hc, leftReg_casimir_eq_neg_three]
  have happ := LinearMap.congr_fun heq (1 : O ℚ)
  simp only [LinearMap.smul_apply, LinearMap.id_apply] at happ
  have h2 : (c - (-3)) • (1 : O ℚ) = 0 := by rw [sub_smul, happ, sub_self]
  rcases smul_eq_zero.mp h2 with h3 | h4
  · linarith [sub_eq_zero.mp h3]
  · exact absurd h4 hone

/-- The banked adjoint Casimir magnitude over the derived ℝ (`8`), read off the forced scalar `−8`. -/
