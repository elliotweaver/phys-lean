      ∧ eucPlanePoint 1 cutPi ≠ eucPlanePoint 1 0
      ∧ (∀ ρ θ : Cut, eucPlanePoint ρ (θ + azimuthalTurn) = eucPlanePoint ρ θ)
      ∧ (∀ M : Cut, bhEntropy M = (bhArea M / cellArea) * cellEntropy) :=
  ⟨closureTip_eq_origin, closureTip_single,
   (closureSection_blind_iff_tip 0).mpr rfl,
   closureSection_blind_iff_tip, closureSection_faithful_off_tip,
   closureSection_closes, interior_finite_depth⟩

