/-! ## (1) THE CLOSURE-SURFACE CAP (the tip of the fold's banked return-section). -/

/-- THE INTERIOR CLOSURE TIP `= eucPlanePoint 0 θ` — the cap (`ρ = 0`) of the fold's banked
    return-section (N360). The classical "singularity" is resolved here as a COORDINATE-degeneration
    point of the return surface, not a physical infinity (a flagged mechanism reading). -/
def closureTip (θ : Cut) : Cut × Cut := eucPlanePoint 0 θ

/-- THE CAP IS THE ORIGIN: `closureTip θ = (0, 0)` — the fold's return / fixed point. -/
theorem closureTip_eq_origin (θ : Cut) : closureTip θ = (0, 0) := by
  unfold closureTip eucPlanePoint
  simp

/-- ALL ANGULAR APPROACHES REACH THE SAME TIP: `closureTip θ = closureTip θ'`. Every "direction" of
    approach converges to the ONE closure point — no cascade of distinct directions. -/
theorem closureTip_angle_independent (θ θ' : Cut) : closureTip θ = closureTip θ' := by
  rw [closureTip_eq_origin, closureTip_eq_origin]

/-- ★ THE CAP IS A SINGLE POINT, reached by every angle: `closureTip θ = closureTip 0` for all `θ`.
    One closure point (`(0,0)`), no chaotic BKL cascade of oscillating directions. -/
theorem closureTip_single (θ : Cut) : closureTip θ = closureTip 0 :=
  closureTip_angle_independent θ 0

/-! ## (2) THE DEGENERATION LOCUS IS EXACTLY THE TIP (genuinely new beyond N360). -/

/-- ★★ THE DEGENERATION LOCUS IS EXACTLY THE TIP: the return-section `eucPlanePoint ρ` is
    angular-CONSTANT (collapses all angles to one point — "blind" to direction) IF AND ONLY IF `ρ = 0`.
    The forward direction uses the banked trig `cutCos 0 = 1 ≠ cutCos cutPi = −1` (N323/N325): if the
    section were constant, then `ρ·1 = ρ·(−1)`, forcing `ρ = 0`. Away from the tip the coordinate is
    faithful. This CHARACTERIZES where the coordinate degenerates — genuinely new: N360 only showed
    closure / non-closure under angular shifts at a fixed `ρ`. -/
theorem closureSection_blind_iff_tip (ρ : Cut) :
    (∀ θ θ' : Cut, eucPlanePoint ρ θ = eucPlanePoint ρ θ') ↔ ρ = 0 := by
  constructor
  · intro h
    have h0 := h 0 cutPi
    unfold eucPlanePoint at h0
    rw [cutCos_zero, cutSin_zero, cutCos_cutPi, cutSin_cutPi] at h0
    have h1 : ρ * 1 = ρ * (-1) := (Prod.ext_iff.mp h0).1
    linarith
  · intro h θ θ'
    subst h
    unfold eucPlanePoint
    simp

/-- THE SECTION IS FAITHFUL OFF THE TIP: at `ρ = 1` the return-section distinguishes `θ = cutPi` from
    `θ = 0` (banked N360 `eucPlane_half_turn_conical`). So the angular coordinate carries genuine
    directional data everywhere EXCEPT the single closure tip. -/
theorem closureSection_faithful_off_tip :
    eucPlanePoint 1 cutPi ≠ eucPlanePoint 1 0 :=
  eucPlane_half_turn_conical

/-- THE RETURN-SECTION CLOSES under one full derived Born turn `azimuthalTurn = 2·cutPi` (banked N360
    `eucPlane_closes`) — the cap has NO conical defect; the geometry closes smoothly rather than
    terminating at an edge. -/
theorem closureSection_closes (ρ θ : Cut) :
    eucPlanePoint ρ (θ + azimuthalTurn) = eucPlanePoint ρ θ :=
  eucPlane_closes ρ θ

/-! ## (3) FINITE INTERIOR DEPTH (banked N361/N362 bit-count — no infinite-curvature singularity). -/

/-- THE INTERIOR DEPTH IS THE FINITE BANKED BIT-COUNT `N·s₀ = (A/a*)·cutLog 2`
    (`bhEntropy_cell_decomposition`, N361). A true infinite-curvature singularity would demand
    unbounded information depth; the fold's binary bit-count is FINITE for a finite mass. -/
theorem interior_finite_depth (M : Cut) :
    bhEntropy M = (bhArea M / cellArea) * cellEntropy :=
  bhEntropy_cell_decomposition M

/-! ## (4) NON-VACUITY (W8): the section is NOT degenerate everywhere. -/

/-- ★ W8 NON-VACUITY: the return-section is NOT angular-constant at `ρ = 1` — a "singular everywhere /
    never-faithful" mis-reading (the coordinate degenerate at `ρ ≠ 0`, e.g. a BKL never-faithful edge)
    genuinely FAILS. The degeneration is confined to the SINGLE tip (`closureSection_blind_iff_tip`);
    away from it the section distinguishes angles. -/
theorem closureSection_not_degenerate_everywhere :
    ¬ (∀ θ θ' : Cut, eucPlanePoint 1 θ = eucPlanePoint 1 θ') := by
  intro h
  exact (one_ne_zero : (1 : Cut) ≠ 0) ((closureSection_blind_iff_tip 1).mp h)

/-! ## (5) THE HEART bundled. -/

/-- ★★★ THE HEART (the singularity = the closure-surface cap): the fold's return-section caps at a
    SINGLE smooth tip — the angular coordinate degenerates EXACTLY at `ρ = 0` (blind to direction) and
