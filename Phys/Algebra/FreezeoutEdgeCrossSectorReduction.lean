/-! ## (A) THE SCALED SECTOR-MASS TOWER — the banked N340 shape scaled by one `Cut` scale. -/

/-- The shared cycle shape amplitudes at the derived phase `δ_B = 2/9` (banked N340 `b0`/`b1`/`b2`), as
    a `Fin 3` vector. Line-independent (rung-1): the SAME shape governs any generation sector. -/
def bShape : Fin 3 → Cut := ![b0, b1, b2]

/-- The banked within-sector Born-square masses `![mass0, mass1, mass2]` (N340), the `M = 1` slice. -/
def bMass : Fin 3 → Cut := ![mass0, mass1, mass2]

/-- The shape squares are the banked masses: `(bShape k)² = bMass k`. -/
theorem bShape_sq (k : Fin 3) : (bShape k) ^ 2 = bMass k := by
  fin_cases k <;> rfl

/-- A generation sector at scale `M`: the amplitude `M·shapeₖ` (banked N340 shape × one `Cut` scale). -/
def sectorAmp (M : Cut) (k : Fin 3) : Cut := M * bShape k

/-- The sector's Born-square masses `mₖ = (M·shapeₖ)²` (the trunk `Born = self-overlap`). -/
def sectorMass (M : Cut) (k : Fin 3) : Cut := (sectorAmp M k) ^ 2

/-! ## (B) THE SCALE-FACTORING + GROUNDING ON THE BANKED SHAPE. -/

/-- ★★★ THE SCALE-FACTORING: `sectorMass M k = M²·(bShape k)² = M²·bMass k`. Every generation mass
    factors into `(scale²) × (the banked N340 shape square)` — the amplitude form `genVec M A p r`
    is LINEAR in `M` with the forced Koide balance `A = √2·M`, so the ONE scale `M` factors out and
    the shape is the banked, line-independent (rung-1) cycle shape. This is the structural handle:
    the scale and the shape SEPARATE. -/
theorem sectorMass_eq (M : Cut) (k : Fin 3) : sectorMass M k = M ^ 2 * bMass k := by
  unfold sectorMass sectorAmp; rw [← bShape_sq]; ring

/-- The `M = 1` slice IS the banked N340 masses. -/
theorem sectorMass_one (k : Fin 3) : sectorMass 1 k = bMass k := by
  rw [sectorMass_eq]; ring

/-- The sector masses are genuine positive reals at any nonzero scale (Born positivity + the banked
    `mass{0,1,2}_pos`). -/
theorem sectorMass_pos (M : Cut) (hM : M ≠ 0) (k : Fin 3) : 0 < sectorMass M k := by
  rw [sectorMass_eq]
  have hM2 : (0 : Cut) < M ^ 2 := by positivity
  have hb : (0 : Cut) < bMass k := by
    fin_cases k
    · exact mass0_pos
    · exact mass1_pos
    · exact mass2_pos
  positivity

/-! ## (C) ★ THE WITHIN-SECTOR DISCHARGE — the ratios are the banked N340 lepton numerals at ANY scale. -/

/-- ★★ THE LINE-INDEPENDENCE CITATION (the load-bearing joint, banked rung-1). The within-sector shape
    `bShape` is the banked N340 cycle shape at the derived Born-count phase `δ_B = 2/9`. That this SAME
    shape governs ANY generation sector (up-type / down-type / lepton) — not a deviated one — is the
    banked rung `phase_no_deviation`: the generation Fano line ASSOCIATES (`gen_triple_assoc_zero`), the
    turning eigenvalue of the ℚ-permutation holonomy is the line-INDEPENDENT `−1`
    (`turning_eigenvalue_line_indep`), so the cycle phase is the unshifted Born count
    `(tr Poth/3)(1 − tr Poth/3) = 2/9` on the associative generation line exactly as on the lepton
    ℂ-line. We re-export the banked phase-value here so the within-sector universality below is not a
    naked prose claim but rests on the cited rung. (The remaining line-dependent invariant is the CP
    form `assoc3 ≠ 0`, SEPARATED from this norm/phase channel by the banked N310 — it does NOT touch the
    within-sector norm ratios; the only cross-sector residual is the relative SCALE, arc M's charter.) -/
theorem within_sector_phase_line_independent :
    ((Matrix.trace Poth / 3) * (1 - Matrix.trace Poth / 3) = 2 / 9)
    ∧ Phys.Algebra.assoc u2 u1 (octCross u1 u2) = 0
    ∧ assoc3 u2 u1 (octCross u1 u2) ≠ 0 :=
  ⟨cycle_phase_value, gen_triple_assoc_zero, fano_assoc3_ne_zero⟩


/-- ★★★ THE WITHIN-SECTOR UNIVERSALITY (the discharge). At ANY sector scale `M ≠ 0`, the lightest/middle
    within-sector mass ratio is the banked N340 lepton numeral `m₁/m₂ ∈ [483/1e5, 485/1e5]` — the scale
    `M²` cancels, so the within-sector quark ratio is FORCED equal to the banked lepton ℝ-descent
    (because the cycle phase is line-independent, rung-1). The within-sector part of the quark spectrum
    is DISCHARGED to a banked value, NOT route-not-yet-found. (PDG e:μ ≈ 0.00484 — removable prose.) -/
theorem withinSector_ratio_12 (M : Cut) (hM : M ≠ 0) :
    (483 : Cut) / 100000 * sectorMass M 2 ≤ sectorMass M 1
    ∧ sectorMass M 1 ≤ (485 : Cut) / 100000 * sectorMass M 2 := by
  have hM2 : (0 : Cut) < M ^ 2 := by positivity
  rw [sectorMass_eq, sectorMass_eq]
  have hb1 : bMass 1 = mass1 := rfl
  have hb2 : bMass 2 = mass2 := rfl
  rw [hb1, hb2]
  refine ⟨?_, ?_⟩
  · have := massRatio_1_2.1; nlinarith [this, hM2]
  · have := massRatio_1_2.2; nlinarith [this, hM2]

/-- ★★★ THE WITHIN-SECTOR UNIVERSALITY (the discharge, middle/heaviest). At ANY sector scale `M ≠ 0`,
    the middle/heaviest within-sector mass ratio is the banked N340 numeral `m₂/m₀ ∈ [594/1e4, 595/1e4]`
    — the scale cancels. The full within-sector spectrum shape is the banked lepton descent at any
    scale. (PDG μ:τ ≈ 0.0595 — removable prose.) -/
theorem withinSector_ratio_20 (M : Cut) (hM : M ≠ 0) :
    (594 : Cut) / 10000 * sectorMass M 0 ≤ sectorMass M 2
    ∧ sectorMass M 2 ≤ (595 : Cut) / 10000 * sectorMass M 0 := by
  have hM2 : (0 : Cut) < M ^ 2 := by positivity
  rw [sectorMass_eq, sectorMass_eq]
  have hb0 : bMass 0 = mass0 := rfl
  have hb2 : bMass 2 = mass2 := rfl
  rw [hb0, hb2]
  refine ⟨?_, ?_⟩
  · have := massRatio_2_0.1; nlinarith [this, hM2]
  · have := massRatio_2_0.2; nlinarith [this, hM2]

/-! ## (D) THE FREEZE-OUT EDGES AS RATIOS OF THE DERIVED TOWER + THE CROSS-SECTOR TELESCOPE. -/

/-- The freeze-out BOTTOM-band edge: the ratio of the down-sector heaviest mass (level-1 down-type,
    scale `Md`) to the up-sector middle mass (level-2 up-type, scale `Mu`) — a CROSS-sector edge
    `m_b/m_c`. A genuine positive ratio of two derived sector masses. -/
def edgeBottom (Mu Md : Cut) : Cut := sectorMass Md 0 / sectorMass Mu 2

/-- The freeze-out CHARM-band edge: the ratio of the up-sector middle mass (scale `Mu`) to the
    down-sector middle mass (scale `Md`) — a CROSS-sector edge `m_c/m_s`. -/
def edgeCharm (Mu Md : Cut) : Cut := sectorMass Mu 2 / sectorMass Md 2

/-- The freeze-out LIGHT-band edge: the ratio of the down-sector middle mass (scale `Md`) to the
    confinement floor `Λ` — a sector-to-confinement edge `m_s/Λ`. -/
def edgeLight (Md lam : Cut) : Cut := sectorMass Md 2 / lam

/-- The edges are genuine positive ratios at nonzero scales / confinement floor. -/
theorem edge_pos (Mu Md lam : Cut) (hu : Mu ≠ 0) (hd : Md ≠ 0) (hl : 0 < lam) :
    0 < edgeBottom Mu Md ∧ 0 < edgeCharm Mu Md ∧ 0 < edgeLight Md lam := by
  refine ⟨?_, ?_, ?_⟩
  · exact div_pos (sectorMass_pos Md hd 0) (sectorMass_pos Mu hu 2)
  · exact div_pos (sectorMass_pos Mu hu 2) (sectorMass_pos Md hd 2)
  · exact div_pos (sectorMass_pos Md hd 2) hl

/-- ★★★ THE CROSS-SECTOR TELESCOPE (the marquee). The PRODUCT of the two adjacent cross-sector edges
    `rb·rc` CANCELS the up-sector scale entirely: `edgeBottom · edgeCharm = sectorMass Md 0 /
    sectorMass Md 2`, a WITHIN-down-sector ratio. The middle scale `sectorMass Mu 2` appears once as a
    denominator and once as a numerator and drops out — the cross-sector scale dependence does NOT
    survive the adjacent product. -/
theorem edgeProduct_telescope (Mu Md : Cut) (hu : Mu ≠ 0) (hd : Md ≠ 0) :
    edgeBottom Mu Md * edgeCharm Mu Md = sectorMass Md 0 / sectorMass Md 2 := by
  unfold edgeBottom edgeCharm
  have hMu2 : sectorMass Mu 2 ≠ 0 := ne_of_gt (sectorMass_pos Mu hu 2)
  field_simp

/-- ★★★ THE TELESCOPED PRODUCT IS A BANKED WITHIN-SECTOR RATIO: `edgeBottom · edgeCharm = mass0/mass2`
    (the banked N340 heaviest/middle ratio, at the down scale `Md`), INDEPENDENT of BOTH relative
    scales — the up scale cancels in the product, the down scale cancels in the within-sector ratio. So
    the adjacent cross-sector edge product is FORCED to the banked N340 numeral (`massRatio_2_0`,
    `[594/1e4, 595/1e4]` for its reciprocal), carrying ZERO relative-scale dependence. -/
theorem edgeProduct_within_sector (Mu Md : Cut) (hu : Mu ≠ 0) (hd : Md ≠ 0) :
    edgeBottom Mu Md * edgeCharm Mu Md = mass0 / mass2 := by
  rw [edgeProduct_telescope Mu Md hu hd, sectorMass_eq, sectorMass_eq]
  have hMd2 : (Md : Cut) ^ 2 ≠ 0 := pow_ne_zero 2 hd
  have hm2 : mass2 ≠ 0 := ne_of_gt mass2_pos
  have hb0 : bMass 0 = mass0 := rfl
  have hb2 : bMass 2 = mass2 := rfl
  rw [hb0, hb2]
  field_simp

/-! ## (E) THE cutLog TELESCOPING — the cross-sector scale drops out of the adjacent-edge log sum. -/

/-- ★★★ THE cutLog TELESCOPING: `cutLog(edgeBottom) + cutLog(edgeCharm) = cutLog(mass0/mass2)`. The
    freeze-out summand's adjacent-edge log combination collapses the cross-sector (up) scale via
    `cutLog_mul` and the telescope: the sum of the two adjacent edge logs equals the log of the banked
    within-down-sector ratio. So in `totalScreening (freezeoutTail rb rc rl)` (D2/D8 `freezeout_closed`
    = `κ·(11/3)·cutLog rb + κ·(10/3)·cutLog rc + κ·2·cutLog rl`) the cross-sector scale dependence is
    confined to the residual relative-scale term, never the shape. -/
theorem cutLog_edgeProduct_within (Mu Md : Cut) (hu : Mu ≠ 0) (hd : Md ≠ 0) :
    cutLog (edgeBottom Mu Md) + cutLog (edgeCharm Mu Md) = cutLog (mass0 / mass2) := by
  have hb := (edge_pos Mu Md 1 hu hd (by norm_num)).1
  have hc := (edge_pos Mu Md 1 hu hd (by norm_num)).2.1
  rw [← cutLog_mul hb hc, edgeProduct_within_sector Mu Md hu hd]

/-- ★★ THE FREEZE-OUT SUMMAND AT THE DERIVED EDGES (grounding on D2/D8): the banked closed form
    (`freezeout_closed`) evaluated at the derived tower edges is the census-weighted sum of their logs.
    Ties this node's edges to the banked `totalScreening`/`freezeoutTail` object. -/
theorem freezeout_at_derived_edges (Mu Md lam : Cut) :
    totalScreening (freezeoutTail (edgeBottom Mu Md) (edgeCharm Mu Md) (edgeLight Md lam))
      = kappaLeading * (11 / 3) * cutLog (edgeBottom Mu Md)
        + kappaLeading * (10 / 3) * cutLog (edgeCharm Mu Md)
        + kappaLeading * 2 * cutLog (edgeLight Md lam) :=
  freezeout_closed (edgeBottom Mu Md) (edgeCharm Mu Md) (edgeLight Md lam)

