theorem dressedAntiScreen_gt_undressed :
    projectedS * totalScreeningWith 1 (completeBandList chargeTraceDepth)
      < projectedS * totalScreeningWith 1 (completeBandList chargeTraceDepth) / (1 - depthWeight) := by
  have hU : (0 : Cut) < totalScreeningWith 1 (completeBandList chargeTraceDepth) := screeningUnit_pos
  have hs : (0 : Cut) < projectedS := by rw [projectedS_eq]; norm_num
  have hnum : (0 : Cut) < projectedS * totalScreeningWith 1 (completeBandList chargeTraceDepth) :=
    mul_pos hs hU
  set X := projectedS * totalScreeningWith 1 (completeBandList chargeTraceDepth) with hX
  have hw : (0 : Cut) < 1 - depthWeight := by
    have := depthWeight_lt_one; linarith
  have hwlt : (1 : Cut) - depthWeight < 1 := by
    have := depthWeight_pos; linarith
  rw [lt_div_iff₀ hw]
  nlinarith [hnum, hwlt]

/-! ## (E) THE CONSISTENT COMPOSITION IS THE BANKED UNDRESSED `leadingCarrier`. -/

