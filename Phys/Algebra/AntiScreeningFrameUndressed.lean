theorem antiScreeningFrameUndressed_landing (Mu Md Mlam : Cut) :
    -- (1) the dressed s-term is the whole-stack Casimir reading
    (projectedS / (1 - depthWeight) = casimirRatio * (depthWeight / (1 - depthWeight)))
    ∧ projectedS / (1 - depthWeight) = 3 / 16
    ∧ casimirRatio * (depthWeight / (1 - depthWeight)) = 3 / 16
    -- (2) it overturns the derived s
    ∧ projectedS / (1 - depthWeight) ≠ projectedS
    ∧ depthWeight / (1 - depthWeight) ≠ depthWeight
    -- (3) the s-term shares the tower's dressing factor (no band-selective split)
