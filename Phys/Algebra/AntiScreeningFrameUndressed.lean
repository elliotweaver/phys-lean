    depthWeight / (1 - depthWeight) ≠ depthWeight := by
  rw [depthWeight_eq]; norm_num

/-! ## (C) NO BAND-SELECTIVE SPLIT + THE WAY-POINTS FORCE `w = 0` (the two structural adjudicators). -/

/-- ★★ THE s-TERM SHARES THE TOWER'S DRESSING FACTOR (re-export of `dressedInvAlphaEM_antiscreen`):
    `dressedInvAlphaEM w s bands = dressedInvAlphaEM w 0 bands − (s·totalScreeningWith 1 bands)/(1−w)`.
    The anti-screening term is dressed by the SAME `/(1−w)` as the tower — there is no band-selective
    split that dresses one and not the other; the s-term is dressed iff the tower is dressed. -/
theorem antiscreen_shares_tower_factor (w s : Cut) (hw0 : 0 ≤ w) (hw1 : w < 1)
    (bands : List (Cut × Cut)) :
    dressedInvAlphaEM w s bands
      = dressedInvAlphaEM w 0 bands - (s * totalScreeningWith 1 bands) / (1 - w) :=
  dressedInvAlphaEM_antiscreen w s hw0 hw1 bands

/-- ★★★ THE WAY-POINTS FORCE `w = 0` ON THE SHARED CARRIER (re-export of `dressed_reproduces_only_at_w0`):
    `dressedInvAlphaZero 0 derivedBandList = 190/3` while `dressedInvAlphaZero depthWeight derivedBandList
    ≠ 190/3`. The banked exact confinement way-point reproduces ONLY at the trivial weight `w = 0`.
    Combined with `antiscreen_shares_tower_factor` (the s-term is dressed iff the tower is), the
    way-point-forced `w = 0` keeps the s-term UNDRESSED. -/
theorem waypoints_force_w0 :
    dressedInvAlphaZero 0 derivedBandList = 190 / 3
    ∧ dressedInvAlphaZero depthWeight derivedBandList ≠ 190 / 3 :=
  dressed_reproduces_only_at_w0

/-! ## (D) THE DRESSING GENUINELY INFLATES THE s-TERM (W8 teeth) — the frame difference is real. -/

/-- ★★ THE DRESSING GENUINELY INFLATES THE s-TERM: for the positive screening unit `U =
    totalScreeningWith 1 (completeBandList chargeTraceDepth)` (`screeningUnit_pos`), the undressed
    anti-screening `projectedS·U` is STRICTLY LESS than the dressed `projectedS·U/(1−depthWeight)`.
    The two frames give genuinely different subtractions — the `±s·T` ledger disagreement was real,
