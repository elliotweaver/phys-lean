noncomputable section

/-! ## The trace-reversed gravitational source on the derived (1,3) arena. -/

/-- THE TRACE-REVERSED ENDOMORPHISM `S − ½·(trace S)·id` — the SAME trace-reversal operation banked
    at N354 for the Einstein tensor (there `G = Ric − ½R·g`, whose metric trace is dimension-forced).
    Here it turns the perfect-fluid stress into the combination that gravitates: the ordinary trace
    of the fluid stress is `ρ − nP`, but the source that curves spacetime is the trace-REVERSED one
    `ρ + nP`. This map produces it. -/
def traceRevStress (S : STV4 →ₗ[ℚ] STV4) : STV4 →ₗ[ℚ] STV4 :=
  S - (2⁻¹ * LinearMap.trace ℚ STV4 S) • LinearMap.id

/-- THE ACTIVE GRAVITATIONAL MASS DENSITY (the time-diagonal reading of the trace-reversed source):
    the timelike component of the trace-reversed stress applied to the pure-time direction. -/
def gravSource (S : STV4 →ₗ[ℚ] STV4) : ℚ := (traceRevStress S (1, 0, 0)).1

/-! ## The source reading on the perfect-fluid stress — `½(ρ + 3P)`. -/

/-- ★ THE GRAVITATIONAL SOURCE OF `pfStress ρ P` is `½·(ρ + 3P)`. The `+3P` (contrast the census's
    ordinary trace `ρ − 3P`) is the sign flip the trace-reversal forces: this is the combination
    that actually gravitates. -/
theorem gravSource_pf (rho P : ℚ) : gravSource (pfStress rho P) = 2⁻¹ * (rho + 3 * P) := by
  unfold gravSource traceRevStress
  rw [LinearMap.sub_apply, LinearMap.smul_apply, eos_trace]
  simp [pfStress, LinearMap.prodMap_apply]
  ring

/-- ★★★ THE DIMENSION FORM: `gravSource (pfStress ρ P) = ½·(ρ + n·P)`, with `n = finrank(ℚ × Dbl ℚ)`
    the DERIVED spacelike-block dimension — not put in by hand. -/
theorem gravSource_pf_dim (rho P : ℚ) :
    gravSource (pfStress rho P)
      = 2⁻¹ * (rho + (Module.finrank ℚ (ℚ × Dbl ℚ) : ℚ) * P) := by
  rw [gravSource_pf, spacelike_block_finrank]; push_cast; ring

/-- ★★★ THE DIMENSION-LOCK: the source's `P`-coefficient dimension IS the banked N419 spatial
    dimension `finrank spaceSub4` (`= 3`). The same derived count that dimension-locks the census's
    radiation `w = +1/3` dimension-locks the gravitational threshold `w = −1/3`. -/
theorem gravSource_dim_eq_spaceSub4 :
    Module.finrank ℚ (ℚ × Dbl ℚ) = Module.finrank ℚ spaceSub4 :=
  spacelike_block_eq_spaceSub4_dim

/-! ## The census gravitational-source values. -/

/-- ★ DUST (`P = 0`): source `= ρ/2 > 0` for `ρ > 0` — pressureless matter attracts. -/
theorem gravSource_dust (rho : ℚ) : gravSource (pfStress rho 0) = 2⁻¹ * rho := by
  rw [gravSource_pf]; ring

/-- ★ RADIATION (`P = ρ/3`): source `= ρ` — radiation attracts (in fact TWICE the dust source per
    unit density), even though its ORDINARY trace is zero. -/
theorem gravSource_radiation (rho : ℚ) : gravSource (pfStress rho (rho / 3)) = rho := by
  rw [gravSource_pf]; ring

/-- ★ VACUUM (`P = −ρ`): source `= −ρ` — dark energy has NEGATIVE gravitational source: it repels. -/
theorem gravSource_vacuum (rho : ℚ) : gravSource (pfStress rho (-rho)) = -rho := by
  rw [gravSource_pf]; ring

/-! ## The acceleration threshold — `w = −1/n`, dimension-locked. -/

/-- ★★★ THE ACCELERATION THRESHOLD. The gravitational source vanishes EXACTLY at
    `w = P/ρ = −1/n`, where `n = finrank spaceSub4` is the DERIVED spacelike dimension. Below the
    threshold (`w < −1/n`) the source is negative (repulsion / accelerated expansion); above it,
    positive (attraction). The `−1/n` is the exact sign-mirror of the census's radiation `+1/n`:
    the ORDINARY trace vanishes at `w = +1/n`, the TRACE-REVERSED source at `w = −1/n`, and the two
    are the same reading with the trace-reversal sign flipped. -/
theorem gravSource_zero_iff_dim (rho P : ℚ) (hr : rho ≠ 0) :
    gravSource (pfStress rho P) = 0 ↔
      eosState (pfStress rho P) = -1 / (Module.finrank ℚ spaceSub4 : ℚ) := by
  rw [gravSource_pf, eosState_pf, finrank_spaceSub4]
  push_cast
  constructor
  · intro h
    have hs : rho + 3 * P = 0 := by
      rcases mul_eq_zero.mp h with h2 | h3
      · norm_num at h2
      · exact h3
    rw [div_eq_div_iff hr (by norm_num : (3 : ℚ) ≠ 0)]; linarith
  · intro h
    rw [div_eq_div_iff hr (by norm_num : (3 : ℚ) ≠ 0)] at h
    have : P = -rho / 3 := by linarith
    rw [this]; ring

/-! ## W8 anti-vacuity — the sign facts (the load-bearing repulsion content). -/

/-- ★ W8: DUST gravitates positively for `ρ > 0` (attraction). -/
theorem dust_source_positive (rho : ℚ) (h : 0 < rho) : 0 < gravSource (pfStress rho 0) := by
  rw [gravSource_pf]; nlinarith

/-- ★ W8: RADIATION gravitates positively for `ρ > 0` — even though its ordinary trace is zero. -/
theorem radiation_source_positive (rho : ℚ) (h : 0 < rho) :
    0 < gravSource (pfStress rho (rho / 3)) := by
  rw [gravSource_pf]; nlinarith

/-- ★★ W8: VACUUM gravitates NEGATIVELY for `ρ > 0` — the REPULSION that drives accelerated
    expansion, FORCED by the trace-reversal sign, not posited. -/
theorem vacuum_source_negative (rho : ℚ) (h : 0 < rho) :
    gravSource (pfStress rho (-rho)) < 0 := by
  rw [gravSource_pf]; nlinarith

/-- ★★ W8: THE SOURCE SIGN IS LOAD-BEARING. The trace-reversed gravitational source (`ρ + 3P`,
    read as `2·gravSource`) is genuinely NOT the census's ordinary trace (`ρ − 3P`) whenever
    `P ≠ 0`: the `+3P`/`−3P` distinction is not cosmetic. The gravitational trace and the census
    trace are DIFFERENT readings. -/
theorem source_sign_load_bearing (rho P : ℚ) (hP : P ≠ 0) :
    2 * gravSource (pfStress rho P) ≠ LinearMap.trace ℚ STV4 (pfStress rho P) := by
  rw [gravSource_pf, eos_trace]; intro h; apply hP; linarith

/-- ★★★ THE MARQUEE CROSS-TIE (transverse to the census, non-hollow): RADIATION is ORDINARY-TRACELESS
    (census `T^μ_μ = 0`, whence `w = +1/3`) YET GRAVITATES POSITIVELY (its trace-reversed source is
    `> 0`). "Traceless" (of the ordinary trace) does NOT mean "does not gravitate": the two traces
    are genuinely different objects. -/
theorem radiation_traceless_but_gravitates (rho : ℚ) (h : 0 < rho) :
    LinearMap.trace ℚ STV4 (pfStress rho (rho / 3)) = 0
    ∧ 0 < gravSource (pfStress rho (rho / 3)) := by
  refine ⟨?_, radiation_source_positive rho h⟩
  rw [eos_trace]; ring

/-! ## The capstone — the gravitational-source threshold. -/

/-- ★★★ THE GRAVITATIONAL-SOURCE THRESHOLD (bundled). The combination that gravitates is the
    TRACE-REVERSED source `½·(ρ + n·P)`, DISTINCT from the census's ordinary trace `ρ − n·P`, welded
    (NOT a bare ∧) by the never-co-stated facts that tie them together:
      • THE SOURCE READING: `gravSource (pfStress ρ P) = ½·(ρ + n·P)` with `n = finrank spaceSub4`
        DERIVED (`gravSource_pf_dim` + `gravSource_dim_eq_spaceSub4`);
      • THE THRESHOLD: the source vanishes `⟺ w = −1/n` — the exact sign-mirror of the census's
        radiation `w = +1/n` (`gravSource_zero_iff_dim`);
      • THE SIGN SPLIT (`ρ > 0`): dust `> 0`, radiation `> 0`, vacuum `< 0` — attraction turning to
        REPULSION as `w` crosses `−1/n`;
      • THE CROSS-TIE: radiation is ordinary-traceless yet gravitates positively — the two traces
        are DIFFERENT readings (`radiation_traceless_but_gravitates`), and the source sign is
        load-bearing (`source_sign_load_bearing`).
    THEOREM-route; the physical names (source / active mass / dark-energy repulsion) carry ZERO
    logical weight (words-removable). -/
theorem gravitational_source_threshold (rho : ℚ) (h : 0 < rho) :
    -- THE SOURCE READING with the DERIVED dimension
    (gravSource (pfStress rho (rho / 3))
        = 2⁻¹ * (rho + (Module.finrank ℚ (ℚ × Dbl ℚ) : ℚ) * (rho / 3))
      ∧ Module.finrank ℚ (ℚ × Dbl ℚ) = Module.finrank ℚ spaceSub4)
    -- THE THRESHOLD: source vanishes ⟺ w = −1/n
    ∧ (∀ P, gravSource (pfStress rho P) = 0 ↔
        eosState (pfStress rho P) = -1 / (Module.finrank ℚ spaceSub4 : ℚ))
    -- THE SIGN SPLIT: attraction (dust, radiation) turning to REPULSION (vacuum)
    ∧ (0 < gravSource (pfStress rho 0)
        ∧ 0 < gravSource (pfStress rho (rho / 3))
        ∧ gravSource (pfStress rho (-rho)) < 0)
    -- THE CROSS-TIE: ordinary-traceless YET gravitates; the gravitational trace ≠ the census trace
    ∧ (LinearMap.trace ℚ STV4 (pfStress rho (rho / 3)) = 0
        ∧ 0 < gravSource (pfStress rho (rho / 3))
        ∧ ∀ P, P ≠ 0 →
            2 * gravSource (pfStress rho P) ≠ LinearMap.trace ℚ STV4 (pfStress rho P)) := by
  refine ⟨⟨gravSource_pf_dim rho (rho / 3), gravSource_dim_eq_spaceSub4⟩, ?_,
    ⟨dust_source_positive rho h, radiation_source_positive rho h, vacuum_source_negative rho h⟩,
    ⟨(radiation_traceless_but_gravitates rho h).1, (radiation_traceless_but_gravitates rho h).2,
      ?_⟩⟩
  · intro P; exact gravSource_zero_iff_dim rho P (ne_of_gt h)
  · intro P hP; exact source_sign_load_bearing rho P hP

end

