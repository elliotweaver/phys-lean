noncomputable section

/-! ## (A) THE THREE CENSUS-NATIVE TEMPERING READINGS of the overshooting adjoint gather census. -/

/-- THE RATIO TEMPERING over the derived ℝ: the overshooting fund-7 gather isospin census reduced by
    the banked convention-free `3:8` ratio (the fraction `isoDepth/chargeTraceDepth = 3/8` the two
    sectors share, N253 / predecessor `matter_ratio_3_8`). -/
def ratioTempered : Cut := gatherIsoSpinCensus * (isoDepth / chargeTraceDepth)

/-- THE DOUBLING TEMPERING over the derived ℝ: the overshooting census reduced by the banked doubling
    square `doublingSq = 2²` a SECOND time (the fundamental doublet is the un-doubled carrier). This
    coincides numerically with the standard su(2) Dynkin-index ratio `T(fund):T(adj) = 1:4`. -/
def doublingTempered : Cut := gatherIsoSpinCensus / doublingSq

/-- THE HALVING READING over the derived ℝ: the overshooting census un-doubled by a single factor of
    the doubling `2` (one of the two doubling triplets `TL ⊕ TR`, N277). -/
def halvingReduced : Cut := gatherIsoSpinCensus / 2

/-! ## (B) THE THREE VALUES — exact closed reals of `Cut`. -/

/-- ★★ THE RATIO TEMPERING IS `3/2`: `gatherIsoSpinCensus·(isoDepth/chargeTraceDepth) = 4·(2/(16/3)) =
    4·(3/8) = 3/2`. From the banked `gatherIsoSpinCensus_eq = 4`, `isoDepth_eq = 2`,
    `chargeTraceDepth_eq = 16/3`. -/
theorem ratioTempered_eq : ratioTempered = 3 / 2 := by
  unfold ratioTempered
  rw [gatherIsoSpinCensus_eq, isoDepth_eq, chargeTraceDepth_eq]; norm_num

/-- ★★ THE DOUBLING TEMPERING IS `1`: `gatherIsoSpinCensus/doublingSq = 4/4 = 1`. From the banked
    `gatherIsoSpinCensus_eq = 4` and `doublingSq = 4`. -/
theorem doublingTempered_eq : doublingTempered = 1 := by
  unfold doublingTempered doublingSq
  rw [gatherIsoSpinCensus_eq]; norm_num

/-- ★★ THE HALVING READING LANDS ON THE BOUNDARY `isoDepth`: `gatherIsoSpinCensus/2 = (2·isoDepth)/2 =
    isoDepth`. From the banked overshoot factor `gatherIsoSpinCensus_eq_two_isoDepth`. -/
theorem halvingReduced_eq : halvingReduced = isoDepth := by
  unfold halvingReduced
  rw [gatherIsoSpinCensus_eq_two_isoDepth]; ring

/-! ## (C) ADMISSIBILITY — both temperings are strictly interior; the halving is the boundary. -/

/-- ★★★ THE RATIO TEMPERING IS ADMISSIBLE: `0 < ratioTempered < isoDepth` (`0 < 3/2 < 2`). UNLIKE the
    raw census (`raw_not_admissible`, predecessor), the ratio tempering lands strictly inside the
    banked open range the whole D2c/Z2/N342 running machinery requires — it FIXES the predecessor's
    inadmissibility. -/
theorem ratioTempered_admissible : (0 : Cut) < ratioTempered ∧ ratioTempered < isoDepth := by
  refine ⟨?_, ?_⟩
  · rw [ratioTempered_eq]; norm_num
  · rw [ratioTempered_eq, isoDepth_eq]; norm_num

/-- ★★★ THE DOUBLING TEMPERING IS ADMISSIBLE: `0 < doublingTempered < isoDepth` (`0 < 1 < 2`). A
    SECOND, DISTINCT census-native reading that ALSO lands strictly inside the banked open range. -/
theorem doublingTempered_admissible :
    (0 : Cut) < doublingTempered ∧ doublingTempered < isoDepth := by
  refine ⟨?_, ?_⟩
  · rw [doublingTempered_eq]; norm_num
  · rw [doublingTempered_eq, isoDepth_eq]; norm_num

/-- ★★ THE HALVING READING IS INADMISSIBLE (the boundary): `¬ (0 < halvingReduced ∧ halvingReduced <
    isoDepth)`. It equals `isoDepth` exactly, so `netIsoDepth = 0` — the fully-screened boundary,
    outside the required strict open range. Admissibility genuinely EXCLUDES it. -/
theorem halvingReduced_not_admissible :
    ¬ ((0 : Cut) < halvingReduced ∧ halvingReduced < isoDepth) := by
  rintro ⟨_, h2⟩
  rw [halvingReduced_eq] at h2
  exact (lt_irrefl _ h2)

/-! ## (D) THE UNDER-DETERMINATION — the census layer does not pin `s` to a point. -/

/-- ★★★ THE TEMPERINGS DISAGREE (THE CEILING): the two admissible census-native temperings are
    DISTINCT — `doublingTempered ≠ ratioTempered` (`1 ≠ 3/2`). Both land strictly inside the banked
    open range `(0, isoDepth)`; admissibility (which kills the raw census `4` and the boundary halving
