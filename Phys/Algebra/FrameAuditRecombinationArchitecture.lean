/-! ## (A) THE SINGLE-PARAMETER RECOMBINATION FAMILY — both architectures as one object at two `t`. -/

/-- ★★ THE SINGLE-PARAMETER RECOMBINATION FAMILY over the derived ℝ `Cut`: the two ceilings
    `112 = invAlpha2High + invAlphaYHigh = 42 + 70` (COMMON to both architectures) plus the tower
    screening at the recombined census `netIsoDepth t + hyperDepth` — the isospin channel reduced by a
    magnitude `t`, the abelian hypercharge unreduced. `t = 0` is ARCH-A (additive, isospin at bare
    matter census); `t = projectedS` is ARCH-B (isospin at its net running census). -/
def recombArch (t : Cut) (bands : List (Cut × Cut)) : Cut :=
  112 + totalScreeningWith (netIsoDepth t + hyperDepth) bands

/-- The two ceilings sum to `112` for EVERY `t` — the `+70` hypercharge ceiling is COMMON to both
    architectures, so it is NOT the discriminator. (The recombined census `netIsoDepth t + hyperDepth`
    is the only `t`-dependent piece.) -/
theorem recombArch_ceiling_common (t : Cut) (bands : List (Cut × Cut)) :
    recombArch t bands = 112 + totalScreeningWith (netIsoDepth t + hyperDepth) bands := rfl

/-! ## (B) THE TWO ARCHITECTURE IDENTIFICATIONS — ARCH-A at `t=0`, ARCH-B at `t=projectedS`. -/

/-- At `t = 0` the recombined census IS the full charge census: `netIsoDepth 0 + hyperDepth =
    chargeTraceDepth`. The switch-off returns the isospin channel to its bare matter census, and
    `Q = T₃ + Y` census additivity (`census_additive`) sums it with the hypercharge census to the full
    charge census. -/
theorem netIsoDepth_zero_add_hyper : netIsoDepth 0 + hyperDepth = chargeTraceDepth := by
  rw [census_additive]; unfold netIsoDepth; ring

/-- ★★★ ARCH-A IS THE SWITCH-OFF: `recombArch 0 = invAlphaEM`. At `t = 0` (the Z1 gather self-census
    switched off) the family collapses onto the banked additive recombined coupling
    (`RecombinedEndpoint.invAlphaEM`, the `invAlphaZero + 70` architecture). -/
theorem recombArch_zero_eq_additive (bands : List (Cut × Cut)) :
    recombArch 0 bands = invAlphaEM bands := by
  unfold recombArch
  rw [netIsoDepth_zero_add_hyper, ← invAlphaEM_closed_charge]

/-- ★★★ ARCH-B IS THE DERIVED-REDUCTION FAMILY MEMBER: `recombArch projectedS = recomposedInvAlphaEM`.
    At `t = s = projectedS` (the DERIVED Z1 anti-screening `1/8`) the family is exactly the banked
    run-both-channels-then-recombine coupling (`RecomposedRunningEndpoint.recomposedInvAlphaEM`, the
    isospin channel at its net running census). -/
theorem recombArch_projectedS_eq_recomposed (bands : List (Cut × Cut)) :
    recombArch projectedS bands = recomposedInvAlphaEM bands := by
  unfold recombArch
  rw [recomposedInvAlphaEM_closed]
  rfl

/-! ## (C) THE ENDPOINT/CENSUS ADJUDICATOR — the architectures differ by the exact Z1 anti-screening. -/

/-- ★★★ THE EXACT ARCHITECTURE SHIFT: the two architectures differ at the top band by EXACTLY the Z1
