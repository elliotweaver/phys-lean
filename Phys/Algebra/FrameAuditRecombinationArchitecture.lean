theorem archA_vs_archB_mixing_distinct (κ M μ : Cut) (hκ : 0 < κ) (hμ : 0 < μ) (hμM : μ < M)
    (h2 : invAlpha2 isoDepth κ M μ ≠ 0) :
    sinSqRun (netIsoDepth projectedS) κ M μ ≠ sinSqRun (netIsoDepth 0) κ M μ := by
  have hB := archB_departs_mixing κ M μ hκ hμ hμM
  have hA := archA_freezes_mixing κ M μ h2
