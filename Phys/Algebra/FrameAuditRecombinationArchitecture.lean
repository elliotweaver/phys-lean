    recombArch 0 [(chargeTraceDepth, topBandRatio)]
      ≠ recombArch projectedS [(chargeTraceDepth, topBandRatio)] := by
  intro h
  have hshift : bandScreen projectedS topBandRatio = 0 := by
    rw [← architecture_shift_exact, h]; ring
  exact recomposed_shift_ne_zero hshift

/-- ★★ THE DERIVED PARAMETER AVOIDS THE SWITCH-OFF BOUNDARY: `projectedS ≠ 0`. The Z1 negative isospin
    gather self-census forces a strictly positive reduction (`projectedS_admissible`: `0 < projectedS`),
    so ARCH-A (`t = 0`, the switch-off) is the FORBIDDEN member; the derived architecture is `t =
    projectedS = 1/8`. -/
theorem forced_param_ne_zero : projectedS ≠ 0 := by
  have h := projectedS_admissible.1
  intro he; rw [he] at h; exact lt_irrefl 0 h

/-- ★ THE `+70` CEILING IS COMMON, NOT THE DEFECT: at the top band both architectures carry the SAME
