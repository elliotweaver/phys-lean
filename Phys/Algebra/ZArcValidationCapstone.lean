/-! ## (1) THE ONE DERIVED PREDICTION OBJECT OVER `Cut` (§Z8(a)). -/

/-- ★ THE Z-ARC PREDICTION BUNDLE: the readings of the ONE finite band tower from the octonion ceiling,
    gathered into ONE object over the derived ℝ `Cut`. Each field is a banked DERIVED reading:
    • `ceiling = invAlphaHigh = 42` (the octonion cascade-stop ceiling, X3/X6);
    • `ewWaypoint = invAlphaZero [(chargeTraceDepth, topBandRatio)] = 1582/27` (the octonion→
      electroweak way-point, X6/X7/Z2);
    • `confWaypoint = invAlphaZero derivedBandList = 190/3` (the confinement-scale way-point, Z4);
    • `endpoint = invAlphaZero (completeBandList chargeTraceDepth)` (the zero-momentum reading, Z6).
    The prediction object IS the finite band tower's readings — one structure, four derived reals. -/
structure ZPrediction where
  ceiling : Cut
  ewWaypoint : Cut
  confWaypoint : Cut
  endpoint : Cut

/-- The populated Z-arc prediction bundle: each field the banked derived reading it names. -/
def zPrediction : ZPrediction :=
  { ceiling := invAlphaHigh
    ewWaypoint := invAlphaZero [(chargeTraceDepth, topBandRatio)]
    confWaypoint := invAlphaZero derivedBandList
    endpoint := invAlphaZero (completeBandList chargeTraceDepth) }

/-! ## (2) THE FIELD VALUES — each a banked derived closed reading (§Z8(a)). -/

/-- The ceiling field is the octonion cascade-stop value `42` (`invAlphaHigh_eq`, X3/X6). -/
theorem ceiling_value : zPrediction.ceiling = 42 := invAlphaHigh_eq

/-- The electroweak way-point field is the EXACT `1582/27` (`em_waypoint_consistency`, X6/X7/Z2). -/
theorem ewWaypoint_value : zPrediction.ewWaypoint = 1582 / 27 := em_waypoint_consistency

/-- The confinement way-point field is the EXACT `190/3` (`derivedBandList_assembly`, Z4). -/
theorem confWaypoint_value : zPrediction.confWaypoint = 190 / 3 := derivedBandList_assembly

/-- The endpoint field is the derived closed real `190/3 + κ·d·cutLog(mass0/mass1)`
    (`endpoint_expanded`, Z6). -/
theorem endpoint_value :
    zPrediction.endpoint = 190 / 3 + kappaLeading * chargeTraceDepth * cutLog (mass0 / mass1) :=
  endpoint_expanded chargeTraceDepth

/-! ## (3) THE NON-HOLLOW ONE-TOWER WELD (★ the marquee ONE-CAUSE unification). -/

/-- ★★★ THE ONE-TOWER WELD: the SM's FIVE unrelated measured couplings — at the octonion ceiling, the
    electroweak edge `v`, the `M_Z` edge, the confinement edge `Λ`, and zero momentum — are ALL PARTIAL
    SUMS of the ONE completed band tower `completeBandList d` from the octonion ceiling:
    (i)   the standalone confinement way-point is `190/3` (`derivedBandList_assembly`, Z4);
    (ii)  the completed tower reads the confinement way-point as a partial sum
          (`confWaypoint_in_complete`, Z6): `= 190/3 + totalScreening (leptonTail d)`;
    (iii) the completed tower reads the electroweak way-point as a partial sum
          (`ewWaypoint_in_complete`, Z6): `= 1582/27 + totalScreening ((chargeTraceDepth, confBandRatio)
          :: leptonTail d)`;
    (iv)  the endpoint is the derived closed real (`endpoint_expanded`, Z6):
          `= 190/3 + κ·d·cutLog(mass0/mass1)`;
    (v)   the `M_Z` reading is a partial sum (`endpoint_reads_MZ`, Z7, under the forced product
          constraint `vz·zL = confBandRatio`): `= invAlphaMZ vz + totalScreening (mzBelow zL d)`.
    ONE tower, five readings — the marquee ONE-CAUSE unification, statable from no single conjunct
    alone (the weld is the SHARING of the ONE tower). It is the coupling analogue-of-one: the SM's
    five unrelated measured inputs are here ONE object's partial sums. -/
theorem one_tower_weld (vz zL d : Cut) (hvz : 0 < vz) (hzL : 0 < zL)
    (hprod : vz * zL = confBandRatio) :
    invAlphaZero derivedBandList = 190 / 3
    ∧ invAlphaZero (completeBandList d) = 190 / 3 + totalScreening (leptonTail d)
    ∧ invAlphaZero (completeBandList d)
        = 1582 / 27 + totalScreening ((chargeTraceDepth, confBandRatio) :: leptonTail d)
    ∧ invAlphaZero (completeBandList d) = 190 / 3 + kappaLeading * d * cutLog (mass0 / mass1)
    ∧ invAlphaZero (completeBandList d) = invAlphaMZ vz + totalScreening (mzBelow zL d) :=
  ⟨derivedBandList_assembly,
   confWaypoint_in_complete d,
   ewWaypoint_in_complete d,
   endpoint_expanded d,
   endpoint_reads_MZ vz zL d hvz hzL hprod⟩

/-! ## (4) THE PER-VALUE GRADE LEDGER as a Lean-checkable object (§Z8(b)/(c)). -/

