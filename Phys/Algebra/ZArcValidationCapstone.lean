      (III) the Z1 GATHER SELF-CENSUS SENSE — the gather's skew self-overlap is `< 0`, opposite to the
            matter census `> 0` (`gatherCharge_selfCensus_neg`, `matter_selfCensus_pos`);
      (IV)  the Z2 TWO-CHANNEL BREAK — the recombined mixing runs strictly `< 3/8` below the octonion
            scale (`twoChannel_mixing_departs`), returning to `3/8` when the gather self-census is
            switched off (`twoChannel_switchoff`, the consistency tooth);
      (V)   the Z5 DRESSED depth-tower closed function `42 + (64/3)/(1−w)`
            (`dressedInvAlphaZero_derivedBandList`);
      (VI)  the Z3 QUARK TEXTURE — PAYING the X10 debt: the per-sector Koide total, genuine CKM
            mixing, and Fano-line CP present (`quark_texture_earned`);
      (VII) the ACCOUNTING IS A TOTAL PARTITION over the ENLARGED ledger — every enumerated value is
            graded OR a dispositioned residual (`ledger_coverage`) and none is both (`ledger_disjoint`):
            "NO RESIDUAL" is a theorem;
      (VIII) the X10 DEBT PAID + NO SILENT UPGRADE — the quark texture is a `theoremExact` graded value
            (`x10_quark_debt_paid`), while the ℝ-descent numerals stay `routeNotYetFound`
            (`rdescent_not_upgraded`) and the absolutes stay `anchoredOnDerivedScale`
            (`absolutes_not_upgraded`);
      (IX)  TEETH — the endpoint genuinely screens above the confinement way-point
            (`endpoint_gt_conf`) and the `M_Z` reading is strictly below the endpoint
            (`endpoint_gt_invAlphaMZ`, a genuine partial sum).
    Statable from no single conjunct alone (non-hollow — the weld is the SHARING of the ONE tower, the
    audit is the PARTITION over the enlarged ledger). ⚠ HONEST GRADE: the one-tower weld, the field
    values, the census sense, the channel break, the dressing, and the quark-texture STRUCTURE are
    theorem-exact NOW; the absolute masses / confinement scale are anchored-on-derived-scale (X8/X9);
    the ℝ-descent numerals (the `v/M_Z` ratio, `cutLog(mass0/mass1)`, the light-quark/hadronic edges,
    the per-band freeze-out, the numerical quark ratios) are ROUTE-NOT-YET-FOUND, carried in the grade
    ledger, NEVER upgraded, handed to the ℝ-descent evaluation arc (arc D); the physical numerals /
    labels / measured comparison are removable prose — all carried in the ledgers, NEVER asserted,
    NEVER fitted. No empirical number in any proof (G2). -/
theorem zArcValidationCapstone (w vz zL d M mz s : Cut) (hw0 : 0 ≤ w) (hw1 : w < 1)
    (hvz : 0 < vz) (hzL1 : 1 ≤ zL) (hprod : vz * zL = confBandRatio)
    (hκ : 0 < kappaLeading) (hs : 0 < s) (hsIso : s < isoDepth) (hmz : 0 < mz) (hmzM : mz < M)
    (h2 : invAlpha2 isoDepth kappaLeading M mz ≠ 0) :
    -- (I) the one-tower weld — one tower, five readings
    (invAlphaZero derivedBandList = 190 / 3
      ∧ invAlphaZero (completeBandList d) = 190 / 3 + totalScreening (leptonTail d)
      ∧ invAlphaZero (completeBandList d)
          = 1582 / 27 + totalScreening ((chargeTraceDepth, confBandRatio) :: leptonTail d)
      ∧ invAlphaZero (completeBandList d) = 190 / 3 + kappaLeading * d * cutLog (mass0 / mass1)
      ∧ invAlphaZero (completeBandList d) = invAlphaMZ vz + totalScreening (mzBelow zL d))
    -- (II) the derived field values
    ∧ (zPrediction.ceiling = 42
      ∧ zPrediction.ewWaypoint = 1582 / 27
      ∧ zPrediction.confWaypoint = 190 / 3
      ∧ zPrediction.endpoint = 190 / 3 + kappaLeading * chargeTraceDepth * cutLog (mass0 / mass1))
    -- (III) the Z1 gather self-census sense (opposite to matter)
    ∧ (traceForm7 chargeOp chargeOp < 0 ∧ (0 : Cut) < chargeTraceDepth)
    -- (IV) the Z2 two-channel break, returning to 3/8 at switch-off
    ∧ (sinSqRun (netIsoDepth s) kappaLeading M mz < 3 / 8
      ∧ sinSqRun (netIsoDepth 0) kappaLeading M mz = 3 / 8)
    -- (V) the Z5 dressed depth-tower closed function
    ∧ dressedInvAlphaZero w derivedBandList = 42 + (64 / 3) / (1 - w)
    -- (VI) the Z3 quark texture (paying the X10 debt): CKM mixing genuine, Fano-CP present
    ∧ ((ckmTexture 1 3 1 0 1 3 0 1) 1 0 ≠ 0
      ∧ textureCP (genVec 1 3 1 0 0) (genVec 1 3 1 0 1)
          (genVec 1 3 0 1 0) (genVec 1 3 0 1 1) u2 u1 (octCross u1 u2) ≠ 0)
    -- (VII) the accounting is a total partition over the enlarged ledger — "NO RESIDUAL" is a theorem
    ∧ ((∀ v : ZValue, v ∈ gradedValues ∨ v ∈ residualValues)
      ∧ (∀ v : ZValue, ¬ (v ∈ gradedValues ∧ v ∈ residualValues)))
    -- (VIII) the X10 debt paid + no scale-anchored/ℝ-descent value silently upgraded
    ∧ ((quarkTextureStructure, theoremExact) ∈ zGradeLedger
      ∧ (leptonAbsMasses, theoremExact) ∉ zGradeLedger
      ∧ (cutLogMass01Numeral, theoremExact) ∉ zGradeLedger)
    -- (IX) teeth: the endpoint genuinely screens; the M_Z reading is strictly below it
    ∧ ((190 : Cut) / 3 < invAlphaZero (completeBandList chargeTraceDepth)
      ∧ invAlphaMZ vz < invAlphaZero (completeBandList chargeTraceDepth)) :=
  ⟨one_tower_weld vz zL d hvz (lt_of_lt_of_le zero_lt_one hzL1) hprod,
   ⟨ceiling_value, ewWaypoint_value, confWaypoint_value, endpoint_value⟩,
   ⟨gatherCharge_selfCensus_neg, matter_selfCensus_pos⟩,
   ⟨twoChannel_mixing_departs s kappaLeading M mz hκ hs hsIso hmz hmzM,
    (twoChannel_switchoff kappaLeading M mz h2).2⟩,
   dressedInvAlphaZero_derivedBandList w hw0 hw1,
   ⟨quark_mixing_nonzero, quark_cp_present_lepton_cp_absent.1⟩,
   ⟨ledger_coverage, ledger_disjoint⟩,
   ⟨(x10_quark_debt_paid).2, (absolutes_not_upgraded).1, (rdescent_not_upgraded).2.1⟩,
   ⟨endpoint_gt_conf, endpoint_gt_invAlphaMZ vz zL hvz hzL1 hprod⟩⟩

end

