    ℝ-descent numeral; the residual ledger actually carries a removable-prose exception. A hollow
    attestation over empty ledgers (with no entries to witness) is excluded. -/
theorem ledgers_nonempty :
    (ceiling, theoremExact) ∈ zGradeLedger
    ∧ (quarkTextureStructure, theoremExact) ∈ zGradeLedger
    ∧ (leptonAbsMasses, anchoredOnDerivedScale) ∈ zGradeLedger
    ∧ (cutLogMass01Numeral, routeNotYetFound) ∈ zGradeLedger
    ∧ (measuredComparison, removableProse) ∈ zResidualLedger := by
  refine ⟨?_, ?_, ?_, ?_, ?_⟩ <;> decide

