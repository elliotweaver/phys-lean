        - dressedInvAlphaEMJoin depthWeight projectedS j (completeBandList chargeTraceDepth))
      < dressedInvAlphaEMJoin depthWeight (1 / 2) j (completeBandList chargeTraceDepth)
        - dressedInvAlphaEMJoin depthWeight (3 / 2) j (completeBandList chargeTraceDepth)) := by
  have hzero := pinned_s_gap_eq_zero depthWeight j (le_of_lt depthWeight_pos) depthWeight_lt_one
      (completeBandList chargeTraceDepth)
  have hgap := composed_numeral_unpinnable j
  refine ⟨hzero, ?_⟩
  rw [hzero]
