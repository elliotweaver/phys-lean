    dressedInvAlphaEMJoin w projectedS j bands
      = 112 + ((chargeTraceDepth - projectedS) * totalScreeningWith 1 bands) / (1 - w)
        + joinContent w j := by
  rw [dressedInvAlphaEMJoin_split, dressedInvAlphaEM_closed w projectedS hw0 hw1]

/-- ★★ THE SURVIVING `s`-COEFFICIENT IS NONZERO (teeth): `chargeTraceDepth − projectedS = 16/3 − 1/8
