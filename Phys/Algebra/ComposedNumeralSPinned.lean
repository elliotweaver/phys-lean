theorem pinned_s_gap_eq_zero (w j : Cut) (hw0 : 0 ≤ w) (hw1 : w < 1) (bands : List (Cut × Cut)) :
    dressedInvAlphaEMJoin w projectedS j bands - dressedInvAlphaEMJoin w projectedS j bands = 0 := by
  rw [composed_s_difference w projectedS projectedS j hw0 hw1 bands]
  have hz : projectedS - projectedS = (0 : Cut) := sub_self _
  rw [hz, zero_mul, zero_div]

/-- ★★★ THE OBSTRUCTION IS CLEARED ON THE `s`-SIDE (the contrast — collapse from `> 1` to `0`): at the
