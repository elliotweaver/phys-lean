    ∧ 0 < totalScreening (freezeoutTail rb rc rl)
    ∧ invAlphaZero (completeBandList chargeTraceDepth)
        < invAlphaZero (completeFreezeoutList rb rc rl chargeTraceDepth)
    -- (3) teeth
