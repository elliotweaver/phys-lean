theorem theNumeral_pinned :
    (679475880261 / 10000000000 : Cut) < invAlphaZero (completeBandList chargeTraceDepth)
      ∧ invAlphaZero (completeBandList chargeTraceDepth) < 679475880262 / 10000000000 := by
  obtain ⟨hlo, hhi⟩ := theNumeral_bracket
  refine ⟨?_, ?_⟩
  · have hw : (679475880261 / 10000000000 : Cut) < 12007329939722 / 176714586765 := by norm_num
    linarith
  · have hw : (32019546505738 / 471238898037 : Cut) < 679475880262 / 10000000000 := by norm_num
    linarith

/-! ## (B) THE COMPOSITION-COMPLETENESS ATTESTATION — the composition is PARTIAL (theorem). -/

/-- ★★★ THE ATTESTATION TOWER SPLIT (exact identity of `Cut`): the COMPLETE tower with the
    freeze-out sub-bands inserted reads EXACTLY the partial-tower endpoint PLUS the freeze-out
    summand:
        invAlphaZero (completeFreezeoutList rb rc rl d)
          = invAlphaZero (completeBandList d) + totalScreening (freezeoutTail rb rc rl).
    The banked D2 way-point-free assembly (`freezeout_confWaypoint_free`), the additive-append
    decomposition (`totalScreening_append`), and the banked Z6 partial-tower split
    (`confWaypoint_in_complete`) make the numeral a genuine PARTIAL SUM of the complete tower — the
    freeze-out sub-bands are a separate, additive summand. -/
theorem attestation_tower_split (rb rc rl d : Cut) :
    invAlphaZero (completeFreezeoutList rb rc rl d)
      = invAlphaZero (completeBandList d) + totalScreening (freezeoutTail rb rc rl) := by
  rw [freezeout_confWaypoint_free, totalScreening_append, confWaypoint_in_complete]
  ring

/-- ★★ THE MISSING SUMMAND IS NON-ZERO: for screening freeze-out edge ratios (`1 < rb, rc, rl`), the
