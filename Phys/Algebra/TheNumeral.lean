    (12007329939722 / 176714586765 : Cut) ≤ invAlphaZero (completeBandList chargeTraceDepth)
      ∧ invAlphaZero (completeBandList chargeTraceDepth) ≤ 32019546505738 / 471238898037 :=
  NarrowedBracket12.invAlphaZero_narrowed12_bracket

/-- ★★★ THE NUMERAL PINNED TO 12 SIGNIFICANT DIGITS: the derived partial-tower endpoint lies in the
    decimal window `(679475880261/1e10, 679475880262/1e10)`, i.e. `67.9475880261…`. Twelve
