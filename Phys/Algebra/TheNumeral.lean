theorem attestation_partial (rb rc rl : Cut) (hb : 1 < rb) (hc : 1 < rc) (hl : 1 < rl) :
    invAlphaZero (completeBandList chargeTraceDepth)
      < invAlphaZero (completeFreezeoutList rb rc rl chargeTraceDepth) := by
  rw [attestation_tower_split]
  have := attestation_freezeout_nonzero rb rc rl hb hc hl
  linarith

