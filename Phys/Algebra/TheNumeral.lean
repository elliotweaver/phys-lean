theorem attestation_freezeout_nonzero (rb rc rl : Cut) (hb : 1 < rb) (hc : 1 < rc) (hl : 1 < rl) :
    0 < totalScreening (freezeoutTail rb rc rl) :=
  freezeoutTail_screens rb rc rl hb hc hl

/-- ★★★ THE ATTESTATION — THE COMPOSITION IS PARTIAL: for screening freeze-out edge ratios, the
