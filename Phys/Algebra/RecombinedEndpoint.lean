/-! ## (A) THE CENSUS ADDITIVITY — `Q = T₃ + Y`, the driver of the free weld. -/

/-- ★★ THE CHARGE CENSUS SPLITS ADDITIVELY: `chargeTraceDepth = isoDepth + hyperDepth`
    (`16/3 = 2 + 10/3`). The electric charge is `Q = T₃ + Y` with the cross-term `Tr(T₃·Y)`
    traceless, so the banked charge census (X6 `chargeTraceDepth_eq`) is the sum of the two channel
    censuses (N342 `isoDepth_eq`/`hyperDepth_eq`). This is what makes the two-channel weld FREE. -/
theorem census_additive : chargeTraceDepth = isoDepth + hyperDepth := by
  rw [chargeTraceDepth_eq, isoDepth_eq, hyperDepth_eq]; norm_num

/-- ★★ THE PER-BAND CHANNEL SPLIT: `bandScreen isoDepth r + bandScreen hyperDepth r = bandScreen
    chargeTraceDepth r`. Because `bandScreen` is LINEAR in the census (`κ·census·cutLog r`), the two
    channel screenings over the SAME ratio sum to the single charge screening (`census_additive`). -/
theorem bandScreen_channel_split (r : Cut) :
    bandScreen isoDepth r + bandScreen hyperDepth r = bandScreen chargeTraceDepth r := by
  unfold bandScreen
  rw [census_additive]; ring

/-! ## (B) THE CHANNEL SCREENING TOWERS — each channel screens with its OWN census. -/

/-- THE PER-CHANNEL TOTAL SCREENING over a band tower: the sum of the per-band increments, each at a
    FIXED channel census `c` over the band's own ratio. `totalScreeningWith chargeTraceDepth = the
    banked X6 `totalScreening` (see `totalScreeningWith_eq_totalScreening`). -/
def totalScreeningWith (c : Cut) (bands : List (Cut × Cut)) : Cut :=
  (bands.map (fun p => bandScreen c p.2)).sum

/-- ★★ THE CHANNEL SCREENING SPLITS OVER THE WHOLE TOWER: `totalScreeningWith isoDepth bands +
    totalScreeningWith hyperDepth bands = totalScreeningWith chargeTraceDepth bands`. Induction on
    the finite band list over the per-band `bandScreen_channel_split`. The two channels' summed
    screening EQUALS the single charge screening across the entire tower. -/
theorem totalScreeningWith_channel_split (bands : List (Cut × Cut)) :
    totalScreeningWith isoDepth bands + totalScreeningWith hyperDepth bands
      = totalScreeningWith chargeTraceDepth bands := by
  induction bands with
  | nil => simp [totalScreeningWith]
  | cons p ps ih =>
    unfold totalScreeningWith at ih ⊢
    simp only [List.map_cons, List.sum_cons]
    have hb := bandScreen_channel_split p.2
    linarith [ih, hb]

