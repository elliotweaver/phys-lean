    ∧ invAlphaEM (completeBandList chargeTraceDepth)
        = invAlphaZero (completeBandList chargeTraceDepth) + 70
    -- (5) the recombination weight = Z2's banked high-scale mixing
    ∧ invAlpha2High / (invAlpha2High + invAlphaYHigh) = 3 / 8
    ∧ invAlpha2High / (invAlpha2High + invAlphaYHigh) = sinSqRun d2 κ M M
    -- (6) the composed numeral: certified bracket + decimal window
    ∧ ((12007329939722 / 176714586765 + 70 : Cut) ≤ invAlphaEM (completeBandList chargeTraceDepth)
        ∧ invAlphaEM (completeBandList chargeTraceDepth) ≤ 32019546505738 / 471238898037 + 70)
    ∧ ((1379475880261 / 10000000000 : Cut) < invAlphaEM (completeBandList chargeTraceDepth)
        ∧ invAlphaEM (completeBandList chargeTraceDepth) < 1379475880262 / 10000000000)
    -- (7) teeth
    ∧ (invAlphaEM (completeBandList chargeTraceDepth)
        ≠ invAlphaZero (completeBandList chargeTraceDepth))
    ∧ (isoDepth ≠ 0 ∧ hyperDepth ≠ 0)
    ∧ isoDepth ≠ hyperDepth
    ∧ invAlpha2High / (invAlpha2High + invAlphaYHigh) ≠ 1 / 4 :=
  ⟨census_additive,
   totalScreeningWith_channel_split,
   invAlphaEM_closed_charge,
   composed_endpoint,
   recombination_weight,
   recombination_weight_eq_highMixing d2 κ M hM,
   composed_bracket,
   composed_pinned,
   plus70_load_bearing,
   both_channels_present,
   census_split_ne_trivial,
   weight_ne_wrong⟩

end

end Phys.Algebra.RecombinedEndpoint
