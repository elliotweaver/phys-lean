attribute [local instance] CD.narCD CD.srCD dblModuleQ cdModuleQ

noncomputable section

/-! ## (A) THE GENERAL SENSE LAW — the count and the sign (polymorphic MACHINERY).

    `hsCensus M = Σ_{ij} (M_ij)²` is the Hilbert–Schmidt census (the COUNT); `traceSq M = trace(M·M)`
    is the trace-form self-overlap (the census WITH its sense). The sign of `traceSq` is +census for a
    symmetric generator and −census for a SKEW one: the OPPOSITE-SENSE law is the whole of Part A. -/

variable {n : ℕ}

/-- THE HILBERT–SCHMIDT CENSUS of a generator: the sum of squares of its entries (the COUNT). -/
def hsCensus {R : Type*} [CommRing R] (M : Matrix (Fin n) (Fin n) R) : R :=
  ∑ i, ∑ j, (M i j) ^ 2

/-- THE TRACE-FORM SELF-OVERLAP `trace (M · M)` — the census WITH its sense. -/
def traceSq {R : Type*} [CommRing R] (M : Matrix (Fin n) (Fin n) R) : R :=
  (M * M).trace

/-- `traceSq M = Σ_i Σ_j M_ij · M_ji` — the trace of the square expanded over the entries. -/
theorem traceSq_expand {R : Type*} [CommRing R] (M : Matrix (Fin n) (Fin n) R) :
    traceSq M = ∑ i, ∑ j, M i j * M j i := by
  unfold traceSq; rw [Matrix.trace]
  simp only [Matrix.diag_apply, Matrix.mul_apply]

/-- ★★★ THE FOLD'S MINUS (the NEGATIVE sense): for a SKEW-adjoint generator `Mᵀ = −M` — the
    infinitesimal form of the root fold law `look = −id` (`fold_eq_neg`, N1) — the trace-form
    self-overlap is the NEGATED census: `traceSq M = −hsCensus M`. This is the sense with which the
    GATHER (whose generators are skew) enters the screening sum: ANTI-screening. -/
theorem traceSq_skew {R : Type*} [CommRing R] (M : Matrix (Fin n) (Fin n) R) (hM : Mᵀ = -M) :
    traceSq M = - hsCensus M := by
  have hentry : ∀ i j, M j i = -(M i j) := by
    intro i j
    have := congrArg (fun (A : Matrix (Fin n) (Fin n) R) => A i j) hM
    simpa [Matrix.transpose_apply] using this
  rw [traceSq_expand]; unfold hsCensus
  rw [← Finset.sum_neg_distrib]
  apply Finset.sum_congr rfl; intro i _
  rw [← Finset.sum_neg_distrib]
  apply Finset.sum_congr rfl; intro j _
  rw [hentry i j]; ring

/-- THE OBSERVABLE'S PLUS (the POSITIVE sense): for a SYMMETRIC generator `Mᵀ = M` — a self-adjoint
    observable like the matter charge — the trace-form self-overlap is the census with its NATURAL
    sign: `traceSq M = +hsCensus M`. The matter census `Tr(Q²) > 0` is this case. -/
theorem traceSq_symm {R : Type*} [CommRing R] (M : Matrix (Fin n) (Fin n) R) (hM : Mᵀ = M) :
    traceSq M = hsCensus M := by
  have hentry : ∀ i j, M j i = M i j := by
    intro i j
    have := congrArg (fun (A : Matrix (Fin n) (Fin n) R) => A i j) hM
    simpa [Matrix.transpose_apply] using this
  rw [traceSq_expand]; unfold hsCensus
  apply Finset.sum_congr rfl; intro i _
  apply Finset.sum_congr rfl; intro j _
  rw [hentry i j]; ring

/-- THE CENSUS IS NONNEGATIVE (a genuine count of squares) over an ordered field. -/
theorem hsCensus_nonneg {R : Type*} [Field R] [LinearOrder R] [IsStrictOrderedRing R]
    (M : Matrix (Fin n) (Fin n) R) : 0 ≤ hsCensus M := by
  unfold hsCensus
  apply Finset.sum_nonneg; intro i _
  apply Finset.sum_nonneg; intro j _
  positivity

/-- THE CENSUS VANISHES IFF THE GENERATOR IS ZERO. Load-bearing for the strict negative sense and
    for the abelian tooth (a zero generator contributes NO gather self-census). -/
theorem hsCensus_eq_zero_iff {R : Type*} [Field R] [LinearOrder R] [IsStrictOrderedRing R]
    (M : Matrix (Fin n) (Fin n) R) : hsCensus M = 0 ↔ M = 0 := by
  unfold hsCensus
  constructor
  · intro h
    have hz : ∀ i ∈ Finset.univ, ∑ j, (M i j) ^ 2 = 0 := by
      apply (Finset.sum_eq_zero_iff_of_nonneg _).mp h
      intro i _; apply Finset.sum_nonneg; intro j _; positivity
    ext i j
    have hi := hz i (Finset.mem_univ i)
    have hj : ∀ j ∈ Finset.univ, (M i j) ^ 2 = 0 := by
      apply (Finset.sum_eq_zero_iff_of_nonneg _).mp hi
      intro j _; positivity
    have := hj j (Finset.mem_univ j)
    simpa using pow_eq_zero_iff (by norm_num) |>.mp this
  · intro h; subst h; simp

/-- SKEW ⟹ `traceSq ≤ 0` (the anti-screening direction). -/
theorem traceSq_skew_nonpos {R : Type*} [Field R] [LinearOrder R] [IsStrictOrderedRing R]
    (M : Matrix (Fin n) (Fin n) R) (hM : Mᵀ = -M) : traceSq M ≤ 0 := by
  rw [traceSq_skew M hM]; linarith [hsCensus_nonneg M]

/-- ★ SKEW + NONZERO ⟹ `traceSq < 0` (a genuine, strictly negative gather self-census). -/
theorem traceSq_skew_neg {R : Type*} [Field R] [LinearOrder R] [IsStrictOrderedRing R]
    (M : Matrix (Fin n) (Fin n) R) (hM : Mᵀ = -M) (hne : M ≠ 0) : traceSq M < 0 := by
  rw [traceSq_skew M hM]
  have h1 : 0 ≤ hsCensus M := hsCensus_nonneg M
  have h2 : hsCensus M ≠ 0 := fun h => hne ((hsCensus_eq_zero_iff M).mp h)
  have : 0 < hsCensus M := lt_of_le_of_ne h1 (Ne.symm h2)
  linarith

/-- SYMM + NONZERO ⟹ `traceSq > 0` (the observable's genuine positive census). -/
theorem traceSq_symm_pos {R : Type*} [Field R] [LinearOrder R] [IsStrictOrderedRing R]
    (M : Matrix (Fin n) (Fin n) R) (hM : Mᵀ = M) (hne : M ≠ 0) : 0 < traceSq M := by
  rw [traceSq_symm M hM]
  have h1 : 0 ≤ hsCensus M := hsCensus_nonneg M
  have h2 : hsCensus M ≠ 0 := fun h => hne ((hsCensus_eq_zero_iff M).mp h)
  exact lt_of_le_of_ne h1 (Ne.symm h2)

/-! ## (B) THE GATHER REALIZES THE NEGATIVE SENSE (banked instantiation).

    The banked gather generators `chargeOp = qI Cmat`, `imRep DI = qI Imat` (N253) have SKEW integer
    matrices `Cmat`, `Imat`; the banked trace form `traceForm7` coincides with the general `traceSq`
    on these; and the values are the banked `−6`, `−16` — the negative sense CAUSED by skewness. -/

/-- THE GATHER CHARGE MATRIX IS SKEW: `Cmatᵀ = −Cmat` (the fold's `look = −id` at generator level). -/
theorem Cmat_skew : (Cmat : Matrix (Fin 7) (Fin 7) ℤ)ᵀ = -(Cmat : Matrix (Fin 7) (Fin 7) ℤ) := by
  decide

/-- THE GATHER ISOSPIN MATRIX IS SKEW: `Imatᵀ = −Imat`. -/
theorem Imat_skew : (Imat : Matrix (Fin 7) (Fin 7) ℤ)ᵀ = -(Imat : Matrix (Fin 7) (Fin 7) ℤ) := by
  decide

/-- THE BANKED TRACE FORM IS THE GENERAL `traceSq` ON THE INTEGER MATRIX: `traceForm7 (qI M) (qI M)`
    equals `(traceSq M : ℚ)`. Through the banked `traceForm7_qI` / `tr7 (mul7 M M)` and the general
    `traceSq_expand`. Ties the banked gather trace form to the general sense law of Part A. -/
theorem traceForm7_eq_traceSq (M : M7) :
    traceForm7 (qI M) (qI M) = ((traceSq (M : Matrix (Fin 7) (Fin 7) ℤ) : ℤ) : ℚ) := by
  rw [traceForm7_qI]
  congr 1
  unfold traceSq; rw [Matrix.trace]
  simp only [tr7, mul7, Matrix.diag_apply, Matrix.mul_apply, Fin.sum_univ_seven]

/-- ★★ THE GATHER CHARGE SELF-CENSUS IS NEGATIVE, VIA SKEWNESS: the general negative-sense law
    `traceSq_skew` applied to the SKEW `Cmat` gives `traceSq Cmat = −hsCensus Cmat = −6`. The gather
    charge enters the screening sum with the fold's minus. -/
theorem gatherCharge_traceSq : traceSq (Cmat : Matrix (Fin 7) (Fin 7) ℤ) = -6 := by
  rw [traceSq_skew _ Cmat_skew]; unfold hsCensus; decide

/-- ★★ THE GATHER ISOSPIN SELF-CENSUS IS NEGATIVE, VIA SKEWNESS: `traceSq Imat = −hsCensus Imat
    = −16`. -/
theorem gatherIsospin_traceSq : traceSq (Imat : Matrix (Fin 7) (Fin 7) ℤ) = -16 := by
  rw [traceSq_skew _ Imat_skew]; unfold hsCensus; decide

/-- THE HILBERT–SCHMIDT COUNTS: `hsCensus Cmat = 6`, `hsCensus Imat = 16` (the raw counts whose
    NEGATIVES are the trace-form values). -/
theorem gatherCharge_hsCensus : hsCensus (Cmat : Matrix (Fin 7) (Fin 7) ℤ) = 6 := by
  unfold hsCensus; decide
theorem gatherIsospin_hsCensus : hsCensus (Imat : Matrix (Fin 7) (Fin 7) ℤ) = 16 := by
  unfold hsCensus; decide

/-- ★★ THE BANKED GATHER CHARGE TRACE FORM IS NEGATIVE (the banked `−6` recovered through the sense
    law): `traceForm7 chargeOp chargeOp = −6 < 0`. The gather charge self-census is negative — the
    NEGATIVE sense, matching the banked `B_chargeOp_chargeOp` (N253) and NOW derived from skewness. -/
theorem gatherCharge_selfCensus_neg : traceForm7 chargeOp chargeOp < 0 := by
  rw [B_chargeOp_chargeOp]; norm_num

/-- ★★ THE BANKED GATHER ISOSPIN TRACE FORM IS NEGATIVE: `traceForm7 (imRep DI) (imRep DI) = −16 < 0`.
    Matching the banked `B_imRep_DI` (N253), now read as the skew negative sense. -/
theorem gatherIsospin_selfCensus_neg : traceForm7 (imRep DI) (imRep DI) < 0 := by
  rw [B_imRep_DI]; norm_num

/-! ## (C) THE MATTER CENSUS IS THE POSITIVE SENSE. -/

/-- THE MATTER CENSUS IS POSITIVE: `chargeTraceDepth = Tr(Q²) = 16/3 > 0` (banked, the self-adjoint
    observable's positive census — opposite sign to the gather). -/
theorem matter_selfCensus_pos : (0 : Cut) < chargeTraceDepth := chargeTraceDepth_pos

/-! ## (D) THE OPPOSITE-SENSE THEOREM (the count + sense, welded over `Cut`). -/

/-- ★★★ THE GATHER SELF-CENSUS ENTERS WITH THE SENSE OPPOSITE TO MATTER. The gather charge and
    isospin self-censuses are strictly NEGATIVE, while the matter census `chargeTraceDepth` is
    strictly POSITIVE — the gather resolves ITSELF into the screening sum with the fold's minus
    (anti-screening), opposite to matter's plus (screening). Welded: the negative gather sense (`< 0`,
    via banked skew generators) and the positive matter sense (`0 <`, banked `Tr(Q²)`), statable from
    neither alone. The count enters through the banked values `−6`, `−16`, `+16/3`. -/
theorem gather_matter_opposite_sense :
    traceForm7 chargeOp chargeOp < 0 ∧
    traceForm7 (imRep DI) (imRep DI) < 0 ∧
    (0 : Cut) < chargeTraceDepth ∧
    traceForm7 chargeOp chargeOp = -6 ∧
    traceForm7 (imRep DI) (imRep DI) = -16 ∧
    chargeTraceDepth = 16 / 3 :=
  ⟨gatherCharge_selfCensus_neg,
   gatherIsospin_selfCensus_neg,
   matter_selfCensus_pos,
   B_chargeOp_chargeOp,
   B_imRep_DI,
   chargeTraceDepth_eq⟩

/-! ## (E) W8 NON-VACUITY WITH TEETH. -/

/-- ★ W8 — THE WRONG (POSITIVE) SENSE IS EXCLUDED: the gather charge self-census is NOT the
    matter-style positive `+6`; it is `−6 < 0`. The sense is genuinely negative, not the observable's
    positive census. -/
theorem gatherCharge_sense_ne_positive : traceForm7 chargeOp chargeOp ≠ 6 := by
  rw [B_chargeOp_chargeOp]; norm_num

/-- ★ W8 — THE GATHER SENSE IS GENUINELY OPPOSITE TO MATTER: `B(chargeOp) < 0 < chargeTraceDepth`
    (over `Cut`). The two self-censuses have strictly different signs — the anti-screening is real,
    not a degenerate coincidence with matter screening. -/
theorem gather_strictly_opposite_matter :
    (((traceForm7 chargeOp chargeOp : ℚ)) : Cut) < 0 ∧ (0 : Cut) < chargeTraceDepth := by
  refine ⟨?_, matter_selfCensus_pos⟩
  rw [B_chargeOp_chargeOp]; norm_num

/-- ★★ W8 — THE ABELIAN TOOTH: a ZERO generator has ZERO self-census (`traceSq 0 = 0`). An abelian,
    self-coupling-free connection contributes NO gather anti-screening — which is precisely WHY the
    pure-U(1) (hypercharge) running is matter-only screening with no gather self-census reduction (the
    non-abelian effect N342 isolates). The negative gather sense requires a genuinely NONZERO skew
    generator. -/
theorem abelian_no_selfCensus : traceSq (0 : Matrix (Fin 7) (Fin 7) ℚ) = 0 := by
  unfold traceSq; simp

/-- ★★ W8 — THE GARBAGE TOOTH (the skew hypothesis is LOAD-BEARING): a NON-skew, NON-symmetric
    "gather-shaped" matrix has `traceSq > 0` — the WRONG (positive) sign — despite looking like a
    generator. Deleting the skew hypothesis from `traceSq_skew` breaks the negative sense; the fold's
    minus genuinely comes from `Mᵀ = −M`. -/
theorem garbage_nonskew_wrong_sense : traceSq (!![(1 : ℚ), 1; 0, 0]) = 1 := by
  unfold traceSq; simp [Matrix.trace, Fin.sum_univ_two]

/-- W8 — the garbage witness is genuinely NEITHER skew NOR symmetric (so neither Part-A law applies,
    and its positive `traceSq` is not the gather's negative sense). -/
theorem garbage_not_skew : (!![(1 : ℚ), 1; 0, 0])ᵀ ≠ -(!![(1 : ℚ), 1; 0, 0]) := by decide

/-- ★ W8 — CENSUS NON-VACUITY: a nonzero skew gather generator has a GENUINELY POSITIVE Hilbert–
    Schmidt count (`hsCensus Cmat = 6 > 0`), so the negative trace-form value `−6` is a real,
    non-degenerate anti-screening contribution — not a vacuous `0`. -/
theorem gatherCharge_census_nonvacuous : 0 < hsCensus (Cmat : Matrix (Fin 7) (Fin 7) ℤ) := by
  rw [gatherCharge_hsCensus]; norm_num

/-! ## (F) THE Z1 CAPSTONE — welded, non-hollow. -/

/-- ★★★ THE Z1 LANDING (welded, NOT a bare ∧): THE GATHER SELF-CENSUS.
    The gather resolves ITSELF into the screening sum with a CENSUS (the counts `6`, `16`) and a SENSE
    (the fold's MINUS) of its own:
    (1) the GENERAL LAW — a SKEW generator's trace-form self-overlap is the NEGATED census
        (`traceSq Cmat = −hsCensus Cmat = −6`; the fold's `look = −id` at generator level);
    (2) the gather generators ARE skew (`Cmat`/`Imat` skew), so their banked trace-form self-censuses
        are strictly NEGATIVE (`B(chargeOp) = −6 < 0`, `B(imRep DI) = −16 < 0`);
    (3) the MATTER census is strictly POSITIVE (`chargeTraceDepth = 16/3 > 0`) — the self-adjoint
        observable's plus;
    (4) so the gather enters with the sense OPPOSITE to matter (anti-screening vs screening);
    (5) the SKEW hypothesis is load-bearing (a garbage non-skew witness has the WRONG positive sense)
        and an abelian (zero) generator contributes NO gather self-census.
    The count, the sense, the opposite-to-matter weld, and the teeth are welded: statable from none
    alone. -/
theorem gatherSelfCensus_landing :
    traceSq (Cmat : Matrix (Fin 7) (Fin 7) ℤ) = -6 ∧
    traceSq (Imat : Matrix (Fin 7) (Fin 7) ℤ) = -16 ∧
    traceForm7 chargeOp chargeOp < 0 ∧
    traceForm7 (imRep DI) (imRep DI) < 0 ∧
    (0 : Cut) < chargeTraceDepth ∧
    (((traceForm7 chargeOp chargeOp : ℚ)) : Cut) < 0 ∧
    traceSq (!![(1 : ℚ), 1; 0, 0]) = 1 ∧
    traceSq (0 : Matrix (Fin 7) (Fin 7) ℚ) = 0 ∧
    0 < hsCensus (Cmat : Matrix (Fin 7) (Fin 7) ℤ) :=
  ⟨gatherCharge_traceSq,
   gatherIsospin_traceSq,
   gatherCharge_selfCensus_neg,
   gatherIsospin_selfCensus_neg,
   matter_selfCensus_pos,
   (gather_strictly_opposite_matter).1,
   garbage_nonskew_wrong_sense,
   abelian_no_selfCensus,
   gatherCharge_census_nonvacuous⟩

end

end Phys.Algebra
