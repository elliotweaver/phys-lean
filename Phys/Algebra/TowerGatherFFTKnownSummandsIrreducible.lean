/-! ## (1) THE 1-SUMMAND (`trivialLine`): irreducible by pure dimension. -/

/-- The trivial line `trivialLine` (the `ℚ·id` summand, dimension `1`) has NO proper nonzero
    subspace at all: a subspace of dimension strictly between `0` and `1` cannot exist. Hence it is
    a fortiori an irreducible `adEnd`-module. -/
theorem trivialLine_no_proper_invariant
    (W : Submodule ℚ (Module.End ℚ ImO)) (_hWle : W ≤ trivialLine)
    (hd0 : 0 < Module.finrank ℚ W) (hd1 : Module.finrank ℚ W < 1) : False := by
  omega

/-! ## (2) THE 7-SUMMAND (`range crossEmb`): irreducible via the injective g₂-equivariant embedding. -/

/-- ★★ THE FUNDAMENTAL 7-SUMMAND IS AN IRREDUCIBLE `adEnd`-MODULE. Any `adEnd`-invariant subspace
    `W ≤ range crossEmb` with `0 < dim W < 7` is impossible. PROOF: pull `W` back through the
    INJECTIVE g₂-equivariant `crossEmb` (`W̃ := crossEmb⁻¹ W`), push to `O ℚ` (`WO := ImO.subtype '' W̃`);
    `crossEmb` and `ImO.subtype` injective preserve dimension, so `dim WO = dim W`; the intertwiner
    `crossOp_imRep_intertwine` (N223) makes `WO` an `adEnd`-invariant subspace of `ImO`; and the banked
    `no_proper_invariant_ImO` (N28) kills it. -/
theorem crossEmb_range_no_proper_invariant
    (W : Submodule ℚ (Module.End ℚ ImO)) (hWle : W ≤ LinearMap.range crossEmb)
    (hWinv : ∀ (D : derivationLieQ) (X : Module.End ℚ ImO), X ∈ W → adEnd D X ∈ W)
    (hd0 : 0 < Module.finrank ℚ W) (hd7 : Module.finrank ℚ W < 7) : False := by
  set Wtil : Submodule ℚ ImO := Submodule.comap crossEmb W with hWtil
  set WO : Submodule ℚ (O ℚ) := Wtil.map ImO.subtype with hWO
  have hmapWtil : Submodule.map crossEmb Wtil = W := by
    rw [hWtil, Submodule.map_comap_eq, inf_eq_right.mpr hWle]
  have hf1 : Module.finrank ℚ WO = Module.finrank ℚ Wtil := by
    rw [hWO]
    exact (Submodule.equivMapOfInjective ImO.subtype ImO.injective_subtype Wtil).finrank_eq.symm
  have hf2 : Module.finrank ℚ Wtil = Module.finrank ℚ W := by
    rw [← hmapWtil]
    exact (Submodule.equivMapOfInjective crossEmb crossEmb_injective Wtil).finrank_eq
  have hfWO : Module.finrank ℚ WO = Module.finrank ℚ W := hf1.trans hf2
  have hWOle : WO ≤ ImO := by
    rw [hWO]; rintro _ ⟨x, _, rfl⟩; exact x.2
  have hWOinv : ∀ (D : derivationLieQ) (x : O ℚ), x ∈ WO → (D : Module.End ℚ (O ℚ)) x ∈ WO := by
    intro D x hx
    rw [hWO, Submodule.mem_map] at hx ⊢
    obtain ⟨a, haW, rfl⟩ := hx
    refine ⟨⟨(D : Module.End ℚ (O ℚ)) (a : O ℚ), derivLieQ_mapsTo D (a:O ℚ) a.2⟩, ?_, rfl⟩
    rw [hWtil, Submodule.mem_comap] at haW ⊢
    have hEq : crossEmb ⟨(D : Module.End ℚ (O ℚ)) (a : O ℚ), derivLieQ_mapsTo D (a:O ℚ) a.2⟩
        = adEnd D (crossEmb a) := by
      rw [adEnd_apply]
      show crossOp ((D : Module.End ℚ (O ℚ)) (a : O ℚ)) = ⁅imRep D, crossOp (a : O ℚ)⁆
      exact (crossOp_imRep_intertwine D (a : O ℚ)).symm
    rw [hEq]
    exact hWinv D (crossEmb a) haW
  exact no_proper_invariant_ImO WO hWOle hWOinv (by rw [hfWO]; exact hd0) (by rw [hfWO]; exact hd7)

/-! ## (3) THE 14-SUMMAND (`range imRepL`): irreducible via the Lie-ideal correspondence. -/

/-- ★★ THE ADJOINT 14-SUMMAND IS AN IRREDUCIBLE `adEnd`-MODULE. Any `adEnd`-invariant subspace
    `W ≤ range imRepL` with `0 < dim W < 14` is impossible. PROOF: pull `W` back through the
    INJECTIVE Lie-homomorphism `imRepL` (`U := imRepL⁻¹ W`); `imRep_injective` (N22) preserves
    dimension so `dim U = dim W`; the Lie-hom identity `LieHom.map_lie` makes `U` a Lie IDEAL of
    `derivationLieQ`; and the banked ideal-lattice simplicity `derivationLieQ_isSimpleOrder`
    (N30) forces `U ∈ {⊥, ⊤}`, contradicting `0 < dim U < 14 = dim derivationLieQ`. -/
theorem imRepL_range_no_proper_invariant
    (W : Submodule ℚ (Module.End ℚ ImO)) (hWle : W ≤ LinearMap.range imRepL)
    (hWinv : ∀ (D : derivationLieQ) (X : Module.End ℚ ImO), X ∈ W → adEnd D X ∈ W)
    (hd0 : 0 < Module.finrank ℚ W) (hd14 : Module.finrank ℚ W < 14) : False := by
  set U : Submodule ℚ derivationLieQ := Submodule.comap imRepL W with hUdef
  have hmapU : Submodule.map imRepL U = W := by
    rw [hUdef, Submodule.map_comap_eq, inf_eq_right.mpr hWle]
  have hfU : Module.finrank ℚ U = Module.finrank ℚ W := by
    rw [← hmapU]
    exact (Submodule.equivMapOfInjective imRepL imRep_injective U).finrank_eq
  have hUlie : ∀ (D : derivationLieQ) (D' : derivationLieQ), D' ∈ U → ⁅D, D'⁆ ∈ U := by
    intro D D' hD'
    rw [hUdef, Submodule.mem_comap] at hD' ⊢
    have hEq : imRepL ⁅D, D'⁆ = adEnd D (imRepL D') := by
      rw [adEnd_apply]
      exact LieHom.map_lie imRep D D'
    rw [hEq]
    exact hWinv D (imRepL D') hD'
  let I : LieIdeal ℚ derivationLieQ :=
    { U with lie_mem := fun {x m} h => hUlie x m h }
  have hImem : ∀ x, x ∈ I ↔ x ∈ U := fun _ => Iff.rfl
  have hIbot : (I : LieIdeal ℚ derivationLieQ) ≠ ⊥ := by
    intro h
    have hU0 : U = ⊥ := by
      apply le_bot_iff.mp
      intro x hx
      have hxI : x ∈ I := (hImem x).mpr hx
      rw [h, LieSubmodule.mem_bot] at hxI
      simpa using hxI
    rw [hU0, finrank_bot] at hfU
    omega
  have hItop : (I : LieIdeal ℚ derivationLieQ) ≠ ⊤ := by
    intro h
    have hUtop : U = ⊤ := by
      apply top_le_iff.mp
      intro x _
      have hxI : x ∈ I := by rw [h]; exact LieSubmodule.mem_top x
      exact (hImem x).mp hxI
    rw [hUtop] at hfU
    have h14 : Module.finrank ℚ (⊤ : Submodule ℚ derivationLieQ) = 14 := by
      rw [finrank_top]; exact finrank_derivationQ_eq_14
    rw [h14] at hfU
    omega
  exact (derivationLieQ_isSimpleOrder.2 I).elim hIbot hItop

/-! ## (4) CAPSTONE: the three KNOWN summands `fourSummands i` (`i ≠ 3`) are irreducible. -/

/-- ★★★ THE THREE KNOWN-SUMMAND IRREDUCIBILITIES, BUNDLED on the banked four-family. For each of the
    three KNOWN summands `fourSummands i` (`i ∈ {0, 1, 2}`, i.e. the `1`, the fundamental `7`, and the
    adjoint `14` of `7 ⊗ 7 = 1 ⊕ 7 ⊕ 14 ⊕ 27`), no proper nonzero `adEnd`-invariant subspace exists:
    a subspace `W ≤ fourSummands i` closed under `X ↦ ⁅imRep D, X⁆` with dimension strictly between
    `0` and `dim (fourSummands i)` is impossible. Three of the four Clebsch–Gordan atoms are thereby
    IRREDUCIBLE g₂-modules — the non-circular constituents the final capstone consumes; the remaining
    atom, the 27 (`tracelessSym`, `i = 3`), needs the childed g₂ FFT generation lemma. -/
theorem three_known_summands_no_proper_invariant
    (i : Fin 4) (hi : i ≠ 3)
    (W : Submodule ℚ (Module.End ℚ ImO)) (hWle : W ≤ fourSummands i)
    (hWinv : ∀ (D : derivationLieQ) (X : Module.End ℚ ImO), X ∈ W → adEnd D X ∈ W)
    (hd0 : 0 < Module.finrank ℚ W)
    (hdlt : Module.finrank ℚ W < Module.finrank ℚ (fourSummands i)) : False := by
  fin_cases i
  · -- i = 0: trivialLine, dim 1
    have e : fourSummands (⟨0, by omega⟩ : Fin 4) = trivialLine := rfl
    rw [e] at hWle hdlt
    rw [finrank_trivialLine] at hdlt
    exact trivialLine_no_proper_invariant W hWle hd0 hdlt
  · -- i = 1: range crossEmb, dim 7
    have e : fourSummands (⟨1, by omega⟩ : Fin 4) = LinearMap.range crossEmb := rfl
    rw [e] at hWle hdlt
    rw [finrank_crossEmb_range] at hdlt
    exact crossEmb_range_no_proper_invariant W hWle hWinv hd0 hdlt
  · -- i = 2: range imRepL, dim 14
    have e : fourSummands (⟨2, by omega⟩ : Fin 4) = LinearMap.range imRepL := rfl
    rw [e] at hWle hdlt
    rw [finrank_imRep_range] at hdlt
    exact imRepL_range_no_proper_invariant W hWle hWinv hd0 hdlt
  · -- i = 3: excluded
    exact absurd rfl hi

/-- ★★★ THE KNOWN-SUMMAND IRREDUCIBILITY TOOLKIT on the banked tower. The three KNOWN summands of
    `7 ⊗ 7 = 1 ⊕ 7 ⊕ 14 ⊕ 27` — the trivial line `trivialLine` (1), the fundamental `range crossEmb`
    (7), and the adjoint `range imRepL` (14) — are IRREDUCIBLE `adEnd`-modules (no proper nonzero
    invariant subspace), each transported from a banked no-proper-invariant / simple-order fact
    through a banked injective g₂-equivariant map. The fourth atom (the 27, `tracelessSym`) needs the
    childed g₂ FFT generation lemma. -/
theorem known_summands_irreducible_toolkit :
    (∀ (W : Submodule ℚ (Module.End ℚ ImO)), W ≤ trivialLine →
        0 < Module.finrank ℚ W → Module.finrank ℚ W < 1 → False) ∧
    (∀ (W : Submodule ℚ (Module.End ℚ ImO)), W ≤ LinearMap.range crossEmb →
        (∀ (D : derivationLieQ) (X : Module.End ℚ ImO), X ∈ W → adEnd D X ∈ W) →
        0 < Module.finrank ℚ W → Module.finrank ℚ W < 7 → False) ∧
    (∀ (W : Submodule ℚ (Module.End ℚ ImO)), W ≤ LinearMap.range imRepL →
        (∀ (D : derivationLieQ) (X : Module.End ℚ ImO), X ∈ W → adEnd D X ∈ W) →
        0 < Module.finrank ℚ W → Module.finrank ℚ W < 14 → False) :=
  ⟨fun W h => trivialLine_no_proper_invariant W h,
    crossEmb_range_no_proper_invariant,
    imRepL_range_no_proper_invariant⟩

end

