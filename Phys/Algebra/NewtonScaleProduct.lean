import Phys.Algebra.ScaleTowerNumeratorLock
import Phys.Algebra.DimensionalTransmutation
import Mathlib.Tactic

namespace Phys.Algebra

open Phys.Foundation Phys.Foundation.ContinuumQ

noncomputable section

/-! ## (1) THE HALF-RUNG ATOM `M/M_Pl = e^(−3π)` (the banked n=28 rung, negated, exponentiated). -/

/-- THE CLOSURE-TO-PLANCK HALF-RUNG RATIO `M/M_Pl = cutExp(−rungExponent(finrank selfAdj))`, the Born-
    positive exponential suppression at the banked n=28 gravitational (saturation) rung. `rungExponent`
    and `finrank selfAdj` are BANKED (N329); `cutExp` is the banked derived-ℝ exponential (N174). -/
def planckClosureRatio : Cut :=
  cutExp (-(rungExponent (Module.finrank ℚ (bornBil).selfAdjointSubmodule)))

/-- ★ THE HALF-RUNG VALUE `M/M_Pl = e^(−3π)`. FALLS OUT of the banked `rungExponent_at_selfAdj =
    3·cutPi`; never premised as a literal `3π`. -/
theorem planckClosureRatio_eq : planckClosureRatio = cutExp (-(3 * cutPi)) := by
  unfold planckClosureRatio; rw [rungExponent_at_selfAdj]

/-- Born positivity of the half-rung ratio: `0 < M/M_Pl` (banked `cutExp_pos`). -/
theorem planckClosureRatio_pos : 0 < planckClosureRatio := by
  unfold planckClosureRatio; exact cutExp_pos _

/-- STRICT SUPPRESSION: `M/M_Pl < 1`. The argument `−(3·cutPi)` is strictly negative (`cutPi_pos`),
    so by banked `cutExp_strictMono` and `cutExp_zero`, `cutExp(−(3·cutPi)) < cutExp 0 = 1`. -/
theorem planckClosureRatio_lt_one : planckClosureRatio < 1 := by
  rw [planckClosureRatio_eq]
  have hneg : -(3 * cutPi) < 0 := by have := cutPi_pos; linarith
  have := cutExp_strictMono hneg
  rwa [cutExp_zero] at this

/-! ## (2) THE GRAVITATIONAL EXPONENT `6π = 2 × the n=28 rung` (the Born-square doubling). -/

/-- ★ THE EXPONENT DOUBLING: `6·cutPi = 2 · rungExponent(finrank selfAdj)`. The `6π` FALLS OUT as
    twice the banked n=28 rung `3·cutPi` — the factor `2` is the Born self-overlap square. -/
theorem gravExponent_eq_two_rung :
    (6 : Cut) * cutPi
      = 2 * rungExponent (Module.finrank ℚ (bornBil).selfAdjointSubmodule) := by
  rw [rungExponent_at_selfAdj]; ring

/-- ★ THE EXPONENT FROM THE SHARED 84π BUDGET: `6·cutPi = 2 · (criticalPhaseNumerator / 28)`. Ties
    the gravitational exponent back to the banked N329 shared numerator `criticalPhaseNumerator =
    84·cutPi` divided by the n=28 saturation count. -/
theorem gravExponent_from_numerator :
    (6 : Cut) * cutPi
      = 2 * (criticalPhaseNumerator
              / (Module.finrank ℚ (bornBil).selfAdjointSubmodule : Cut)) := by
  have h : criticalPhaseNumerator
      / (Module.finrank ℚ (bornBil).selfAdjointSubmodule : Cut)
      = rungExponent (Module.finrank ℚ (bornBil).selfAdjointSubmodule) := rfl
  rw [h, rungExponent_at_selfAdj]; ring

/-! ## (3) THE GRAVITATIONAL PRODUCT `G·M² = (M/M_Pl)² = e^(−6π)`. -/

/-- ★★ THE BARE-G / CLOSURE-SCALE PRODUCT `G·M² = (M/M_Pl)²`, the BORN SELF-OVERLAP SQUARE of the
    half-rung ratio. (Bare-G convention — see the honest-grade flag (i) in the header.) -/
def newtonScaleProduct : Cut := planckClosureRatio * planckClosureRatio

/-- `G·M²` is a genuine square (`planckClosureRatio²`) — the Born self-overlap form. -/
theorem newtonScaleProduct_born_square :
    newtonScaleProduct = planckClosureRatio ^ 2 := by
  unfold newtonScaleProduct; ring

/-- ★★★ B3 — THE GRAVITATIONAL RELATION `G·M² = e^(−6π)`. The Born square of the half-rung `e^(−3π)`
    collapses by the banked homomorphism law `cutExp_add` to `cutExp(−(6·cutPi))`. The `6·cutPi`
    FALLS OUT as twice the banked n=28 rung `3·cutPi`; nothing about `e^(−6π)` is premised. -/
theorem newtonScaleProduct_eq : newtonScaleProduct = cutExp (-(6 * cutPi)) := by
  unfold newtonScaleProduct
  rw [planckClosureRatio_eq, cutExp_add]
  congr 1; ring

/-- Born positivity of the gravitational product: `0 < G·M²` (banked `cutExp_pos`). -/
theorem newtonScaleProduct_pos : 0 < newtonScaleProduct := by
  rw [newtonScaleProduct_eq]; exact cutExp_pos _

/-- ★ GRAVITY IS EXPONENTIALLY WEAK: `G·M² < 1`. The argument `−(6·cutPi)` is strictly negative
    (`cutPi_pos`), so `cutExp(−(6·cutPi)) < cutExp 0 = 1` by banked `cutExp_strictMono`/`cutExp_zero`. -/
theorem newtonScaleProduct_lt_one : newtonScaleProduct < 1 := by
  rw [newtonScaleProduct_eq]
  have hneg : -(6 * cutPi) < 0 := by have := cutPi_pos; linarith
  have := cutExp_strictMono hneg
  rwa [cutExp_zero] at this

/-- ★ THE SQUARE IS DEEPER: `G·M² < M/M_Pl`. Since `0 < M/M_Pl < 1`, squaring the half-rung ratio
    lands strictly below it — the gravitational product is more suppressed than its half-rung atom. -/
theorem newtonScaleProduct_lt_planckClosureRatio :
    newtonScaleProduct < planckClosureRatio := by
  unfold newtonScaleProduct
  have h1 := planckClosureRatio_lt_one
  have h0 := planckClosureRatio_pos
  calc planckClosureRatio * planckClosureRatio
      < 1 * planckClosureRatio := mul_lt_mul_of_pos_right h1 h0
    _ = planckClosureRatio := one_mul _

/-- ★★★ THE CAPSTONE — B3, all consequences at once, on the banked derived-ℝ `cutExp`/`cutPi` and the
    banked n=28 rung. The gravitational product `G·M²` equals `e^(−6π)`, is the Born square of the
    half-rung `e^(−3π)`, its exponent `6·cutPi` is twice the banked n=28 rung `3·cutPi`, it is
    positive, and it is strictly below `1` (gravity exponentially weak). -/
theorem newton_gravitational_product :
    newtonScaleProduct = cutExp (-(6 * cutPi))
    ∧ newtonScaleProduct = planckClosureRatio ^ 2
    ∧ (6 : Cut) * cutPi = 2 * rungExponent (Module.finrank ℚ (bornBil).selfAdjointSubmodule)
    ∧ 0 < newtonScaleProduct
    ∧ newtonScaleProduct < 1 :=
  ⟨newtonScaleProduct_eq, newtonScaleProduct_born_square, gravExponent_eq_two_rung,
   newtonScaleProduct_pos, newtonScaleProduct_lt_one⟩

/-! ## NON-VACUITY (W8): the Born-square doubling is load-bearing. -/

/-- NON-VACUITY: `G·M² ≠ M/M_Pl` — the Born self-overlap SQUARE (`6π`) is genuinely below the
    un-squared half-rung (`3π`). If the doubling collapsed, the two would coincide. -/
theorem newtonScaleProduct_ne_halfRung :
    newtonScaleProduct ≠ planckClosureRatio :=
  ne_of_lt newtonScaleProduct_lt_planckClosureRatio

/-- NON-VACUITY: the gravitational exponent `6·cutPi` genuinely differs from the half-rung `3·cutPi`
    — a WRONG single-power reading (`G·M² = e^(−3π)`, no Born square) would collapse the doubling. -/
theorem gravExponent_ne_rung : (6 : Cut) * cutPi ≠ 3 * cutPi := by
  intro h
  have := cutPi_pos
  nlinarith [this]

end

