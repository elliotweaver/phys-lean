attribute [local instance] CD.narCD CD.srCD dblModuleQ cdModuleQ

noncomputable section

/-! ## The enthalpy / null-energy combination — the eigenvalue gap of the stress. -/

/-- THE ENTHALPY / NULL-ENERGY READING `ρ + P` = density + pressure. On the diagonal perfect-fluid
    stress it is the GAP between the two eigenvalues — the timelike `ρ` and the spacelike `−P` — so
    it compares the two eigenvalue VALUES rather than summing over the spacelike slots. That is why
    its `P`-coefficient is `1`, not the block dimension `n`. -/
def enthalpy (S : STV4 →ₗ[ℚ] STV4) : ℚ := eosDensity S + eosPressure S

/-- ★ THE ENTHALPY of `pfStress ρ P` is `ρ + P`, with coefficient `1` on `P` (NO `finrank`): the
    eigenvalue gap does not count the spacelike multiplicity. -/
theorem enthalpy_pf (rho P : ℚ) : enthalpy (pfStress rho P) = rho + P := by
  unfold enthalpy
  rw [eosDensity_pf, eosPressure_pf]

/-- ★ THE EIGENVALUE-GAP IDENTITY: `enthalpy` is literally the difference of the two diagonal
    eigenvalue readings — the timelike component `(S(1,0,0)).1 = ρ` minus the spacelike component
    `(S(0,1,0)).2.1 = −P`. So `ρ + P = ρ − (−P)` is the spectral gap. -/
theorem enthalpy_eq_eigengap (rho P : ℚ) :
    enthalpy (pfStress rho P)
      = (pfStress rho P (1, 0, 0)).1 - (pfStress rho P (0, 1, 0)).2.1 := by
  unfold enthalpy eosDensity eosPressure
  ring

/-! ## The dimension-INDEPENDENT vacuum threshold `w = −1`. -/

/-- ★★★ THE VACUUM THRESHOLD, DIMENSION-INDEPENDENT. The enthalpy vanishes EXACTLY at `w = P/ρ = −1`
    — and the `−1` carries NO `finrank`: it is dimension-FREE, unlike the census's radiation
    `w = +1/n` and the source's acceleration `w = −1/n`, both of which carry the derived spacelike
    dimension `n`. This is the theory-native WHY the cosmological-constant equation of state is
    `w = −1` universally, not one of the dimension-locked `±1/n`. -/
theorem enthalpy_zero_iff (rho P : ℚ) (hr : rho ≠ 0) :
    enthalpy (pfStress rho P) = 0 ↔ eosState (pfStress rho P) = -1 := by
  rw [enthalpy_pf, eosState_pf]
  constructor
  · intro h
    rw [div_eq_iff hr]; linarith
  · intro h
    rw [div_eq_iff hr] at h; linarith

/-- ★★★ THE ISOTROPY EQUIVALENCE: the enthalpy vanishes EXACTLY when the stress is proportional to
    the identity `pfStress ρ (−ρ) = ρ·id` — the spectrum DEGENERATES (the two eigenvalues coincide),
    the stress becomes Lorentz-invariant / isotropic, the hallmark of the vacuum. Cites the banked
    N455 `vacuum_eq_smul_id`. The eigenvalue gap being zero IS spectral degeneracy. -/
theorem enthalpy_zero_iff_isotropic (rho P : ℚ) :
    enthalpy (pfStress rho P) = 0 ↔ pfStress rho P = rho • LinearMap.id := by
  rw [enthalpy_pf]
  constructor
  · intro h
    have hP : P = -rho := by linarith
    rw [hP]; exact vacuum_eq_smul_id rho
  · intro h
    have hread := congrArg (fun (M : STV4 →ₗ[ℚ] STV4) => (M (0, 1, 0)).2.1) h
    simp [pfStress, LinearMap.prodMap_apply] at hread
    linarith

/-! ## The three-reading trichotomy — two dimension-locked, one dimension-free. -/

/-- ★★★ THE TRICHOTOMY OF P-COEFFICIENTS. The ONE stress `pfStress ρ P`, read three ways, gives
    three `P`-coefficients:
      • the ORDINARY trace `ρ − n·P` (N455 `eos_trace_dim`);
      • twice the gravitational SOURCE `ρ + n·P` (N457 `gravSource_pf_dim`);
      • the ENTHALPY `ρ + 1·P` (this node).
    The first two carry the DERIVED spacelike dimension `n = finrank(ℚ × Dbl ℚ)`; the third carries
    `1`. Three readings of one endomorphism, three thresholds. -/
theorem trichotomy_coeffs (rho P : ℚ) :
    LinearMap.trace ℚ STV4 (pfStress rho P) = rho - (Module.finrank ℚ (ℚ × Dbl ℚ) : ℚ) * P
    ∧ 2 * gravSource (pfStress rho P) = rho + (Module.finrank ℚ (ℚ × Dbl ℚ) : ℚ) * P
    ∧ enthalpy (pfStress rho P) = rho + 1 * P := by
  refine ⟨eos_trace_dim rho P, ?_, ?_⟩
  · rw [gravSource_pf_dim]; ring
  · rw [enthalpy_pf]; ring

/-- ★★ THE THRESHOLD IS DIMENSION-FREE (load-bearing). The derived spacelike dimension
    `n = finrank spaceSub4 = 3 ≠ 1`, so the enthalpy's `P`-coefficient `1` is genuinely NOT the
    trace/source coefficient `±n`: the `w = −1` threshold is NOT one of the dimension-locked `±1/n`.
    Were `n = 1` the three readings would collapse; they do not. -/
theorem enthalpy_threshold_dimension_free : (Module.finrank ℚ spaceSub4 : ℚ) ≠ 1 := by
  rw [finrank_spaceSub4]; norm_num

/-- ★★ W8: the three combinations are GENUINELY DISTINCT for `P ≠ 0` — the enthalpy `ρ + P` is
    neither the ordinary trace `ρ − 3P` nor twice the source `ρ + 3P`. The trichotomy is not a
    hollow restatement of one reading. -/
theorem trichotomy_distinct (rho P : ℚ) (hP : P ≠ 0) :
    enthalpy (pfStress rho P) ≠ LinearMap.trace ℚ STV4 (pfStress rho P)
    ∧ enthalpy (pfStress rho P) ≠ 2 * gravSource (pfStress rho P) := by
  rw [enthalpy_pf, eos_trace, gravSource_pf]
  refine ⟨?_, ?_⟩
  · intro h; apply hP; linarith
  · intro h; apply hP; linarith

/-! ## W8 anti-vacuity — the sign of the gap is the null-energy dividing line. -/

/-- ★ W8: ORDINARY matter (`ρ > 0`, `P ≥ 0`) has POSITIVE enthalpy — the eigenvalue gap is positive,
    the null energy condition holds. -/
theorem enthalpy_null_positive (rho P : ℚ) (hr : 0 < rho) (hP : 0 ≤ P) :
    0 < enthalpy (pfStress rho P) := by
  rw [enthalpy_pf]; linarith

/-- ★★ W8: PHANTOM (`w < −1`, i.e. `P < −ρ`) has NEGATIVE enthalpy — the eigenvalue gap turns
    negative exactly on the far side of the vacuum threshold. The sign of `ρ + P` is the null-energy
    dividing line, a DERIVED reading (the difference of the two eigenvalues), not a posited bound. -/
theorem enthalpy_phantom_negative (rho P : ℚ) (h : P < -rho) :
    enthalpy (pfStress rho P) < 0 := by
  rw [enthalpy_pf]; linarith

/-! ## The capstone — the enthalpy / null-energy threshold. -/

/-- ★★★ THE ENTHALPY / NULL-ENERGY THRESHOLD (bundled). The third central combination of the derived
    perfect-fluid stress — the eigenvalue GAP `ρ + P` — welded (NOT a bare ∧) by the facts that tie
    it to the banked census/source readings and pin its dimension-independence:
      • THE READING & GAP: `enthalpy (pfStress ρ P) = ρ + P`, the difference of the two diagonal
        eigenvalues (`enthalpy_pf` + `enthalpy_eq_eigengap`);
      • THE DIMENSION-FREE THRESHOLD: the enthalpy vanishes `⟺ w = −1` (`enthalpy_zero_iff`) `⟺` the
        stress is `ρ·id` (spectral degeneracy / isotropy, `enthalpy_zero_iff_isotropic`);
      • THE TRICHOTOMY: the three P-coefficients are `−n, +n, +1` off the ONE stress
        (`trichotomy_coeffs`), and `n = finrank spaceSub4 ≠ 1` makes the third genuinely distinct
        (`enthalpy_threshold_dimension_free`, `trichotomy_distinct`);
      • THE SIGN LINE: ordinary matter `> 0`, phantom `< 0` — the gap's sign is the null-energy
        dividing line (`enthalpy_null_positive`, `enthalpy_phantom_negative`).
    THEOREM-route; the physical names (enthalpy / null energy / dark energy / phantom) carry ZERO
    logical weight (words-removable). -/
theorem enthalpy_null_energy_threshold (rho : ℚ) (h : 0 < rho) :
    -- THE READING & GAP
    (enthalpy (pfStress rho (-rho)) = rho + (-rho)
      ∧ ∀ P, enthalpy (pfStress rho P)
          = (pfStress rho P (1, 0, 0)).1 - (pfStress rho P (0, 1, 0)).2.1)
    -- THE DIMENSION-FREE THRESHOLD: w = −1 ⟺ ρ·id
    ∧ (∀ P, enthalpy (pfStress rho P) = 0 ↔ eosState (pfStress rho P) = -1)
    ∧ (∀ P, enthalpy (pfStress rho P) = 0 ↔ pfStress rho P = rho • LinearMap.id)
    -- THE TRICHOTOMY: three P-coefficients −n, +n, +1, and n ≠ 1
    ∧ (∀ P, LinearMap.trace ℚ STV4 (pfStress rho P) = rho - (Module.finrank ℚ (ℚ × Dbl ℚ) : ℚ) * P
        ∧ 2 * gravSource (pfStress rho P) = rho + (Module.finrank ℚ (ℚ × Dbl ℚ) : ℚ) * P
        ∧ enthalpy (pfStress rho P) = rho + 1 * P)
    ∧ (Module.finrank ℚ spaceSub4 : ℚ) ≠ 1
    -- THE SIGN LINE: ordinary matter > 0, phantom < 0
    ∧ (∀ P, 0 ≤ P → 0 < enthalpy (pfStress rho P))
    ∧ (∀ P, P < -rho → enthalpy (pfStress rho P) < 0) := by
  refine ⟨⟨enthalpy_pf rho (-rho), fun P => enthalpy_eq_eigengap rho P⟩, ?_, ?_, ?_,
    enthalpy_threshold_dimension_free, ?_, ?_⟩
  · intro P; exact enthalpy_zero_iff rho P (ne_of_gt h)
  · intro P; exact enthalpy_zero_iff_isotropic rho P
  · intro P; exact trichotomy_coeffs rho P
  · intro P hP; exact enthalpy_null_positive rho P h hP
  · intro P hP; exact enthalpy_phantom_negative rho P hP

end

end Phys.Algebra.CosmoEnthalpyNullEnergy
