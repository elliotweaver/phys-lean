import Phys.Algebra.PlanckMassRatio
import Mathlib.Tactic

namespace Phys.Algebra

open Phys.Foundation Phys.Foundation.ContinuumQ

noncomputable section

/-! ## (1) THE EW RUNG `v/M = e^(−28π/3)` as the concrete n=9 quotient of the 84π grammar. -/

/-- THE ELECTROWEAK-TO-CLOSURE RUNG RATIO `v/M = cutExp(−rungExponent(finrank spaceSub))`, the Born-
    positive exponential suppression at the banked n=9 (electroweak F₄ dual-Coxeter) grammar rung.
    `rungExponent` and `finrank spaceSub` are BANKED (N329); `cutExp` is the banked derived-ℝ
    exponential (N174). This makes the B1 electroweak rung a CONCRETE derived ratio of the 84π
    grammar, no longer a free parameter. -/
def ewClosureRatio : Cut :=
  cutExp (-(rungExponent (Module.finrank ℚ spaceSub)))

/-- ★ THE EW RUNG VALUE `v/M = e^(−28π/3)`. FALLS OUT of the banked `rungExponent_at_spaceSub =
    28·cutPi/3` (the n=9 quotient of the shared 84π numerator); never premised as a literal. -/
theorem ewClosureRatio_eq : ewClosureRatio = cutExp (-(28 * cutPi / 3)) := by
  unfold ewClosureRatio; rw [rungExponent_at_spaceSub]

/-- Born positivity of the EW rung ratio: `0 < v/M` (banked `cutExp_pos`). -/
theorem ewClosureRatio_pos : 0 < ewClosureRatio := by
  unfold ewClosureRatio; exact cutExp_pos _

/-- STRICT SUPPRESSION: `v/M < 1`. The argument `−(28·cutPi/3)` is strictly negative (`cutPi_pos`), so
    by banked `cutExp_strictMono` and `cutExp_zero`, `cutExp(−(28·cutPi/3)) < cutExp 0 = 1`. -/
theorem ewClosureRatio_lt_one : ewClosureRatio < 1 := by
  rw [ewClosureRatio_eq]
  have hneg : -(28 * cutPi / 3) < 0 := by have := cutPi_pos; linarith
  have := cutExp_strictMono hneg
  rwa [cutExp_zero] at this

/-! ## (2) CLOSING B1's DEFERRED COEFFICIENT: `c = rungExponent(9)·g²`. -/

/-- ★★ THE CLOSURE OF B1's DEFERRAL. B1 (N320) left the transmutation coefficient `c` a FREE
    PARAMETER. Here it is FORCED: for any `g² ≠ 0`, the B1 transmutation ratio at `c =
    rungExponent(9)·g²` equals the concrete EW grammar rung `ewClosureRatio`. Proof is pure
    `mul_div_cancel` algebra (`(rungExponent(9)·g²)/g² = rungExponent(9)`). So the EW rung of B1's OWN
    exponential form IS the grammar's n=9 quotient, independent of how the exponent splits into `c` and
    `g²` — the electroweak rung is a derived ratio of the 84π grammar, not a bridge. -/
theorem ewClosureRatio_eq_transmutation (g2 : Cut) (hg : g2 ≠ 0) :
    transmutationRatio (rungExponent (Module.finrank ℚ spaceSub) * g2) g2 = ewClosureRatio := by
  unfold transmutationRatio ewClosureRatio
  congr 1
  rw [mul_div_assoc, div_self hg, mul_one]

/-- ★ THE EW RUNG IS DEEPER THAN THE GRAVITY HALF-RUNG: `v/M < M/M_Pl`. The EW exponent `28·cutPi/3`
    exceeds the gravity half-rung exponent `3·cutPi` (28/3 > 3), so by banked `cutExp_strictMono` the
    EW suppression is stronger. -/
theorem ewClosureRatio_lt_planckClosureRatio : ewClosureRatio < planckClosureRatio := by
  rw [ewClosureRatio_eq, planckClosureRatio_eq]
  apply cutExp_strictMono
  have := cutPi_pos; linarith

/-! ## (3) THE COMPOSITE `v/M_Pl = e^(−37π/3)` — a product of two grammar rungs. -/

/-- THE ELECTROWEAK-TO-PLANCK RATIO `v/M_Pl = (v/M)·(M/M_Pl)`, the product of the banked EW rung and
    the banked gravity half-rung — a composite derived ratio of the 84π grammar. -/
def ewToPlanckRatio : Cut := ewClosureRatio * planckClosureRatio

/-- ★★ THE COMPOSITE VALUE `v/M_Pl = e^(−37π/3)`. The product of `e^(−28π/3)` and `e^(−3π)` collapses
    by the banked homomorphism `cutExp_add` to `cutExp(−(37·cutPi/3))` (37π/3 = 28π/3 + 9π/3); the
    exponent is the SUM of the two grammar rung exponents. Never premised as a literal. -/
theorem ewToPlanckRatio_eq : ewToPlanckRatio = cutExp (-(37 * cutPi / 3)) := by
  unfold ewToPlanckRatio
  rw [ewClosureRatio_eq, planckClosureRatio_eq, cutExp_add]
  congr 1; ring

/-- The composite `v/M_Pl` is `cutExp` of the SUM of the two banked grammar rung exponents (n=9 EW +
    n=28 gravity) — exhibiting it as a stack of two 84π-grammar rungs, not a fresh scale. -/
theorem ewToPlanckRatio_from_grammar :
    ewToPlanckRatio = cutExp (-(rungExponent (Module.finrank ℚ spaceSub)
                              + rungExponent (Module.finrank ℚ (bornBil).selfAdjointSubmodule))) := by
  unfold ewToPlanckRatio ewClosureRatio planckClosureRatio
  rw [cutExp_add]; congr 1; ring

/-- Born positivity of the composite ratio: `0 < v/M_Pl` (banked `cutExp_pos`). -/
theorem ewToPlanckRatio_pos : 0 < ewToPlanckRatio := by
  rw [ewToPlanckRatio_eq]; exact cutExp_pos _

/-- ★ THE COMPOSITE IS BELOW THE GRAVITY HALF-RUNG: `v/M_Pl < M/M_Pl`. Since `0 < v/M < 1`, stacking
    the EW rung onto the gravity half-rung lands strictly below the half-rung alone. -/
theorem ewToPlanckRatio_lt_planckClosureRatio : ewToPlanckRatio < planckClosureRatio := by
  unfold ewToPlanckRatio
  have h1 := ewClosureRatio_lt_one
  have h0 := planckClosureRatio_pos
  calc ewClosureRatio * planckClosureRatio < 1 * planckClosureRatio :=
        mul_lt_mul_of_pos_right h1 h0
    _ = planckClosureRatio := one_mul _

/-! ## (4) THE ORDERED LADDER `G → M_Pl → M → v` (the single deliverable object). -/

/-- ★★★ B5 — THE ONE ORDERED DIMENSIONLESS SCALE LADDER, anchored on G. Every rung is a derived ratio
    of the 84π grammar; the ordering `0 < v/M_Pl < M/M_Pl < 1 < M_Pl/M` is forced by the sign
    structure (suppressions e^(−rung) below `1`, the Planck enhancement e^(+rung) above `1`, the EW
    rung stacking on the gravity half-rung), and the whole ladder is pinned to the single dimensionful
    anchor G through the banked natural-units normalization `G·M_Pl² = 1`
    (`planckMassRatio²·newtonScaleProduct = 1`). This is the ordered chain G → M_Pl → M → v as a chain
    of dimensionless ratios — NO new dimensionful object introduced (G3). -/
theorem scale_tower_ladder :
    0 < ewToPlanckRatio
    ∧ ewToPlanckRatio < planckClosureRatio
    ∧ planckClosureRatio < 1
    ∧ 1 < planckMassRatio
    ∧ planckMassRatio ^ 2 * newtonScaleProduct = 1 :=
  ⟨ewToPlanckRatio_pos, ewToPlanckRatio_lt_planckClosureRatio,
   planckClosureRatio_lt_one, planckMassRatio_gt_one,
   planckMassRatio_sq_mul_newtonScaleProduct⟩

/-! ## NON-VACUITY (W8): the rungs are genuine, distinct, and ordered. -/

/-- NON-VACUITY: `v/M_Pl ≠ M/M_Pl` — the composite (EW rung stacked on the gravity half-rung) is
    genuinely below the gravity half-rung alone. If the EW rung collapsed to `1`, they would coincide. -/
theorem ewToPlanckRatio_ne_planckClosureRatio :
    ewToPlanckRatio ≠ planckClosureRatio :=
  ne_of_lt ewToPlanckRatio_lt_planckClosureRatio

/-- NON-VACUITY: `v/M ≠ 1` — the n=9 EW rung is nontrivial (`28·cutPi/3 > 0`), so the electroweak
    scale is genuinely below the closure scale; a WRONG reading with a vanishing rung would give `1`. -/
theorem ewClosureRatio_ne_one : ewClosureRatio ≠ 1 := by
  have := ewClosureRatio_lt_one; intro h; rw [h] at this; linarith

end

