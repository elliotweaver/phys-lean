/-! ## (A) THE COLOURED / SINGLET CENSUS SPLIT — forced by the banked census conservation. -/

/-- THE COLOURED (quark) SLICE of the charge census, doubled over chirality: `2·(colouredCensusTerm 2
    + colouredCensusTerm 1) = 2·(4/3 + 1/3) = 10/3`. The banked X3 coloured census terms; the part of
    `chargeTraceDepth` that carries colour and DECOUPLES below the quark / confinement thresholds. -/
def colouredCensus : Cut := ((2 * (colouredCensusTerm 2 + colouredCensusTerm 1) : ℚ) : Cut)

/-- The coloured slice is the derived `10/3` (banked `colouredCensusTerm_one`/`colouredCensusTerm_two`). -/
theorem colouredCensus_val : colouredCensus = 10 / 3 := by
  unfold colouredCensus
  rw [colouredCensusTerm_two, colouredCensusTerm_one]; push_cast; norm_num

/-- THE SINGLET (lepton) SLICE of the charge census, forced by census conservation: `leptonCensus =
    chargeTraceDepth − colouredCensus`. What remains of `16/3` after the coloured content decouples. -/
def leptonCensus : Cut := chargeTraceDepth - colouredCensus

/-- The singlet slice is the derived `2`: `16/3 − 10/3 = 2` (banked `chargeTraceDepth_eq`). -/
theorem leptonCensus_val : leptonCensus = 2 := by
  unfold leptonCensus
  rw [colouredCensus_val, chargeTraceDepth_eq]; norm_num

/-- ★★★ THE CENSUS CONSERVATION SPLIT: `chargeTraceDepth = colouredCensus + leptonCensus`. The ONE
    charge census `16/3` re-partitions into the coloured slice `10/3` (decouples below threshold) plus
    the singlet slice `2` (the census-conserving lepton band) — banked `census_conserves_depth`,
    nothing added, nothing lost. This is the driver of the removal frame. -/
theorem census_split : chargeTraceDepth = colouredCensus + leptonCensus := by
  unfold leptonCensus; ring

/-- The census conservation split tied to the banked X3 identity (grounding): the doubled
    coloured + singlet census reconstructs `chargeTraceDepth` (`census_generation_is_depth`). -/
theorem census_split_grounded :
    (((2 * ((colouredCensusTerm 2 + colouredCensusTerm 1) + 1)) : ℚ) : Cut) = chargeTraceDepth :=
  census_generation_is_depth

/-! ## (B) THE DECOUPLING REMOVAL — the decoupled coloured screening subtracted from the lepton tail. -/

/-- ★★★ THE DECOUPLING REMOVAL: the additive lepton tail (full census `chargeTraceDepth`) minus the
    census-conserving lepton tail (singlet census `leptonCensus`) is EXACTLY the banked coloured
    screening at the forced flavor edge:
        totalScreening (leptonTail chargeTraceDepth) − totalScreening (leptonTail leptonCensus)
          = bandScreen colouredCensus (mass0/mass1).
    The decoupled coloured content REMOVED from the descent — a subtraction of active content, never
    an added summand. FALLS OUT of the banked telescoping (`leptonTail_screen_telescope`) + the
    linearity of `bandScreen` in the census + `census_split`. -/
theorem decoupling_removal :
    totalScreening (leptonTail chargeTraceDepth) - totalScreening (leptonTail leptonCensus)
      = bandScreen colouredCensus (mass0 / mass1) := by
  rw [leptonTail_screen_telescope, leptonTail_screen_telescope]
  unfold bandScreen
  rw [census_split]; ring

/-- ★★ THE REMOVAL IS STRICTLY POSITIVE: `0 < bandScreen colouredCensus (mass0/mass1)`
    (`colouredCensus = 10/3 > 0`, `mass0/mass1 > 1`). A positive removal runs `1/α` DOWN — the
    ONE-LAW direction that corrects the worse-with-completeness overshoot. -/
theorem removal_pos : 0 < bandScreen colouredCensus (mass0 / mass1) := by
  apply bandScreen_pos _ m01_gt_one
  rw [colouredCensus_val]; norm_num

/-! ## (C) THE CENSUS-CONSERVING ENDPOINT SITS STRICTLY BELOW THE ADDITIVE ONE. -/

/-- ★★★ THE CENSUS-CONSERVING ENDPOINT IS STRICTLY BELOW THE ADDITIVE (FULL-CENSUS) ONE:
        invAlphaZero (completeBandList leptonCensus) < invAlphaZero (completeBandList chargeTraceDepth).
    The removal of the decoupled coloured screening runs `1/α` DOWN — exactly the direction that
    corrects the additive frame's overshoot. FALLS OUT of `endpoint_closed` (both towers) + the
    linear census split + `removal_pos`. -/
theorem conserving_below_additive :
    invAlphaZero (completeBandList leptonCensus)
      < invAlphaZero (completeBandList chargeTraceDepth) := by
  rw [endpoint_closed, endpoint_closed]
  have h : bandScreen chargeTraceDepth (mass0/mass1) - bandScreen leptonCensus (mass0/mass1)
      = bandScreen colouredCensus (mass0/mass1) := by
    unfold bandScreen; rw [census_split]; ring
  have hp := removal_pos
  linarith [h, hp]

