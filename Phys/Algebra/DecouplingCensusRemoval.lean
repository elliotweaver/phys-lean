    ∧ (invAlphaZero (completeBandList leptonCensus)
        < invAlphaZero (completeBandList chargeTraceDepth))
    -- (5) both way-points reproduce free
    ∧ (invAlphaZero (completeBandList leptonCensus)
        = 190 / 3 + totalScreening (leptonTail leptonCensus))
    ∧ (invAlphaZero (completeBandList leptonCensus)
