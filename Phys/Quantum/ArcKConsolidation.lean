/-! ## §1 — WELD 1: THE ONE COMPLETENESS (arc K ⊗ arc J ⊗ arc I). -/

/-- WELD 1 (half): the S-matrix CONSERVES the idempotent gather's completeness sum. For a
    unit-phase transport `U` (`dblNormSq U = 1`, K1), the Born self-overlap of a scattered
    dressed asymptotic singlet equals `wIn + wOut` (K4 `scatteringOp_conserves_gather`,
    which is K1's `unitary_conserves_gather_resolution`). -/
theorem smatrix_conserves_gather_completeness
    (U : Dbl ContinuumQ.Cut) (hU : dblNormSq U = 1) (a b : ℚ) :
    bornForm (scatteringOp U (dress a b)) (scatteringOp U (dress a b))
      = wIn (dress a b) + wOut (dress a b) :=
  scatteringOp_conserves_gather U hU (dress a b)

/-- WELD 1 (half): the gather's completeness sum on a dressed singlet IS the singlet's
    OCTONION norm (K2 `dress_completeness`, arc I). The completeness of the asymptotic space
    is the octonion norm of the confined singlet line. -/
theorem gather_completeness_is_octonion_norm (a b : ℚ) :
    wIn (dress a b) + wOut (dress a b)
      = ((gForm (singletElt a b) (singletElt a b) : ℚ) : ContinuumQ.Cut) :=
  dress_completeness a b

/-- ★ WELD 1 — THE ONE COMPLETENESS. The S-matrix (K4) CONSERVES the Born self-overlap of a
    dressed asymptotic singlet; that conserved self-overlap IS the idempotent gather's
    completeness sum `wIn + wOut` (K1/J); and that completeness sum IS the singlet's OCTONION
    norm `gForm` (K2, arc I). Three arcs, one number:
    `g(S(dress a b), S(dress a b)) = ratCast (gForm (singletElt a b))`. The thing the S-matrix
    conserves, the thing the gather completes, and the octonion norm of the confined singlet
    are ONE conserved functional. No prior module's TYPE welds the three. -/
theorem smatrix_conserves_octonion_norm
    (U : Dbl ContinuumQ.Cut) (hU : dblNormSq U = 1) (a b : ℚ) :
    bornForm (scatteringOp U (dress a b)) (scatteringOp U (dress a b))
      = ((gForm (singletElt a b) (singletElt a b) : ℚ) : ContinuumQ.Cut) := by
  rw [smatrix_conserves_gather_completeness U hU a b, gather_completeness_is_octonion_norm a b]

/-! ## §2 — WELD 2: THE ONE ROOT (arc K ⊗ arc J ⊗ arc I). -/

/-- ★ WELD 2 — THE ONE ROOT. On asymptotic (dressed singlet) states, the S-matrix's own
    generator — the fold's phase `Dbl.J` (the cascade √-1, K1) — acts as the Born fibre's
    complex structure `foldComplex` (= `J₂`, arc J/N392), which in turn is octonion
    `u1`-multiplication on the confined singlet line (arc I): all three send `(a,b) ↦ (-b,a)`.
      `scatteringOp Dbl.J (dress a b) = foldComplex (dress a b) = dress (-b) a`, and
      `u1 · singletElt a b = singletElt (-b) a`.
    The dynamical generator (K), the Born complex structure (J), and the octonion √-1 (I) are
    the ONE fold-root read three ways, on the asymptotic space. No prior TYPE welds them here. -/
theorem scattering_generator_is_complex_structure (a b : ℚ) :
    scatteringOp Dbl.J (dress a b) = foldComplex (dress a b)
      ∧ foldComplex (dress a b) = dress (-b) a
      ∧ u1 * singletElt a b = singletElt (-b) a := by
  refine ⟨?_, dress_intertwines_J a b, u1_mul_singletElt a b⟩
  rw [scatteringOp_eq_evolve, evolve_J_dress, dress_intertwines_J]

/-! ## §3 — WELD 3: THE ONE IDEMPOTENT / OPTICAL TOTAL (arc K ⊗ arc K ⊗ arc J). -/

/-- ★ WELD 3 — THE ONE IDEMPOTENT. The optical-theorem total `2 · Im T` (K3, the sum over
    intermediate channels) is itself a BORN SELF-OVERLAP (`bornForm_fromDbl`) that the S-matrix
    (K4) CONSERVES (K1 `unitary_conserves_born`): for unit phases `V`, `U`,
      `g(S(fromDbl (intOp U)), S(fromDbl (intOp U))) = 2 · Im (intOp U)`.
    The quantity the optical theorem balances is the SAME conserved-under-scattering self-overlap
    that IS the gather completeness (WELD 1) — the optical theorem's "total" and unitarity's
    "conserved norm" are the one idempotent-gather functional. No prior TYPE welds K3's optical
    total to K4's conservation. -/
theorem optical_total_is_conserved_overlap
    (V U : Dbl ContinuumQ.Cut) (hV : dblNormSq V = 1) (hU : dblNormSq U = 1) :
    bornForm (scatteringOp V (fromDbl (intOp U))) (scatteringOp V (fromDbl (intOp U)))
      = 2 * (intOp U).im := by
  rw [scatteringOp_eq_evolve, unitary_conserves_born V hV, bornForm_fromDbl,
    ← optical_theorem U hU]

/-! ## §4 — W8 NON-VACUITY: the fold's own phase `Dbl.J` makes all three welds bite. -/

/-- ★ [W8] WELD 1 BITES. On the frame singlet `(1,0)`, the S-matrix conserves the octonion
    norm to `1 ≠ 0` — the conserved completeness is a genuine nonzero number, not a vacuous
    `0 = 0`. -/
theorem smatrix_nv_completeness :
    bornForm (scatteringOp Dbl.J (dress 1 0)) (scatteringOp Dbl.J (dress 1 0)) = 1 := by
  rw [smatrix_conserves_octonion_norm Dbl.J J_is_unit_phase 1 0, gForm_singletElt]
  push_cast; ring

/-- ★ [W8] WELD 2 BITES. The S-matrix generator `Dbl.J` GENUINELY rotates an asymptotic state
    off itself: `scatteringOp Dbl.J (dress 1 0) = eOutward ≠ eInward = dress 1 0`. So the "one
    root" is a real complex structure, not the identity. -/
theorem smatrix_nv_root : scatteringOp Dbl.J (dress 1 0) ≠ dress 1 0 := by
  rw [scatteringOp_eq_evolve, evolve_J_dress, neg_zero, dress_eOutward, dress_eInward]
  exact fun h => eInward_ne_eOutward h.symm

/-- ★ [W8] WELD 3 BITES. For the fold's own phase (`U = V = Dbl.J`), the optical total is a
    genuine `2 ≠ 0` conserved self-overlap (`intOp Dbl.J` genuinely interacts, `Im T = 1`,
    N399). So the "one idempotent" weld relates real nonzero quantities. -/
theorem smatrix_nv_optical :
    bornForm (scatteringOp Dbl.J (fromDbl (intOp Dbl.J)))
        (scatteringOp Dbl.J (fromDbl (intOp Dbl.J))) = 2 := by
  rw [optical_total_is_conserved_overlap Dbl.J Dbl.J J_is_unit_phase J_is_unit_phase,
    intOp_J_nontrivial.1]
  norm_num

/-! ## §5 — ★★ THE ARC-K CAPSTONE: QFT dynamics as ONE derived-object statement. -/

/-- ★★ THE ARC-K CONSOLIDATION (the whole QFT-dynamics arc as one statement, over the banked
    derived objects). The four faces of QFT dynamics are driven by the SAME two derived objects
    — the ONE fold-root √-1 (`Dbl.J`) and the ONE idempotent gather-completeness functional
    (`wIn + wOut`) — under the SAME self-blindness / C6 recursion:

      K1 (unitarity) — transport preserves the modulus-square IFF the multiplier is a unit phase;
      K2 (asymptotic states) — the asymptotic sector is the proper sheafifiable singlet line;
      ONE ROOT (K↔J↔I, WELD 2) — the S-matrix generator `Dbl.J` acts as `foldComplex` on the
        Born fibre and as `u1`-mult on the octonion singlet line;
      K3 (optical theorem) — `2 · Im T = dblNormSq T` for a unit-phase transport;
      K4 (the S-matrix) — the scattering operator is the K1 transport, conserving `wIn + wOut`;
      ONE COMPLETENESS (K↔J↔I, WELD 1) — the S-matrix conserves the octonion norm of a dressed
        singlet, `g(S(dress a b), S(dress a b)) = ratCast (gForm (singlet))`;
      ONE IDEMPOTENT (K↔K↔J, WELD 3) — the optical total is itself an S-conserved self-overlap,
        `g(S(fromDbl T), S(fromDbl T)) = 2 · Im T`;
      THE WELD (K↔I, K4/N400) — a standpoint is asymptotic (in the domain) IFF massless.

    THE ONE CAUSE: the fold's self-blindness (C6, N1) forces the complex √-1 (`Dbl.J`, N2 — the
    shared root) and makes the look-back RECUR (transport, K1); the recursion conserves the
    idempotent gather's completeness (the shared functional `wIn + wOut`), which on the confined
    singlet line IS the octonion norm (arc I). QFT dynamics = unitary (monad-idempotent)
    evolution of colour-singlet sheaf states with Born-square amplitudes, mass-gapped by arc I.
    ⚠ The full constructive interacting-QFT existence (Clay Yang–Mills) is OWNER-HELD — untouched. -/
theorem arc_K_consolidation
    (U V : Dbl ContinuumQ.Cut) (hU : dblNormSq U = 1) (hV : dblNormSq V = 1) (a b : ℚ) :
    -- K1: the emergent unitary group = norm-preserving ⟺ unit phase.
    ((∀ z, dblNormSq (U * z) = dblNormSq z) ↔ dblNormSq U = 1)
    -- K2: the asymptotic sector is the proper sheafifiable singlet line.
    ∧ (Submodule.span ℚ {(1 : O ℚ), u1} ≠ (⊤ : Submodule ℚ (O ℚ)))
    -- WELD 2 (ONE ROOT): the S-matrix generator IS foldComplex IS u1-mult.
    ∧ (scatteringOp Dbl.J (dress a b) = foldComplex (dress a b)
        ∧ foldComplex (dress a b) = dress (-b) a
        ∧ u1 * singletElt a b = singletElt (-b) a)
    -- K3: the optical theorem for a unit-phase transport.
    ∧ (2 * (intOp U).im = dblNormSq (intOp U))
    -- K4: the scattering operator is the K1 transport, conserving the gather completeness.
    ∧ (scatteringOp U = evolve U)
    ∧ (bornForm (scatteringOp U (dress a b)) (scatteringOp U (dress a b))
        = wIn (dress a b) + wOut (dress a b))
    -- WELD 1 (ONE COMPLETENESS): the S-matrix conserves the octonion norm of a dressed singlet.
    ∧ (bornForm (scatteringOp U (dress a b)) (scatteringOp U (dress a b))
        = ((gForm (singletElt a b) (singletElt a b) : ℚ) : ContinuumQ.Cut))
    -- WELD 3 (ONE IDEMPOTENT): the optical total is an S-conserved self-overlap.
    ∧ (bornForm (scatteringOp V (fromDbl (intOp U))) (scatteringOp V (fromDbl (intOp U)))
        = 2 * (intOp U).im)
    -- THE K4 WELD (K ⊗ I): asymptotic (in the domain) ⟺ massless.
    ∧ (∀ x y : O ℚ, WorldsGlue x y ↔ ∀ z, bornAction x y z = 0) := by
  refine ⟨norm_preserving_iff_unit_phase U, asymptotic_sector_proper,
    scattering_generator_is_complex_structure a b, optical_theorem U hU,
    scatteringOp_eq_evolve U, smatrix_conserves_gather_completeness U hU a b,
    smatrix_conserves_octonion_norm U hU a b,
    optical_total_is_conserved_overlap V U hV hU, asymptotic_iff_massless⟩

end Phys.Quantum.ArcKConsolidation
