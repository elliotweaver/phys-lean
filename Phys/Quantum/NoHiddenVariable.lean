import Mathlib.Tactic
import Phys.Foundation.Fold
import Phys.Cascade.ComplexUnit
import Phys.Quantum.PrimitiveFibre
import Phys.Quantum.ComplexStructure
import Phys.Quantum.BornRule
import Phys.Quantum.Measurement

namespace Phys.Quantum.NoHiddenVariable

open Phys.Foundation Phys.Cascade Module
open Phys.Foundation.ContinuumQ
open Phys.Quantum

/-! ## §1 — THE FIXED-POINT EXCLUSION: a pre-existing definite record is a look-back
    fixed point; self-blindness forbids nonzero ones. THEOREM (banked N392 / N1). -/

/-- ★★★ THE FIXED-POINT EXCLUSION (the direct C6 leg / the fifth no-dial). A pre-existing
    definite outcome-record carried by a state is a value the fold's self-look-back
    returns UNCHANGED — to "pre-exist and be revealed" is exactly for self-inspection to
    find the same value it already had (a fixed point). On the banked fibre the
    self-inspection operator is the banked complex structure `foldComplex` (= the cascade
    unit `J₂`, the recursion of self-blindness, N392). Its ONLY fixed point is the void
    (banked `foldComplex_self_blind`, inheriting N1 `fold_self_blind`). Hence NO nonzero
    state carries a pre-existing definite self-record: outcome-determinism is unwritable.
    (The IDENTIFICATION "definite pre-existing record = look-back-fixed value" is the
    flagged architectural reading; the FACT — only the void is `foldComplex`-fixed — is
    the banked theorem.) -/
theorem definite_record_void (p : StateFibre) (hp : foldComplex p = p) : p = 0 :=
  foldComplex_self_blind p hp

/-- No NONZERO state carries a pre-existing definite self-record: for every nonzero `p`,
    self-inspection genuinely MOVES it (`foldComplex p ≠ p`). The hidden-variable
    assignment has no nonzero fixed point to attach a definite outcome to. -/
theorem no_nonzero_definite_record (p : StateFibre) (hp : p ≠ 0) : foldComplex p ≠ p := by
  intro h; exact hp (definite_record_void p h)

/-! ## §2 — THE NON-FUNCTIONAL OUTCOME: the gather's outcome is not a function of the
    phase-blind Born-observable data. THEOREM (concrete phase-partner collision). -/

/-- The total Born weight is invariant under the fold's own complex unit — the modulus-
    square over the banked complex algebra `Dbl Cut` does not see the phase. Assembled
    from banked `toDbl_foldComplex` (N393: `foldComplex` IS mult by `Dbl.J`) and banked
    `totalWeight_phase_blind` (N394: `|J·z|² = |z|²`). -/
theorem weight_foldComplex_invariant (p : StateFibre) :
    dblNormSq (toDbl (foldComplex p)) = dblNormSq (toDbl p) := by
  rw [toDbl_foldComplex]; exact totalWeight_phase_blind p

/-- A state and its PHASE-PARTNER `i·p = foldComplex p` carry the SAME total Born weight:
    `dblNormSq (toDbl (foldComplex p)) = dblNormSq (toDbl p)`. Phase-partners are
    Born-indistinguishable — the phase is invisible to the accessible data. -/
theorem phase_partner_same_weight (p : StateFibre) :
    dblNormSq (toDbl (foldComplex p)) = dblNormSq (toDbl p) :=
  weight_foldComplex_invariant p

/-- Yet the gather sends a state and its phase-partner to DIFFERENT definite outcomes:
    for the frame axis `eInward`, its phase-partner is `eOutward = foldComplex eInward`
    (banked `foldComplex_eInward`), and the "toward" outcome-gatherer separates them —
    `gatherIn (foldComplex eInward) = (0,0) ≠ (1,0) = gatherIn eInward`. The outcome is
    phase-DEPENDENT, while the accessible weight is phase-BLIND. -/
theorem phase_partner_diff_outcome :
    gatherIn (foldComplex eInward) ≠ gatherIn eInward := by
  rw [foldComplex_eInward, gatherIn_apply, gatherIn_apply]
  intro hcon
  have : (1 : ContinuumQ.Cut) = 0 := by
    have h := congrArg Prod.fst hcon
    simp only [eInward, eOutward] at h
    exact h.symm
  exact one_ne_zero this

/-- ★★★ THE NON-FUNCTIONAL OUTCOME (the operational Bell / Kochen–Specker content). There
    is NO function `h` from the phase-blind Born-observable data (the total weight
    `dblNormSq ∘ toDbl`) to the gather's definite outcome (`gatherIn`). If there were, the
    two frame axes `eInward` and `eOutward` — which are phase-partners (`eOutward =
    foldComplex eInward`) and hence carry the SAME weight (`1`, `phase_partner_same_weight`)
    — would receive the SAME outcome; but the gather separates them
    (`phase_partner_diff_outcome`). The would-be hidden variable is the PHASE, which the
    Born weight discards. Outcome-determinism from accessible data is unwritable. -/
theorem outcome_not_phaseInvariant_function :
    ¬ ∃ h : ContinuumQ.Cut → StateFibre,
        ∀ p : StateFibre, gatherIn p = h (dblNormSq (toDbl p)) := by
  rintro ⟨h, hh⟩
  apply phase_partner_diff_outcome
  rw [hh (foldComplex eInward), hh eInward, phase_partner_same_weight]

/-! ## §3 — THE i-ORIGIN WELD: the hidden-variable-compatible sign is exactly the sign
    J2 rejected when it forced `i`. THEOREM (banked N392). -/

/-- ★★★ THE i-ORIGIN WELD (the moat). A hidden-variable-compatible self-inspection — one
    that RETURNS a nonzero state unchanged, so a definite record can pre-exist — is exactly
    the `+e₁` completion J2 REJECTED when it forced the sign of the complex unit `i`. The
    `+1` axis-exchange `Jexch 1` FIXES the nonzero diagonal `eInward + eOutward` (banked
    `plus_completion_has_lookback_fixed_point`), a nonzero look-back fixed point — forbidden
    by self-blindness (which is WHY `J = Jexch (-1)`, N392). So "no hidden variables" and
    "the sign of `i`" are ONE fact: the channel the hidden-variable program demands is the
    very channel whose closure built quantum mechanics. -/
theorem hv_record_sign_is_rejected_sign :
    Jexch 1 (eInward + eOutward) = eInward + eOutward ∧ eInward + eOutward ≠ 0 :=
  ⟨plus_completion_has_lookback_fixed_point, eInwOut_ne_zero⟩

/-- The forced complex unit `J = foldComplex = Jexch (-1)` (the self-blind sign) carries NO
    such record: it fixes only the void (`definite_record_void`). The rejected sign `+1`
    would have supplied a nonzero fixed point (a hidden record); the forced sign `−1` does
    not. The hidden-variable channel is closed exactly where `i` is fixed. -/
theorem forced_sign_has_no_record (p : StateFibre) (hp : p ≠ 0) : foldComplex p ≠ p :=
  no_nonzero_definite_record p hp

/-! ## §4 — THE CAPSTONE: the no-hidden-variable theorem. -/

/-- ★★★ THE NO-HIDDEN-VARIABLE THEOREM (the measurement adjudication — the fifth no-dial).
    On the banked J1–J4 fibre, over the derived ℝ `Cut`:

    (1) THE FIXED-POINT EXCLUSION — the only state carrying a pre-existing definite record
        (a look-back-fixed value) is the void: `foldComplex p = p → p = 0`;
    (2) THE NON-FUNCTIONAL OUTCOME — the gather's definite outcome `gatherIn` is NOT a
        function of the phase-blind Born weight `dblNormSq ∘ toDbl`;
    (3) THE i-ORIGIN WELD — the hidden-variable-compatible sign (`Jexch 1`, which fixes the
        nonzero diagonal) is exactly the sign J2 rejected when it forced `i`.

    ONE CAUSE (self-blindness, N1: the look-back has NO nonzero fixed point), read at the
    excluded hidden record — the same self-blindness that forced the sign of `i` (J2) and
    made the gather phase-blind (J4). The hidden-variable program assumes a pre-existing
    definite record the fold's self-blindness provably excludes; outcome-determinism is
    unwritable. Nothing is posited: no hidden-variable model, no locality/non-contextuality
    premise, no Bell inequality — the fold-native Bell/Kochen–Specker no-go is a two-line
    corollary of the self-blindness that already built quantum mechanics. -/
theorem no_hidden_variable :
    -- (1) the fixed-point exclusion: only the void is a pre-existing definite record.
    (∀ p : StateFibre, foldComplex p = p → p = 0)
    -- (2) the non-functional outcome: the outcome is not a function of the phase-blind weight.
    ∧ (¬ ∃ h : ContinuumQ.Cut → StateFibre,
          ∀ p : StateFibre, gatherIn p = h (dblNormSq (toDbl p)))
    -- (3) the i-origin weld: the hidden-variable-compatible sign is the rejected `+1` sign.
    ∧ (Jexch 1 (eInward + eOutward) = eInward + eOutward ∧ eInward + eOutward ≠ 0) :=
  ⟨definite_record_void, outcome_not_phaseInvariant_function, hv_record_sign_is_rejected_sign⟩

/-! ## §5 — W8 NON-VACUITY TEETH. -/

/-- ★★ [W8] THE NO-HIDDEN-VARIABLE THEOREM IS NON-VACUOUS AND LOAD-BEARING. The collision is
    GENUINE: the two frame axes have the SAME phase-blind weight, `dblNormSq (toDbl eInward)
    = dblNormSq (toDbl eOutward) = 1`, YET the gather separates them, `gatherIn eInward =
    (1,0) ≠ (0,0) = gatherIn eOutward`. So the outcome really does depend on data the weight
    discards (the phase) — the non-functionality is not a statement about an already-constant
    outcome. A WRONG mis-reading — that phase-partners have different weights, or that the
    gather cannot tell them apart — fails here. This is the fact the C446 costume rejects. -/
theorem no_hidden_variable_nonvacuous :
    dblNormSq (toDbl eInward) = 1 ∧ dblNormSq (toDbl eOutward) = 1
    ∧ dblNormSq (toDbl eInward) = dblNormSq (toDbl eOutward)
    ∧ gatherIn eInward ≠ gatherIn eOutward := by
  have hIn : dblNormSq (toDbl eInward) = 1 := by
    unfold dblNormSq; simp [toDbl, eInward]
  have hOut : dblNormSq (toDbl eOutward) = 1 := by
    unfold dblNormSq; simp [toDbl, eOutward]
  refine ⟨hIn, hOut, by rw [hIn, hOut], ?_⟩
  rw [gatherIn_apply, gatherIn_apply]
  intro hcon
  have : (1 : ContinuumQ.Cut) = 0 := by
    have h := congrArg Prod.fst hcon
    simp only [eInward, eOutward] at h
    exact h
  exact one_ne_zero this

end Phys.Quantum.NoHiddenVariable
