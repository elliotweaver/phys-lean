import Mathlib.Tactic
import Phys.Quantum.PrimitiveFibre
import Phys.Quantum.Measurement
import Phys.Algebra.CosmicFateEternalApproach

namespace Phys.Quantum.Radiation

open Phys.Quantum Phys.Algebra
open Phys.Foundation.ContinuumQ

/-! ## The (1,1) null structure over the derived ℝ, in lightcone coordinates. -/

/-- THE LIGHTCONE (null-coordinate) PRODUCT FORM on the banked fibre `StateFibre = Cut × Cut`:
    `nullForm (u,v) = u·v`. In lightcone coordinates `u = t+x`, `v = t−x` this IS the banked
    indefinite (1,1) Minkowski form `t² − x²` (see `mink_eq_nullForm_lc`) — the (1,1) slice of the
    banked octonionic Minkowski signature (N43). -/
noncomputable def nullForm (p : StateFibre) : Cut := p.1 * p.2

/-- THE INDEFINITE (1,1) MINKOWSKI FORM over the derived ℝ (the banked N43 minus sign, (1,1)
    slice): `minkForm (t,x) = t² − x²`. -/
noncomputable def minkForm (t x : Cut) : Cut := t ^ 2 - x ^ 2

/-- THE LIGHTCONE MAP `(t,x) ↦ (t+x, t−x)` (spacetime event ↦ its null coordinates). -/
noncomputable def lc (t x : Cut) : StateFibre := (t + x, t - x)

/-- The inverse lightcone map `(u,v) ↦ ((u+v)/2, (u−v)/2)`. -/
noncomputable def unLc (p : StateFibre) : Cut × Cut := ((p.1 + p.2) / 2, (p.1 - p.2) / 2)

/-- ★ THE MINKOWSKI FORM IS THE LIGHTCONE PRODUCT: `t² − x² = (t+x)(t−x) = nullForm (lc t x)`.
    Ties `nullForm` to the genuine indefinite signature — the two null coordinates are the fold's
    banked frame `eInward`/`eOutward` directions. -/
theorem mink_eq_nullForm_lc (t x : Cut) : minkForm t x = nullForm (lc t x) := by
  unfold minkForm nullForm lc; ring

/-- ★ THE NULL CONE SPLITS INTO TWO HALVES: `nullForm p = 0 ↔ p.1 = 0 ∨ p.2 = 0` — the two
    coordinate axes (the incoming and outgoing null generators). -/
theorem nullForm_zero_iff (p : StateFibre) : nullForm p = 0 ↔ p.1 = 0 ∨ p.2 = 0 := by
  unfold nullForm; exact mul_eq_zero

/-- ★ THE MINKOWSKI NULL CONE is the two unit-slope rays `t = ±x` (echoing N420's
    `null_cone_unit_slope`, here over the derived ℝ). -/
theorem minkForm_zero_iff (t x : Cut) : minkForm t x = 0 ↔ t = x ∨ t = -x := by
  unfold minkForm
  constructor
  · intro h
    have hfac : (t - x) * (t + x) = 0 := by ring_nf; ring_nf at h; linarith
    rcases mul_eq_zero.mp hfac with h1 | h2
    · left; linarith [sub_eq_zero.mp h1]
    · right; linarith [add_eq_zero_iff_eq_neg.mp h2]
  · rintro (h | h) <;> subst h <;> ring

/-! ## The retarded gather = the banked J4 gather (N394) in lightcone coordinates. -/

/-- THE OUTGOING null half `{v = 0}` (the `eInward` / `u`-axis — the future outgoing generator). -/
def OutHalf (p : StateFibre) : Prop := p.2 = 0

/-- THE INCOMING null half `{u = 0}` (the `eOutward` / `v`-axis — the incoming generator). -/
def InHalf (p : StateFibre) : Prop := p.1 = 0

/-- THE RETARDED GATHER := the banked J4 `gatherIn` (N394), read in lightcone coordinates.
    NOT a new object — the fold's gather move itself. -/
noncomputable def radGather (p : StateFibre) : StateFibre := gatherIn p

/-- The retarded gather IS the banked J4 gatherIn — definitional (the WELD, not a bare ∧). -/
theorem radGather_eq_gatherIn (p : StateFibre) : radGather p = gatherIn p := rfl

/-- ★ SELECTION (image on the outgoing half): the retarded gather lands in the outgoing null half
    `{v = 0}`. Radiation propagates along the outgoing generator. -/
theorem radGather_in_outHalf (p : StateFibre) : OutHalf (radGather p) := by
  unfold OutHalf radGather; rw [gatherIn_apply]

/-- ★ the gathered state is ON THE NULL CONE (`nullForm = 0`). -/
theorem radGather_null (p : StateFibre) : nullForm (radGather p) = 0 := by
  rw [nullForm_zero_iff]; right; exact radGather_in_outHalf p

/-- ★ THE GATHER ANNIHILATES THE INCOMING HALF: `radGather (gatherOut p) = 0` (banked
    `gatherIn_gatherOut`). The incoming generator is the KERNEL of the retarded gather. -/
theorem radGather_kills_inHalf (p : StateFibre) : radGather (gatherOut p) = 0 :=
  gatherIn_gatherOut p

/-- ★ RESOLUTION OF UNITY (the two halves reconstruct the whole): banked `gather_resolves_unity`.
    The outgoing (selected) and incoming (annihilated) components sum to the original state — the
    selection loses nothing structurally, it only chooses a direction. -/
theorem two_halves_resolve (p : StateFibre) : radGather p + gatherOut p = p :=
  gather_resolves_unity p

/-- Repeatability: the retarded gather is idempotent (banked `gatherIn_idem`). Once radiation has
    left through the outgoing generator, re-gathering changes nothing. -/
theorem radGather_idem (p : StateFibre) : radGather (radGather p) = radGather p :=
  gatherIn_idem p

/-- ★★ NON-INJECTIVITY — NO UN-GATHER. `radGather eOutward = 0 = radGather 0` but `eOutward ≠ 0`,
    so the retarded gather is not injective and has NO inverse. The advanced solution would be the
    inverse of the retarded gather; there is none — the un-gather does not exist as a map. -/
theorem radGather_not_injective : ¬ Function.Injective radGather := by
  intro hinj
  have h0 : radGather eOutward = radGather 0 := by
    unfold radGather; rw [gatherIn_apply, gatherIn_apply]; simp [eOutward]
  have hz : eOutward = (0 : StateFibre) := hinj h0
  have h1 : (1 : Cut) = 0 := congrArg Prod.snd hz
  exact one_ne_zero h1

/-! ## The discarded incoming weight and the C6-forbidden un-gather. -/

/-- THE DISCARDED INCOMING WEIGHT — the banked Born self-overlap of the annihilated (incoming)
    component `gatherOut`, `wOut` (N394). What the retarded gather throws away. -/
noncomputable def discardedWeight (p : StateFibre) : Cut := wOut p

/-- ★ the discarded incoming weight is `p.2²` (banked `wOut_eq`). -/
theorem discardedWeight_eq (p : StateFibre) : discardedWeight p = p.2 ^ 2 :=
  wOut_eq p

/-- ★ [W8] NON-VACUITY: the discarded incoming weight is GENUINELY NONZERO on a state with an
    incoming component (`eOutward`) — the gather really destroys something; the selection is not
    a statement about an already-empty half. -/
theorem discardedWeight_nonvacuous : discardedWeight eOutward = 1 := by
  rw [discardedWeight_eq]; simp [eOutward]

/-- ★★ THE CROSS FACT (never co-stated). The retarded gather is real-blind to the coherence
    between the two null halves (banked `coherence_real_blind`) AND that coherence is genuinely
    nonzero before the gather (banked `coherence_diag`). The forward gather discards a real
    interference; the reverse (advanced) would have to recreate it from nothing. -/
theorem radGather_discards_real_coherence :
    (∀ p : StateFibre, bornForm (radGather p) (gatherOut p) = 0)
      ∧ coherence (eInward + eOutward) = 1 :=
  ⟨fun p => coherence_real_blind p, coherence_diag⟩

/-- ★★ THE C6-FORBIDDEN UN-GATHER. Treat the discarded incoming weight of a state with a genuine
    incoming component as the (positive) initial gap `g₀` of the banked eternal-approach flow
    `coherenceGap` (N383). Then at every finite `t` the gap is STRICTLY POSITIVE (banked
    `heat_death_never_reached`) — the discarded weight is NEVER driven to 0. Recovering it (the
    advanced / un-gather) is the fixed point the fold's self-blindness forbids. -/
theorem discarded_weight_never_recovered (lam t : Cut) :
    0 < coherenceGap (discardedWeight eOutward) lam t := by
  rw [discardedWeight_nonvacuous]
  exact heat_death_never_reached 1 lam t one_pos

/-- ★★ the un-gather (reaching the recovered fixed point, gap 0) is forbidden at every finite epoch
    for a positive discarded weight (banked `fixed_point_unreachable`). -/
theorem ungather_forbidden (g₀ lam t : Cut) (hg : 0 < g₀) (hl : 0 < lam) :
    -lam * coherenceGap g₀ lam t ≠ 0 :=
  fixed_point_unreachable g₀ lam t hg hl

/-! ## The lightcone weld — any event is sent to the outgoing null generator. -/

/-- ★ THE LIGHTCONE WELD: the retarded gather of a spacetime event's null coordinates keeps the
    outgoing coordinate `u = t + x` and zeroes the incoming `v = t − x`. -/
theorem radGather_lc (t x : Cut) : radGather (lc t x) = (t + x, 0) := by
  unfold radGather lc; rw [gatherIn_apply]

/-- ★★ OUTGOING RAY SELECTION (spacetime reading). Recovering the gathered event's `(t,x)`
    coordinates (`unLc`), it lies on the OUTGOING null ray `t = x` — the retarded gather sends any
    event to the future light cone's outgoing generator. Radiation is the look-back weight leaving
    along the outgoing null direction. -/
theorem radGather_selects_outgoing_ray (t x : Cut) :
    (unLc (radGather (lc t x))).1 = (unLc (radGather (lc t x))).2 := by
  rw [radGather_lc]; unfold unLc; ring

/-! ## THE CAPSTONE — the radiation arrow IS the gather's irreversible cone-half selection. -/

/-- ★★★ THE CAPSTONE — THE RADIATION ARROW, DERIVED (the Wheeler–Feynman puzzle dissolved).
    On the banked (1,1) null structure over the derived ℝ, with the banked J4 gather (N394) and the
    banked C6 eternal-approach flow (N383):
    (i)   the null cone splits into two halves (`nullForm_zero_iff`), the two null generators;
    (ii)  the retarded gather (the banked `gatherIn`) SELECTS the outgoing half (`radGather_in_outHalf`,
          `radGather_null`) and ANNIHILATES the incoming half (`radGather_kills_inHalf`), the two
          halves reconstructing the whole (`two_halves_resolve`) — a directed resolution of Unity;
    (iii) it sends any event to the outgoing null generator `t = x` (`radGather_selects_outgoing_ray`);
    (iv)  it is NON-INJECTIVE (`radGather_not_injective`) — no un-gather, no inverse; and it discards
          a genuinely-nonzero incoming weight (`discardedWeight_nonvacuous`) / a genuinely-nonzero
          coherence (`radGather_discards_real_coherence`) that, as the C6 flow's positive initial
          gap, is never recovered (`discarded_weight_never_recovered`).
    Nothing is posited: the "retarded not advanced" preference is the fold's gather move (a many→one,
    irreversible totalization) read on the null cone — the advanced solution is an un-gather, which is
    C6-forbidden. No boundary condition, no absorber hypothesis. -/
theorem radiation_arrow :
    -- (i) the null cone splits into two halves (the two null generators).
    (∀ p : StateFibre, nullForm p = 0 ↔ p.1 = 0 ∨ p.2 = 0) ∧
    -- (ii) SELECTION: the retarded gather lands in the outgoing half, annihilates the incoming
    --      half, and the two halves resolve Unity.
    (∀ p : StateFibre, OutHalf (radGather p)) ∧
    (∀ p : StateFibre, radGather (gatherOut p) = 0) ∧
    (∀ p : StateFibre, radGather p + gatherOut p = p) ∧
    -- (iii) any event is sent to the outgoing null generator t = x.
    (∀ t x : Cut, (unLc (radGather (lc t x))).1 = (unLc (radGather (lc t x))).2) ∧
    -- (iv) NO UN-GATHER: non-injective, discards a genuinely-nonzero coherence, never recovered.
    (¬ Function.Injective radGather) ∧
    ((∀ p : StateFibre, bornForm (radGather p) (gatherOut p) = 0)
        ∧ coherence (eInward + eOutward) = 1) ∧
    (∀ lam t : Cut, 0 < coherenceGap (discardedWeight eOutward) lam t) := by
  refine ⟨nullForm_zero_iff, radGather_in_outHalf, radGather_kills_inHalf, two_halves_resolve,
    radGather_selects_outgoing_ray, radGather_not_injective, radGather_discards_real_coherence,
    discarded_weight_never_recovered⟩

end Phys.Quantum.Radiation
