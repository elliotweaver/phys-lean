import Mathlib.Tactic
import Phys.Quantum.BornRule
import Phys.Algebra.ParityMirrorObstruction
import Phys.Algebra.ChiralGenerationAnomalyCancellation

namespace Phys.Quantum.CPT

open Phys.Foundation Phys.Cascade Phys.Quantum
open Phys.Foundation.ContinuumQ

noncomputable section

/-! ## §1 — THE THREE BANKED INVOLUTIONS on the fold's Born amplitude fibre (N391). -/

/-- C (CHARGE CONJUGATION) on the banked Born fibre: `chargeConj (a,b) = (−a,−b) = −id`. The total
    amplitude negation — the antiparticle amplitude is the negated amplitude; the amplitude
    incarnation of the F1 (N366) Hodge-odd charge sign reversal. -/
def chargeConj (p : StateFibre) : StateFibre := (-p.1, -p.2)

/-- P (PARITY / spatial chirality) on the banked Born fibre: `parityRefl (a,b) = (−a, b)`. The
    axis reflection that anti-commutes with the banked chirality operator `foldComplex` (N392/N435). -/
def parityRefl (p : StateFibre) : StateFibre := (-p.1, p.2)

/-- T (TIME REVERSAL / the modular–KMS reversal) on the banked Born fibre: `timeRev (a,b) = (a, −b)`.
    Complex conjugation — the banked N393 conjugation `dblConj` transported to the fibre; the
    banked O9 (N424) modular/KMS reversal. Anti-unitary: it reverses the oriented phase `ω`. -/
def timeRev (p : StateFibre) : StateFibre := (p.1, -p.2)

/-- C is an INVOLUTION: `chargeConj ∘ chargeConj = id`. -/
theorem chargeConj_involutive (p : StateFibre) : chargeConj (chargeConj p) = p := by
  unfold chargeConj; simp

/-- P is an INVOLUTION: `parityRefl ∘ parityRefl = id`. -/
theorem parityRefl_involutive (p : StateFibre) : parityRefl (parityRefl p) = p := by
  unfold parityRefl; simp

/-- T is an INVOLUTION: `timeRev ∘ timeRev = id`. -/
theorem timeRev_involutive (p : StateFibre) : timeRev (timeRev p) = p := by
  unfold timeRev; simp

/-! ## §2 — THE KLEIN-FOUR STRUCTURE: pairwise commutation and the closure `C = P·T`. -/

/-- C and P COMMUTE (Klein-four). -/
theorem cpt_C_P_comm (p : StateFibre) : chargeConj (parityRefl p) = parityRefl (chargeConj p) := by
  unfold chargeConj parityRefl; simp

/-- C and T COMMUTE (Klein-four). -/
theorem cpt_C_T_comm (p : StateFibre) : chargeConj (timeRev p) = timeRev (chargeConj p) := by
  unfold chargeConj timeRev; simp

/-- P and T COMMUTE (Klein-four). -/
theorem cpt_P_T_comm (p : StateFibre) : parityRefl (timeRev p) = timeRev (parityRefl p) := by
  unfold parityRefl timeRev; simp

/-- ★ THE KLEIN-FOUR CLOSURE `C = P·T`: `parityRefl ∘ timeRev = chargeConj`. The two axis
    reflections compose to the total negation — the reversal group of the fibre is the Klein-four
    group `{id, C, P, T}`, and C is FORCED to equal the product P·T. This closure IS the CPT
    theorem's engine: it makes the triple composite collapse to the identity. -/
theorem cpt_PT_eq_C (p : StateFibre) : parityRefl (timeRev p) = chargeConj p := by
  unfold parityRefl timeRev chargeConj; simp

/-! ## §3 — ★★ THE HEART: the composite C∘P∘T returns the fold to itself (CPT = id). -/

/-- ★★ THE CPT COMPOSITE RETURNS THE FOLD TO ITSELF: `chargeConj ∘ parityRefl ∘ timeRev = id`.
    Every amplitude is returned to itself by the triple. By the Klein-four closure
    (`cpt_PT_eq_C`) the inner `parityRefl ∘ timeRev` is `chargeConj`, and `chargeConj` is an
    involution, so the composite is `chargeConj ∘ chargeConj = id`. CPT is the identity's costume
    — DERIVED, not posited. -/
theorem cpt_composite_returns (p : StateFibre) :
    chargeConj (parityRefl (timeRev p)) = p := by
  rw [cpt_PT_eq_C]; exact chargeConj_involutive p

/-! ## §4 — ALL THREE ARE `g`-ISOMETRIES (Born positivity respected by each factor). -/

/-- C preserves the banked self-overlap `g = bornForm` (a `g`-isometry). -/
theorem chargeConj_bornForm (x y : StateFibre) :
    bornForm (chargeConj x) (chargeConj y) = bornForm x y := by
  unfold chargeConj bornForm; ring

/-- P preserves the banked self-overlap `g = bornForm` (a `g`-isometry). -/
theorem parityRefl_bornForm (x y : StateFibre) :
    bornForm (parityRefl x) (parityRefl y) = bornForm x y := by
  unfold parityRefl bornForm; ring

/-- T preserves the banked self-overlap `g = bornForm` (a `g`-isometry). -/
theorem timeRev_bornForm (x y : StateFibre) :
    bornForm (timeRev x) (timeRev y) = bornForm x y := by
  unfold timeRev bornForm; ring

/-! ## §5 — THE ω-SIGN SPLIT: P, T reverse the oriented phase; C preserves it. -/

/-- ★ C PRESERVES the oriented Kähler form `ω = kahlerForm` (it is `−id`, a rotation by π):
    `ω(Cx, Cy) = ω(x, y)`. -/
theorem chargeConj_kahler (x y : StateFibre) :
    kahlerForm (chargeConj x) (chargeConj y) = kahlerForm x y := by
  rw [kahlerForm_apply, kahlerForm_apply]; unfold chargeConj; ring

/-- ★ P REVERSES the oriented Kähler form `ω`: `ω(Px, Py) = −ω(x, y)`. Parity is anti-symplectic
    — the fold's chirality is reversed. This is WHY parity alone is a "violated" symmetry of the
    oriented Born structure. -/
theorem parityRefl_kahler (x y : StateFibre) :
    kahlerForm (parityRefl x) (parityRefl y) = - kahlerForm x y := by
  rw [kahlerForm_apply, kahlerForm_apply]; unfold parityRefl; ring

/-- ★ T REVERSES the oriented Kähler form `ω`: `ω(Tx, Ty) = −ω(x, y)`. Time reversal is
    anti-unitary / anti-symplectic — the phase orientation is reversed. -/
theorem timeRev_kahler (x y : StateFibre) :
    kahlerForm (timeRev x) (timeRev y) = - kahlerForm x y := by
  rw [kahlerForm_apply, kahlerForm_apply]; unfold timeRev; ring

/-- ★ CP REVERSES `ω` (individually violated): `ω(CPx, CPy) = −ω(x, y)`. -/
theorem cpt_CP_kahler (x y : StateFibre) :
    kahlerForm (chargeConj (parityRefl x)) (chargeConj (parityRefl y)) = - kahlerForm x y := by
  rw [chargeConj_kahler, parityRefl_kahler]

/-- ★ CT REVERSES `ω` (individually violated): `ω(CTx, CTy) = −ω(x, y)`. -/
theorem cpt_CT_kahler (x y : StateFibre) :
    kahlerForm (chargeConj (timeRev x)) (chargeConj (timeRev y)) = - kahlerForm x y := by
  rw [chargeConj_kahler, timeRev_kahler]

/-- ★ PT PRESERVES `ω` (`= C`, a rotation): `ω(PTx, PTy) = ω(x, y)`. -/
theorem cpt_PT_kahler (x y : StateFibre) :
    kahlerForm (parityRefl (timeRev x)) (parityRefl (timeRev y)) = kahlerForm x y := by
  rw [parityRefl_kahler, timeRev_kahler]; ring

/-- ★★ THE FULL CPT PRESERVES `ω` — the composite is a genuine symmetry of the oriented phase,
    though `P`, `T`, `CP`, `CT` each reverse it: `ω(CPTx, CPTy) = ω(x, y)`. -/
theorem cpt_CPT_kahler (x y : StateFibre) :
    kahlerForm (chargeConj (parityRefl (timeRev x))) (chargeConj (parityRefl (timeRev y)))
      = kahlerForm x y := by
  rw [chargeConj_kahler, cpt_PT_kahler]

/-- ★ THE FULL CPT PRESERVES THE BORN-SQUARE `bornProb` (transition probability): the composite
    preserves BOTH the self-overlap `g` and the oriented `ω`, hence the modulus-square `g² + ω²`.
    (Since `CPT = id` this is also a corollary of `cpt_composite_returns`; the content is that it
    holds factorwise on both forms, not merely because the composite is trivial.) -/
theorem cpt_CPT_bornProb (x y : StateFibre) :
    bornProb (chargeConj (parityRefl (timeRev x))) (chargeConj (parityRefl (timeRev y)))
      = bornProb x y := by
  unfold bornProb
  rw [show bornForm (chargeConj (parityRefl (timeRev x))) (chargeConj (parityRefl (timeRev y)))
        = bornForm x y from by rw [chargeConj_bornForm, parityRefl_bornForm, timeRev_bornForm],
     cpt_CPT_kahler]

/-! ## §6 — THE THREE BANKED ANCHORS (the WELD — cross-module facts never before co-stated). -/

/-- ★ T-ANCHOR: `timeRev` IS the banked N393 conjugation `dblConj` transported to `Dbl Cut`:
    `toDbl (timeRev p) = dblConj (toDbl p)`. Time reversal is the banked modular/KMS reversal
    (O9, N424 — conjugation on the derived complex algebra), welded to the CPT composite. -/
theorem timeRev_is_dblConj (p : StateFibre) :
    toDbl (timeRev p) = dblConj (toDbl p) := by
  apply Dbl.ext <;> unfold timeRev <;> simp [toDbl, dblConj]

/-- ★ P-ANCHOR: `parityRefl` ANTI-COMMUTES with the banked complex/chirality operator
    `foldComplex = J₂` (N392) — the banked N435 chirality operator (`iγ⁵`):
    `parityRefl (foldComplex p) = − foldComplex (parityRefl p)`. Parity reverses the fold's
    chirality, welding the CPT composite's P to the banked parity module. -/
theorem parityRefl_anticommutes_foldComplex (p : StateFibre) :
    parityRefl (foldComplex p) = - foldComplex (parityRefl p) := by
  rw [foldComplex_apply]; unfold parityRefl; rw [foldComplex_apply]; simp

/-- P-ANCHOR (banked chirality identity, cited from N435): the chirality operator `foldComplex`
    with which `parityRefl` anti-commutes is the self-blind fold `J₂` — `J² = −1` and its only
    fixed point is the void (`chirality_operator_is_selfblind_fold`, N435/N392). This is the
    banked object the CPT P-factor is welded to. -/
theorem parity_chirality_is_selfblind_fold :
    (∀ p, foldComplex (foldComplex p) = -p) ∧ (∀ p, foldComplex p = p → p = 0) :=
  Phys.Algebra.chirality_operator_is_selfblind_fold

/-- ★ C-ANCHOR: charge conjugation reverses the sign — the amplitude `chargeConj = −id` is the
    fibre incarnation of the SAME ℤ/2 sign reversal that makes the banked F1 (N366) ladder charge
    ODD under the Hodge complement: `blCharge n Sᶜ = − blCharge n S`. Welds the CPT composite's C
    to the banked anomaly-cancellation charge-conjugation involution. -/
theorem charge_conjugation_hodge_odd (n : ℕ) (S : Finset (Fin n)) :
    Phys.Algebra.blCharge n Sᶜ = - Phys.Algebra.blCharge n S :=
  Phys.Algebra.blCharge_compl_odd n S

/-- C-ANCHOR (fibre form): `chargeConj = −id` — the total amplitude negation. -/
theorem chargeConj_eq_neg (p : StateFibre) : chargeConj p = -p := by
  unfold chargeConj; apply Prod.ext <;> simp

/-! ## §7 — W8 NON-VACUITY: the factors are genuine reversals; the triple genuinely restores. -/

/-- W8: C is genuinely NONTRIVIAL — it moves `eInward` (`chargeConj eInward ≠ eInward`). -/
theorem chargeConj_ne_id : chargeConj eInward ≠ eInward := by
  unfold chargeConj eInward; intro h
  have : (-1 : Cut) = 1 := congrArg Prod.fst h
  norm_num at this

/-- W8: P is genuinely NONTRIVIAL — it moves `eInward`. -/
theorem parityRefl_ne_id : parityRefl eInward ≠ eInward := by
  unfold parityRefl eInward; intro h
  have : (-1 : Cut) = 1 := congrArg Prod.fst h
  norm_num at this

/-- W8: T is genuinely NONTRIVIAL — it moves `eOutward`. -/
theorem timeRev_ne_id : timeRev eOutward ≠ eOutward := by
  unfold timeRev eOutward; intro h
  have : (-1 : Cut) = 1 := congrArg Prod.snd h
  norm_num at this

/-- ★★ W8 — THE NEVER-CO-STATED CROSS FACT (the anti-hollow heart): a factor genuinely REVERSES
    the oriented phase `ω` on a concrete pair (parity is a genuine reversal, not a vacuous
    `∀`-triviality), YET the full triple `CPT` RESTORES `ω` on EVERY pair. The individual factor
    is "violated"; the composite is a genuine symmetry. This is exactly the content that a bare
    conjunction "C is an involution ∧ P is ∧ T is" could NEVER express. -/
theorem cpt_factor_violates_but_triple_restores :
    (kahlerForm (parityRefl eInward) (parityRefl eOutward)
      ≠ kahlerForm eInward eOutward)
    ∧ (∀ x y : StateFibre,
        kahlerForm (chargeConj (parityRefl (timeRev x))) (chargeConj (parityRefl (timeRev y)))
          = kahlerForm x y) := by
  refine ⟨?_, cpt_CPT_kahler⟩
  rw [parityRefl_kahler]
  have hω : kahlerForm eInward eOutward = 1 := by
    rw [kahlerForm_apply]; simp [eInward, eOutward]
  rw [hω]; norm_num

/-! ## §8 — THE CAPSTONE: the CPT theorem as the weld of three banked involutions. -/

/-- ★★★ THE CPT THEOREM (arc-Q Q4) — the WELD of three banked involutions of the fold's Born
    amplitude fibre. On the banked `StateFibre` (N391) with its banked `g = bornForm` and oriented
    `ω = kahlerForm` (N393):
      • C, P, T are three commuting nontrivial involutions with the Klein-four closure `C = P·T`,
        so the composite `C∘P∘T = id` returns every amplitude to itself (CPT = the identity's
        costume);
      • all three preserve the self-overlap `g` (Born positivity), but `P` and `T` (and `CP`, `CT`)
        REVERSE the oriented `ω` while `C`, `PT`, and the full `CPT` PRESERVE it — the composite is
        the unique nontrivial combination that is a genuine symmetry of the complete oriented Born
        structure though its factors are not;
      • the three factors are welded to three DISTINCT banked modules: `T = dblConj` (N393, the
        modular/KMS reversal), `P` anti-commutes with `foldComplex` (N392/N435, chirality), and `C`
        is the amplitude incarnation of the F1 (N366) Hodge-odd charge (`blCharge n Sᶜ = −blCharge`).
    ⚠ THEOREM-route for the STRUCTURE; the reading "therefore CPT is nature's one unbreakable
    discrete symmetry" is MECHANISM-grade prose. CPT is DERIVED as the composite of the banked
    involutions, NEVER posited. -/
theorem cpt_theorem :
    -- (i) three commuting nontrivial involutions with the Klein-four closure C = P·T.
    (∀ p : StateFibre, chargeConj (chargeConj p) = p) ∧
    (∀ p : StateFibre, parityRefl (parityRefl p) = p) ∧
    (∀ p : StateFibre, timeRev (timeRev p) = p) ∧
    (∀ p : StateFibre, parityRefl (timeRev p) = chargeConj p) ∧
    -- (ii) ★★ the composite CPT = id (the fold returns to itself).
    (∀ p : StateFibre, chargeConj (parityRefl (timeRev p)) = p) ∧
    -- (iii) all three preserve g; P and T reverse ω, C preserves ω; the full CPT preserves ω.
    (∀ x y : StateFibre, bornForm (chargeConj x) (chargeConj y) = bornForm x y) ∧
    (∀ x y : StateFibre, bornForm (parityRefl x) (parityRefl y) = bornForm x y) ∧
    (∀ x y : StateFibre, bornForm (timeRev x) (timeRev y) = bornForm x y) ∧
    (∀ x y : StateFibre, kahlerForm (parityRefl x) (parityRefl y) = - kahlerForm x y) ∧
    (∀ x y : StateFibre, kahlerForm (timeRev x) (timeRev y) = - kahlerForm x y) ∧
    (∀ x y : StateFibre, kahlerForm (chargeConj x) (chargeConj y) = kahlerForm x y) ∧
    (∀ x y : StateFibre,
      kahlerForm (chargeConj (parityRefl (timeRev x))) (chargeConj (parityRefl (timeRev y)))
        = kahlerForm x y) ∧
    -- (iv) the three banked anchors (the weld to three distinct modules).
    (∀ p : StateFibre, toDbl (timeRev p) = dblConj (toDbl p)) ∧
    (∀ p : StateFibre, parityRefl (foldComplex p) = - foldComplex (parityRefl p)) ∧
    (∀ (n : ℕ) (S : Finset (Fin n)), Phys.Algebra.blCharge n Sᶜ = - Phys.Algebra.blCharge n S) ∧
    -- (v) ★★ the never-co-stated cross fact: a factor violates ω yet the triple restores it.
    ((kahlerForm (parityRefl eInward) (parityRefl eOutward) ≠ kahlerForm eInward eOutward)
      ∧ (chargeConj eInward ≠ eInward)) :=
  ⟨chargeConj_involutive, parityRefl_involutive, timeRev_involutive, cpt_PT_eq_C,
   cpt_composite_returns,
   chargeConj_bornForm, parityRefl_bornForm, timeRev_bornForm,
   parityRefl_kahler, timeRev_kahler, chargeConj_kahler, cpt_CPT_kahler,
   timeRev_is_dblConj, parityRefl_anticommutes_foldComplex, charge_conjugation_hodge_odd,
   ⟨(cpt_factor_violates_but_triple_restores).1, chargeConj_ne_id⟩⟩

end

end Phys.Quantum.CPT
